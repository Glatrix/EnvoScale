{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Envo",
  "scopeName": "source.envo",
  "fileTypes": [
    "envo"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.envo",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.envo",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.envo",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.envo",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.interpolated.envo",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "name": "meta.interpolation.envo",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.envo"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.envo"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.envo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.envo",
          "match": "'(?:\\\\(?:u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)|[^'\\\\])'"
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.envo",
      "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|[nrt0\\\\\"'{}])"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.envo",
          "match": "\\b0x[0-9A-Fa-f_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.binary.envo",
          "match": "\\b0b[01_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.octal.envo",
          "match": "\\b0o[0-7_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.decimal.envo",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9_]+)?(?:_?(?:[iu](?:8|16|32|64|128|size)|f32|f64))?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(struct|enum|interface|class|namespace|impl)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.envo"
            },
            "2": {
              "name": "entity.name.type.envo"
            }
          }
        },
        {
          "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.envo"
            },
            "2": {
              "name": "entity.name.namespace.envo"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.envo",
          "match": "\\b(if|else|for|foreach|while|do|break|continue|return|match|yield|await|async|try|catch|throw|goto)\\b"
        },
        {
          "name": "constant.language.envo",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "variable.language.envo",
          "match": "\\b(this|base)\\b"
        },
        {
          "name": "keyword.operator.word.envo",
          "match": "\\b(as|in|out|ref|is|new|sizeof|alignof|where|from)\\b"
        },
        {
          "name": "storage.modifier.envo",
          "match": "\\b(public|private|protected|internal|static|const|unsafe|extern|abstract|sealed|virtual|override|weak|comptime|mut|move|once)\\b"
        },
        {
          "name": "keyword.other.envo",
          "match": "\\b(var|fn|using|asm|macro|struct|enum|interface|class|namespace|impl|use)\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.primitive.envo",
      "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|int|uint|f32|f64|bool|char|str|string|void)\\b"
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.envo"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.envo",
          "match": "=>"
        },
        {
          "name": "keyword.operator.envo",
          "match": "\\?\\?|\\.\\.|[-+*/%&|^!~<>=?]=?|&&|\\|\\|"
        }
      ]
    }
  }
}
