// The platform binding for `--os none` (PLAN D23): the reference adapters. The file
// system is in memory, the clock stands at 2026-01-01 00:00 UTC until advanced, entropy
// is seeded (deterministic), the only argument is "program", no environment variable is
// set, and the one program Process can run is "program", which echoes its arguments
// (os.none.Process). The console is the process's own, so output can still be read.
namespace platform;

use os.none;

public none.Terminal Console() => none.Terminal.New();
public none.FileSystem FileSystem() => none.SharedFileSystem();
public none.Clock Clock() => none.SharedClock();
public none.Entropy Entropy() => none.SharedEntropy();
public none.Environment Environment() => none.SharedEnvironment();
public none.Process Process() => none.SharedProcess();

// The reference adapters have no system to call: the script runtime runs only on a
// native platform.
public i64 RawCall(u32 kind, i64 k, i64 a, i64 b, i64 c, i64 d, i64 e, i64 f, i64 g, i64 h, i64 i, i64 j) => -1;
