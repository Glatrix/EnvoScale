// os.none: the reference adapters, which need no operating system (PLAN D22-D24;
// docs/architecture/ports-and-adapters.md). Each port's conformance suite is developed
// against them first, most library tests use them, and they are the fallback on a new
// platform. They are deterministic: the same calls give the same results on every run.
//
// Each adapter keeps its state on the heap behind a pointer, so copies of one adapter
// share it (the heap never frees in Envo-S1, so nothing is lost).
namespace os.none;

use ports.{IConsole, IFileSystem, IClock, IEntropy, IEnvironment, IProcess, INet, ITrust, ITerminal, IWindow, IClipboard, Event, EventKind, IoError};
use alloc.map.{Map};
use alloc.set.{Set};
use alloc.text;

// ------------------------------------------------------------------ console

struct ConsoleState {
    string Out;
    string Err;
    string In;
    usize InAt;
}

// A console that keeps what is written to it, and reads from text given up front.
public struct Console {
    *ConsoleState State;

    public static Console New() => Console.WithInput("");

    public static Console WithInput(str input) {
        unsafe {
            *ConsoleState p = alloc(sizeof(ConsoleState)) as *ConsoleState;
            p[0] = new ConsoleState { Out = string.New(), Err = string.New(), In = string.From(input), InAt = 0 };
            return new Console { State = p };
        }
    }

    // Everything written to standard output so far.
    public str Stdout(in this) {
        unsafe { return this.State[0].Out.AsStr(); }
    }

    // Everything written to standard error so far.
    public str Stderr(in this) {
        unsafe { return this.State[0].Err.AsStr(); }
    }
}

impl IConsole for Console {
    void Out(ref this, str text) {
        unsafe { this.State[0].Out.Append(text); }
    }

    void Err(ref this, str text) {
        unsafe { this.State[0].Err.Append(text); }
    }

    usize Read(ref this, mut u8[] into) {
        usize n = 0;
        unsafe {
            str input = this.State[0].In.AsStr();
            usize at = this.State[0].InAt;
            while (n < into.Len && at + n < input.Len) {
                into[n] = input[at + n];
                n++;
            }
            this.State[0].InAt = at + n;
        }
        return n;
    }
}

// The process's own standard streams, through the language runtime: what `platform`
// gives as the console with `--os none`, so a program's output can still be read.
public struct Stdio {
    u8 Unused;

    public static Stdio New() => new Stdio { Unused = 0 };
}

impl IConsole for Stdio {
    void Out(ref this, str text) => write(1, text);
    void Err(ref this, str text) => write(2, text);

    usize Read(ref this, mut u8[] into) {
        if (into.Len == 0) return 0;
        isize n = 0;
        unsafe { n = read(0, &into[0], into.Len); }
        if (n <= 0) return 0;
        return n as usize;
    }
}

// ------------------------------------------------------------------ file system

struct FsState {
    Map<string, string> Files;
    Set<string> Dirs;
}

// A file system in memory. Paths are compared after `\` becomes `/`, a leading `./` and
// a trailing `/` go, and repeated `/` collapse; "" and "." are the working directory,
// which always exists.
public struct FileSystem {
    *FsState State;

    public static FileSystem New() {
        unsafe {
            *FsState p = alloc(sizeof(FsState)) as *FsState;
            p[0] = new FsState { Files = Map<string, string>.New(), Dirs = Set<string>.New() };
            return new FileSystem { State = p };
        }
    }
}

// Does path hold a NUL byte? Native systems cannot take one, so neither does this.
bool BadPath(str path) {
    for (usize i = 0; i < path.Len; i++) {
        if (path[i] == 0) return true;
    }
    return false;
}

// path in the form the file system compares.
string Clean(str path) {
    string r = string.New();
    usize i = 0;
    while (i + 1 < path.Len && path[i] == '.' && (path[i + 1] == '/' || path[i + 1] == 0x5C)) i += 2;
    if (path.Len == 1 && path[0] == '.') i = 1;
    while (i < path.Len) {
        u8 c = path[i];
        if (c == 0x5C) c = '/';
        if (c == '/' && r.Len() > 0 && r.AsStr()[r.Len() - 1] == '/') {
            i++;
            continue;
        }
        r.AppendByte(c);
        i++;
    }
    while (r.Len() > 1 && r.AsStr()[r.Len() - 1] == '/') {
        string t = string.From(r.AsStr()[0..r.Len() - 1]);
        r = t;
    }
    return r;
}

// The directory that holds path ("" for the working directory).
string Parent(str path) {
    usize i = path.Len;
    while (i > 0) {
        i--;
        if (path[i] == '/') {
            if (i == 0) return string.From("/");
            return string.From(path[0..i]);
        }
    }
    return string.New();
}

impl IFileSystem for FileSystem {
    Result<string, IoError> Read(ref this, str path) {
        if (BadPath(path)) return Err(IoError.Invalid);
        string p = Clean(path);
        unsafe {
            string[] v = this.State[0].Files.View(p);
            if (v.Len == 0) {
                if (this.State[0].Dirs.Has(p)) return Err(IoError.Invalid);
                return Err(IoError.NotFound);
            }
            return Ok(string.From(v[0].AsStr()));
        }
    }

    Result<usize, IoError> Write(ref this, str path, str data) {
        if (BadPath(path)) return Err(IoError.Invalid);
        string p = Clean(path);
        if (p.Len() == 0) return Err(IoError.Invalid);
        string parent = Parent(p.AsStr());
        unsafe {
            if (this.State[0].Dirs.Has(p)) return Err(IoError.Invalid);
            if (parent.Len() > 0 && !this.State[0].Dirs.Has(parent)) return Err(IoError.NotFound);
            this.State[0].Files.Set(p, string.From(data));
        }
        return Ok(data.Len);
    }

    bool IsFile(ref this, str path) {
        if (BadPath(path)) return false;
        string p = Clean(path);
        unsafe { return this.State[0].Files.Has(p); }
    }

    bool IsDir(ref this, str path) {
        if (BadPath(path)) return false;
        string p = Clean(path);
        if (p.Len() == 0) return true;
        unsafe { return this.State[0].Dirs.Has(p); }
    }

    Result<bool, IoError> Delete(ref this, str path) {
        if (BadPath(path)) return Err(IoError.Invalid);
        string p = Clean(path);
        unsafe {
            if (this.State[0].Files.Remove(p).IsSome()) return Ok(true);
            if (this.State[0].Dirs.Has(p)) return Err(IoError.Invalid);
        }
        return Err(IoError.NotFound);
    }

    Result<bool, IoError> CreateDir(ref this, str path) {
        if (BadPath(path)) return Err(IoError.Invalid);
        string p = Clean(path);
        if (p.Len() == 0) return Err(IoError.Exists);
        string parent = Parent(p.AsStr());
        unsafe {
            if (this.State[0].Dirs.Has(p) || this.State[0].Files.Has(p)) return Err(IoError.Exists);
            if (parent.Len() > 0 && !this.State[0].Dirs.Has(parent)) return Err(IoError.NotFound);
            this.State[0].Dirs.Add(p);
        }
        return Ok(true);
    }

    Result<bool, IoError> RemoveDir(ref this, str path) {
        if (BadPath(path)) return Err(IoError.Invalid);
        string p = Clean(path);
        unsafe {
            if (!this.State[0].Dirs.Has(p)) return Err(IoError.NotFound);
            // empty: no file or directory has p as its parent
            List<string> files = KeysOf(this.State[0].Files);
            foreach (var f in files.AsSlice()) {
                string fp = Parent(f.AsStr());
                if (fp.Equals(p.AsStr())) return Err(IoError.NotEmpty);
            }
            List<string> dirs = DirsOf(this.State[0].Dirs);
            foreach (var d in dirs.AsSlice()) {
                string dp = Parent(d.AsStr());
                if (dp.Equals(p.AsStr())) return Err(IoError.NotEmpty);
            }
            this.State[0].Dirs.Remove(p);
        }
        return Ok(true);
    }

    Result<List<string>, IoError> List(ref this, str path) {
        if (BadPath(path)) return Err(IoError.Invalid);
        string p = Clean(path);
        unsafe {
            if (p.Len() > 0 && !this.State[0].Dirs.Has(p)) {
                if (this.State[0].Files.Has(p)) return Err(IoError.Invalid);
                return Err(IoError.NotFound);
            }
            List<string> names = List<string>.New();
            List<string> files = KeysOf(this.State[0].Files);
            foreach (var f in files.AsSlice()) {
                string fp = Parent(f.AsStr());
                if (fp.Equals(p.AsStr())) names.Push(LastPart(f.AsStr()));
            }
            List<string> dirs = DirsOf(this.State[0].Dirs);
            foreach (var d in dirs.AsSlice()) {
                string dp = Parent(d.AsStr());
                if (dp.Equals(p.AsStr())) names.Push(LastPart(d.AsStr()));
            }
            text.Sort(ref names);
            return Ok(names);
        }
    }
}

// The part of path after its last `/`.
string LastPart(str path) {
    usize i = path.Len;
    while (i > 0 && path[i - 1] != '/') i--;
    return string.From(path[i..path.Len]);
}

// Copies of the paths a table holds.
List<string> KeysOf(in Map<string, string> m) {
    List<string> all = List<string>.New();
    for (usize i = 0; i < m.Slots(); i++) {
        string[] k = m.KeyAt(i);
        if (k.Len == 1) all.Push(string.From(k[0].AsStr()));
    }
    return all;
}

List<string> DirsOf(in Set<string> s) {
    List<string> all = List<string>.New();
    for (usize i = 0; i < s.Slots(); i++) {
        string[] k = s.ItemAt(i);
        if (k.Len == 1) all.Push(string.From(k[0].AsStr()));
    }
    return all;
}

// ------------------------------------------------------------------ clock

struct ClockState {
    i64 Now;
    u64 Mono;
}

// A clock that moves only when told to (Advance).
public struct Clock {
    *ClockState State;

    // Starts at wall-clock time start (nanoseconds since 1970) and monotonic time 0.
    public static Clock At(i64 start) {
        unsafe {
            *ClockState p = alloc(sizeof(ClockState)) as *ClockState;
            p[0] = new ClockState { Now = start, Mono = 0 };
            return new Clock { State = p };
        }
    }

    public void Advance(ref this, u64 nanos) {
        unsafe {
            this.State[0].Now = this.State[0].Now + nanos as i64;
            this.State[0].Mono = this.State[0].Mono + nanos;
        }
    }
}

impl IClock for Clock {
    i64 NowNanos(ref this) {
        unsafe { return this.State[0].Now; }
    }

    u64 MonoNanos(ref this) {
        unsafe { return this.State[0].Mono; }
    }
}

// ------------------------------------------------------------------ entropy

struct EntropyState {
    u64 Next;
}

// Deterministic bytes from a seed (SplitMix64): for tests, never for keys.
public struct Entropy {
    *EntropyState State;

    public static Entropy Seeded(u64 seed) {
        unsafe {
            *EntropyState p = alloc(sizeof(EntropyState)) as *EntropyState;
            p[0] = new EntropyState { Next = seed };
            return new Entropy { State = p };
        }
    }
}

impl IEntropy for Entropy {
    void Fill(ref this, mut u8[] into) {
        usize i = 0;
        while (i < into.Len) {
            u64 z = 0;
            unsafe {
                this.State[0].Next = this.State[0].Next +% 0x9E3779B97F4A7C15;
                z = this.State[0].Next;
            }
            z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9;
            z = (z ^ (z >> 27)) *% 0x94D049BB133111EB;
            z = z ^ (z >> 31);
            for (u64 k = 0; k < 8 && i < into.Len; k++) {
                into[i] = ((z >> (8 * k)) & 0xFF) as u8;
                i++;
            }
        }
    }
}

// ------------------------------------------------------------------ environment

struct EnvState {
    List<string> Args;
    Map<string, string> Vars;
}

// A fixed set of arguments.
public struct Environment {
    *EnvState State;

    // An environment whose only argument is the program's name.
    public static Environment Of(str program) {
        unsafe {
            *EnvState p = alloc(sizeof(EnvState)) as *EnvState;
            p[0] = new EnvState { Args = List<string>.New(), Vars = Map<string, string>.New() };
            p[0].Args.Push(string.From(program));
            return new Environment { State = p };
        }
    }

    public void Add(ref this, str arg) {
        unsafe { this.State[0].Args.Push(string.From(arg)); }
    }

    // Sets the environment variable name to value.
    public void SetVar(ref this, str name, str value) {
        unsafe { this.State[0].Vars.Set(string.From(name), string.From(value)); }
    }
}

impl IEnvironment for Environment {
    usize ArgCount(ref this) {
        unsafe { return this.State[0].Args.Len(); }
    }

    str Arg(ref this, usize i) {
        unsafe { return this.State[0].Args.AsSlice()[i].AsStr(); }
    }

    // The reference file system's working directory is its root.
    string CurrentDir(ref this) => string.From("/");

    string? Var(ref this, str name) {
        string key = string.From(name);
        unsafe {
            string[] v = this.State[0].Vars.View(key);
            if (v.Len == 0) return null;
            return Some(string.From(v[0].AsStr()));
        }
    }
}

// ------------------------------------------------------------------ process

struct ProcState {
    *FsState Fs;
    Set<string> Programs;
    string Runs;
}

// Programs that exist only by name. Each one echoes: it writes each of its arguments
// and a newline to standard output, "err" and a newline to standard error, and exits
// with its number of arguments. Their output files are written to a FileSystem of this
// module; output not sent to a file goes to this process's own streams.
public struct Process {
    *ProcState State;

    public static Process On(FileSystem fs) {
        unsafe {
            *ProcState p = alloc(sizeof(ProcState)) as *ProcState;
            p[0] = new ProcState { Fs = fs.State, Programs = Set<string>.New(), Runs = string.New() };
            return new Process { State = p };
        }
    }

    // Makes program (a name or a path) one that Run can start.
    public void Add(ref this, str program) {
        unsafe { this.State[0].Programs.Add(string.From(program)); }
    }

    // Every run so far, a line each: the program and its arguments, between spaces.
    public str Runs(in this) {
        unsafe { return this.State[0].Runs.AsStr(); }
    }
}

impl IProcess for Process {
    Result<i32, IoError> Run(ref this, str program, str[] args, str workDir, str outPath, str errPath) {
        if (BadPath(program) || BadPath(workDir) || BadPath(outPath) || BadPath(errPath)) return Err(IoError.Invalid);
        foreach (var a in args) {
            if (BadPath(a)) return Err(IoError.Invalid);
        }
        string echo = string.New();
        foreach (var a in args) {
            echo.Append(a);
            echo.AppendByte('\n');
        }
        str err = "err\n";
        unsafe {
            string name = string.From(program);
            if (!this.State[0].Programs.Has(name)) return Err(IoError.NotFound);
            FileSystem fs = new FileSystem { State = this.State[0].Fs };
            if (!fs.IsDir(workDir)) return Err(IoError.NotFound);
            string o = Clean(outPath);
            string e = Clean(errPath);
            if (outPath.Len > 0 && errPath.Len > 0 && o.Equals(e.AsStr())) {
                string both = string.From(echo.AsStr());
                both.Append(err);
                usize w = fs.Write(outPath, both.AsStr())?;
            } else {
                if (outPath.Len > 0) {
                    usize w = fs.Write(outPath, echo.AsStr())?;
                } else {
                    write(1, echo.AsStr());
                }
                if (errPath.Len > 0) {
                    usize w = fs.Write(errPath, err)?;
                } else {
                    write(2, err);
                }
            }
            this.State[0].Runs.Append(program);
            foreach (var a in args) {
                this.State[0].Runs.AppendByte(' ');
                this.State[0].Runs.Append(a);
            }
            this.State[0].Runs.AppendByte('\n');
        }
        return Ok(args.Len as i32);
    }
}

// ------------------------------------------------------------------ shared instances

// One of each for the whole program: what `platform` hands out with `--os none`.
static usize SharedFs = 0;
static usize SharedClockState = 0;
static usize SharedClipboardState = 0;
static usize SharedEntropyState = 0;
static usize SharedEnvState = 0;
static usize SharedProcState = 0;

// 2026-01-01 00:00:00 UTC, where the shared clock starts.
public const i64 START_NANOS = 1767225600000000000;

public FileSystem SharedFileSystem() {
    unsafe {
        if (SharedFs == 0) {
            FileSystem f = FileSystem.New();
            SharedFs = f.State as usize;
        }
        return new FileSystem { State = SharedFs as *FsState };
    }
}

struct ClipboardState {
    bool Has;
    string Text;
}

// A clipboard in memory (PLAN D73): what SetText put there, for the next Text.
public struct Clipboard {
    *ClipboardState State;
}

impl IClipboard for Clipboard {
    string? Text(ref this) {
        unsafe {
            if (!this.State[0].Has) return None;
            return Some(string.From(this.State[0].Text.AsStr()));
        }
    }

    bool SetText(ref this, str text) {
        unsafe {
            this.State[0].Text = string.From(text);
            this.State[0].Has = true;
        }
        return true;
    }
}

public Clipboard SharedClipboard() {
    unsafe {
        if (SharedClipboardState == 0) {
            *ClipboardState p = alloc(sizeof(ClipboardState)) as *ClipboardState;
            p[0] = new ClipboardState { Has = false, Text = string.New() };
            SharedClipboardState = p as usize;
        }
        return new Clipboard { State = SharedClipboardState as *ClipboardState };
    }
}

public Clock SharedClock() {
    unsafe {
        if (SharedClockState == 0) {
            Clock c = Clock.At(START_NANOS);
            SharedClockState = c.State as usize;
        }
        return new Clock { State = SharedClockState as *ClockState };
    }
}

public Entropy SharedEntropy() {
    unsafe {
        if (SharedEntropyState == 0) {
            Entropy e = Entropy.Seeded(0);
            SharedEntropyState = e.State as usize;
        }
        return new Entropy { State = SharedEntropyState as *EntropyState };
    }
}

public Environment SharedEnvironment() {
    unsafe {
        if (SharedEnvState == 0) {
            Environment e = Environment.Of("program");
            SharedEnvState = e.State as usize;
        }
        return new Environment { State = SharedEnvState as *EnvState };
    }
}

// The shared process knows one program, "program": the name the shared environment
// gives as argument 0, so a program can start itself.
public Process SharedProcess() {
    unsafe {
        if (SharedProcState == 0) {
            Process p = Process.On(SharedFileSystem());
            p.Add("program");
            SharedProcState = p.State as usize;
        }
        return new Process { State = SharedProcState as *ProcState };
    }
}

// ------------------------------------------------------------------ network

// One end of an in-memory connection: what the other end has sent, not yet received.
struct Pipe {
    string Data;
    usize At;           // bytes of Data already received
    bool PeerClosed;
    i64 Peer;           // the other end's handle
}

struct NetState {
    List<string> Names;         // resolvable names
    List<string> Addresses;     // and their addresses
    List<u16> ListenPorts;      // a listening socket per entry, by handle
    List<i64> ListenHandles;
    List<i64> Pending;          // connections waiting for Accept: the server ends
    List<i64> PendingPort;
    List<Pipe> Ends;            // handle h is Ends[h - 1]
    u16 NextPort;
}

// A network in memory: listening sockets, connections between them, and names given
// with AddName. Only 127.0.0.1 (and "localhost") is reachable. Receiving from a
// connection with nothing to read and an open peer is an error (a single program
// cannot wait for itself).
public struct Net {
    *NetState State;

    public static Net New() {
        unsafe {
            *NetState p = alloc(sizeof(NetState)) as *NetState;
            p[0] = new NetState {
                Names = List<string>.New(), Addresses = List<string>.New(), ListenPorts = List<u16>.New(),
                ListenHandles = List<i64>.New(), Pending = List<i64>.New(), PendingPort = List<i64>.New(),
                Ends = List<Pipe>.New(), NextPort = 40000,
            };
            return new Net { State = p };
        }
    }

    // Makes name resolve to address.
    public void AddName(ref this, str name, str address) {
        unsafe {
            this.State[0].Names.Push(string.From(name));
            this.State[0].Addresses.Push(string.From(address));
        }
    }

    i64 NewEnd(ref this) {
        unsafe {
            this.State[0].Ends.Push(new Pipe { Data = string.New(), At = 0, PeerClosed = false, Peer = 0 });
            return this.State[0].Ends.Len() as i64;
        }
    }
}

bool IsLoopback(str a) => a.Len == 9 && a[0] == '1' && a[1] == '2' && a[2] == '7' && a[3] == '.' && a[4] == '0' && a[5] == '.' && a[6] == '0' && a[7] == '.' && a[8] == '1';

impl INet for Net {
    Result<List<string>, IoError> Resolve(ref this, str host) {
        List<string> all = List<string>.New();
        if (IsLoopback(host) || text.Lower(host).Equals("localhost")) {
            all.Push(string.From("127.0.0.1"));
            return Ok(all);
        }
        unsafe {
            for (usize i = 0; i < this.State[0].Names.Len(); i++) {
                if (this.State[0].Names.AsSlice()[i].Equals(host)) all.Push(string.From(this.State[0].Addresses.AsSlice()[i].AsStr()));
            }
        }
        if (all.Len() == 0) return Err(IoError.NotFound);
        return Ok(all);
    }

    Result<i64, IoError> Connect(ref this, str host, u16 port) {
        List<string> addrs = this.Resolve(host)?;
        if (!IsLoopback(addrs.AsSlice()[0].AsStr())) return Err(IoError.Refused);
        bool listening = false;
        unsafe {
            foreach (var p in this.State[0].ListenPorts.AsSlice()) {
                if (p == port) listening = true;
            }
        }
        if (!listening) return Err(IoError.Refused);
        i64 client = this.NewEnd();
        i64 server = this.NewEnd();
        unsafe {
            this.State[0].Ends.AsMutSlice()[(client - 1) as usize].Peer = server;
            this.State[0].Ends.AsMutSlice()[(server - 1) as usize].Peer = client;
            this.State[0].Pending.Push(server);
            this.State[0].PendingPort.Push(port as i64);
        }
        return Ok(client);
    }

    Result<i64, IoError> Listen(ref this, str host, u16 port) {
        List<string> addrs = this.Resolve(host)?;
        if (!IsLoopback(addrs.AsSlice()[0].AsStr())) return Err(IoError.Invalid);
        u16 p = port;
        unsafe {
            if (p == 0) {
                p = this.State[0].NextPort;
                this.State[0].NextPort = p + 1;
            }
            foreach (var used in this.State[0].ListenPorts.AsSlice()) {
                if (used == p) return Err(IoError.Exists);
            }
            i64 h = 0 - (this.State[0].ListenPorts.Len() as i64 + 1);
            this.State[0].ListenPorts.Push(p);
            this.State[0].ListenHandles.Push(h);
            return Ok(h);
        }
    }

    u16 LocalPort(ref this, i64 listener) {
        unsafe {
            for (usize i = 0; i < this.State[0].ListenHandles.Len(); i++) {
                if (this.State[0].ListenHandles.AsSlice()[i] == listener) return this.State[0].ListenPorts.AsSlice()[i];
            }
        }
        return 0;
    }

    Result<i64, IoError> Accept(ref this, i64 listener) {
        u16 port = this.LocalPort(listener);
        unsafe {
            for (usize i = 0; i < this.State[0].Pending.Len(); i++) {
                if (this.State[0].PendingPort.AsSlice()[i] == port as i64) {
                    i64 h = this.State[0].Pending.AsSlice()[i];
                    // take it out of the queue
                    List<i64> pending = List<i64>.New();
                    List<i64> ports = List<i64>.New();
                    for (usize k = 0; k < this.State[0].Pending.Len(); k++) {
                        if (k == i) continue;
                        pending.Push(this.State[0].Pending.AsSlice()[k]);
                        ports.Push(this.State[0].PendingPort.AsSlice()[k]);
                    }
                    this.State[0].Pending = pending;
                    this.State[0].PendingPort = ports;
                    return Ok(h);
                }
            }
        }
        return Err(IoError.Other);
    }

    Result<usize, IoError> Send(ref this, i64 conn, u8[] data) {
        unsafe {
            if (conn <= 0 || conn as usize > this.State[0].Ends.Len()) return Err(IoError.Invalid);
            i64 peer = this.State[0].Ends.AsSlice()[(conn - 1) as usize].Peer;
            if (peer == 0) return Err(IoError.Other);
            for (usize i = 0; i < data.Len; i++) this.State[0].Ends.AsMutSlice()[(peer - 1) as usize].Data.AppendByte(data[i]);
        }
        return Ok(data.Len);
    }

    Result<usize, IoError> Recv(ref this, i64 conn, mut u8[] into) {
        unsafe {
            if (conn <= 0 || conn as usize > this.State[0].Ends.Len()) return Err(IoError.Invalid);
            usize at = this.State[0].Ends.AsSlice()[(conn - 1) as usize].At;
            str d = this.State[0].Ends.AsSlice()[(conn - 1) as usize].Data.AsStr();
            if (at >= d.Len) {
                if (this.State[0].Ends.AsSlice()[(conn - 1) as usize].PeerClosed) return Ok(0);
                return Err(IoError.Other);
            }
            usize n = 0;
            while (n < into.Len && at + n < d.Len) {
                into[n] = d[at + n];
                n++;
            }
            this.State[0].Ends.AsMutSlice()[(conn - 1) as usize].At = at + n;
            return Ok(n);
        }
    }

    void Close(ref this, i64 handle) {
        unsafe {
            if (handle <= 0 || handle as usize > this.State[0].Ends.Len()) {
                // a listening socket: it stops listening
                for (usize i = 0; i < this.State[0].ListenHandles.Len(); i++) {
                    if (this.State[0].ListenHandles.AsSlice()[i] == handle) this.State[0].ListenPorts.AsMutSlice()[i] = 0;
                }
                return;
            }
            i64 peer = this.State[0].Ends.AsSlice()[(handle - 1) as usize].Peer;
            if (peer > 0) {
                this.State[0].Ends.AsMutSlice()[(peer - 1) as usize].PeerClosed = true;
                this.State[0].Ends.AsMutSlice()[(peer - 1) as usize].Peer = 0;
            }
            this.State[0].Ends.AsMutSlice()[(handle - 1) as usize].Peer = 0;
        }
    }
}

static usize SharedNetState = 0;

public Net SharedNet() {
    unsafe {
        if (SharedNetState == 0) {
            Net n = Net.New();
            SharedNetState = n.State as usize;
        }
        return new Net { State = SharedNetState as *NetState };
    }
}

// ------------------------------------------------------------------ trust

struct TrustState {
    List<List<u8>> Roots;
}

// Trust anchors given with Add: none at first.
public struct Trust {
    *TrustState State;

    public static Trust New() {
        unsafe {
            *TrustState p = alloc(sizeof(TrustState)) as *TrustState;
            p[0] = new TrustState { Roots = List<List<u8>>.New() };
            return new Trust { State = p };
        }
    }

    // Trusts the certificate in der.
    public void Add(ref this, u8[] der) {
        List<u8> one = List<u8>.New();
        for (usize i = 0; i < der.Len; i++) one.Push(der[i]);
        unsafe { this.State[0].Roots.Push(one); }
    }
}

impl ITrust for Trust {
    List<List<u8>> Roots(ref this) {
        List<List<u8>> all = List<List<u8>>.New();
        unsafe {
            foreach (var r in this.State[0].Roots.AsSlice()) {
                List<u8> one = List<u8>.New();
                foreach (var b in r.AsSlice()) one.Push(b);
                all.Push(one);
            }
        }
        return all;
    }
}

// ------------------------------------------------------------------ terminal

struct TerminalState {
    string Out;
    string In;
    usize InAt;
    u32 C;
    u32 R;
    bool IsRaw;
}

// A terminal of a given size that keeps what is written to it and reads from text given
// to it: what envo.term's tests drive.
public struct Terminal {
    *TerminalState State;

    public static Terminal New() => Terminal.Sized(80, 24);

    public static Terminal Sized(u32 cols, u32 rows) {
        unsafe {
            *TerminalState p = alloc(sizeof(TerminalState)) as *TerminalState;
            p[0] = new TerminalState { Out = string.New(), In = string.New(), InAt = 0, C = cols, R = rows, IsRaw = false };
            return new Terminal { State = p };
        }
    }

    // Everything written so far.
    public str Output(in this) {
        unsafe { return this.State[0].Out.AsStr(); }
    }

    // Forgets what was written so far.
    public void ClearOutput(ref this) {
        unsafe { this.State[0].Out = string.New(); }
    }

    // Input for Read to give, after what is already waiting.
    public void Type(ref this, str input) {
        unsafe { this.State[0].In.Append(input); }
    }

    // Is raw mode on?
    public bool InRaw(in this) {
        unsafe { return this.State[0].IsRaw; }
    }

    // The window changes size.
    public void Resize(ref this, u32 cols, u32 rows) {
        unsafe {
            this.State[0].C = cols;
            this.State[0].R = rows;
        }
    }
}

impl ITerminal for Terminal {
    bool IsTerminal(ref this) => true;

    u32 Cols(ref this) {
        unsafe { return this.State[0].C; }
    }

    u32 Rows(ref this) {
        unsafe { return this.State[0].R; }
    }

    bool Raw(ref this, bool on) {
        unsafe { this.State[0].IsRaw = on; }
        return true;
    }

    void Write(ref this, str text) {
        unsafe { this.State[0].Out.Append(text); }
    }

    usize Read(ref this, mut u8[] into, i32 waitMs) {
        usize n = 0;
        unsafe {
            str input = this.State[0].In.AsStr();
            usize at = this.State[0].InAt;
            while (n < into.Len && at + n < input.Len) {
                into[n] = input[at + n];
                n++;
            }
            this.State[0].InAt = at + n;
        }
        return n;
    }
}

// ------------------------------------------------------------------ window

struct WindowState {
    bool Opened;
    string Title;
    u32 W;
    u32 H;
    List<Event> Queue;
    usize At;
    List<u8> Frame;
    u32 FrameW;
    u32 FrameH;
    u32 Frames;
}

// An off-screen window: it keeps the last frame presented, and gives the events a test
// queues (D45).
public struct Window {
    *WindowState State;

    public static Window New() {
        unsafe {
            *WindowState p = alloc(sizeof(WindowState)) as *WindowState;
            p[0] = new WindowState { Opened = false, Title = string.New(), W = 0, H = 0, Queue = List<Event>.New(), At = 0, Frame = List<u8>.New(), FrameW = 0, FrameH = 0, Frames = 0 };
            return new Window { State = p };
        }
    }

    // An event for Poll to give, after those already waiting. Close closes the window
    // as it is given; Resize changes its size.
    public void Queue(ref this, Event e) {
        unsafe { this.State[0].Queue.Push(e); }
    }

    public str Title(in this) {
        unsafe { return this.State[0].Title.AsStr(); }
    }

    // The last frame presented, RGBA, and its size; how many frames so far.
    public u8[] Frame(in this) {
        unsafe { return this.State[0].Frame.AsSlice(); }
    }

    public u32 FrameWidth(in this) {
        unsafe { return this.State[0].FrameW; }
    }

    public u32 FrameHeight(in this) {
        unsafe { return this.State[0].FrameH; }
    }

    public u32 Frames(in this) {
        unsafe { return this.State[0].Frames; }
    }
}

impl IWindow for Window {
    bool Open(ref this, str title, u32 width, u32 height) {
        unsafe {
            if (this.State[0].Opened) return false;
            this.State[0].Opened = true;
            this.State[0].Title = string.From(title);
            this.State[0].W = width;
            this.State[0].H = height;
        }
        return true;
    }

    bool IsOpen(ref this) {
        unsafe { return this.State[0].Opened; }
    }

    u32 Width(ref this) {
        unsafe { return this.State[0].W; }
    }

    u32 Height(ref this) {
        unsafe { return this.State[0].H; }
    }

    Event Poll(ref this) {
        unsafe {
            usize at = this.State[0].At;
            if (!this.State[0].Opened || at >= this.State[0].Queue.Len()) return Event.Nothing();
            Event e = this.State[0].Queue.Get(at);
            this.State[0].At = at + 1;
            if (e.Is(EventKind.Close)) this.State[0].Opened = false;
            if (e.Is(EventKind.Resize)) {
                this.State[0].W = e.X() as u32;
                this.State[0].H = e.Y() as u32;
            }
            return e;
        }
    }

    void Present(ref this, u8[] rgba, u32 width, u32 height) {
        unsafe {
            if (!this.State[0].Opened) return;
            List<u8> f = List<u8>.New();
            usize n = (width * height * 4) as usize;
            for (usize i = 0; i < n && i < rgba.Len; i++) f.Push(rgba[i]);
            this.State[0].Frame = f;
            this.State[0].FrameW = width;
            this.State[0].FrameH = height;
            this.State[0].Frames = this.State[0].Frames + 1;
        }
    }

    void SetTitle(ref this, str title) {
        unsafe { this.State[0].Title = string.From(title); }
    }

    void Close(ref this) {
        unsafe { this.State[0].Opened = false; }
    }
}
