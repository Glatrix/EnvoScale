// os.windows: the native adapters for Windows (PLAN D25). They call KERNEL32.dll and
// ADVAPI32.dll through the `__wincall` intrinsic: import k is slot k of the executable's
// address table (bootstrap/stage1/x64/image.envo). Text is UTF-8; paths are converted to
// UTF-16 for the `…W` functions.
namespace os.windows;

use ports.{IConsole, IFileSystem, IClock, IEntropy, IEnvironment, IProcess, INet, IoError};
use core.text as ct;
use alloc.text;

const i64 W_GETSTDHANDLE = 0;
const i64 W_CREATEFILEW = 2;
const i64 W_CLOSEHANDLE = 5;
const i64 W_GETLASTERROR = 8;
const i64 W_MULTIBYTETOWIDECHAR = 10;
const i64 W_WIDECHARTOMULTIBYTE = 11;
const i64 W_GETSYSTEMTIMEPRECISE = 12;
const i64 W_QUERYPERFCOUNTER = 13;
const i64 W_QUERYPERFFREQUENCY = 14;
const i64 W_DELETEFILEW = 15;
const i64 W_CREATEDIRECTORYW = 16;
const i64 W_REMOVEDIRECTORYW = 17;
const i64 W_GETFILEATTRIBUTESW = 18;
const i64 W_CREATEPROCESSW = 19;
const i64 W_WAITFORSINGLEOBJECT = 20;
const i64 W_GETEXITCODEPROCESS = 21;
const i64 W_FINDFIRSTFILEW = 22;
const i64 W_FINDNEXTFILEW = 23;
const i64 W_FINDCLOSE = 24;
const i64 W_SETHANDLEINFORMATION = 25;
const i64 W_GETENVIRONMENTVARIABLEW = 26;
const i64 W_GETCURRENTDIRECTORYW = 27;
const i64 W_RTLGENRANDOM = 29;

const u32 ATTR_DIRECTORY = 0x10;

i64 Ptr(*u8 p) {
    unsafe { return p as isize as i64; }
}

i64 Call(i64 k, i64 a, i64 b, i64 c, i64 d, i64 e, i64 f) => __wincall(k, a, b, c, d, e, f, 0, 0, 0, 0);

u32 LastError() => Call(W_GETLASTERROR, 0, 0, 0, 0, 0, 0) as u32;

// UTF-16 text ending in 0, as UTF-8.
string Narrow(*u8 wide) {
    string s = string.New();
    i64 n = __wincall(W_WIDECHARTOMULTIBYTE, 65001, 0, Ptr(wide), -1, 0, 0, 0, 0, 0, 0) as i32 as i64;
    if (n <= 1) return s;
    unsafe {
        *u8 buf = alloc(n as usize);
        __wincall(W_WIDECHARTOMULTIBYTE, 65001, 0, Ptr(wide), -1, Ptr(buf), n, 0, 0, 0, 0);
        for (usize i = 0; i + 1 < n as usize; i++) s.AppendByte(buf[i]);
    }
    return s;
}

// path as UTF-16 with a terminating 0, or null for one the system cannot take (a NUL
// byte, invalid UTF-8, too long).
*u8 Wide(str path) {
    unsafe {
        if (path.Len >= 32768) return 0 as usize as *u8;
        *u8 z = alloc(path.Len + 1);
        for (usize i = 0; i < path.Len; i++) {
            if (path[i] == 0) return 0 as usize as *u8;
            z[i] = path[i];
        }
        z[path.Len] = 0;
        *u8 wide = alloc((path.Len + 1) * 2);
        i64 n = Call(W_MULTIBYTETOWIDECHAR, 65001, 8, Ptr(z), -1, Ptr(wide), (path.Len + 1) as i64);
        if (n as i32 == 0) return 0 as usize as *u8;
        return wide;
    }
}

// The IoError for a Windows error code.
IoError ErrorOf(u32 code) {
    if (code == 2 || code == 3) return IoError.NotFound;         // FILE_NOT_FOUND, PATH_NOT_FOUND
    if (code == 5 || code == 32) return IoError.Denied;          // ACCESS_DENIED, SHARING_VIOLATION
    if (code == 80 || code == 183) return IoError.Exists;        // FILE_EXISTS, ALREADY_EXISTS
    if (code == 145) return IoError.NotEmpty;                    // DIR_NOT_EMPTY
    if (code == 123 || code == 161 || code == 267) return IoError.Invalid;  // INVALID_NAME, BAD_PATHNAME, DIRECTORY
    return IoError.Other;
}

// The attributes of path, or 0xFFFFFFFF if there is nothing there.
u32 Attributes(str path) {
    *u8 w = Wide(path);
    unsafe {
        if (w as usize == 0) return 0xFFFFFFFF;
    }
    return Call(W_GETFILEATTRIBUTESW, Ptr(w), 0, 0, 0, 0, 0) as u32;
}

// ------------------------------------------------------------------ console

// Standard output, error and input.
public struct Console {
    u8 Unused;

    public static Console New() => new Console { Unused = 0 };
}

impl IConsole for Console {
    void Out(ref this, str text) => write(1, text);
    void Err(ref this, str text) => write(2, text);

    usize Read(ref this, mut u8[] into) {
        if (into.Len == 0) return 0;
        isize n = 0;
        unsafe { n = read(0, &into[0], into.Len); }
        if (n <= 0) return 0;
        return n as usize;
    }
}

// ------------------------------------------------------------------ file system

// The Windows file system. Both `/` and `\` separate a path's parts.
public struct FileSystem {
    u8 Unused;

    public static FileSystem New() => new FileSystem { Unused = 0 };
}

impl IFileSystem for FileSystem {
    Result<string, IoError> Read(ref this, str path) {
        i32 fd = open(path, 0);
        if (fd < 0) {
            // a folder cannot be opened either (ACCESS_DENIED too): look before deciding;
            // a name the system cannot take never reached it, so its error is stale
            u32 e = LastError();
            unsafe {
                if (Wide(path) as usize == 0) return Err(IoError.Invalid);
            }
            u32 attrs = Attributes(path);
            if (attrs != 0xFFFFFFFF && attrs & ATTR_DIRECTORY != 0) return Err(IoError.Invalid);
            if (e == 5) return Err(IoError.Denied);
            if (attrs == 0xFFFFFFFF) return Err(IoError.NotFound);
            return Err(IoError.Denied);
        }
        string s = string.New();
        u8[4096] buf;
        while (true) {
            isize n = 0;
            unsafe { n = read(fd, &buf[0], 4096); }
            if (n < 0) {
                close(fd);
                return Err(IoError.Other);
            }
            if (n == 0) break;
            for (usize i = 0; i < n as usize; i++) s.AppendByte(buf[i]);
        }
        close(fd);
        return Ok(s);
    }

    Result<usize, IoError> Write(ref this, str path, str data) {
        u32 attrs = Attributes(path);
        if (attrs != 0xFFFFFFFF && attrs & ATTR_DIRECTORY != 0) return Err(IoError.Invalid);
        i32 fd = open(path, 1);
        if (fd < 0) {
            u32 e = LastError();
            unsafe {
                if (Wide(path) as usize == 0) return Err(IoError.Invalid);
            }
            if (e == 5) return Err(IoError.Denied);
            return Err(IoError.NotFound);
        }
        write(fd, data);
        close(fd);
        return Ok(data.Len);
    }

    bool IsFile(ref this, str path) {
        u32 attrs = Attributes(path);
        return attrs != 0xFFFFFFFF && attrs & ATTR_DIRECTORY == 0;
    }

    bool IsDir(ref this, str path) {
        if (path.Len == 0) return true;
        u32 attrs = Attributes(path);
        return attrs != 0xFFFFFFFF && attrs & ATTR_DIRECTORY != 0;
    }

    Result<bool, IoError> Delete(ref this, str path) {
        *u8 w = Wide(path);
        unsafe {
            if (w as usize == 0) return Err(IoError.Invalid);
        }
        if (this.IsDir(path)) return Err(IoError.Invalid);
        if (Call(W_DELETEFILEW, Ptr(w), 0, 0, 0, 0, 0) as i32 == 0) return Err(ErrorOf(LastError()));
        return Ok(true);
    }

    Result<bool, IoError> CreateDir(ref this, str path) {
        *u8 w = Wide(path);
        unsafe {
            if (w as usize == 0) return Err(IoError.Invalid);
        }
        if (Call(W_CREATEDIRECTORYW, Ptr(w), 0, 0, 0, 0, 0) as i32 == 0) return Err(ErrorOf(LastError()));
        return Ok(true);
    }

    Result<bool, IoError> RemoveDir(ref this, str path) {
        *u8 w = Wide(path);
        unsafe {
            if (w as usize == 0) return Err(IoError.Invalid);
        }
        if (!this.IsDir(path)) return Err(IoError.NotFound);
        if (Call(W_REMOVEDIRECTORYW, Ptr(w), 0, 0, 0, 0, 0) as i32 == 0) return Err(ErrorOf(LastError()));
        return Ok(true);
    }

    Result<List<string>, IoError> List(ref this, str path) {
        unsafe {
            if (Wide(path) as usize == 0) return Err(IoError.Invalid);
        }
        u32 attrs = 0xFFFFFFFF;
        if (path.Len > 0) attrs = Attributes(path);
        if (path.Len > 0 && attrs == 0xFFFFFFFF) {
            if (LastError() == 5) return Err(IoError.Denied);
            return Err(IoError.NotFound);
        }
        if (path.Len > 0 && attrs & ATTR_DIRECTORY == 0) return Err(IoError.Invalid);
        string pattern = string.From(path);
        if (path.Len > 0 && path[path.Len - 1] != '/' && path[path.Len - 1] != 0x5C) pattern.AppendByte('/');
        pattern.AppendByte('*');
        *u8 w = Wide(pattern.AsStr());
        List<string> names = List<string>.New();
        unsafe {
            if (w as usize == 0) return Err(IoError.Invalid);
            *u8 found = alloc(592);         // WIN32_FIND_DATAW; the name is at 44
            i64 h = Call(W_FINDFIRSTFILEW, Ptr(w), Ptr(found), 0, 0, 0, 0);
            if (h == -1) {
                u32 e = LastError();
                if (e == 2 || e == 18) return Ok(names);    // FILE_NOT_FOUND, NO_MORE_FILES
                return Err(ErrorOf(e));
            }
            while (true) {
                string name = Narrow(&found[44]);
                if (!name.Equals(".") && !name.Equals("..")) names.Push(name);
                if (Call(W_FINDNEXTFILEW, h, Ptr(found), 0, 0, 0, 0) as i32 == 0) break;
            }
            Call(W_FINDCLOSE, h, 0, 0, 0, 0, 0);
        }
        text.Sort(ref names);
        return Ok(names);
    }
}

// ------------------------------------------------------------------ clock

// The system clock (GetSystemTimePreciseAsFileTime) and the performance counter.
public struct Clock {
    u8 Unused;

    public static Clock New() => new Clock { Unused = 0 };
}

impl IClock for Clock {
    i64 NowNanos(ref this) {
        u64 ft = 0;
        unsafe { Call(W_GETSYSTEMTIMEPRECISE, &ft as isize as i64, 0, 0, 0, 0, 0); }
        // 100-ns ticks since 1601-01-01; 1970-01-01 is 11644473600 s later
        i64 ticks = ft as i64 - 116444736000000000;
        return ticks * 100;
    }

    u64 MonoNanos(ref this) {
        u64 count = 0;
        u64 freq = 0;
        unsafe {
            Call(W_QUERYPERFCOUNTER, &count as isize as i64, 0, 0, 0, 0, 0);
            Call(W_QUERYPERFFREQUENCY, &freq as isize as i64, 0, 0, 0, 0, 0);
        }
        if (freq == 0) return 0;
        return count / freq * 1000000000 + count % freq * 1000000000 / freq;
    }
}

// ------------------------------------------------------------------ entropy

// The system's random generator (RtlGenRandom).
public struct Entropy {
    u8 Unused;

    public static Entropy New() => new Entropy { Unused = 0 };
}

impl IEntropy for Entropy {
    void Fill(ref this, mut u8[] into) {
        usize at = 0;
        while (at < into.Len) {
            usize n = into.Len - at;
            if (n > 0x10000000) n = 0x10000000;
            i64 ok = 0;
            unsafe { ok = Call(W_RTLGENRANDOM, &into[at] as isize as i64, n as i64, 0, 0, 0, 0); }
            if (ok as u8 == 0) panic("os.windows: the system random generator failed");
            at += n;
        }
    }
}

// ------------------------------------------------------------------ environment

// The command line, split as the C runtime does.
public struct Environment {
    u8 Unused;

    public static Environment New() => new Environment { Unused = 0 };
}

impl IEnvironment for Environment {
    usize ArgCount(ref this) => argc();
    str Arg(ref this, usize i) => arg(i);

    string CurrentDir(ref this) {
        unsafe {
            i64 cap = 260;
            while (true) {
                *u8 buf = alloc((cap * 2) as usize);
                i64 n = Call(W_GETCURRENTDIRECTORYW, cap, Ptr(buf), 0, 0, 0, 0) as u32 as i64;
                if (n == 0) return string.New();
                if (n < cap) return Narrow(buf);
                cap = n;        // the size it needs, its 0 included
            }
        }
        return string.New();
    }

    string? Var(ref this, str name) {
        if (name.Len == 0) return null;
        *u8 w = Wide(name);
        unsafe {
            if (w as usize == 0) return null;
            i64 cap = 256;
            while (true) {
                *u8 buf = alloc((cap * 2) as usize);
                i64 n = Call(W_GETENVIRONMENTVARIABLEW, Ptr(w), Ptr(buf), cap, 0, 0, 0) as u32 as i64;
                if (n == 0) return null;
                if (n < cap) return Some(Narrow(buf));
                cap = n;        // the size it needs, its 0 included
            }
        }
        return null;
    }
}

// ------------------------------------------------------------------ process

// Programs started with CreateProcessW. The command line is built so the C runtime's
// rules (CommandLineToArgvW) split it back into the same arguments; a program without a
// path is looked up as CreateProcessW does (its own directory, the working directory,
// the system directories, then PATH; ".exe" is added when the name has no extension).
public struct Process {
    u8 Unused;

    public static Process New() => new Process { Unused = 0 };
}

// Appends a to cmd, quoted when it must be; false if a holds a NUL byte.
bool Quote(ref string cmd, str a) {
    bool needs = a.Len == 0;
    for (usize i = 0; i < a.Len; i++) {
        u8 c = a[i];
        if (c == 0) return false;
        if (c == ' ' || c == 9 || c == 10 || c == 11 || c == 0x22) needs = true;
    }
    if (!needs) {
        cmd.Append(a);
        return true;
    }
    cmd.AppendByte(0x22);
    usize i = 0;
    while (i < a.Len) {
        usize slashes = 0;
        while (i < a.Len && a[i] == 0x5C) {
            slashes++;
            i++;
        }
        if (i == a.Len) {
            for (usize k = 0; k < slashes * 2; k++) cmd.AppendByte(0x5C);
            break;
        }
        if (a[i] == 0x22) {
            for (usize k = 0; k < slashes * 2 + 1; k++) cmd.AppendByte(0x5C);
        } else {
            for (usize k = 0; k < slashes; k++) cmd.AppendByte(0x5C);
        }
        cmd.AppendByte(a[i]);
        i++;
    }
    cmd.AppendByte(0x22);
    return true;
}

// A handle the child inherits, for writing the file at path (replaced).
Result<i64, IoError> OpenForChild(str path) {
    *u8 w = Wide(path);
    unsafe {
        if (w as usize == 0) return Err(IoError.Invalid);
        *u8 sa = alloc(24);             // SECURITY_ATTRIBUTES, bInheritHandle set
        for (usize i = 0; i < 24; i++) sa[i] = 0;
        sa[0] = 24;
        sa[16] = 1;
        // GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, CREATE_ALWAYS, NORMAL
        i64 h = __wincall(W_CREATEFILEW, Ptr(w), 0x40000000, 3, Ptr(sa), 2, 0x80, 0, 0, 0, 0);
        if (h == -1) return Err(ErrorOf(LastError()));
        return Ok(h);
    }
}

// Lets a child inherit h, one of this process's standard handles (0 if there is none).
void Inheritable(i64 h) {
    if (h != 0 && h != -1) Call(W_SETHANDLEINFORMATION, h, 1, 1, 0, 0, 0);
}

impl IProcess for Process {
    Result<i32, IoError> Run(ref this, str program, str[] args, str workDir, str outPath, str errPath) {
        *u8 wdir = Wide(".");
        unsafe { wdir = 0 as usize as *u8; }
        if (workDir.Len > 0) {
            wdir = Wide(workDir);
            unsafe {
                if (wdir as usize == 0) return Err(IoError.Invalid);
            }
            u32 attrs = Attributes(workDir);
            if (attrs == 0xFFFFFFFF || attrs & ATTR_DIRECTORY == 0) return Err(IoError.NotFound);
        }
        // CreateProcessW takes only `\` as a separator when it looks for the program: with
        // `/`, a relative path is looked for next to this executable, not in the working
        // directory
        string exe = string.New();
        for (usize i = 0; i < program.Len; i++) {
            if (program[i] == '/') exe.AppendByte(0x5C);
            else exe.AppendByte(program[i]);
        }
        string cmd = string.New();
        if (!Quote(ref cmd, exe.AsStr())) return Err(IoError.Invalid);
        foreach (var a in args) {
            cmd.AppendByte(' ');
            if (!Quote(ref cmd, a)) return Err(IoError.Invalid);
        }
        *u8 wcmd = Wide(cmd.AsStr());
        unsafe {
            if (wcmd as usize == 0) return Err(IoError.Invalid);
        }
        i64 hin = Call(W_GETSTDHANDLE, -10, 0, 0, 0, 0, 0);
        i64 hout = Call(W_GETSTDHANDLE, -11, 0, 0, 0, 0, 0);
        i64 herr = Call(W_GETSTDHANDLE, -12, 0, 0, 0, 0, 0);
        i64 fout = 0;
        i64 ferr = 0;
        if (outPath.Len > 0) {
            fout = OpenForChild(outPath)?;
            hout = fout;
        }
        if (errPath.Len > 0) {
            if (outPath.Len > 0 && ct.Compare(outPath, errPath) == 0) {
                herr = fout;
            } else {
                Result<i64, IoError> r = OpenForChild(errPath);
                if (r.IsErr()) {
                    if (fout != 0) Call(W_CLOSEHANDLE, fout, 0, 0, 0, 0, 0);
                    return Err(r.UnwrapErr());
                }
                ferr = r.Unwrap();
                herr = ferr;
            }
        }
        Inheritable(hin);
        Inheritable(hout);
        Inheritable(herr);
        i64 ok = 0;
        u32 code = 0;
        unsafe {
            *u8 si = alloc(104);            // STARTUPINFOW
            for (usize i = 0; i < 104; i++) si[i] = 0;
            *u32 si32 = si as *u32;
            si32[0] = 104;                  // cb
            si32[15] = 0x100;               // dwFlags: STARTF_USESTDHANDLES
            *i64 si64 = si as *i64;
            si64[10] = hin;
            si64[11] = hout;
            si64[12] = herr;
            *u8 pi = alloc(24);             // PROCESS_INFORMATION
            for (usize i = 0; i < 24; i++) pi[i] = 0;
            ok = __wincall(W_CREATEPROCESSW, 0, Ptr(wcmd), 0, 0, 1, 0, 0, Ptr(wdir), Ptr(si), Ptr(pi));
            u32 e = LastError();
            if (fout != 0) Call(W_CLOSEHANDLE, fout, 0, 0, 0, 0, 0);
            if (ferr != 0) Call(W_CLOSEHANDLE, ferr, 0, 0, 0, 0, 0);
            if (ok as i32 == 0) return Err(ErrorOf(e));
            *i64 pi64 = pi as *i64;
            Call(W_WAITFORSINGLEOBJECT, pi64[0], 0xFFFFFFFF, 0, 0, 0, 0);
            Call(W_GETEXITCODEPROCESS, pi64[0], &code as isize as i64, 0, 0, 0, 0);
            Call(W_CLOSEHANDLE, pi64[0], 0, 0, 0, 0, 0);
            Call(W_CLOSEHANDLE, pi64[1], 0, 0, 0, 0, 0);
        }
        return Ok(code as i32);
    }
}

// ------------------------------------------------------------------ raw calls

// Calls import k of the executable's table with the arguments: what a program's own
// `__wincall(k, …)` does. The script runtime forwards its programs' calls here (PLAN
// D32); k must be one of the slots the table has, else the result is -1.
public i64 WinCall(i64 k, i64 a, i64 b, i64 c, i64 d, i64 e, i64 f, i64 g, i64 h, i64 i, i64 j) {
    match k {
        0 => { return __wincall(0, a, b, c, d, e, f, g, h, i, j); }
        1 => { return __wincall(1, a, b, c, d, e, f, g, h, i, j); }
        2 => { return __wincall(2, a, b, c, d, e, f, g, h, i, j); }
        3 => { return __wincall(3, a, b, c, d, e, f, g, h, i, j); }
        4 => { return __wincall(4, a, b, c, d, e, f, g, h, i, j); }
        5 => { return __wincall(5, a, b, c, d, e, f, g, h, i, j); }
        6 => { return __wincall(6, a, b, c, d, e, f, g, h, i, j); }
        7 => { return __wincall(7, a, b, c, d, e, f, g, h, i, j); }
        8 => { return __wincall(8, a, b, c, d, e, f, g, h, i, j); }
        9 => { return __wincall(9, a, b, c, d, e, f, g, h, i, j); }
        10 => { return __wincall(10, a, b, c, d, e, f, g, h, i, j); }
        11 => { return __wincall(11, a, b, c, d, e, f, g, h, i, j); }
        12 => { return __wincall(12, a, b, c, d, e, f, g, h, i, j); }
        13 => { return __wincall(13, a, b, c, d, e, f, g, h, i, j); }
        14 => { return __wincall(14, a, b, c, d, e, f, g, h, i, j); }
        15 => { return __wincall(15, a, b, c, d, e, f, g, h, i, j); }
        16 => { return __wincall(16, a, b, c, d, e, f, g, h, i, j); }
        17 => { return __wincall(17, a, b, c, d, e, f, g, h, i, j); }
        18 => { return __wincall(18, a, b, c, d, e, f, g, h, i, j); }
        19 => { return __wincall(19, a, b, c, d, e, f, g, h, i, j); }
        20 => { return __wincall(20, a, b, c, d, e, f, g, h, i, j); }
        21 => { return __wincall(21, a, b, c, d, e, f, g, h, i, j); }
        22 => { return __wincall(22, a, b, c, d, e, f, g, h, i, j); }
        23 => { return __wincall(23, a, b, c, d, e, f, g, h, i, j); }
        24 => { return __wincall(24, a, b, c, d, e, f, g, h, i, j); }
        25 => { return __wincall(25, a, b, c, d, e, f, g, h, i, j); }
        26 => { return __wincall(26, a, b, c, d, e, f, g, h, i, j); }
        27 => { return __wincall(27, a, b, c, d, e, f, g, h, i, j); }
        29 => { return __wincall(29, a, b, c, d, e, f, g, h, i, j); }
        31 => { return __wincall(31, a, b, c, d, e, f, g, h, i, j); }
        32 => { return __wincall(32, a, b, c, d, e, f, g, h, i, j); }
        33 => { return __wincall(33, a, b, c, d, e, f, g, h, i, j); }
        34 => { return __wincall(34, a, b, c, d, e, f, g, h, i, j); }
        35 => { return __wincall(35, a, b, c, d, e, f, g, h, i, j); }
        36 => { return __wincall(36, a, b, c, d, e, f, g, h, i, j); }
        37 => { return __wincall(37, a, b, c, d, e, f, g, h, i, j); }
        38 => { return __wincall(38, a, b, c, d, e, f, g, h, i, j); }
        39 => { return __wincall(39, a, b, c, d, e, f, g, h, i, j); }
        40 => { return __wincall(40, a, b, c, d, e, f, g, h, i, j); }
        41 => { return __wincall(41, a, b, c, d, e, f, g, h, i, j); }
        42 => { return __wincall(42, a, b, c, d, e, f, g, h, i, j); }
        43 => { return __wincall(43, a, b, c, d, e, f, g, h, i, j); }
        44 => { return __wincall(44, a, b, c, d, e, f, g, h, i, j); }
        45 => { return __wincall(45, a, b, c, d, e, f, g, h, i, j); }
        _ => { return -1; }
    }
}

// ------------------------------------------------------------------ network

const i64 W_WSASTARTUP = 31;
const i64 W_SOCKET = 32;
const i64 W_CONNECT = 33;
const i64 W_BIND = 34;
const i64 W_LISTEN = 35;
const i64 W_ACCEPT = 36;
const i64 W_SEND = 37;
const i64 W_RECV = 38;
const i64 W_CLOSESOCKET = 39;
const i64 W_GETADDRINFO = 40;
const i64 W_FREEADDRINFO = 41;
const i64 W_WSAGETLASTERROR = 42;
const i64 W_GETSOCKNAME = 45;

// The IoError for a Winsock error code.
IoError NetErrorOf(u32 code) {
    if (code == 10061) return IoError.Refused;              // WSAECONNREFUSED
    if (code == 10013) return IoError.Denied;               // WSAEACCES
    if (code == 10048) return IoError.Exists;               // WSAEADDRINUSE
    if (code == 10049 || code == 10022) return IoError.Invalid;    // WSAEADDRNOTAVAIL, WSAEINVAL
    if (code == 11001 || code == 11004) return IoError.NotFound;   // WSAHOST_NOT_FOUND, WSANO_DATA
    return IoError.Other;
}

u32 WsaError() => Call(W_WSAGETLASTERROR, 0, 0, 0, 0, 0, 0) as u32;

// "a.b.c.d" as its four bytes; false if s is not one.
bool ParseIpv4(str s, mut u8[] addr4) {
    usize part = 0;
    u32 value = 0;
    usize digits = 0;
    for (usize i = 0; i <= s.Len; i++) {
        if (i == s.Len || s[i] == '.') {
            if (digits == 0 || value > 255 || part > 3) return false;
            addr4[part] = value as u8;
            part++;
            value = 0;
            digits = 0;
        } else if (s[i] >= '0' && s[i] <= '9') {
            value = value * 10 + (s[i] - '0') as u32;
            digits++;
            if (digits > 3) return false;
        } else {
            return false;
        }
    }
    return part == 4;
}

string Ipv4Text(u8[] a) {
    string s = string.New();
    for (usize i = 0; i < 4; i++) {
        if (i > 0) s.AppendByte('.');
        s.Append(text.Uint(a[i] as u64).AsStr());
    }
    return s;
}

// A sockaddr_in for addr4 and port, in 16 bytes.
*u8 SockAddr(u8[] addr4, u16 port) {
    unsafe {
        *u8 sa = alloc(16);
        for (usize i = 0; i < 16; i++) sa[i] = 0;
        sa[0] = 2;                      // AF_INET
        sa[2] = (port >> 8) as u8;      // the port, big-endian
        sa[3] = port as u8;
        for (usize i = 0; i < 4; i++) sa[4 + i] = addr4[i];
        return sa;
    }
}

// TCP and name lookup through Winsock (WS2_32.dll).
public struct Net {
    u8 Unused;

    public static Net New() {
        unsafe {
            *u8 data = alloc(512);      // WSADATA
            Call(W_WSASTARTUP, 0x202, Ptr(data), 0, 0, 0, 0);
        }
        return new Net { Unused = 0 };
    }
}

impl INet for Net {
    Result<List<string>, IoError> Resolve(ref this, str host) {
        List<string> all = List<string>.New();
        u8[4] a;
        if (ParseIpv4(host, a[0..4])) {
            all.Push(string.From(host));
            return Ok(all);
        }
        if (host.Len == 9 && text.Lower(host).Equals("localhost")) {
            all.Push(string.From("127.0.0.1"));
            return Ok(all);
        }
        unsafe {
            *u8 node = alloc(host.Len + 1);
            for (usize i = 0; i < host.Len; i++) {
                if (host[i] == 0) return Err(IoError.Invalid);
                node[i] = host[i];
            }
            node[host.Len] = 0;
            *u8 hints = alloc(48);      // ADDRINFOA: family at 4, socktype at 8
            for (usize i = 0; i < 48; i++) hints[i] = 0;
            hints[4] = 2;
            hints[8] = 1;
            u64 res = 0;
            i64 r = Call(W_GETADDRINFO, Ptr(node), 0, Ptr(hints), &res as isize as i64, 0, 0) as i32 as i64;
            if (r != 0) return Err(NetErrorOf(r as u32));
            // the list: ai_addr at 32, ai_next at 40; the address at sin_addr (4)
            u64 at = res;
            while (at != 0) {
                *u8 ai = at as usize as *u8;
                *u64 fields = ai as *u64;
                *u8 sa = fields[4] as usize as *u8;
                if (sa as usize != 0 && sa[0] == 2) {
                    string t = Ipv4Text(slice_from(&sa[4], 4));
                    bool seen = false;
                    foreach (var x in all.AsSlice()) {
                        if (x.Equals(t.AsStr())) seen = true;
                    }
                    if (!seen) all.Push(t);
                }
                at = fields[5];
            }
            Call(W_FREEADDRINFO, res as i64, 0, 0, 0, 0, 0);
        }
        if (all.Len() == 0) return Err(IoError.NotFound);
        return Ok(all);
    }

    Result<i64, IoError> Connect(ref this, str host, u16 port) {
        List<string> addrs = this.Resolve(host)?;
        IoError last = IoError.NotFound;
        foreach (var t in addrs.AsSlice()) {
            u8[4] a;
            if (!ParseIpv4(t.AsStr(), a[0..4])) continue;
            i64 s = Call(W_SOCKET, 2, 1, 6, 0, 0, 0);       // AF_INET, SOCK_STREAM, TCP
            if (s == -1) return Err(NetErrorOf(WsaError()));
            *u8 sa = SockAddr(a[0..4], port);
            if (Call(W_CONNECT, s, Ptr(sa), 16, 0, 0, 0) as i32 == 0) return Ok(s);
            last = NetErrorOf(WsaError());
            Call(W_CLOSESOCKET, s, 0, 0, 0, 0, 0);
        }
        return Err(last);
    }

    Result<i64, IoError> Listen(ref this, str host, u16 port) {
        List<string> addrs = this.Resolve(host)?;
        u8[4] a;
        if (!ParseIpv4(addrs.AsSlice()[0].AsStr(), a[0..4])) return Err(IoError.Invalid);
        i64 s = Call(W_SOCKET, 2, 1, 6, 0, 0, 0);
        if (s == -1) return Err(NetErrorOf(WsaError()));
        *u8 sa = SockAddr(a[0..4], port);
        if (Call(W_BIND, s, Ptr(sa), 16, 0, 0, 0) as i32 != 0 || Call(W_LISTEN, s, 128, 0, 0, 0, 0) as i32 != 0) {
            IoError e = NetErrorOf(WsaError());
            Call(W_CLOSESOCKET, s, 0, 0, 0, 0, 0);
            return Err(e);
        }
        return Ok(s);
    }

    u16 LocalPort(ref this, i64 listener) {
        unsafe {
            *u8 sa = alloc(16);
            i32 len = 16;
            if (Call(W_GETSOCKNAME, listener, Ptr(sa), &len as isize as i64, 0, 0, 0) as i32 != 0) return 0;
            return ((sa[2] as u16) << 8) | sa[3] as u16;
        }
    }

    Result<i64, IoError> Accept(ref this, i64 listener) {
        i64 s = Call(W_ACCEPT, listener, 0, 0, 0, 0, 0);
        if (s == -1) return Err(NetErrorOf(WsaError()));
        return Ok(s);
    }

    Result<usize, IoError> Send(ref this, i64 conn, u8[] data) {
        usize at = 0;
        while (at < data.Len) {
            usize n = data.Len - at;
            if (n > 0x40000000) n = 0x40000000;
            i64 r = 0;
            unsafe { r = Call(W_SEND, conn, &data[at] as isize as i64, n as i64, 0, 0, 0) as i32 as i64; }
            if (r < 0) return Err(NetErrorOf(WsaError()));
            at += r as usize;
        }
        return Ok(data.Len);
    }

    Result<usize, IoError> Recv(ref this, i64 conn, mut u8[] into) {
        if (into.Len == 0) return Ok(0);
        usize n = into.Len;
        if (n > 0x40000000) n = 0x40000000;
        i64 r = 0;
        unsafe { r = Call(W_RECV, conn, &into[0] as isize as i64, n as i64, 0, 0, 0) as i32 as i64; }
        if (r < 0) return Err(NetErrorOf(WsaError()));
        return Ok(r as usize);
    }

    void Close(ref this, i64 handle) {
        Call(W_CLOSESOCKET, handle, 0, 0, 0, 0, 0);
    }
}
