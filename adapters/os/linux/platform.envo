// The platform binding for Linux (PLAN D23): the native adapters.
namespace platform;

use os.linux;

public linux.Console Console() => linux.Console.New();
public linux.FileSystem FileSystem() => linux.FileSystem.New();
public linux.Clock Clock() => linux.Clock.New();
public linux.Entropy Entropy() => linux.Entropy.New();
public linux.Environment Environment() => linux.Environment.New();
public linux.Process Process() => linux.Process.New();

// The host's raw call gate for the script runtime: `syscall` (kind 1) on Linux.
public i64 RawCall(u32 kind, i64 k, i64 a, i64 b, i64 c, i64 d, i64 e, i64 f, i64 g, i64 h, i64 i, i64 j) {
    if (kind != 1) return -1;
    return linux.SysCall(k, a, b, c, d, e, f);
}
