// os.linux: the native adapters for Linux on x86-64 (PLAN D25). They make system calls
// through the `__syscall` intrinsic. Paths are passed as NUL-terminated copies; a path
// holding a NUL byte is refused.
namespace os.linux;

use ports.{IConsole, IFileSystem, IClock, IEntropy, IEnvironment, IProcess, IoError};
use core.text as ct;
use alloc.text;

const i64 SYS_OPEN = 2;
const i64 SYS_CLOSE = 3;
const i64 SYS_DUP2 = 33;
const i64 SYS_FORK = 57;
const i64 SYS_EXECVE = 59;
const i64 SYS_WAIT4 = 61;
const i64 SYS_GETCWD = 79;
const i64 SYS_CHDIR = 80;
const i64 SYS_MKDIR = 83;
const i64 SYS_RMDIR = 84;
const i64 SYS_UNLINK = 87;
const i64 SYS_CLOCK_GETTIME = 228;
const i64 SYS_NEWFSTATAT = 262;
const i64 SYS_GETDENTS64 = 217;
const i64 SYS_EXIT_GROUP = 231;
const i64 SYS_GETRANDOM = 318;

const i64 O_WRONLY = 1;
const i64 O_CREAT = 0x40;
const i64 O_TRUNC = 0x200;
const i64 O_DIRECTORY = 0x10000;
const i64 O_CLOEXEC = 0x80000;

const i64 AT_FDCWD = -100;
const u32 S_IFMT = 0xF000;
const u32 S_IFDIR = 0x4000;
const u32 S_IFREG = 0x8000;

i64 Ptr(*u8 p) {
    unsafe { return p as isize as i64; }
}

i64 Sys(i64 n, i64 a, i64 b, i64 c, i64 d) => __syscall(n, a, b, c, d, 0, 0);

// path as a NUL-terminated copy, or null if it holds a NUL byte.
*u8 CPath(str path) {
    unsafe {
        *u8 z = alloc(path.Len + 1);
        for (usize i = 0; i < path.Len; i++) {
            if (path[i] == 0) return 0 as usize as *u8;
            z[i] = path[i];
        }
        z[path.Len] = 0;
        return z;
    }
}

// The IoError for a negative errno result.
IoError ErrorOf(i64 r) {
    if (r == -2 || r == -20) return IoError.NotFound;       // ENOENT, ENOTDIR
    if (r == -13 || r == -1) return IoError.Denied;         // EACCES, EPERM
    if (r == -17) return IoError.Exists;                    // EEXIST
    if (r == -39) return IoError.NotEmpty;                  // ENOTEMPTY
    if (r == -21 || r == -22 || r == -36) return IoError.Invalid;   // EISDIR, EINVAL, ENAMETOOLONG
    return IoError.Other;
}

// The file type bits of path (S_IFDIR, S_IFREG, …), or 0 if there is nothing there.
u32 Kind(str path) {
    *u8 p = CPath(path);
    unsafe {
        if (p as usize == 0) return 0;
        *u8 st = alloc(144);        // struct stat on x86-64; st_mode is the u32 at 24
        i64 r = Sys(SYS_NEWFSTATAT, AT_FDCWD, Ptr(p), Ptr(st), 0);
        if (r != 0) return 0;
        u32 mode = st[24] as u32 | (st[25] as u32 << 8) | (st[26] as u32 << 16) | (st[27] as u32 << 24);
        return mode & S_IFMT;
    }
}

// ------------------------------------------------------------------ console

// Standard output, error and input.
public struct Console {
    u8 Unused;

    public static Console New() => new Console { Unused = 0 };
}

impl IConsole for Console {
    void Out(ref this, str text) => write(1, text);
    void Err(ref this, str text) => write(2, text);

    usize Read(ref this, mut u8[] into) {
        if (into.Len == 0) return 0;
        isize n = 0;
        unsafe { n = read(0, &into[0], into.Len); }
        if (n <= 0) return 0;
        return n as usize;
    }
}

// ------------------------------------------------------------------ file system

// The Linux file system.
public struct FileSystem {
    u8 Unused;

    public static FileSystem New() => new FileSystem { Unused = 0 };
}

impl IFileSystem for FileSystem {
    Result<string, IoError> Read(ref this, str path) {
        u32 kind = Kind(path);
        if (kind == S_IFDIR) return Err(IoError.Invalid);
        i32 fd = open(path, 0);
        if (fd < 0) {
            if (kind == 0) return Err(IoError.NotFound);
            return Err(IoError.Denied);
        }
        string s = string.New();
        u8[4096] buf;
        while (true) {
            isize n = 0;
            unsafe { n = read(fd, &buf[0], 4096); }
            if (n < 0) {
                close(fd);
                return Err(IoError.Other);
            }
            if (n == 0) break;
            for (usize i = 0; i < n as usize; i++) s.AppendByte(buf[i]);
        }
        close(fd);
        return Ok(s);
    }

    Result<usize, IoError> Write(ref this, str path, str data) {
        if (Kind(path) == S_IFDIR) return Err(IoError.Invalid);
        i32 fd = open(path, 1);
        if (fd < 0) {
            unsafe {
                if (CPath(path) as usize == 0) return Err(IoError.Invalid);
            }
            return Err(ErrorOf(fd as i64));
        }
        write(fd, data);
        close(fd);
        return Ok(data.Len);
    }

    bool IsFile(ref this, str path) => Kind(path) == S_IFREG;

    bool IsDir(ref this, str path) {
        if (path.Len == 0) return true;
        return Kind(path) == S_IFDIR;
    }

    Result<bool, IoError> Delete(ref this, str path) {
        *u8 p = CPath(path);
        unsafe {
            if (p as usize == 0) return Err(IoError.Invalid);
        }
        if (Kind(path) == S_IFDIR) return Err(IoError.Invalid);
        i64 r = Sys(SYS_UNLINK, Ptr(p), 0, 0, 0);
        if (r < 0) return Err(ErrorOf(r));
        return Ok(true);
    }

    Result<bool, IoError> CreateDir(ref this, str path) {
        *u8 p = CPath(path);
        unsafe {
            if (p as usize == 0) return Err(IoError.Invalid);
        }
        i64 r = Sys(SYS_MKDIR, Ptr(p), 0x1ED, 0, 0);       // 0755
        if (r < 0) return Err(ErrorOf(r));
        return Ok(true);
    }

    Result<bool, IoError> RemoveDir(ref this, str path) {
        *u8 p = CPath(path);
        unsafe {
            if (p as usize == 0) return Err(IoError.Invalid);
        }
        i64 r = Sys(SYS_RMDIR, Ptr(p), 0, 0, 0);
        if (r < 0) return Err(ErrorOf(r));
        return Ok(true);
    }

    Result<List<string>, IoError> List(ref this, str path) {
        str dir = path;
        if (dir.Len == 0) dir = ".";
        *u8 p = CPath(dir);
        List<string> names = List<string>.New();
        unsafe {
            if (p as usize == 0) return Err(IoError.Invalid);
            if (Kind(dir) == S_IFREG) return Err(IoError.Invalid);
            i64 fd = Sys(SYS_OPEN, Ptr(p), O_DIRECTORY | O_CLOEXEC, 0, 0);
            if (fd < 0) return Err(ErrorOf(fd));
            *u8 buf = alloc(8192);
            while (true) {
                i64 n = Sys(SYS_GETDENTS64, fd, Ptr(buf), 8192, 0);
                if (n == -4) continue;      // EINTR
                if (n < 0) {
                    Sys(SYS_CLOSE, fd, 0, 0, 0);
                    return Err(ErrorOf(n));
                }
                if (n == 0) break;
                // struct linux_dirent64: d_reclen is the u16 at 16, d_name starts at 19
                usize at = 0;
                while (at < n as usize) {
                    usize reclen = buf[at + 16] as usize | (buf[at + 17] as usize << 8);
                    usize end = at + 19;
                    while (end < at + reclen && buf[end] != 0) end++;
                    str name = str_from(&buf[at + 19], end - (at + 19));
                    if (ct.Compare(name, ".") != 0 && ct.Compare(name, "..") != 0) names.Push(string.From(name));
                    at += reclen;
                }
            }
            Sys(SYS_CLOSE, fd, 0, 0, 0);
        }
        text.Sort(ref names);
        return Ok(names);
    }
}

// ------------------------------------------------------------------ clock

// CLOCK_REALTIME and CLOCK_MONOTONIC.
public struct Clock {
    u8 Unused;

    public static Clock New() => new Clock { Unused = 0 };
}

// The time on clock id in nanoseconds.
i64 ClockNanos(i64 id) {
    i64[2] ts;      // tv_sec, tv_nsec
    unsafe { Sys(SYS_CLOCK_GETTIME, id, &ts[0] as isize as i64, 0, 0); }
    return ts[0] * 1000000000 + ts[1];
}

impl IClock for Clock {
    i64 NowNanos(ref this) => ClockNanos(0);
    u64 MonoNanos(ref this) => ClockNanos(1) as u64;
}

// ------------------------------------------------------------------ entropy

// The kernel's random generator (getrandom).
public struct Entropy {
    u8 Unused;

    public static Entropy New() => new Entropy { Unused = 0 };
}

impl IEntropy for Entropy {
    void Fill(ref this, mut u8[] into) {
        usize at = 0;
        while (at < into.Len) {
            i64 r = 0;
            unsafe { r = Sys(SYS_GETRANDOM, &into[at] as isize as i64, (into.Len - at) as i64, 0, 0); }
            if (r == -4) continue;      // EINTR
            if (r <= 0) panic("os.linux: getrandom failed");
            at += r as usize;
        }
    }
}

// ------------------------------------------------------------------ environment

// The arguments the program was started with.
public struct Environment {
    u8 Unused;

    public static Environment New() => new Environment { Unused = 0 };
}

impl IEnvironment for Environment {
    usize ArgCount(ref this) => argc();
    str Arg(ref this, usize i) => arg(i);

    string CurrentDir(ref this) => Absolute("");

    string? Var(ref this, str name) {
        if (name.Len == 0) return null;
        string all = Environ();
        str s = all.AsStr();
        usize at = 0;
        while (at < s.Len) {
            usize end = at;
            while (end < s.Len && s[end] != 0) end++;
            str entry = s[at..end];
            if (entry.Len > name.Len && entry[name.Len] == '=' && ct.StartsWith(entry, name)) {
                return Some(string.From(entry[name.Len + 1..entry.Len]));
            }
            at = end + 1;
        }
        return null;
    }
}

// The environment this process was started with: NAME=value entries, each ending in a
// NUL byte ("" if it cannot be read).
string Environ() {
    FileSystem fs = FileSystem.New();
    Result<string, IoError> r = fs.Read("/proc/self/environ");
    match r {
        Ok(s) => { return s; }
        Err(_) => { return string.New(); }
    }
}

// ------------------------------------------------------------------ process

// Programs started with fork and execve. A program without a `/` is looked up on PATH,
// as a shell does.
public struct Process {
    u8 Unused;

    public static Process New() => new Process { Unused = 0 };
}

// path made absolute, against the working directory.
string Absolute(str path) {
    if (path.Len > 0 && path[0] == '/') return string.From(path);
    string s = string.New();
    unsafe {
        *u8 buf = alloc(4096);
        i64 n = Sys(SYS_GETCWD, Ptr(buf), 4096, 0, 0);
        if (n <= 1) return string.From(path);
        for (usize i = 0; i + 1 < n as usize; i++) s.AppendByte(buf[i]);
    }
    if (path.Len == 0) return s;
    if (s.AsStr()[s.Len() - 1] != '/') s.AppendByte('/');
    s.Append(path);
    return s;
}

// The file to run for program, as an absolute path, or "" if there is none.
string Resolve(str program) {
    if (ct.IndexOfByte(program, '/').IsSome()) {
        if (Kind(program) == S_IFREG) return Absolute(program);
        return string.New();
    }
    Environment env = Environment.New();
    string? found = env.Var("PATH");
    string path = string.From("/usr/local/bin:/usr/bin:/bin");
    if (found.IsSome()) path = found.Unwrap();
    str ps = path.AsStr();
    usize at = 0;
    while (at <= ps.Len) {
        usize end = at;
        while (end < ps.Len && ps[end] != ':') end++;
        string candidate = string.New();
        if (end == at) candidate.Append(".");
        else candidate.Append(ps[at..end]);
        candidate.AppendByte('/');
        candidate.Append(program);
        if (Kind(candidate.AsStr()) == S_IFREG) return Absolute(candidate.AsStr());
        at = end + 1;
    }
    return string.New();
}

// The file at path opened for writing (replaced), closed on exec unless it is made a
// standard stream; a negative errno if it cannot be.
i64 OpenForChild(str path) {
    *u8 p = CPath(path);
    unsafe {
        if (p as usize == 0) return -22;
    }
    if (Kind(path) == S_IFDIR) return -21;
    return Sys(SYS_OPEN, Ptr(p), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0x1A4, 0);      // 0644
}

impl IProcess for Process {
    Result<i32, IoError> Run(ref this, str program, str[] args, str workDir, str outPath, str errPath) {
        *u8 wdir = CPath(workDir);
        unsafe {
            if (CPath(program) as usize == 0 || wdir as usize == 0) return Err(IoError.Invalid);
        }
        if (workDir.Len > 0 && Kind(workDir) != S_IFDIR) return Err(IoError.NotFound);
        foreach (var a in args) {
            unsafe {
                if (CPath(a) as usize == 0) return Err(IoError.Invalid);
            }
        }
        string exe = Resolve(program);
        if (exe.Len() == 0) return Err(IoError.NotFound);
        i64 fout = -1;
        i64 ferr = -1;
        if (outPath.Len > 0) {
            fout = OpenForChild(outPath);
            if (fout < 0) return Err(ErrorOf(fout));
        }
        if (errPath.Len > 0) {
            if (outPath.Len > 0 && ct.Compare(outPath, errPath) == 0) {
                ferr = fout;
            } else {
                ferr = OpenForChild(errPath);
                if (ferr < 0) {
                    if (fout >= 0) Sys(SYS_CLOSE, fout, 0, 0, 0);
                    return Err(ErrorOf(ferr));
                }
            }
        }
        string env = Environ();
        i64 status = 0;
        unsafe {
            // argv and envp: arrays of pointers to NUL-terminated text, ending in null
            *i64 argv = alloc((args.Len + 2) * 8) as *i64;
            argv[0] = Ptr(CPath(program));
            for (usize i = 0; i < args.Len; i++) argv[i + 1] = Ptr(CPath(args[i]));
            argv[args.Len + 1] = 0;
            str es = env.AsStr();
            usize count = 0;
            for (usize i = 0; i < es.Len; i++) {
                if (es[i] == 0) count++;
            }
            *u8 ebuf = alloc(es.Len + 1);
            for (usize i = 0; i < es.Len; i++) ebuf[i] = es[i];
            ebuf[es.Len] = 0;
            *i64 envp = alloc((count + 1) * 8) as *i64;
            usize at = 0;
            for (usize k = 0; k < count; k++) {
                envp[k] = Ptr(&ebuf[at]);
                while (ebuf[at] != 0) at++;
                at++;
            }
            envp[count] = 0;
            *u8 path = CPath(exe.AsStr());
            i64 pid = Sys(SYS_FORK, 0, 0, 0, 0);
            if (pid == 0) {
                // the child: its standard streams, then the program
                if (fout >= 0) Sys(SYS_DUP2, fout, 1, 0, 0);
                if (ferr >= 0) Sys(SYS_DUP2, ferr, 2, 0, 0);
                if (workDir.Len > 0 && Sys(SYS_CHDIR, Ptr(wdir), 0, 0, 0) < 0) Sys(SYS_EXIT_GROUP, 127, 0, 0, 0);
                Sys(SYS_EXECVE, Ptr(path), argv as isize as i64, envp as isize as i64, 0);
                Sys(SYS_EXIT_GROUP, 127, 0, 0, 0);
            }
            if (fout >= 0) Sys(SYS_CLOSE, fout, 0, 0, 0);
            if (ferr >= 0 && ferr != fout) Sys(SYS_CLOSE, ferr, 0, 0, 0);
            if (pid < 0) return Err(ErrorOf(pid));
            while (true) {
                i64 r = Sys(SYS_WAIT4, pid, &status as isize as i64, 0, 0);
                if (r == -4) continue;      // EINTR
                if (r < 0) return Err(ErrorOf(r));
                break;
            }
        }
        i64 sig = status & 0x7F;
        if (sig == 0) return Ok(((status >> 8) & 0xFF) as i32);
        return Ok((128 + sig) as i32);
    }
}
