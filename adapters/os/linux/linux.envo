// os.linux: the native adapters for Linux on x86-64 and AArch64 (PLAN D25, D69). They
// make system calls through the `__syscall` intrinsic; the numbers, and the calls whose
// form differs between architectures, are in os.linux.sys (one file per architecture).
// Paths are passed as NUL-terminated copies; a path holding a NUL byte is refused.
namespace os.linux;

use ports.{IConsole, IFileSystem, IClock, IEntropy, IEnvironment, IProcess, INet, ITrust, ITerminal, IWindow, Event, EventKind, IoError};
use core.text as ct;
use alloc.text;
use os.linux.sys;


const i64 O_WRONLY = 1;
const i64 O_CREAT = 0x40;
const i64 O_TRUNC = 0x200;
const i64 O_CLOEXEC = 0x80000;

const i64 AT_FDCWD = -100;
const u32 S_IFMT = 0xF000;
const u32 S_IFDIR = 0x4000;
const u32 S_IFREG = 0x8000;

i64 Ptr(*u8 p) {
    unsafe { return p as isize as i64; }
}

i64 Sys(i64 n, i64 a, i64 b, i64 c, i64 d) => __syscall(n, a, b, c, d, 0, 0);

// path as a NUL-terminated copy, or null if it holds a NUL byte.
*u8 CPath(str path) {
    unsafe {
        *u8 z = alloc(path.Len + 1);
        for (usize i = 0; i < path.Len; i++) {
            if (path[i] == 0) return 0 as usize as *u8;
            z[i] = path[i];
        }
        z[path.Len] = 0;
        return z;
    }
}

// The IoError for a negative errno result.
IoError ErrorOf(i64 r) {
    if (r == -2 || r == -20) return IoError.NotFound;       // ENOENT, ENOTDIR
    if (r == -13 || r == -1) return IoError.Denied;         // EACCES, EPERM
    if (r == -17) return IoError.Exists;                    // EEXIST
    if (r == -39) return IoError.NotEmpty;                  // ENOTEMPTY
    if (r == -21 || r == -22 || r == -36) return IoError.Invalid;   // EISDIR, EINVAL, ENAMETOOLONG
    return IoError.Other;
}

// The file type bits of path (S_IFDIR, S_IFREG, …), or 0 if there is nothing there.
u32 Kind(str path) {
    *u8 p = CPath(path);
    unsafe {
        if (p as usize == 0) return 0;
        *u8 st = alloc(sys.STAT_SIZE);      // struct stat; st_mode is the u32 at STAT_MODE
        i64 r = Sys(sys.NEWFSTATAT, AT_FDCWD, Ptr(p), Ptr(st), 0);
        if (r != 0) return 0;
        usize m = sys.STAT_MODE;
        u32 mode = st[m] as u32 | (st[m + 1] as u32 << 8) | (st[m + 2] as u32 << 16) | (st[m + 3] as u32 << 24);
        return mode & S_IFMT;
    }
}

// ------------------------------------------------------------------ console

// Standard output, error and input.
public struct Console {
    u8 Unused;

    public static Console New() => new Console { Unused = 0 };
}

impl IConsole for Console {
    void Out(ref this, str text) => write(1, text);
    void Err(ref this, str text) => write(2, text);

    usize Read(ref this, mut u8[] into) {
        if (into.Len == 0) return 0;
        isize n = 0;
        unsafe { n = read(0, &into[0], into.Len); }
        if (n <= 0) return 0;
        return n as usize;
    }
}

// ------------------------------------------------------------------ file system

// The Linux file system.
public struct FileSystem {
    u8 Unused;

    public static FileSystem New() => new FileSystem { Unused = 0 };
}

impl IFileSystem for FileSystem {
    Result<string, IoError> Read(ref this, str path) {
        u32 kind = Kind(path);
        if (kind == S_IFDIR) return Err(IoError.Invalid);
        i32 fd = open(path, 0);
        if (fd < 0) {
            if (fd == -13) return Err(IoError.Denied);
            if (kind == 0) return Err(IoError.NotFound);
            return Err(IoError.Denied);
        }
        string s = string.New();
        u8[4096] buf;
        while (true) {
            isize n = 0;
            unsafe { n = read(fd, &buf[0], 4096); }
            if (n < 0) {
                close(fd);
                return Err(IoError.Other);
            }
            if (n == 0) break;
            for (usize i = 0; i < n as usize; i++) s.AppendByte(buf[i]);
        }
        close(fd);
        return Ok(s);
    }

    Result<usize, IoError> Write(ref this, str path, str data) {
        if (Kind(path) == S_IFDIR) return Err(IoError.Invalid);
        i32 fd = open(path, 1);
        if (fd < 0) {
            unsafe {
                if (CPath(path) as usize == 0) return Err(IoError.Invalid);
            }
            return Err(ErrorOf(fd as i64));
        }
        write(fd, data);
        close(fd);
        return Ok(data.Len);
    }

    bool IsFile(ref this, str path) => Kind(path) == S_IFREG;

    bool IsDir(ref this, str path) {
        if (path.Len == 0) return true;
        return Kind(path) == S_IFDIR;
    }

    Result<bool, IoError> Delete(ref this, str path) {
        *u8 p = CPath(path);
        unsafe {
            if (p as usize == 0) return Err(IoError.Invalid);
        }
        if (Kind(path) == S_IFDIR) return Err(IoError.Invalid);
        i64 r = sys.Unlink(Ptr(p));
        if (r < 0) return Err(ErrorOf(r));
        return Ok(true);
    }

    Result<bool, IoError> CreateDir(ref this, str path) {
        *u8 p = CPath(path);
        unsafe {
            if (p as usize == 0) return Err(IoError.Invalid);
        }
        i64 r = sys.Mkdir(Ptr(p), 0x1ED);       // 0755
        if (r < 0) return Err(ErrorOf(r));
        return Ok(true);
    }

    Result<bool, IoError> RemoveDir(ref this, str path) {
        *u8 p = CPath(path);
        unsafe {
            if (p as usize == 0) return Err(IoError.Invalid);
        }
        i64 r = sys.Rmdir(Ptr(p));
        if (r < 0) return Err(ErrorOf(r));
        return Ok(true);
    }

    Result<List<string>, IoError> List(ref this, str path) {
        str dir = path;
        if (dir.Len == 0) dir = ".";
        *u8 p = CPath(dir);
        List<string> names = List<string>.New();
        unsafe {
            if (p as usize == 0) return Err(IoError.Invalid);
            if (Kind(dir) == S_IFREG) return Err(IoError.Invalid);
            i64 fd = sys.Open(Ptr(p), sys.O_DIRECTORY | O_CLOEXEC, 0);
            if (fd < 0) return Err(ErrorOf(fd));
            *u8 buf = alloc(8192);
            while (true) {
                i64 n = Sys(sys.GETDENTS64, fd, Ptr(buf), 8192, 0);
                if (n == -4) continue;      // EINTR
                if (n < 0) {
                    Sys(sys.CLOSE, fd, 0, 0, 0);
                    return Err(ErrorOf(n));
                }
                if (n == 0) break;
                // struct linux_dirent64: d_reclen is the u16 at 16, d_name starts at 19
                usize at = 0;
                while (at < n as usize) {
                    usize reclen = buf[at + 16] as usize | (buf[at + 17] as usize << 8);
                    usize end = at + 19;
                    while (end < at + reclen && buf[end] != 0) end++;
                    str name = str_from(&buf[at + 19], end - (at + 19));
                    if (ct.Compare(name, ".") != 0 && ct.Compare(name, "..") != 0) names.Push(string.From(name));
                    at += reclen;
                }
            }
            Sys(sys.CLOSE, fd, 0, 0, 0);
        }
        text.Sort(ref names);
        return Ok(names);
    }
}

// ------------------------------------------------------------------ clock

// CLOCK_REALTIME and CLOCK_MONOTONIC.
public struct Clock {
    u8 Unused;

    public static Clock New() => new Clock { Unused = 0 };
}

// The time on clock id in nanoseconds.
i64 ClockNanos(i64 id) {
    i64[2] ts;      // tv_sec, tv_nsec
    unsafe { Sys(sys.CLOCK_GETTIME, id, &ts[0] as isize as i64, 0, 0); }
    return ts[0] * 1000000000 + ts[1];
}

impl IClock for Clock {
    i64 NowNanos(ref this) => ClockNanos(0);
    u64 MonoNanos(ref this) => ClockNanos(1) as u64;
}

// ------------------------------------------------------------------ entropy

// The kernel's random generator (getrandom).
public struct Entropy {
    u8 Unused;

    public static Entropy New() => new Entropy { Unused = 0 };
}

impl IEntropy for Entropy {
    void Fill(ref this, mut u8[] into) {
        usize at = 0;
        while (at < into.Len) {
            i64 r = 0;
            unsafe { r = Sys(sys.GETRANDOM, &into[at] as isize as i64, (into.Len - at) as i64, 0, 0); }
            if (r == -4) continue;      // EINTR
            if (r <= 0) panic("os.linux: getrandom failed");
            at += r as usize;
        }
    }
}

// ------------------------------------------------------------------ environment

// The arguments the program was started with.
public struct Environment {
    u8 Unused;

    public static Environment New() => new Environment { Unused = 0 };
}

impl IEnvironment for Environment {
    usize ArgCount(ref this) => argc();
    str Arg(ref this, usize i) => arg(i);

    string CurrentDir(ref this) => Absolute("");

    string? Var(ref this, str name) {
        if (name.Len == 0) return null;
        string all = Environ();
        str s = all.AsStr();
        usize at = 0;
        while (at < s.Len) {
            usize end = at;
            while (end < s.Len && s[end] != 0) end++;
            str entry = s[at..end];
            if (entry.Len > name.Len && entry[name.Len] == '=' && ct.StartsWith(entry, name)) {
                return Some(string.From(entry[name.Len + 1..entry.Len]));
            }
            at = end + 1;
        }
        return null;
    }
}

// The environment this process was started with: NAME=value entries, each ending in a
// NUL byte ("" if it cannot be read).
string Environ() {
    FileSystem fs = FileSystem.New();
    Result<string, IoError> r = fs.Read("/proc/self/environ");
    match r {
        Ok(s) => { return s; }
        Err(_) => { return string.New(); }
    }
}

// ------------------------------------------------------------------ process

// Programs started with fork and execve. A program without a `/` is looked up on PATH,
// as a shell does.
public struct Process {
    u8 Unused;

    public static Process New() => new Process { Unused = 0 };
}

// path made absolute, against the working directory.
string Absolute(str path) {
    if (path.Len > 0 && path[0] == '/') return string.From(path);
    string s = string.New();
    unsafe {
        *u8 buf = alloc(4096);
        i64 n = Sys(sys.GETCWD, Ptr(buf), 4096, 0, 0);
        if (n <= 1) return string.From(path);
        for (usize i = 0; i + 1 < n as usize; i++) s.AppendByte(buf[i]);
    }
    if (path.Len == 0) return s;
    if (s.AsStr()[s.Len() - 1] != '/') s.AppendByte('/');
    s.Append(path);
    return s;
}

// The file to run for program, as an absolute path, or "" if there is none.
string Resolve(str program) {
    if (ct.IndexOfByte(program, '/').IsSome()) {
        if (Kind(program) == S_IFREG) return Absolute(program);
        return string.New();
    }
    Environment env = Environment.New();
    string? found = env.Var("PATH");
    string path = string.From("/usr/local/bin:/usr/bin:/bin");
    if (found.IsSome()) path = found.Unwrap();
    str ps = path.AsStr();
    usize at = 0;
    while (at <= ps.Len) {
        usize end = at;
        while (end < ps.Len && ps[end] != ':') end++;
        string candidate = string.New();
        if (end == at) candidate.Append(".");
        else candidate.Append(ps[at..end]);
        candidate.AppendByte('/');
        candidate.Append(program);
        if (Kind(candidate.AsStr()) == S_IFREG) return Absolute(candidate.AsStr());
        at = end + 1;
    }
    return string.New();
}

// The file at path opened for writing (replaced), closed on exec unless it is made a
// standard stream; a negative errno if it cannot be.
i64 OpenForChild(str path) {
    *u8 p = CPath(path);
    unsafe {
        if (p as usize == 0) return -22;
    }
    if (Kind(path) == S_IFDIR) return -21;
    return sys.Open(Ptr(p), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0x1A4);      // 0644
}

impl IProcess for Process {
    Result<i32, IoError> Run(ref this, str program, str[] args, str workDir, str outPath, str errPath) {
        *u8 wdir = CPath(workDir);
        unsafe {
            if (CPath(program) as usize == 0 || wdir as usize == 0) return Err(IoError.Invalid);
        }
        if (workDir.Len > 0 && Kind(workDir) != S_IFDIR) return Err(IoError.NotFound);
        foreach (var a in args) {
            unsafe {
                if (CPath(a) as usize == 0) return Err(IoError.Invalid);
            }
        }
        string exe = Resolve(program);
        if (exe.Len() == 0) return Err(IoError.NotFound);
        i64 fout = -1;
        i64 ferr = -1;
        if (outPath.Len > 0) {
            fout = OpenForChild(outPath);
            if (fout < 0) return Err(ErrorOf(fout));
        }
        if (errPath.Len > 0) {
            if (outPath.Len > 0 && ct.Compare(outPath, errPath) == 0) {
                ferr = fout;
            } else {
                ferr = OpenForChild(errPath);
                if (ferr < 0) {
                    if (fout >= 0) Sys(sys.CLOSE, fout, 0, 0, 0);
                    return Err(ErrorOf(ferr));
                }
            }
        }
        string env = Environ();
        i64 status = 0;
        unsafe {
            // argv and envp: arrays of pointers to NUL-terminated text, ending in null
            *i64 argv = alloc((args.Len + 2) * 8) as *i64;
            argv[0] = Ptr(CPath(program));
            for (usize i = 0; i < args.Len; i++) argv[i + 1] = Ptr(CPath(args[i]));
            argv[args.Len + 1] = 0;
            str es = env.AsStr();
            usize count = 0;
            for (usize i = 0; i < es.Len; i++) {
                if (es[i] == 0) count++;
            }
            *u8 ebuf = alloc(es.Len + 1);
            for (usize i = 0; i < es.Len; i++) ebuf[i] = es[i];
            ebuf[es.Len] = 0;
            *i64 envp = alloc((count + 1) * 8) as *i64;
            usize at = 0;
            for (usize k = 0; k < count; k++) {
                envp[k] = Ptr(&ebuf[at]);
                while (ebuf[at] != 0) at++;
                at++;
            }
            envp[count] = 0;
            *u8 path = CPath(exe.AsStr());
            i64 pid = sys.Fork();
            if (pid == 0) {
                // the child: its standard streams, then the program
                if (fout >= 0) sys.Dup2(fout, 1);
                if (ferr >= 0) sys.Dup2(ferr, 2);
                if (workDir.Len > 0 && Sys(sys.CHDIR, Ptr(wdir), 0, 0, 0) < 0) Sys(sys.EXIT_GROUP, 127, 0, 0, 0);
                Sys(sys.EXECVE, Ptr(path), argv as isize as i64, envp as isize as i64, 0);
                Sys(sys.EXIT_GROUP, 127, 0, 0, 0);
            }
            if (fout >= 0) Sys(sys.CLOSE, fout, 0, 0, 0);
            if (ferr >= 0 && ferr != fout) Sys(sys.CLOSE, ferr, 0, 0, 0);
            if (pid < 0) return Err(ErrorOf(pid));
            while (true) {
                i64 r = Sys(sys.WAIT4, pid, &status as isize as i64, 0, 0);
                if (r == -4) continue;      // EINTR
                if (r < 0) return Err(ErrorOf(r));
                break;
            }
        }
        i64 sig = status & 0x7F;
        if (sig == 0) return Ok(((status >> 8) & 0xFF) as i32);
        return Ok((128 + sig) as i32);
    }
}

// ------------------------------------------------------------------ raw calls

// Makes system call n with the arguments: what a program's own `__syscall(n, …)` does.
// The script runtime forwards its programs' calls here (PLAN D32).
public i64 SysCall(i64 n, i64 a, i64 b, i64 c, i64 d, i64 e, i64 f) => __syscall(n, a, b, c, d, e, f);

// ------------------------------------------------------------------ network


// The IoError for a negative errno from a socket call.
IoError NetErrorOf(i64 r) {
    if (r == -111) return IoError.Refused;                  // ECONNREFUSED
    if (r == -13 || r == -1) return IoError.Denied;         // EACCES, EPERM
    if (r == -98) return IoError.Exists;                    // EADDRINUSE
    if (r == -99 || r == -22) return IoError.Invalid;       // EADDRNOTAVAIL, EINVAL
    if (r == -101 || r == -113) return IoError.NotFound;    // ENETUNREACH, EHOSTUNREACH
    return IoError.Other;
}

// "a.b.c.d" as its four bytes; false if s is not one.
bool ParseIpv4(str s, mut u8[] addr4) {
    usize part = 0;
    u32 value = 0;
    usize digits = 0;
    for (usize i = 0; i <= s.Len; i++) {
        if (i == s.Len || s[i] == '.') {
            if (digits == 0 || value > 255 || part > 3) return false;
            addr4[part] = value as u8;
            part++;
            value = 0;
            digits = 0;
        } else if (s[i] >= '0' && s[i] <= '9') {
            value = value * 10 + (s[i] - '0') as u32;
            digits++;
            if (digits > 3) return false;
        } else {
            return false;
        }
    }
    return part == 4;
}

string Ipv4Text(u8[] a) {
    string s = string.New();
    for (usize i = 0; i < 4; i++) {
        if (i > 0) s.AppendByte('.');
        s.Append(text.Uint(a[i] as u64).AsStr());
    }
    return s;
}

// A sockaddr_in for addr4 and port, in 16 bytes.
*u8 SockAddr(u8[] addr4, u16 port) {
    unsafe {
        *u8 sa = alloc(16);
        for (usize i = 0; i < 16; i++) sa[i] = 0;
        sa[0] = 2;                      // AF_INET
        sa[2] = (port >> 8) as u8;      // the port, big-endian
        sa[3] = port as u8;
        for (usize i = 0; i < 4; i++) sa[4 + i] = addr4[i];
        return sa;
    }
}

i64 Sys6(i64 n, i64 a, i64 b, i64 c, i64 d, i64 e, i64 f) => __syscall(n, a, b, c, d, e, f);

// The addresses /etc/hosts gives host.
void FromHosts(str host, ref List<string> found) {
    FileSystem fs = FileSystem.New();
    Result<string, IoError> r = fs.Read("/etc/hosts");
    if (r.IsErr()) return;
    string all = r.Unwrap();
    List<str> lines = text.Lines(all.AsStr());
    foreach (var line in lines.AsSlice()) {
        str l = line;
        usize? hash = ct.IndexOfByte(l, '#');
        if (hash.IsSome()) l = l[0..hash.Unwrap()];
        List<str> words = text.Split(ct.Trim(l), " ");
        // fields may be separated by tabs or several spaces
        List<str> fields = List<str>.New();
        foreach (var w in words.AsSlice()) {
            List<str> parts = text.Split(w, "\t");
            foreach (var p in parts.AsSlice()) {
                if (p.Len > 0) fields.Push(p);
            }
        }
        if (fields.Len() < 2) continue;
        u8[4] a;
        if (!ParseIpv4(fields.AsSlice()[0], a[0..4])) continue;
        for (usize i = 1; i < fields.Len(); i++) {
            if (text.Lower(fields.AsSlice()[i]).Equals(text.Lower(host).AsStr())) found.Push(string.From(fields.AsSlice()[0]));
        }
    }
}

// The first nameserver in /etc/resolv.conf, or "".
string Nameserver() {
    FileSystem fs = FileSystem.New();
    Result<string, IoError> r = fs.Read("/etc/resolv.conf");
    if (r.IsErr()) return string.New();
    string all = r.Unwrap();
    List<str> lines = text.Lines(all.AsStr());
    foreach (var line in lines.AsSlice()) {
        str l = ct.Trim(line);
        if (!ct.StartsWith(l, "nameserver")) continue;
        str rest = ct.Trim(l[10..l.Len]);
        u8[4] a;
        if (ParseIpv4(rest, a[0..4])) return string.From(rest);
    }
    return string.New();
}

// Asks the nameserver for host's A records (RFC 1035), over UDP, waiting up to 5 seconds.
void FromDns(str host, ref List<string> found) {
    string server = Nameserver();
    u8[4] ns;
    if (server.Len() == 0 || !ParseIpv4(server.AsStr(), ns[0..4])) return;
    // the query: header (id, recursion desired, one question), the name, type A, class IN
    List<u8> q = List<u8>.New();
    q.Push(0x45);
    q.Push(0x6e);
    q.Push(1);
    q.Push(0);
    q.Push(0);
    q.Push(1);
    for (usize i = 0; i < 6; i++) q.Push(0);
    List<str> labels = text.Split(host, ".");
    foreach (var label in labels.AsSlice()) {
        if (label.Len == 0 || label.Len > 63) return;
        q.Push(label.Len as u8);
        for (usize i = 0; i < label.Len; i++) q.Push(label[i]);
    }
    q.Push(0);
    q.Push(0);
    q.Push(1);
    q.Push(0);
    q.Push(1);
    i64 fd = Sys(sys.SOCKET, 2, 2 | 0x80000, 0, 0);        // AF_INET, SOCK_DGRAM | SOCK_CLOEXEC
    if (fd < 0) return;
    unsafe {
        i64[2] timeout;
        timeout[0] = 5;
        Sys6(sys.SETSOCKOPT, fd, 1, 20, &timeout[0] as isize as i64, 16, 0);      // SO_RCVTIMEO
        *u8 sa = SockAddr(ns[0..4], 53);
        Sys6(sys.SENDTO, fd, Ptr(&q.AsSlice()[0]), q.Len() as i64, 0, Ptr(sa), 16);
        *u8 buf = alloc(1500);
        i64 n = Sys6(sys.RECVFROM, fd, Ptr(buf), 1500, 0, 0, 0);
        Sys(sys.CLOSE, fd, 0, 0, 0);
        if (n < 12 || buf[0] != 0x45 || buf[1] != 0x6e) return;
        usize count = ((buf[6] as usize) << 8) | buf[7] as usize;
        usize at = 12;
        // skip the question: its name, type and class
        while (at < n as usize && buf[at] != 0) {
            if (buf[at] & 0xC0 == 0xC0) {
                at += 1;
                break;
            }
            at += buf[at] as usize + 1;
        }
        at += 5;
        for (usize k = 0; k < count && at + 10 <= n as usize; k++) {
            // the answer's name: labels, or a pointer
            while (at < n as usize && buf[at] != 0) {
                if (buf[at] & 0xC0 == 0xC0) {
                    at += 1;
                    break;
                }
                at += buf[at] as usize + 1;
            }
            at += 1;
            if (at + 10 > n as usize) return;
            usize rtype = ((buf[at] as usize) << 8) | buf[at + 1] as usize;
            usize length = ((buf[at + 8] as usize) << 8) | buf[at + 9] as usize;
            at += 10;
            if (at + length > n as usize) return;
            if (rtype == 1 && length == 4) found.Push(Ipv4Text(slice_from(&buf[at], 4)));
            at += length;
        }
    }
}

// TCP through system calls, and name lookup through /etc/hosts and DNS.
public struct Net {
    u8 Unused;

    public static Net New() => new Net { Unused = 0 };
}

impl INet for Net {
    Result<List<string>, IoError> Resolve(ref this, str host) {
        List<string> all = List<string>.New();
        u8[4] a;
        if (ParseIpv4(host, a[0..4])) {
            all.Push(string.From(host));
            return Ok(all);
        }
        if (text.Lower(host).Equals("localhost")) {
            all.Push(string.From("127.0.0.1"));
            return Ok(all);
        }
        FromHosts(host, ref all);
        if (all.Len() == 0) FromDns(host, ref all);
        if (all.Len() == 0) return Err(IoError.NotFound);
        return Ok(all);
    }

    Result<i64, IoError> Connect(ref this, str host, u16 port) {
        List<string> addrs = this.Resolve(host)?;
        IoError last = IoError.NotFound;
        foreach (var t in addrs.AsSlice()) {
            u8[4] a;
            if (!ParseIpv4(t.AsStr(), a[0..4])) continue;
            i64 fd = Sys(sys.SOCKET, 2, 1 | 0x80000, 0, 0);    // AF_INET, SOCK_STREAM | SOCK_CLOEXEC
            if (fd < 0) return Err(NetErrorOf(fd));
            *u8 sa = SockAddr(a[0..4], port);
            i64 r = Sys(sys.CONNECT, fd, Ptr(sa), 16, 0);
            while (r == -4) r = Sys(sys.CONNECT, fd, Ptr(sa), 16, 0);
            if (r == 0) return Ok(fd);
            last = NetErrorOf(r);
            Sys(sys.CLOSE, fd, 0, 0, 0);
        }
        return Err(last);
    }

    Result<i64, IoError> Listen(ref this, str host, u16 port) {
        List<string> addrs = this.Resolve(host)?;
        u8[4] a;
        if (!ParseIpv4(addrs.AsSlice()[0].AsStr(), a[0..4])) return Err(IoError.Invalid);
        i64 fd = Sys(sys.SOCKET, 2, 1 | 0x80000, 0, 0);
        if (fd < 0) return Err(NetErrorOf(fd));
        u32 one = 1;
        unsafe { Sys6(sys.SETSOCKOPT, fd, 1, 2, &one as isize as i64, 4, 0); }   // SO_REUSEADDR
        *u8 sa = SockAddr(a[0..4], port);
        i64 r = Sys(sys.BIND, fd, Ptr(sa), 16, 0);
        if (r == 0) r = Sys(sys.LISTEN, fd, 128, 0, 0);
        if (r != 0) {
            Sys(sys.CLOSE, fd, 0, 0, 0);
            return Err(NetErrorOf(r));
        }
        return Ok(fd);
    }

    u16 LocalPort(ref this, i64 listener) {
        unsafe {
            *u8 sa = alloc(16);
            u32 len = 16;
            if (Sys(sys.GETSOCKNAME, listener, Ptr(sa), &len as isize as i64, 0) != 0) return 0;
            return ((sa[2] as u16) << 8) | sa[3] as u16;
        }
    }

    Result<i64, IoError> Accept(ref this, i64 listener) {
        i64 fd = Sys(sys.ACCEPT, listener, 0, 0, 0);
        while (fd == -4) fd = Sys(sys.ACCEPT, listener, 0, 0, 0);
        if (fd < 0) return Err(NetErrorOf(fd));
        return Ok(fd);
    }

    Result<usize, IoError> Send(ref this, i64 conn, u8[] data) {
        usize at = 0;
        while (at < data.Len) {
            i64 r = 0;
            // MSG_NOSIGNAL: a closed peer is an error, not a signal that ends the program
            unsafe { r = Sys6(sys.SENDTO, conn, &data[at] as isize as i64, (data.Len - at) as i64, 0x4000, 0, 0); }
            if (r == -4) continue;
            if (r < 0) return Err(NetErrorOf(r));
            at += r as usize;
        }
        return Ok(data.Len);
    }

    Result<usize, IoError> Recv(ref this, i64 conn, mut u8[] into) {
        if (into.Len == 0) return Ok(0);
        while (true) {
            i64 r = 0;
            unsafe { r = Sys6(sys.RECVFROM, conn, &into[0] as isize as i64, into.Len as i64, 0, 0, 0); }
            if (r == -4) continue;
            if (r < 0) return Err(NetErrorOf(r));
            return Ok(r as usize);
        }
        return Ok(0);
    }

    void Close(ref this, i64 handle) {
        Sys(sys.CLOSE, handle, 0, 0, 0);
    }
}

// ------------------------------------------------------------------ trust

u8 B64Value(u8 c) {
    if (c >= 'A' && c <= 'Z') return c - 'A';
    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
    if (c >= '0' && c <= '9') return c - '0' + 52;
    if (c == '+') return 62;
    if (c == '/') return 63;
    return 255;
}

// The certificates in the system's CA bundle (the first of the usual places that exists).
public struct Trust {
    u8 Unused;

    public static Trust New() => new Trust { Unused = 0 };
}

impl ITrust for Trust {
    List<List<u8>> Roots(ref this) {
        List<List<u8>> all = List<List<u8>>.New();
        FileSystem fs = FileSystem.New();
        List<str> places = List<str>.New();
        places.Push("/etc/ssl/certs/ca-certificates.crt");
        places.Push("/etc/pki/tls/certs/ca-bundle.crt");
        places.Push("/etc/ssl/cert.pem");
        places.Push("/etc/ssl/ca-bundle.pem");
        foreach (var place in places.AsSlice()) {
            Result<string, IoError> r = fs.Read(place);
            if (r.IsErr()) continue;
            string pem = r.Unwrap();
            str p = pem.AsStr();
            str begin = "-----BEGIN CERTIFICATE-----";
            str end = "-----END CERTIFICATE-----";
            usize at = 0;
            while (at < p.Len) {
                usize? b = ct.IndexOf(p[at..p.Len], begin);
                if (b.IsNone()) break;
                usize start = at + b.Unwrap() + begin.Len;
                usize? e = ct.IndexOf(p[start..p.Len], end);
                if (e.IsNone()) break;
                List<u8> der = List<u8>.New();
                u32 acc = 0;
                u32 bits = 0;
                for (usize i = start; i < start + e.Unwrap(); i++) {
                    u8 v = B64Value(p[i]);
                    if (v == 255) continue;
                    acc = (acc << 6) | v as u32;
                    bits += 6;
                    if (bits >= 8) {
                        bits -= 8;
                        der.Push((acc >> bits) as u8);
                    }
                }
                all.Push(der);
                at = start + e.Unwrap() + end.Len;
            }
            break;
        }
        return all;
    }
}

// ------------------------------------------------------------------ terminal

const i64 TCGETS = 0x5401;
const i64 TCSETS = 0x5402;
const i64 TIOCGWINSZ = 0x5413;

u32 Le32(u8[] b, usize at) => b[at] as u32 | (b[at + 1] as u32) << 8 | (b[at + 2] as u32) << 16 | (b[at + 3] as u32) << 24;

void PutLe32(mut u8[] b, usize at, u32 v) {
    b[at] = v as u8;
    b[at + 1] = (v >> 8) as u8;
    b[at + 2] = (v >> 16) as u8;
    b[at + 3] = (v >> 24) as u8;
}

// The window's size from TIOCGWINSZ: rows (which 0) or columns (which 1); 0 if unknown.
u32 WinSize(usize which) {
    u8[8] ws;
    i64 r = 0;
    unsafe { r = Sys(sys.IOCTL, 1, TIOCGWINSZ, Ptr(&ws[0]), 0); }
    if (r != 0) return 0;
    return ws[2 * which] as u32 | (ws[2 * which + 1] as u32) << 8;
}

// The terminal through ioctl (TCGETS, TCSETS, TIOCGWINSZ) and poll (PLAN D43).
public struct Terminal {
    List<u8> Saved;     // the termios found, given back when raw mode ends
    bool IsRaw;

    public static Terminal New() => new Terminal { Saved = List<u8>.New(), IsRaw = false };
}

impl ITerminal for Terminal {
    bool IsTerminal(ref this) {
        u8[64] t;
        unsafe { return Sys(sys.IOCTL, 1, TCGETS, Ptr(&t[0]), 0) == 0; }
    }

    u32 Cols(ref this) {
        u32 c = WinSize(1);
        if (c == 0) return 80;
        return c;
    }

    u32 Rows(ref this) {
        u32 r = WinSize(0);
        if (r == 0) return 24;
        return r;
    }

    bool Raw(ref this, bool on) {
        u8[64] t;
        if (on) {
            if (this.IsRaw) return true;
            i64 r = 0;
            unsafe { r = Sys(sys.IOCTL, 0, TCGETS, Ptr(&t[0]), 0); }
            if (r != 0) return false;
            this.Saved = List<u8>.New();
            for (usize i = 0; i < 64; i++) this.Saved.Push(t[i]);
            // no BRKINT, ICRNL, INPCK, ISTRIP, IXON, INLCR, IGNCR, PARMRK, IGNBRK
            PutLe32(t[0..64], 0, Le32(t[0..64], 0) & ~(0x1 | 0x2 | 0x8 | 0x10 | 0x20 | 0x40 | 0x80 | 0x100 | 0x400));
            // no ECHO, ECHONL, ICANON, ISIG, IEXTEN
            PutLe32(t[0..64], 12, Le32(t[0..64], 12) & ~(0x1 | 0x2 | 0x8 | 0x40 | 0x8000));
            t[17 + 6] = 1;      // VMIN
            t[17 + 5] = 0;      // VTIME
            unsafe { r = Sys(sys.IOCTL, 0, TCSETS, Ptr(&t[0]), 0); }
            if (r != 0) return false;
            this.IsRaw = true;
            return true;
        }
        if (!this.IsRaw) return true;
        u8[] saved = this.Saved.AsSlice();
        for (usize i = 0; i < 64 && i < saved.Len; i++) t[i] = saved[i];
        unsafe { Sys(sys.IOCTL, 0, TCSETS, Ptr(&t[0]), 0); }
        this.IsRaw = false;
        return true;
    }

    void Write(ref this, str text) => write(1, text);

    usize Read(ref this, mut u8[] into, i32 waitMs) {
        if (into.Len == 0) return 0;
        u8[8] pfd;          // struct pollfd: fd 0, events POLLIN
        pfd[4] = 1;
        i64 r = 0;
        unsafe { r = sys.Poll(Ptr(&pfd[0]), 1, waitMs as i64); }
        if (r <= 0) return 0;
        isize n = 0;
        unsafe { n = read(0, &into[0], into.Len); }
        if (n <= 0) return 0;
        return n as usize;
    }
}

// ------------------------------------------------------------------ window

// Linux windows (X11, Wayland) come after M8 (PLAN D45): Open says no.
public struct Window {
    u8 Unused;

    public static Window New() => new Window { Unused = 0 };
}

impl IWindow for Window {
    bool Open(ref this, str title, u32 width, u32 height) => false;
    bool IsOpen(ref this) => false;
    u32 Width(ref this) => 0;
    u32 Height(ref this) => 0;
    Event Poll(ref this) => Event.Nothing();
    void Present(ref this, u8[] rgba, u32 width, u32 height) {
    }
    void SetTitle(ref this, str title) {
    }
    void Close(ref this) {
    }
}
