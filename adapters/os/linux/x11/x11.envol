// os.linux.x11: an X11 client spoken over the X server's socket, with no Xlib (PLAN
// D45, M14.7). It does what the Window port needs: connect (with the MIT-MAGIC-COOKIE-1
// from the Xauthority file), open a window that asks to be told of its closing, show
// frames (PutImage, in strips under the request size limit), and turn the server's
// events into port events, keys through the server's keyboard map. It also holds the
// CLIPBOARD selection for the Clipboard port (M14.7b): it owns it to copy, answering other
// programs' requests, and converts it to paste.
//
// Only the core protocol, little-endian, for a TrueColor visual of depth 24 drawn 32 bits
// a pixel (what X servers offer today). The protocol: https://www.x.org/releases/X11R7.7/doc/xproto/x11protocol.html
namespace os.linux.x11;

use ports.{Event, EventKind};
use core.text as ct;
use alloc.text;
use os.linux.sys;

// Requests (major opcodes).
const u8 CREATE_WINDOW = 1;
const u8 DESTROY_WINDOW = 4;
const u8 MAP_WINDOW = 8;
const u8 INTERN_ATOM = 16;
const u8 CHANGE_PROPERTY = 18;
const u8 CREATE_GC = 55;
const u8 PUT_IMAGE = 72;
const u8 GET_KEYBOARD_MAPPING = 101;
const u8 GET_PROPERTY = 20;
const u8 SET_SELECTION_OWNER = 22;
const u8 GET_SELECTION_OWNER = 23;
const u8 CONVERT_SELECTION = 24;
const u8 SEND_EVENT = 25;

// Atoms every server has.
const u32 ATOM_ATOM = 4;
const u32 ATOM_STRING = 31;
const u32 ATOM_WM_NAME = 39;

// The events a window asks for: keys, buttons, motion, exposure, its structure.
const u32 EVENT_MASK = 0x1 | 0x2 | 0x4 | 0x8 | 0x40 | 0x8000 | 0x20000;

i64 Sys(i64 n, i64 a, i64 b, i64 c, i64 d, i64 e, i64 f) => __syscall(n, a, b, c, d, e, f);

i64 Addr(*u8 p) {
    unsafe { return p as isize as i64; }
}

u16 Get16(u8[] b, usize at) => b[at] as u16 | (b[at + 1] as u16 << 8);
u32 Get32(u8[] b, usize at) => b[at] as u32 | (b[at + 1] as u32 << 8) | (b[at + 2] as u32 << 16) | (b[at + 3] as u32 << 24);
i32 I16(u8[] b, usize at) => Get16(b, at) as i16 as i32;
u16 Be16(u8[] b, usize at) => (b[at] as u16 << 8) | b[at + 1] as u16;

// A request being built: little-endian fields, padded to four bytes.
struct Req {
    List<u8> B;

    static Req Of(u8 opcode, u8 data) {
        Req r = new Req { B = List<u8>.New() };
        r.B.Push(opcode);
        r.B.Push(data);
        r.B.Push(0);                // the length, filled in by Done
        r.B.Push(0);
        return r;
    }

    void U8(ref this, u8 v) => this.B.Push(v);
    void U16(ref this, u16 v) {
        this.B.Push(v as u8);
        this.B.Push((v >> 8) as u8);
    }
    void U32(ref this, u32 v) {
        this.B.Push(v as u8);
        this.B.Push((v >> 8) as u8);
        this.B.Push((v >> 16) as u8);
        this.B.Push((v >> 24) as u8);
    }
    void Bytes(ref this, u8[] b) {
        foreach (var x in b) this.B.Push(x);
    }
    void Pad(ref this) {
        while (this.B.Len() % 4 != 0) this.B.Push(0);
    }

    // The finished request: padded, its length (in four-byte units) set.
    void Done(ref this) {
        this.Pad();
        usize words = this.B.Len() / 4;
        mut u8[] b = this.B.AsMutSlice();
        b[2] = words as u8;
        b[3] = (words >> 8) as u8;
    }
}

// The display named by $DISPLAY (":N", ":N.S", "unix:N"): its number as text, or none
// for a display reached over TCP, which this client does not speak.
string? DisplayNumber(str display) {
    usize? colon = ct.LastIndexOf(display, ":");
    if (colon.IsNone()) return null;
    str host = display[0..colon.Unwrap()];
    if (host.Len > 0 && ct.Compare(host, "unix") != 0) return null;
    str rest = display[colon.Unwrap() + 1..display.Len];
    usize end = 0;
    while (end < rest.Len && ct.IsDigit(rest[end])) end++;
    if (end == 0) return null;
    return Some(string.From(rest[0..end]));
}

// The MIT-MAGIC-COOKIE-1 for display number num in the Xauthority file at path (empty
// when there is none: the server may not ask for one).
List<u8> Cookie(str path, str num) {
    List<u8> none = List<u8>.New();
    i64 fd = 0;
    *u8 p = CPath(path);
    unsafe {
        if (p as usize == 0) return none;
        fd = sys.Open(Addr(p), 0x80000, 0);     // O_RDONLY | O_CLOEXEC
    }
    if (fd < 0) return none;
    List<u8> data = List<u8>.New();
    u8[4096] buf;
    while (true) {
        isize n = 0;
        unsafe { n = read(fd as i32, &buf[0], 4096); }
        if (n <= 0) break;
        for (isize i = 0; i < n; i++) data.Push(buf[i as usize]);
    }
    Sys(sys.CLOSE, fd, 0, 0, 0, 0, 0);
    // entries: family (u16), then address, number, name and data, each a big-endian u16
    // length and its bytes
    u8[] d = data.AsSlice();
    usize at = 0;
    while (at + 2 <= d.Len) {
        at += 2;
        usize[4] start;
        usize[4] len;
        bool whole = true;
        for (usize k = 0; k < 4; k++) {
            if (at + 2 > d.Len) {
                whole = false;
                break;
            }
            len[k] = Be16(d, at) as usize;
            start[k] = at + 2;
            at += 2 + len[k];
            if (at > d.Len) {
                whole = false;
                break;
            }
        }
        if (!whole) break;
        bool anyNumber = len[1] == 0;
        bool cookie = Same(d[start[2]..start[2] + len[2]], "MIT-MAGIC-COOKIE-1");
        if (cookie && (anyNumber || Same(d[start[1]..start[1] + len[1]], num))) {
            List<u8> c = List<u8>.New();
            foreach (var x in d[start[3]..start[3] + len[3]]) c.Push(x);
            return c;
        }
    }
    return none;
}

// Whether bytes b are text t.
bool Same(u8[] b, str t) {
    if (b.Len != t.Len) return false;
    for (usize i = 0; i < b.Len; i++) {
        if (b[i] != t[i]) return false;
    }
    return true;
}

*u8 CPath(str path) {
    unsafe {
        *u8 z = alloc(path.Len + 1);
        for (usize i = 0; i < path.Len; i++) {
            if (path[i] == 0) return 0 as usize as *u8;
            z[i] = path[i];
        }
        z[path.Len] = 0;
        return z;
    }
}

// A connection to an X server, with one window.
public struct Conn {
    i64 Fd;
    List<u8> In;            // bytes read and not yet taken
    u16 Seq;                // the sequence number of the last request
    u32 IdBase;
    u32 IdMask;
    u32 NextId;
    u32 Root;
    u32 Black;
    u32 MaxBytes;           // the largest request, in bytes
    u8 MinKey;
    u8 MaxKey;
    u32 PerKey;             // keysyms for each keycode
    List<u32> Syms;         // the keyboard map
    List<Event> Queue;      // events parsed, not yet polled
    u32 Win;
    u32 Gc;
    u32 DeleteAtom;
    u32 ProtocolsAtom;
    u32 W;
    u32 H;
    bool Failed;            // an error came back: the window is no use
    u32 ClipWin;            // an unmapped window that owns and receives the selection
    u32 ClipAtom;           // CLIPBOARD
    u32 Utf8Atom;           // UTF8_STRING
    u32 TargetsAtom;        // TARGETS
    u32 PropAtom;           // where a pasted selection is put for us
    string ClipText;        // what we copied
    bool Owning;            // we own CLIPBOARD
    bool Notified;          // a SelectionNotify came
    u32 NotifiedProp;       // its property (0: the owner could not convert)

    // No connection.
    public static Conn Closed() => new Conn {
        Fd = -1, In = List<u8>.New(), Seq = 0, IdBase = 0, IdMask = 0, NextId = 0, Root = 0, Black = 0,
        MaxBytes = 0, MinKey = 0, MaxKey = 0, PerKey = 0, Syms = List<u32>.New(), Queue = List<Event>.New(),
        Win = 0, Gc = 0, DeleteAtom = 0, ProtocolsAtom = 0, W = 0, H = 0, Failed = false,
        ClipWin = 0, ClipAtom = 0, Utf8Atom = 0, TargetsAtom = 0, PropAtom = 0, ClipText = string.New(),
        Owning = false, Notified = false, NotifiedProp = 0
    };

    // Connects to display (as $DISPLAY names it) with the cookie in the Xauthority file
    // at xauthority; a closed connection (IsBroken) if there is no server or it refuses.
    public static Conn Open(str display, str xauthority) {
        Conn c = Conn.Closed();
        string? num = DisplayNumber(display);
        if (num.IsNone()) return c;
        string n = num.Unwrap();
        string path = string.From("/tmp/.X11-unix/X");
        path.Append(n.AsStr());
        i64 fd = Sys(sys.SOCKET, 1, 1 | 0x80000, 0, 0, 0, 0);     // AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC
        if (fd < 0) return c;
        u8[110] sa;                                                 // struct sockaddr_un
        sa[0] = 1;
        for (usize i = 0; i < path.Len() && i < 107; i++) sa[2 + i] = path.AsStr()[i];
        i64 r = 0;
        unsafe { r = Sys(sys.CONNECT, fd, Addr(&sa[0]), (2 + path.Len() + 1) as i64, 0, 0, 0); }
        while (r == -4) {
            unsafe { r = Sys(sys.CONNECT, fd, Addr(&sa[0]), (2 + path.Len() + 1) as i64, 0, 0, 0); }
        }
        if (r != 0) {
            Sys(sys.CLOSE, fd, 0, 0, 0, 0, 0);
            return c;
        }
        c.Fd = fd;
        if (!c.Setup(Cookie(xauthority, n.AsStr()))) c.Close();
        return c;
    }

    public void Close(ref this) {
        if (this.Fd >= 0) Sys(sys.CLOSE, this.Fd, 0, 0, 0, 0, 0);
        this.Fd = -1;
    }

    public bool IsBroken(in this) => this.Failed || this.Fd < 0;

    // ---------------------------------------------------------------- bytes

    bool Send(ref this, u8[] data) {
        usize at = 0;
        while (at < data.Len) {
            i64 r = 0;
            // MSG_NOSIGNAL: a server gone away is an error, not a signal
            unsafe { r = Sys(sys.SENDTO, this.Fd, Addr(&data[at]), (data.Len - at) as i64, 0x4000, 0, 0); }
            if (r == -4) continue;
            if (r <= 0) {
                this.Failed = true;
                return false;
            }
            at += r as usize;
        }
        return true;
    }

    // Sends a finished request; it gets the next sequence number.
    void Request(ref this, ref Req r) {
        r.Done();
        this.Seq++;
        this.Send(r.B.AsSlice());
    }

    // Reads what the server has sent, waiting up to ms milliseconds for something (0: not
    // at all). False if the connection is gone.
    bool Fill(ref this, i64 ms) {
        u8[8] pfd;
        unsafe {
            *i32 fdp = &pfd[0] as *i32;
            fdp[0] = this.Fd as i32;
        }
        pfd[4] = 1;                                 // POLLIN
        i64 ready = 0;
        unsafe { ready = sys.Poll(Addr(&pfd[0]), 1, ms); }
        if (ready <= 0) return true;
        u8[8192] buf;
        i64 n = 0;
        unsafe { n = Sys(sys.RECVFROM, this.Fd, Addr(&buf[0]), 8192, 0, 0, 0); }
        if (n == -4 || n == -11) return true;
        if (n <= 0) {
            this.Failed = true;
            return false;
        }
        for (i64 i = 0; i < n; i++) this.In.Push(buf[i as usize]);
        return true;
    }

    // Takes n bytes from the front of what was read.
    List<u8> Take(ref this, usize n) {
        List<u8> taken = List<u8>.New();
        List<u8> rest = List<u8>.New();
        u8[] all = this.In.AsSlice();
        for (usize i = 0; i < all.Len; i++) {
            if (i < n) taken.Push(all[i]);
            else rest.Push(all[i]);
        }
        this.In = rest;
        return taken;
    }

    // Waits (up to five seconds) until n bytes are there; false if they never come.
    bool Need(ref this, usize n) {
        u32 tries = 0;
        while (this.In.Len() < n) {
            if (!this.Fill(100) || tries > 50) return false;
            tries++;
        }
        return true;
    }

    // ---------------------------------------------------------------- setup

    bool Setup(ref this, List<u8> cookie) {
        Req r = new Req { B = List<u8>.New() };
        r.U8('l');                  // little-endian
        r.U8(0);
        r.U16(11);                  // protocol 11.0
        r.U16(0);
        str name = "MIT-MAGIC-COOKIE-1";
        if (cookie.Len() == 0) name = "";
        r.U16(name.Len as u16);
        r.U16(cookie.Len() as u16);
        r.U16(0);
        for (usize i = 0; i < name.Len; i++) r.U8(name[i]);
        r.Pad();
        r.Bytes(cookie.AsSlice());
        r.Pad();
        if (!this.Send(r.B.AsSlice())) return false;
        if (!this.Need(8)) return false;
        usize more = Get16(this.In.AsSlice(), 6) as usize * 4;
        if (!this.Need(8 + more)) return false;
        List<u8> reply = this.Take(8 + more);
        u8[] s = reply.AsSlice();
        if (s[0] != 1) return false;                // refused, or asks for more
        this.IdBase = Get32(s, 12);
        this.IdMask = Get32(s, 16);
        usize vendor = Get16(s, 24) as usize;
        this.MaxBytes = Get16(s, 26) as u32 * 4;
        usize screens = s[28] as usize;
        usize formats = s[29] as usize;
        this.MinKey = s[34];
        this.MaxKey = s[35];
        usize at = 40 + (vendor + 3) / 4 * 4 + 8 * formats;
        if (screens == 0 || at + 40 > s.Len) return false;
        this.Root = Get32(s, at);
        this.Black = Get32(s, at + 12);
        if (s[at + 38] != 24 && s[at + 38] != 32) return false;     // the root's depth
        return this.LoadKeyboard();
    }

    u32 NewId(ref this) {
        u32 id = this.IdBase | (this.NextId & this.IdMask);
        this.NextId++;
        return id;
    }

    // Waits for the reply to the last request, keeping the events that come first.
    // None on an error or when it never comes.
    List<u8>? Reply(ref this) {
        u32 tries = 0;
        while (tries < 50) {
            if (this.In.Len() < 32) {
                if (!this.Fill(100)) return null;
                tries++;
                continue;
            }
            u8 kind = this.In.AsSlice()[0];
            if (kind == 1) {
                usize more = Get32(this.In.AsSlice(), 4) as usize * 4;
                if (!this.Need(32 + more)) return null;
                List<u8> r = this.Take(32 + more);
                if (Get16(r.AsSlice(), 2) == this.Seq) return Some(r);
                continue;
            }
            List<u8> e = this.Take(32);
            if (kind == 0) {
                if (Get16(e.AsSlice(), 2) == this.Seq) {
                    this.Failed = true;
                    return null;
                }
                continue;
            }
            this.Translate(e.AsSlice());
        }
        return null;
    }

    u32 Atom(ref this, str name) {
        Req r = Req.Of(INTERN_ATOM, 0);
        r.U16(name.Len as u16);
        r.U16(0);
        for (usize i = 0; i < name.Len; i++) r.U8(name[i]);
        this.Request(ref r);
        List<u8>? reply = this.Reply();
        if (reply.IsNone()) return 0;
        return Get32(reply.Unwrap().AsSlice(), 8);
    }

    bool LoadKeyboard(ref this) {
        Req r = Req.Of(GET_KEYBOARD_MAPPING, 0);
        u32 count = (this.MaxKey - this.MinKey) as u32 + 1;
        r.U8(this.MinKey);
        r.U8(count as u8);
        r.U16(0);
        this.Request(ref r);
        List<u8>? reply = this.Reply();
        if (reply.IsNone()) return false;
        u8[] s = reply.Unwrap().AsSlice();
        this.PerKey = s[1] as u32;
        this.Syms = List<u32>.New();
        for (usize at = 32; at + 4 <= s.Len; at += 4) this.Syms.Push(Get32(s, at));
        return true;
    }

    // ---------------------------------------------------------------- the window

    // Opens a window with a drawable area of width x height; false if the server says no.
    public bool CreateWindow(ref this, str title, u32 width, u32 height) {
        this.Win = this.NewId();
        Req r = Req.Of(CREATE_WINDOW, 0);           // depth: the parent's
        r.U32(this.Win);
        r.U32(this.Root);
        r.U16(0);                                   // x, y
        r.U16(0);
        r.U16(width as u16);
        r.U16(height as u16);
        r.U16(0);                                   // border
        r.U16(1);                                   // InputOutput
        r.U32(0);                                   // visual: the parent's
        r.U32(0x2 | 0x800);                         // background-pixel, event-mask
        r.U32(this.Black);
        r.U32(EVENT_MASK);
        this.Request(ref r);
        this.ProtocolsAtom = this.Atom("WM_PROTOCOLS");
        this.DeleteAtom = this.Atom("WM_DELETE_WINDOW");
        if (this.Failed || this.ProtocolsAtom == 0 || this.DeleteAtom == 0) return false;
        // ask to be told when the user closes it, rather than being cut off
        List<u8> protocols = List<u8>.New();
        protocols.Push(this.DeleteAtom as u8);
        protocols.Push((this.DeleteAtom >> 8) as u8);
        protocols.Push((this.DeleteAtom >> 16) as u8);
        protocols.Push((this.DeleteAtom >> 24) as u8);
        this.Property(this.ProtocolsAtom, ATOM_ATOM, 32, protocols.AsSlice());
        this.SetTitle(title);
        this.Gc = this.NewId();
        Req g = Req.Of(CREATE_GC, 0);
        g.U32(this.Gc);
        g.U32(this.Win);
        g.U32(0);
        this.Request(ref g);
        Req m = Req.Of(MAP_WINDOW, 0);
        m.U32(this.Win);
        this.Request(ref m);
        this.W = width;
        this.H = height;
        // a round trip: anything wrong with the requests above shows now
        this.Atom("UTF8_STRING");
        return !this.Failed;
    }

    void Property(ref this, u32 property, u32 kind, u8 format, u8[] data) => this.PropertyOn(this.Win, property, kind, format, data);

    void PropertyOn(ref this, u32 window, u32 property, u32 kind, u8 format, u8[] data) {
        Req r = Req.Of(CHANGE_PROPERTY, 0);         // Replace
        r.U32(window);
        r.U32(property);
        r.U32(kind);
        r.U8(format);
        r.U8(0);
        r.U16(0);
        r.U32((data.Len / (format as usize / 8)) as u32);
        r.Bytes(data);
        this.Request(ref r);
    }

    public void SetTitle(ref this, str title) {
        List<u8> t = List<u8>.New();
        for (usize i = 0; i < title.Len; i++) t.Push(title[i]);
        this.Property(ATOM_WM_NAME, ATOM_STRING, 8, t.AsSlice());
        u32 utf8 = this.Atom("UTF8_STRING");
        u32 netName = this.Atom("_NET_WM_NAME");
        if (utf8 != 0 && netName != 0) this.Property(netName, utf8, 8, t.AsSlice());
    }

    public u32 Width(in this) => this.W;
    public u32 Height(in this) => this.H;

    // Shows width x height RGBA pixels at the top left, as strips of rows each within the
    // request size limit.
    public void Present(ref this, u8[] rgba, u32 width, u32 height) {
        if (width == 0 || height == 0 || rgba.Len < (width * height * 4) as usize) return;
        usize row = width as usize * 4;
        usize rows = (this.MaxBytes as usize - 24) / row;
        if (rows == 0) return;
        usize y = 0;
        while (y < height as usize) {
            usize n = rows;
            if (y + n > height as usize) n = height as usize - y;
            Req r = Req.Of(PUT_IMAGE, 2);           // ZPixmap
            r.U32(this.Win);
            r.U32(this.Gc);
            r.U16(width as u16);
            r.U16(n as u16);
            r.U16(0);
            r.U16(y as u16);
            r.U8(0);                                // left pad
            r.U8(24);                               // depth
            r.U16(0);
            // RGBA to the server's BGRX
            for (usize i = y * row; i < (y + n) * row; i += 4) {
                r.U8(rgba[i + 2]);
                r.U8(rgba[i + 1]);
                r.U8(rgba[i]);
                r.U8(0);
            }
            this.Request(ref r);
            y += n;
        }
    }

    public void Destroy(ref this) {
        if (this.Win != 0 && !this.Failed) {
            Req r = Req.Of(DESTROY_WINDOW, 0);
            r.U32(this.Win);
            this.Request(ref r);
        }
        this.Win = 0;
    }

    // ---------------------------------------------------------------- the clipboard

    // Makes the window that owns and receives the selection; false if the server says no.
    public bool OpenClipboard(ref this) {
        if (this.ClipWin != 0) return !this.Failed;
        this.ClipWin = this.NewId();
        Req r = Req.Of(CREATE_WINDOW, 0);
        r.U32(this.ClipWin);
        r.U32(this.Root);
        r.U16(0);
        r.U16(0);
        r.U16(1);
        r.U16(1);
        r.U16(0);
        r.U16(2);                                   // InputOnly: never shown
        r.U32(0);
        r.U32(0);                                   // no values
        this.Request(ref r);
        this.ClipAtom = this.Atom("CLIPBOARD");
        this.Utf8Atom = this.Atom("UTF8_STRING");
        this.TargetsAtom = this.Atom("TARGETS");
        this.PropAtom = this.Atom("ENVO_CLIPBOARD");
        return !this.Failed && this.ClipAtom != 0 && this.Utf8Atom != 0 && this.TargetsAtom != 0 && this.PropAtom != 0;
    }

    // Takes the selection with text; false if the server would not give it.
    public bool Own(ref this, str text) {
        this.ClipText = string.From(text);
        Req r = Req.Of(SET_SELECTION_OWNER, 0);
        r.U32(this.ClipWin);
        r.U32(this.ClipAtom);
        r.U32(0);                                   // CurrentTime
        this.Request(ref r);
        Req q = Req.Of(GET_SELECTION_OWNER, 0);
        q.U32(this.ClipAtom);
        this.Request(ref q);
        List<u8>? reply = this.Reply();
        this.Owning = reply.IsSome() && Get32(reply.Unwrap().AsSlice(), 8) == this.ClipWin;
        return this.Owning;
    }

    // The selection's text: ours without asking, or converted to UTF-8 by its owner
    // (waiting up to a second); None if nobody has it or it is not text.
    public string? Fetch(ref this) {
        this.Service();
        if (this.Owning) return Some(string.From(this.ClipText.AsStr()));
        Req r = Req.Of(CONVERT_SELECTION, 0);
        r.U32(this.ClipWin);
        r.U32(this.ClipAtom);
        r.U32(this.Utf8Atom);
        r.U32(this.PropAtom);
        r.U32(0);
        this.Request(ref r);
        this.Notified = false;
        u32 tries = 0;
        while (!this.Notified && tries < 10 && !this.Failed) {
            this.Fill(100);
            this.Drain();
            tries++;
        }
        if (!this.Notified || this.NotifiedProp == 0) return null;
        Req g = Req.Of(GET_PROPERTY, 1);            // delete it once read
        g.U32(this.ClipWin);
        g.U32(this.PropAtom);
        g.U32(0);                                   // any type
        g.U32(0);
        g.U32(0x100000);                            // up to 4 MiB
        this.Request(ref g);
        List<u8>? reply = this.Reply();
        if (reply.IsNone()) return null;
        u8[] p = reply.Unwrap().AsSlice();
        if (p[1] != 8) return null;                 // not bytes
        usize n = Get32(p, 16) as usize;
        if (32 + n > p.Len) return null;
        string t = string.New();
        for (usize i = 32; i < 32 + n; i++) t.AppendByte(p[i]);
        return Some(t);
    }

    // Answers what other programs asked of the selection since the last call, without
    // waiting: a window's Poll calls it, so pastes elsewhere are answered while it runs.
    public void Service(ref this) {
        this.Fill(0);
        this.Drain();
    }

    // Turns the events read so far into the queue (and selection work).
    void Drain(ref this) {
        while (this.In.Len() >= 32) {
            u8 kind = this.In.AsSlice()[0];
            if (kind == 1) {
                usize more = Get32(this.In.AsSlice(), 4) as usize * 4;
                if (this.In.Len() < 32 + more) break;
                List<u8> skipped = this.Take(32 + more);
                continue;
            }
            List<u8> e = this.Take(32);
            if (kind == 0) continue;                // an error about a request nobody waits for
            this.Translate(e.AsSlice());
        }
    }

    // SelectionRequest: another program pastes. It gets our text (UTF8_STRING or STRING),
    // or the list of what we offer (TARGETS), in the property it named.
    void AnswerSelection(ref this, u8[] e) {
        u32 time = Get32(e, 4);
        u32 requestor = Get32(e, 12);
        u32 selection = Get32(e, 16);
        u32 target = Get32(e, 20);
        u32 property = Get32(e, 24);
        if (property == 0) property = target;       // an old client
        u32 answered = 0;
        if (this.Owning && selection == this.ClipAtom) {
            if (target == this.TargetsAtom) {
                List<u8> atoms = List<u8>.New();
                PushAtom(ref atoms, this.TargetsAtom);
                PushAtom(ref atoms, this.Utf8Atom);
                PushAtom(ref atoms, ATOM_STRING);
                this.PropertyOn(requestor, property, ATOM_ATOM, 32, atoms.AsSlice());
                answered = property;
            } else if (target == this.Utf8Atom || target == ATOM_STRING) {
                List<u8> t = List<u8>.New();
                str text = this.ClipText.AsStr();
                for (usize i = 0; i < text.Len; i++) t.Push(text[i]);
                this.PropertyOn(requestor, property, target, 8, t.AsSlice());
                answered = property;
            }
        }
        // SelectionNotify to the requestor: done, or (property 0) refused
        Req r = Req.Of(SEND_EVENT, 0);
        r.U32(requestor);
        r.U32(0);                                   // no event mask: to the client that made the window
        r.U8(31);
        r.U8(0);
        r.U16(0);
        r.U32(time);
        r.U32(requestor);
        r.U32(selection);
        r.U32(target);
        r.U32(answered);
        for (usize i = 0; i < 8; i++) r.U8(0);
        this.Request(ref r);
    }

    // ---------------------------------------------------------------- events

    // The next event, without waiting; EventKind.None when there is none.
    // The connection's socket, for waiting on it.
    public i64 Handle(in this) => this.Fd;

    public Event Poll(ref this) {
        if (this.Queue.Len() == 0) {
            this.Fill(0);
            while (this.In.Len() >= 32) {
                u8 kind = this.In.AsSlice()[0];
                if (kind == 1) {
                    // a reply nobody waits for
                    usize more = Get32(this.In.AsSlice(), 4) as usize * 4;
                    if (this.In.Len() < 32 + more) break;
                    List<u8> skipped = this.Take(32 + more);
                    continue;
                }
                List<u8> e = this.Take(32);
                if (kind == 0) {
                    this.Failed = true;
                    continue;
                }
                this.Translate(e.AsSlice());
            }
        }
        if (this.Queue.Len() == 0) return Event.Nothing();
        // the oldest first
        Event first = this.Queue.Get(0);
        List<Event> rest = List<Event>.New();
        for (usize i = 1; i < this.Queue.Len(); i++) rest.Push(this.Queue.Get(i));
        this.Queue = rest;
        return first;
    }

    // One event from the server, as port events on the queue.
    void Translate(ref this, u8[] e) {
        u8 kind = e[0] & 0x7F;
        if (kind == 2 || kind == 3) {
            u32 state = Get16(e, 28) as u32;
            u32 mods = Mods(state);
            u32 sym = this.KeySym(e[1], state);
            u32 code = KeyCode(sym);
            if (kind == 2) {
                if (code != 0) this.Queue.Push(Event.Of(EventKind.KeyDown, 0, 0, code).WithMods(mods));
                u32 ch = CharOf(sym);
                if (ch != 0 && state & 0x4 == 0) this.Queue.Push(Event.Of(EventKind.Char, 0, 0, ch).WithMods(mods));
            } else if (code != 0) {
                this.Queue.Push(Event.Of(EventKind.KeyUp, 0, 0, code).WithMods(mods));
            }
            return;
        }
        if (kind == 4 || kind == 5) {
            i32 x = I16(e, 24);
            i32 y = I16(e, 26);
            u32 mods = Mods(Get16(e, 28) as u32);
            u8 b = e[1];
            if (b == 4 || b == 5) {
                // the wheel: a press for each notch
                if (kind == 4) {
                    i32 d = 120;
                    if (b == 5) d = -120;
                    this.Queue.Push(Event.Of(EventKind.Wheel, x, y, d as u32).WithMods(mods));
                }
                return;
            }
            u32 button = 1;
            if (b == 3) button = 2;
            else if (b == 2) button = 3;
            else if (b != 1) return;
            EventKind k = EventKind.MouseDown;
            if (kind == 5) k = EventKind.MouseUp;
            this.Queue.Push(Event.Of(k, x, y, button).WithMods(mods));
            return;
        }
        if (kind == 6) {
            this.Queue.Push(Event.Of(EventKind.MouseMove, I16(e, 24), I16(e, 26), 0).WithMods(Mods(Get16(e, 28) as u32)));
            return;
        }
        if (kind == 22) {
            // ConfigureNotify: a new size
            u32 w = Get16(e, 20) as u32;
            u32 h = Get16(e, 22) as u32;
            if (Get32(e, 4) == this.Win && (w != this.W || h != this.H)) {
                this.W = w;
                this.H = h;
                this.Queue.Push(Event.Of(EventKind.Resize, w as i32, h as i32, 0));
            }
            return;
        }
        if (kind == 33) {
            // ClientMessage: WM_DELETE_WINDOW is the user closing the window
            if (Get32(e, 8) == this.ProtocolsAtom && Get32(e, 12) == this.DeleteAtom) {
                this.Queue.Push(Event.Of(EventKind.Close, 0, 0, 0));
            }
            return;
        }
        if (kind == 29) {
            // SelectionClear: another program copied
            if (Get32(e, 12) == this.ClipAtom) this.Owning = false;
            return;
        }
        if (kind == 30) {
            this.AnswerSelection(e);
            return;
        }
        if (kind == 31) {
            // SelectionNotify: what we asked to paste is ready (or not)
            if (Get32(e, 8) == this.ClipWin) {
                this.Notified = true;
                this.NotifiedProp = Get32(e, 20);
            }
            return;
        }
        if (kind == 34) {
            // MappingNotify: the keyboard changed
            this.LoadKeyboard();
        }
    }

    // The keysym keycode means with modifiers state: the shifted one with Shift, Caps
    // Lock giving capitals.
    u32 KeySym(in this, u8 keycode, u32 state) {
        if (keycode < this.MinKey || keycode > this.MaxKey || this.PerKey == 0) return 0;
        usize at = (keycode - this.MinKey) as usize * this.PerKey as usize;
        if (at >= this.Syms.Len()) return 0;
        u32 plain = this.Syms.Get(at);
        u32 shifted = 0;
        if (this.PerKey > 1 && at + 1 < this.Syms.Len()) shifted = this.Syms.Get(at + 1);
        bool shift = state & 0x1 != 0;
        bool lower = plain >= 'a' as u32 && plain <= 'z' as u32;
        if (state & 0x2 != 0 && lower) shift = !shift;
        if (shift) {
            if (shifted != 0) return shifted;
            if (lower) return plain - 32;
        }
        return plain;
    }
}

void PushAtom(ref List<u8> b, u32 a) {
    b.Push(a as u8);
    b.Push((a >> 8) as u8);
    b.Push((a >> 16) as u8);
    b.Push((a >> 24) as u8);
}

// The port's modifiers from an X state mask.
u32 Mods(u32 state) {
    u32 m = 0;
    if (state & 0x1 != 0) m |= ports.MOD_SHIFT;
    if (state & 0x4 != 0) m |= ports.MOD_CTRL;
    if (state & 0x8 != 0) m |= ports.MOD_ALT;
    if (state & 0x40 != 0) m |= ports.MOD_META;
    return m;
}

// The port's key code (KEY_*) for a keysym, or 0.
u32 KeyCode(u32 sym) {
    if (sym >= 'a' as u32 && sym <= 'z' as u32) return ports.KEY_A + sym - 'a' as u32;
    if (sym >= 'A' as u32 && sym <= 'Z' as u32) return ports.KEY_A + sym - 'A' as u32;
    if (sym >= '0' as u32 && sym <= '9' as u32) return ports.KEY_0 + sym - '0' as u32;
    if (sym == ' ' as u32) return ports.KEY_SPACE;
    if (sym == '=' as u32 || sym == '+' as u32) return ports.KEY_EQUAL;
    if (sym == ',' as u32 || sym == '<' as u32) return ports.KEY_COMMA;
    if (sym == '-' as u32 || sym == '_' as u32) return ports.KEY_MINUS;
    if (sym == '.' as u32 || sym == '>' as u32) return ports.KEY_PERIOD;
    if (sym == '/' as u32 || sym == '?' as u32) return ports.KEY_SLASH;
    if (sym >= 0xFFBE && sym <= 0xFFC9) return ports.KEY_F1 + sym - 0xFFBE;
    if (sym == 0xFF08) return ports.KEY_BACKSPACE;
    if (sym == 0xFF09 || sym == 0xFE20) return ports.KEY_TAB;          // Tab, ISO_Left_Tab
    if (sym == 0xFF0D || sym == 0xFF8D) return ports.KEY_ENTER;        // Return, KP_Enter
    if (sym == 0xFF1B) return ports.KEY_ESCAPE;
    if (sym == 0xFF50) return ports.KEY_HOME;
    if (sym == 0xFF51) return ports.KEY_LEFT;
    if (sym == 0xFF52) return ports.KEY_UP;
    if (sym == 0xFF53) return ports.KEY_RIGHT;
    if (sym == 0xFF54) return ports.KEY_DOWN;
    if (sym == 0xFF55) return ports.KEY_PAGE_UP;
    if (sym == 0xFF56) return ports.KEY_PAGE_DOWN;
    if (sym == 0xFF57) return ports.KEY_END;
    if (sym == 0xFF63) return ports.KEY_INSERT;
    if (sym == 0xFFFF) return ports.KEY_DELETE;
    if (sym == 0xFFE1 || sym == 0xFFE2) return ports.KEY_SHIFT;
    if (sym == 0xFFE3 || sym == 0xFFE4) return ports.KEY_CONTROL;
    if (sym == 0xFFE9 || sym == 0xFFEA) return ports.KEY_ALT;
    return 0;
}

// The character a keysym types (a code point), or 0.
u32 CharOf(u32 sym) {
    if ((sym >= 0x20 && sym <= 0x7E) || (sym >= 0xA0 && sym <= 0xFF)) return sym;
    if (sym >= 0x01000100 && sym <= 0x0110FFFF) return sym - 0x01000000;
    return 0;
}
