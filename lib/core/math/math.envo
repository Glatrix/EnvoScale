// core.math: integer helpers. Arithmetic that can overflow panics, as Envo's operators
// do; functions say when they cannot overflow. Floats are not in Envo-S1 yet, so neither
// are their functions.
namespace core.math;

public i64 Min(i64 a, i64 b) {
    if (a < b) return a;
    return b;
}

public i64 Max(i64 a, i64 b) {
    if (a > b) return a;
    return b;
}

public i64 Clamp(i64 v, i64 lo, i64 hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

public u64 MinU(u64 a, u64 b) {
    if (a < b) return a;
    return b;
}

public u64 MaxU(u64 a, u64 b) {
    if (a > b) return a;
    return b;
}

public u64 ClampU(u64 v, u64 lo, u64 hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

// |v|, which fits in a u64 for every i64 (no overflow).
public u64 Abs(i64 v) {
    if (v >= 0) return v as u64;
    return 0 -% (v as u64);
}

// base to the power exp; panics on overflow.
public u64 Pow(u64 radix, u32 exp) {
    u64 r = 1;
    u64 b = radix;
    u32 e = exp;
    while (e > 0) {
        if (e & 1 != 0) r = r * b;
        e = e >> 1;
        if (e > 0) b = b * b;
    }
    return r;
}

// a / b rounded up; b must not be 0.
public u64 DivCeil(u64 a, u64 b) {
    u64 q = a / b;
    if (a % b != 0) q += 1;
    return q;
}

public bool IsPowerOfTwo(u64 v) => v != 0 && v & (v - 1) == 0;

// The smallest power of two >= v (1 for 0); panics past 2^63.
public u64 NextPowerOfTwo(u64 v) {
    u64 p = 1;
    while (p < v) p = p * 2;
    return p;
}

// floor(log2(v)); v must not be 0.
public u32 Log2(u64 v) {
    if (v == 0) panic("core.math: Log2 of 0");
    u32 n = 0;
    while (v > 1) {
        v = v >> 1;
        n++;
    }
    return n;
}

public u64 Gcd(u64 a, u64 b) {
    while (b != 0) {
        u64 t = a % b;
        a = b;
        b = t;
    }
    return a;
}
