// std.env: what the program was started with. The simple door uses the platform's
// environment; the full-control door (…From) takes any IEnvironment.
namespace std.env;

use ports.{IEnvironment};
use platform;

// The number of command-line arguments, the program's own name included.
public usize ArgCount() {
    var e = platform.Environment();
    return e.ArgCount();
}

// Argument i (0 is the program); panics if i is not below ArgCount.
public str Arg(usize i) {
    var e = platform.Environment();
    if (i >= e.ArgCount()) panic("std.env: no such argument");
    return e.Arg(i);
}

// The value of the environment variable name, if it is set.
public string? Var(str name) {
    var e = platform.Environment();
    return e.Var(name);
}

// The working directory, as an absolute path.
public string CurrentDir() {
    var e = platform.Environment();
    return e.CurrentDir();
}

// The arguments after the program's name.
public List<str> Args() {
    var e = platform.Environment();
    return ArgsFrom(ref e);
}

public List<str> ArgsFrom<E>(ref E env) where E : IEnvironment {
    List<str> all = List<str>.New();
    for (usize i = 1; i < env.ArgCount(); i++) all.Push(env.Arg(i));
    return all;
}
