// ports: the interfaces through which lib/ reaches the outside world (PLAN D22, D24;
// docs/architecture/library.md). An adapter is a type that implements a port; the
// reference adapters are in adapters/os/none, the native ones in adapters/os/windows and
// adapters/os/linux. Each port's promises are checked by its conformance suite in
// tests/conformance/, against every adapter.
//
// Methods take `ref this`: an adapter may keep state (a captured console, an in-memory
// file system, a manual clock).
namespace ports;

// Why an operation on the outside world failed.
public enum IoError {
    NotFound,       // no such file or directory
    Exists,         // it is already there
    NotEmpty,       // a directory that still has entries
    Denied,         // not allowed
    Invalid,        // a path or argument the adapter cannot accept
    Other,          // anything else the system reported
    Refused,        // a connection was refused: nothing listens there
}

// Standard output, standard error and standard input.
public interface IConsole {
    void Out(ref this, str text);
    void Err(ref this, str text);
    // Reads up to into.Len bytes of standard input; 0 at its end.
    usize Read(ref this, mut u8[] into);
}

// Files and directories, named by paths with `/` between their parts (adapters accept
// `\` too where the system does). A path is relative to the program's working directory
// unless it is absolute.
public interface IFileSystem {
    // The whole content of the file at path.
    Result<string, IoError> Read(ref this, str path);
    // Replaces the file at path with data, creating it if needed; its directory must
    // exist. Returns the number of bytes written.
    Result<usize, IoError> Write(ref this, str path, str data);
    // Is there a file (not a directory) at path?
    bool IsFile(ref this, str path);
    // Is there a directory at path?
    bool IsDir(ref this, str path);
    // Removes the file at path.
    Result<bool, IoError> Delete(ref this, str path);
    // Creates the directory path; its parent must exist. Exists if it is already there.
    Result<bool, IoError> CreateDir(ref this, str path);
    // Removes the empty directory path.
    Result<bool, IoError> RemoveDir(ref this, str path);
    // The names of the entries in the directory path (files and directories, without "."
    // and ".."), in byte order. Invalid if path is a file.
    Result<List<string>, IoError> List(ref this, str path);
}

// Time.
public interface IClock {
    // The wall clock: nanoseconds since 1970-01-01 00:00 UTC. It can jump.
    i64 NowNanos(ref this);
    // A clock that never goes back: nanoseconds since an arbitrary start.
    u64 MonoNanos(ref this);
}

// Random bytes.
public interface IEntropy {
    // Fills into with random bytes. A native adapter uses the system's generator, which
    // is fit for keys; the reference adapter is deterministic, for tests only.
    void Fill(ref this, mut u8[] into);
}

// What the program was started with.
public interface IEnvironment {
    // The number of command-line arguments, the program's own name included.
    usize ArgCount(ref this);
    // Argument i (0 is the program); i must be below ArgCount.
    str Arg(ref this, usize i);
    // The value of the environment variable name, if it is set.
    string? Var(ref this, str name);
    // The working directory, as an absolute path.
    string CurrentDir(ref this);
}

// Running other programs.
public interface IProcess {
    // Runs program with args (the program's own name is not one of them), waits for it to
    // end and gives its exit code; on Linux a program ended by signal n gives 128 + n.
    // program is a path, or a name looked up on PATH as the system does. The program
    // runs in the directory workDir ("" for this program's). When outPath is not "", the
    // program's standard output replaces that file's content; errPath does the same for
    // standard error, and when the two are equal both streams go to the one file.
    // program, outPath and errPath are relative to this program's working directory, not
    // workDir. Standard input, and any stream not sent to a file, is this program's.
    // NotFound if there is no such program, no directory workDir, or a file's directory
    // does not exist.
    Result<i32, IoError> Run(ref this, str program, str[] args, str workDir, str outPath, str errPath);
}

// TCP over IPv4 and name lookup (PLAN D40). Handles are opaque numbers the adapter gives.
// IPv6 and UDP come later.
public interface INet {
    // The IPv4 addresses of host, as text ("127.0.0.1"): a numeric address is itself,
    // "localhost" is 127.0.0.1, and other names are looked up as the system does.
    // NotFound if there is none.
    Result<List<string>, IoError> Resolve(ref this, str host);
    // A TCP connection to host and port. Refused if nothing listens there.
    Result<i64, IoError> Connect(ref this, str host, u16 port);
    // A listening socket on host's address and port (port 0: the system picks one).
    Result<i64, IoError> Listen(ref this, str host, u16 port);
    // The port a listening socket is bound to.
    u16 LocalPort(ref this, i64 listener);
    // The next connection to a listening socket, waiting for one.
    Result<i64, IoError> Accept(ref this, i64 listener);
    // Sends all of data.
    Result<usize, IoError> Send(ref this, i64 conn, u8[] data);
    // Receives up to into.Len bytes, waiting for some; 0 when the other side has closed.
    Result<usize, IoError> Recv(ref this, i64 conn, mut u8[] into);
    // Closes a connection or listening socket.
    void Close(ref this, i64 handle);
}

// The certificates the system trusts as roots, for TLS (PLAN D41).
public interface ITrust {
    // The DER of each trusted root certificate.
    List<List<u8>> Roots(ref this);
}

// The terminal a program runs in (PLAN D43): its size, raw input and VT output. Output is
// UTF-8 with VT escape sequences (colors, cursor moves), which every supported terminal
// understands once the adapter has switched them on. Input arrives as bytes, keys as the
// VT sequences terminals send (envo.term decodes them).
public interface ITerminal {
    // Is standard output a terminal (not a file or a pipe)?
    bool IsTerminal(ref this);
    // The window's width in cells; 80 when it cannot be told.
    u32 Cols(ref this);
    // The window's height in cells; 24 when it cannot be told.
    u32 Rows(ref this);
    // Raw mode on (true): input comes a key at a time, not echoed, Ctrl+C included. Off
    // (false) gives back the mode found. False if this is not a terminal.
    bool Raw(ref this, bool on);
    // Writes text (UTF-8, VT sequences included).
    void Write(ref this, str text);
    // Up to into.Len bytes of input, waiting at most waitMs milliseconds for the first
    // (negative: as long as it takes); 0 if none came.
    usize Read(ref this, mut u8[] into, i32 waitMs);
}
