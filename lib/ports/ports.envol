// ports: the interfaces through which lib/ reaches the outside world (PLAN D22, D24;
// EnvoScale/architecture/library.md). An adapter is a type that implements a port; the
// reference adapters are in adapters/os/none, the native ones in adapters/os/windows and
// adapters/os/linux. Each port's promises are checked by its conformance suite in
// tests/conformance/, against every adapter.
//
// Methods take `ref this`: an adapter may keep state (a captured console, an in-memory
// file system, a manual clock).
namespace ports;

// Why an operation on the outside world failed.
public enum IoError {
    NotFound,       // no such file or directory
    Exists,         // it is already there
    NotEmpty,       // a directory that still has entries
    Denied,         // not allowed
    Invalid,        // a path or argument the adapter cannot accept
    Other,          // anything else the system reported
    Refused,        // a connection was refused: nothing listens there
}

// Standard output, standard error and standard input.
public interface IConsole {
    void Out(ref this, str text);
    void Err(ref this, str text);
    // Reads up to into.Len bytes of standard input; 0 at its end.
    usize Read(ref this, mut u8[] into);
}

// Files and directories, named by paths with `/` between their parts (adapters accept
// `\` too where the system does). A path is relative to the program's working directory
// unless it is absolute.
public interface IFileSystem {
    // The whole content of the file at path.
    Result<string, IoError> Read(ref this, str path);
    // Replaces the file at path with data, creating it if needed; its directory must
    // exist. Returns the number of bytes written.
    Result<usize, IoError> Write(ref this, str path, str data);
    // Is there a file (not a directory) at path?
    bool IsFile(ref this, str path);
    // Is there a directory at path?
    bool IsDir(ref this, str path);
    // Removes the file at path.
    Result<bool, IoError> Delete(ref this, str path);
    // Creates the directory path; its parent must exist. Exists if it is already there.
    Result<bool, IoError> CreateDir(ref this, str path);
    // Removes the empty directory path.
    Result<bool, IoError> RemoveDir(ref this, str path);
    // The names of the entries in the directory path (files and directories, without "."
    // and ".."), in byte order. Invalid if path is a file.
    Result<List<string>, IoError> List(ref this, str path);
}

// Time.
public interface IClock {
    // The wall clock: nanoseconds since 1970-01-01 00:00 UTC. It can jump.
    i64 NowNanos(ref this);
    // A clock that never goes back: nanoseconds since an arbitrary start.
    u64 MonoNanos(ref this);
}

// Random bytes.
public interface IEntropy {
    // Fills into with random bytes. A native adapter uses the system's generator, which
    // is fit for keys; the reference adapter is deterministic, for tests only.
    void Fill(ref this, mut u8[] into);
}

// What the program was started with.
public interface IEnvironment {
    // The number of command-line arguments, the program's own name included.
    usize ArgCount(ref this);
    // Argument i (0 is the program); i must be below ArgCount.
    str Arg(ref this, usize i);
    // The value of the environment variable name, if it is set.
    string? Var(ref this, str name);
    // The working directory, as an absolute path.
    string CurrentDir(ref this);
}

// Running other programs.
public interface IProcess {
    // Runs program with args (the program's own name is not one of them), waits for it to
    // end and gives its exit code; on Linux a program ended by signal n gives 128 + n.
    // program is a path, or a name looked up on PATH as the system does. The program
    // runs in the directory workDir ("" for this program's). When outPath is not "", the
    // program's standard output replaces that file's content; errPath does the same for
    // standard error, and when the two are equal both streams go to the one file.
    // program, outPath and errPath are relative to this program's working directory, not
    // workDir. Standard input, and any stream not sent to a file, is this program's.
    // NotFound if there is no such program, no directory workDir, or a file's directory
    // does not exist.
    Result<i32, IoError> Run(ref this, str program, str[] args, str workDir, str outPath, str errPath);

    // Child processes with pipes (M14.3). Spawn starts program (found as Run finds it)
    // with args in workDir ("" for this program's), its standard input, output and error
    // connected to this program by pipes, and gives the child's handle. NotFound as for
    // Run; Other on a system without processes.
    Result<u64, IoError> Spawn(ref this, str program, str[] args, str workDir);
    // Writes all of bytes to the child's standard input, waiting while the pipe is full.
    // Other once the child has stopped reading.
    Result<usize, IoError> Send(ref this, u64 child, u8[] bytes);
    // Ends the child's standard input: it reads the end of its input.
    void EndInput(ref this, u64 child);
    // What the child wrote to stream (1 its output, 2 its error) without waiting: up to
    // into.Len bytes; 0 when nothing is waiting; -1 once the stream has ended and all of
    // it has been read.
    isize Receive(ref this, u64 child, u32 stream, mut u8[] into);
    // The child's exit code once it has ended, without waiting (on Linux a child ended by
    // signal n gives 128 + n); None while it runs.
    i32? Exited(ref this, u64 child);
    // Ends the child at once.
    void Kill(ref this, u64 child);
    // Forgets the child and closes what is left of its pipes. Call it once the child has
    // ended; the handle is not valid after.
    void Release(ref this, u64 child);
}

// TCP over IPv4 and name lookup (PLAN D40). Handles are opaque numbers the adapter gives.
// IPv6 and UDP come later.
public interface INet {
    // The IPv4 addresses of host, as text ("127.0.0.1"): a numeric address is itself,
    // "localhost" is 127.0.0.1, and other names are looked up as the system does.
    // NotFound if there is none.
    Result<List<string>, IoError> Resolve(ref this, str host);
    // A TCP connection to host and port. Refused if nothing listens there.
    Result<i64, IoError> Connect(ref this, str host, u16 port);
    // A listening socket on host's address and port (port 0: the system picks one).
    Result<i64, IoError> Listen(ref this, str host, u16 port);
    // The port a listening socket is bound to.
    u16 LocalPort(ref this, i64 listener);
    // The next connection to a listening socket, waiting for one.
    Result<i64, IoError> Accept(ref this, i64 listener);
    // Sends all of data.
    Result<usize, IoError> Send(ref this, i64 conn, u8[] data);
    // Receives up to into.Len bytes, waiting for some; 0 when the other side has closed.
    Result<usize, IoError> Recv(ref this, i64 conn, mut u8[] into);
    // Closes a connection or listening socket.
    void Close(ref this, i64 handle);
}

// The certificates the system trusts as roots, for TLS (PLAN D41).
public interface ITrust {
    // The DER of each trusted root certificate.
    List<List<u8>> Roots(ref this);
}

// The terminal a program runs in (PLAN D43): its size, raw input and VT output. Output is
// UTF-8 with VT escape sequences (colors, cursor moves), which every supported terminal
// understands once the adapter has switched them on. Input arrives as bytes, keys as the
// VT sequences terminals send (envo.term decodes them).
public interface ITerminal {
    // Is standard output a terminal (not a file or a pipe)?
    bool IsTerminal(ref this);
    // The window's width in cells; 80 when it cannot be told.
    u32 Cols(ref this);
    // The window's height in cells; 24 when it cannot be told.
    u32 Rows(ref this);
    // Raw mode on (true): input comes a key at a time, not echoed, Ctrl+C included. Off
    // (false) gives back the mode found. False if this is not a terminal.
    bool Raw(ref this, bool on);
    // Writes text (UTF-8, VT sequences included).
    void Write(ref this, str text);
    // Up to into.Len bytes of input, waiting at most waitMs milliseconds for the first
    // (negative: as long as it takes); 0 if none came.
    usize Read(ref this, mut u8[] into, i32 waitMs);
}

// Key codes (PLAN D73): EnvoScale's own, the same on every system; adapters translate
// the system's codes to them. Letters are their capital ASCII, digits theirs; the numbers
// match Win32's virtual keys by design, so that adapter passes them through.
public const u32 KEY_BACKSPACE = 8;
public const u32 KEY_TAB = 9;
public const u32 KEY_ENTER = 13;
public const u32 KEY_SHIFT = 16;
public const u32 KEY_CONTROL = 17;
public const u32 KEY_ALT = 18;
public const u32 KEY_ESCAPE = 27;
public const u32 KEY_SPACE = 32;
public const u32 KEY_PAGE_UP = 33;
public const u32 KEY_PAGE_DOWN = 34;
public const u32 KEY_END = 35;
public const u32 KEY_HOME = 36;
public const u32 KEY_LEFT = 37;
public const u32 KEY_UP = 38;
public const u32 KEY_RIGHT = 39;
public const u32 KEY_DOWN = 40;
public const u32 KEY_INSERT = 45;
public const u32 KEY_DELETE = 46;
public const u32 KEY_0 = 48;           // to KEY_0 + 9
public const u32 KEY_A = 65;           // to KEY_A + 25
public const u32 KEY_F1 = 112;         // to KEY_F1 + 11

// Modifier keys held during an event (Event.Mods).
public const u32 MOD_SHIFT = 1;
public const u32 MOD_CTRL = 2;
public const u32 MOD_ALT = 4;
public const u32 MOD_META = 8;         // the Windows key; Command on a Mac

// What happened to a window.
public enum EventKind {
    None,           // nothing waiting
    Close,          // the window was closed
    Resize,         // the drawable area has a new size: Width, Height
    KeyDown,        // a key went down (or repeats): Code is the key (KEY_*)
    KeyUp,          // a key went up: Code
    Char,           // a character was typed: Code is its code point
    MouseMove,      // the pointer moved: X, Y
    MouseDown,      // a button went down: Code (1 left, 2 right, 3 middle), X, Y
    MouseUp,        // a button went up: Code, X, Y
    Wheel,          // the wheel turned: Code is the distance (120 a notch, up positive, as two's complement)
}

// One window event. Positions are pixels from the top left of the drawable area; Mods
// are the modifier keys held (MOD_*) for keys, characters and the mouse.
public struct Event {
    EventKind K;
    i32 PX;
    i32 PY;
    u32 C;
    u32 M;

    public static Event Of(EventKind k, i32 x, i32 y, u32 code) => new Event { K = k, PX = x, PY = y, C = code, M = 0 };
    public static Event Nothing() => new Event { K = EventKind.None, PX = 0, PY = 0, C = 0, M = 0 };

    // The same event with modifier keys mods.
    public Event WithMods(in this, u32 mods) => new Event { K = this.K, PX = this.PX, PY = this.PY, C = this.C, M = mods };

    public EventKind Kind(in this) => this.K;
    public i32 X(in this) => this.PX;
    public i32 Y(in this) => this.PY;
    public u32 Code(in this) => this.C;
    // The wheel's distance, signed.
    public i32 Delta(in this) => this.C as i32;
    public bool Is(in this, EventKind k) => this.K == k;
    public u32 Mods(in this) => this.M;
    public bool Shift(in this) => this.M & MOD_SHIFT != 0;
    public bool Ctrl(in this) => this.M & MOD_CTRL != 0;
    public bool Alt(in this) => this.M & MOD_ALT != 0;
}

// The system clipboard's text (PLAN D73). A system without one (no desktop) has an empty
// clipboard that keeps nothing.
public interface IClipboard {
    // The clipboard's text, if it holds text.
    string? Text(ref this);
    // Puts text on the clipboard; false if this system has no clipboard.
    bool SetText(ref this, str text);
}

// A window on the desktop (PLAN D45): a title, a drawable area of pixels, and events.
// The program draws into memory (envo.gfx) and presents whole frames.
public interface IWindow {
    // Opens the window with a drawable area of width x height pixels (a system may make
    // a small window larger: Width and Height tell). False if this system cannot open
    // one (no desktop, or windows not supported yet).
    bool Open(ref this, str title, u32 width, u32 height);
    // Is the window open (opened and not yet closed, by the program or the user)?
    bool IsOpen(ref this);
    // The drawable area's size in pixels.
    u32 Width(ref this);
    u32 Height(ref this);
    // The next event, without waiting; EventKind.None when there is none.
    Event Poll(ref this);
    // Shows a frame: width x height pixels, RGBA, rows from the top.
    void Present(ref this, u8[] rgba, u32 width, u32 height);
    void SetTitle(ref this, str title);
    // Closes the window.
    void Close(ref this);
}

// A triangle corner for the GPU port: a position in pixels from the top left (corners
// of pixels, so a pixel's centre is at +0.5) and a color, 0xRRGGBBAA, blended across the
// triangle.
public struct Vertex {
    i32 X;
    i32 Y;
    u32 Rgba;

    public static Vertex At(i32 x, i32 y, u32 rgba) => new Vertex { X = x, Y = y, Rgba = rgba };
}

// A device that draws (PLAN D46): frames of colored triangles, rendered off-screen and
// read back; and computes (D61): matrix products. The software adapter (envo.gpu) and the GPU adapters (D3D12, Vulkan) draw
// the same frames; a window presents them.
public interface IGpu {
    // Which adapter and device this is: "software", or the API and the GPU's name.
    string Name(ref this);
    // Starts a frame of width x height pixels, cleared to clearRgba. False if the
    // device cannot.
    bool Begin(ref this, u32 width, u32 height, u32 clearRgba);
    // Draws triangles: every three vertices make one; pixels whose centres lie inside
    // (the top-left rule decides edges) take the colors blended across it, alpha-blended
    // over the frame.
    void Triangles(ref this, Vertex[] vertices);
    // Finishes the frame: its pixels, RGBA, rows from the top.
    List<u8> End(ref this);
    // Computes a × b for a (m × k) and b (k × n), row-major f32, into into (m × n values,
    // replacing what it held): the first compute kernel (PLAN D61). A GPU may round
    // differently from the CPU (fused multiply-add, another order of sums); results agree
    // to a relative 1e-4. False, and into unchanged, if the sizes do not match.
    bool MatMul(ref this, f32[] a, f32[] b, u32 m, u32 k, u32 n, ref List<f32> into);
}
