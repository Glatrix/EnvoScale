// envo.crypto.curve25519 in both modes: one X25519 vector (RFC 7748 section 5.2, test 1),
// small enough for the script runtime; curve25519.envo has the full set.
// expect: x25519 t1 ok
use envo.crypto.curve25519;
use alloc.text;

u8 Nib(u8 c) {
    if (c >= 'a') return c - 'a' + 10;
    return c - '0';
}

List<u8> FromHex(str h) {
    List<u8> b = List<u8>.New();
    for (usize i = 0; i + 1 < h.Len; i += 2) b.Push(Nib(h[i]) * 16 + Nib(h[i + 1]));
    return b;
}

string ToHex(u8[] b) {
    string s = string.New();
    for (usize i = 0; i < b.Len; i++) s.Append(text.Hex(b[i] as u64, 2).AsStr());
    return s;
}

void Check(str name, u8[] got, str want) {
    write(1, name);
    if (ToHex(got).Equals(want)) print(" ok");
    else {
        write(1, " got ");
        print(ToHex(got).AsStr());
    }
}

void X(str name, str k, str u, str want) {
    List<u8> kb = FromHex(k);
    List<u8> ub = FromHex(u);
    u8[32] out32;
    curve25519.X25519(kb.AsSlice(), ub.AsSlice(), out32[0..32]);
    Check(name, out32[0..32], want);
}

X("x25519 t1", "a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4", "e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c", "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552");
