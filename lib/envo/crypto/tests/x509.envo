// envo.crypto.x509: a test CA (P-256, made with OpenSSL for this test) and a server
// certificate it signed (RSA-2048, for localhost, *.envo.test and 127.0.0.1): fields, host
// names, and chain verification against the CA, a wrong host, an untrusted chain and a
// time outside the validity.
// expect: leaf localhost by Envo Test CA, ca false
// expect: names localhost *.envo.test
// expect: ca Envo Test CA, ca true
// expect: hosts ok
// expect: chain ok
// expect: wrong host: the certificate is for localhost, not example.com
// expect: untrusted: the certificate does not chain to a trusted root
// expect: expired: a certificate in the chain has expired or is not valid yet
// expect: pem 1
// vm: skip (about a minute in the script runtime: big-number arithmetic)
use envo.crypto.x509;

u8 Nib(u8 c) {
    if (c >= 'a') return c - 'a' + 10;
    return c - '0';
}

List<u8> FromHex(str h) {
    List<u8> b = List<u8>.New();
    for (usize i = 0; i + 1 < h.Len; i += 2) b.Push(Nib(h[i]) * 16 + Nib(h[i + 1]));
    return b;
}

List<u8> leafDer = FromHex("");
List<u8> caDer = FromHex("");
x509.Certificate leaf;
x509.Certificate ca;
if (!x509.Parse(leafDer.AsSlice(), ref leaf) || !x509.Parse(caDer.AsSlice(), ref ca)) print("parse failed");
write(1, "leaf ");
write(1, leaf.Name());
write(1, " by ");
write(1, ca.Name());
if (leaf.Authority()) print(", ca true");
else print(", ca false");
write(1, "names ");
write(1, leaf.DnsName(0));
write(1, " ");
print(leaf.DnsName(1));
write(1, "ca ");
write(1, ca.Name());
if (ca.Authority()) print(", ca true");
else print(", ca false");
if (x509.MatchesHost(leaf, "LocalHost") && x509.MatchesHost(leaf, "a.envo.test") && !x509.MatchesHost(leaf, "a.b.envo.test") && x509.MatchesHost(leaf, "127.0.0.1") && !x509.MatchesHost(leaf, "envo.test")) print("hosts ok");
List<x509.Certificate> chain = List<x509.Certificate>.New();
chain.Push(leaf);
List<x509.Certificate> trust = List<x509.Certificate>.New();
trust.Push(ca);
string why = x509.VerifyChain(chain, trust, "localhost", "20300101000000");
if (why.Len() == 0) print("chain ok");
else print(why.AsStr());
write(1, "wrong host: ");
print(x509.VerifyChain(chain, trust, "example.com", "20300101000000").AsStr());
List<x509.Certificate> none = List<x509.Certificate>.New();
write(1, "untrusted: ");
print(x509.VerifyChain(chain, none, "localhost", "20300101000000").AsStr());
write(1, "expired: ");
print(x509.VerifyChain(chain, trust, "localhost", "20500101000000").AsStr());
string pem = string.From("-----BEGIN CERTIFICATE-----");
pem.AppendByte(10);
pem.Append("MAA=");
pem.AppendByte(10);
pem.Append("-----END CERTIFICATE-----");
pem.AppendByte(10);
List<List<u8>> blocks = x509.FromPem(pem.AsStr());
write(1, "pem ");
if (blocks.Len() == 1 && blocks.AsSlice()[0].Len() == 2) print("1");
