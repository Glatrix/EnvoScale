// envo.crypto.rsa and ecdsa: signatures made by OpenSSL 1.1.1 with throwaway test keys
// (tests/vectors/README.md): RSA-2048 with PKCS #1 v1.5 and PSS (SHA-256), ECDSA on P-256
// (SHA-256) and P-384 (SHA-384). Each must verify, and fail for a changed message.
// expect: pkcs1 ok
// expect: pss ok
// expect: rsa tampered rejected
// expect: prime256v1 ok, tampered rejected
// expect: secp384r1 ok, tampered rejected
// vm: skip (about a minute in the script runtime: big-number arithmetic)
use envo.crypto.rsa;
use envo.crypto.ecdsa;

u8 Nib(u8 c) {
    if (c >= 'a') return c - 'a' + 10;
    return c - '0';
}

List<u8> FromHex(str h) {
    List<u8> b = List<u8>.New();
    for (usize i = 0; i + 1 < h.Len; i += 2) b.Push(Nib(h[i]) * 16 + Nib(h[i + 1]));
    return b;
}

List<u8> n = FromHex("");
List<u8> s1 = FromHex("");
List<u8> sp = FromHex("");
str msg = "envo signs this";
List<u8> m = List<u8>.New();
for (usize i = 0; i < msg.Len; i++) m.Push(msg[i]);
rsa.PublicKey key = rsa.PublicKey.New(n.AsSlice(), 65537);
if (rsa.VerifyPkcs1Sha256(key, m.AsSlice(), s1.AsSlice())) print("pkcs1 ok");
if (rsa.VerifyPssSha256(key, m.AsSlice(), sp.AsSlice())) print("pss ok");
m.Set(0, 'E');
if (!rsa.VerifyPkcs1Sha256(key, m.AsSlice(), s1.AsSlice()) && !rsa.VerifyPssSha256(key, m.AsSlice(), sp.AsSlice())) print("rsa tampered rejected");

void Check(in ecdsa.Curve c, str name, str qx, str qy, str dig, str sig) {
    List<u8> x = FromHex(qx);
    List<u8> y = FromHex(qy);
    List<u8> d = FromHex(dig);
    List<u8> der = FromHex(sig);
    List<u8> r = List<u8>.New();
    List<u8> s = List<u8>.New();
    if (!ecdsa.SplitDer(der.AsSlice(), ref r, ref s)) {
        print("bad der");
        return;
    }
    write(1, name);
    if (ecdsa.Verify(c, x.AsSlice(), y.AsSlice(), d.AsSlice(), r.AsSlice(), s.AsSlice())) write(1, " ok");
    else write(1, " FAILED");
    d.Set(0, d.Get(0) ^ 1);
    if (!ecdsa.Verify(c, x.AsSlice(), y.AsSlice(), d.AsSlice(), r.AsSlice(), s.AsSlice())) print(", tampered rejected");
    else print(", tampered ACCEPTED");
}

Check(ecdsa.Curve.P256(), "prime256v1", "ecd9f28479d2ecf6815cb9811dbfb4e13d7f7a0d31278184a7c43679f034994c", "d720dd17d5f41d9dfa6a8645bea1dc0a37f1ce5c8325bfb5bc4219781709727c", "a6a6d5b58f5146c7074f7700a3818f8ed5f92ccfc2aef02bc9234d6bff7f44f6", "3044022053c4d1b4d0445e5a447a3a882aa6b497b49dd6a60191e31ea148b69e904a0dae02207bb977e983dbc8ca177b3e8079844e237702180690ad1d2bcdc0486f831111d0");
Check(ecdsa.Curve.P384(), "secp384r1", "1bb07031a295967dfaa4ddfa62bf41117fae274af8c98a52ac6388dcb5bb8795203e6148d5a4f80fe5fd8a6f70fb8684", "e2684ecb0957824c4b948e308075ec9f30450b0e1b21e66680090d081950af16b912f37e3b516eb285d8bdb9c4d82299", "bab7524d003fa26981916ef9af92b0282d5560cacddfbf28548c4f5ced76326434fe766fd1bfbdffa78ea06cc3349f9c", "3066023100a750196fbd150068ce359d54593efff329d9b9d794f8b0e28e8fdb87570f78ee5eb10faaf42d903cd92acc5ea71357ee023100c7c3321f19bdf0ad5be62801931da222ca1038c0a5852e707c97cead309745e23f2ca204a11a9b5e317e66be084605af");
