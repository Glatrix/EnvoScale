// envo.cli: commands, flags (long, short, inline values, switches), defaults, errors,
// generated help, tables and progress bars.
// expect: greet name=EnvoL verbose arg=3
// expect: default name=World
// expect: unknown flag '--nope'
// expect: unknown command 'dance'
// expect: usage: tool <command> [flags]
// expect:
// expect: Does things.
// expect:
// expect: commands:
// expect:   greet  say hello
// expect:   count  count to a number
// expect:
// expect: flags:
// expect:   -v, --verbose  say more
// expect:   -h, --help     this help
// expect: usage: tool greet [flags] <times>
// expect:
// expect: Does things.
// expect:
// expect: flags:
// expect:   -v, --verbose       say more
// expect:   -n, --name <value>  who to greet (default: World)
// expect:   -h, --help          this help
// expect: name        size  kind
// expect: ------------------------
// expect: main.envol  1200  source
// expect: é           7     text
// expect: [#####.....]  50%
// expect: [####] 100%
use envo.cli;

cli.App app = cli.App.New("tool", "Does things.");
app.Switch("verbose", 'v', "say more");
app.Command("greet", "say hello");
app.CommandFlag("greet", "name", 'n', "who to greet", "World");
app.CommandArg("greet", "times");
app.Command("count", "count to a number");
List<str> a1 = List<str>.New();
a1.Push("greet");
a1.Push("--name=EnvoL");
a1.Push("-v");
a1.Push("3");
cli.Parsed p = app.Parse(a1.AsSlice());
write(1, p.CommandName());
write(1, " name=");
write(1, p.Value("name"));
if (p.On("verbose")) write(1, " verbose");
write(1, " arg=");
print(p.Arg(0));
List<str> a2 = List<str>.New();
a2.Push("greet");
cli.Parsed q = app.Parse(a2.AsSlice());
write(1, "default name=");
print(q.Value("name"));
List<str> a3 = List<str>.New();
a3.Push("greet");
a3.Push("--nope");
print(app.Parse(a3.AsSlice()).ErrorText());
List<str> a4 = List<str>.New();
a4.Push("dance");
print(app.Parse(a4.AsSlice()).ErrorText());
write(1, app.Help("").AsStr());
write(1, app.Help("greet").AsStr());
cli.Table t = cli.Table.New();
t.Row("name|size|kind");
t.Row("main.envol|1200|source");
t.Row("é|7|text");
write(1, t.Render().AsStr());
print(cli.ProgressBar(5, 10, 10).AsStr());
print(cli.ProgressBar(10, 10, 4).AsStr());
