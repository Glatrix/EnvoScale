// envo.ai: tensors and automatic differentiation (M12). A Tensor is a dense row-major
// array of f32 with a shape (a matrix: rows × cols, a vector: 1 × n). A Graph records
// the operations of one forward pass, define-by-run, and Backward walks them in reverse,
// accumulating each value's gradient. All of it is IEEE arithmetic in Envol, so training
// gives the same numbers in every build and in the script runtime.
namespace envo.ai;

use core.math as cm;
use alloc.text;
use envo.ai.gguf;
use envo.ai.tokenizer;
use alloc.map.{Map};
use ports.{IGpu};

// ------------------------------------------------------------------ tensors

public struct Tensor {
    u32 R;
    u32 C;
    List<f32> D;

    public static Tensor Zeros(u32 rows, u32 cols) {
        Tensor t = new Tensor { R = rows, C = cols, D = List<f32>.New() };
        for (u32 i = 0; i < rows * cols; i++) t.D.Push(0.0);
        return t;
    }

    // rows × cols values, row by row.
    public static Tensor Of(u32 rows, u32 cols, f32[] values) {
        Tensor t = Tensor.Zeros(rows, cols);
        mut f32[] d = t.D.AsMutSlice();
        for (usize i = 0; i < values.Len && i < d.Len; i++) d[i] = values[i];
        return t;
    }

    // Uniform values in [-scale, scale) from a seeded generator: the same seed gives the
    // same tensor everywhere.
    public static Tensor Random(u32 rows, u32 cols, f32 scale, ref Rng rng) {
        Tensor t = Tensor.Zeros(rows, cols);
        mut f32[] d = t.D.AsMutSlice();
        for (usize i = 0; i < d.Len; i++) d[i] = (rng.Next() * 2.0 - 1.0) * scale;
        return t;
    }

    public u32 Rows(in this) => this.R;
    public u32 Cols(in this) => this.C;
    public f32 At(in this, u32 r, u32 c) => this.D.Get((r * this.C + c) as usize);

    public void Set(ref this, u32 r, u32 c, f32 v) {
        this.D.Set((r * this.C + c) as usize, v);
    }

    public f32[] Values(in this) => this.D.AsSlice();

    public Tensor Copy(in this) => Tensor.Of(this.R, this.C, this.D.AsSlice());

    // this × o (rows × k times k × cols).
    public Tensor MatMul(in this, in Tensor o) {
        Tensor r = Tensor.Zeros(this.R, o.C);
        f32[] a = this.D.AsSlice();
        f32[] b = o.D.AsSlice();
        mut f32[] d = r.D.AsMutSlice();
        for (u32 i = 0; i < this.R; i++) {
            for (u32 k = 0; k < this.C; k++) {
                f32 x = a[(i * this.C + k) as usize];
                if (x == 0.0) continue;
                for (u32 j = 0; j < o.C; j++) d[(i * o.C + j) as usize] += x * b[(k * o.C + j) as usize];
            }
        }
        return r;
    }

    public Tensor Transpose(in this) {
        Tensor r = Tensor.Zeros(this.C, this.R);
        f32[] a = this.D.AsSlice();
        mut f32[] d = r.D.AsMutSlice();
        for (u32 i = 0; i < this.R; i++) {
            for (u32 j = 0; j < this.C; j++) d[(j * this.R + i) as usize] = a[(i * this.C + j) as usize];
        }
        return r;
    }

    // The sum of all values.
    public f32 Sum(in this) {
        f32 s = 0.0;
        f32[] a = this.D.AsSlice();
        for (usize i = 0; i < a.Len; i++) s += a[i];
        return s;
    }

    // The column of each row's largest value.
    public u32 ArgMax(in this, u32 row) {
        u32 best = 0;
        for (u32 j = 1; j < this.C; j++) {
            if (this.At(row, j) > this.At(row, best)) best = j;
        }
        return best;
    }
}

// a × b on a device: a GPU through the IGpu port (D61), which falls back to the CPU when it
// has no GPU. GPU sums may round differently from Tensor.MatMul's (within 1e-4 relative).
public Tensor MatMulOn<G>(ref G dev, in Tensor a, in Tensor b) where G : IGpu {
    List<f32> r = List<f32>.New();
    if (!dev.MatMul(a.D.AsSlice(), b.D.AsSlice(), a.R, a.C, b.C, ref r)) panic("ai: the matrices' sizes do not match");
    return new Tensor { R = a.R, C = b.C, D = r };
}

// A small, seeded generator (xorshift64*): reproducible initial weights.
public struct Rng {
    u64 S;

    public static Rng Seeded(u64 seed) {
        u64 s = seed;
        if (s == 0) s = 0x9E3779B97F4A7C15;
        return new Rng { S = s };
    }

    // A value in [0, 1).
    public f32 Next(ref this) {
        u64 x = this.S;
        x = x ^ (x >> 12);
        x = x ^ (x << 25);
        x = x ^ (x >> 27);
        this.S = x;
        u64 r = x *% 0x2545F4914F6CDD1D;
        return ((r >> 40) as f32) / 16777216.0;
    }
}

// ------------------------------------------------------------------ automatic differentiation

const u8 OP_LEAF = 0;
const u8 OP_MATMUL = 1;
const u8 OP_ADD_ROW = 2;    // a + b broadcast over rows (b is 1 × cols): a bias
const u8 OP_RELU = 3;
const u8 OP_TANH = 4;
const u8 OP_SIGMOID = 5;
const u8 OP_MSE = 6;        // mean squared error against a constant target
const u8 OP_XENT = 7;       // softmax cross-entropy against one-hot labels (a constant)
const u8 OP_ADD = 8;        // a + b, same shapes
const u8 OP_MUL = 9;        // a * b, elementwise

struct Node {
    u8 Op;
    u32 A;
    u32 B;
}

// The operations of one forward pass; values and gradients by node id.
public struct Graph {
    List<Node> Nodes;
    List<Tensor> Vals;
    List<Tensor> Grads;
    List<Tensor> Consts;    // per node: a target or labels (OP_MSE, OP_XENT), else empty

    public static Graph New() => new Graph { Nodes = List<Node>.New(), Vals = List<Tensor>.New(), Grads = List<Tensor>.New(), Consts = List<Tensor>.New() };

    u32 Push(ref this, u8 op, u32 a, u32 b, Tensor v, Tensor k) {
        Tensor g = Tensor.Zeros(v.R, v.C);
        this.Nodes.Push(new Node { Op = op, A = a, B = b });
        this.Vals.Push(v);
        this.Grads.Push(g);
        this.Consts.Push(k);
        return (this.Nodes.Len() - 1) as u32;
    }

    // An input or a parameter: a leaf whose gradient Backward fills.
    public u32 Leaf(ref this, in Tensor t) => this.Push(OP_LEAF, 0, 0, t.Copy(), Tensor.Zeros(0, 0));

    public Tensor Value(in this, u32 id) => this.Vals.AsSlice()[id as usize].Copy();
    public Tensor Grad(in this, u32 id) => this.Grads.AsSlice()[id as usize].Copy();
    public f32 Scalar(in this, u32 id) => this.Vals.AsSlice()[id as usize].At(0, 0);

    public u32 MatMul(ref this, u32 a, u32 b) {
        Tensor[] v = this.Vals.AsSlice();
        Tensor r = v[a as usize].MatMul(v[b as usize]);
        return this.Push(OP_MATMUL, a, b, r, Tensor.Zeros(0, 0));
    }

    // a + bias (bias is 1 × cols, added to every row).
    public u32 AddRow(ref this, u32 a, u32 bias) {
        Tensor[] v = this.Vals.AsSlice();
        Tensor r = v[a as usize].Copy();
        mut f32[] d = r.D.AsMutSlice();
        f32[] b = v[bias as usize].D.AsSlice();
        for (u32 i = 0; i < r.R; i++) {
            for (u32 j = 0; j < r.C; j++) d[(i * r.C + j) as usize] += b[j as usize];
        }
        return this.Push(OP_ADD_ROW, a, bias, r, Tensor.Zeros(0, 0));
    }

    public u32 Add(ref this, u32 a, u32 b) => this.Elementwise(OP_ADD, a, b);
    public u32 Mul(ref this, u32 a, u32 b) => this.Elementwise(OP_MUL, a, b);

    u32 Elementwise(ref this, u8 op, u32 a, u32 b) {
        Tensor[] v = this.Vals.AsSlice();
        Tensor r = v[a as usize].Copy();
        mut f32[] d = r.D.AsMutSlice();
        f32[] y = v[b as usize].D.AsSlice();
        for (usize i = 0; i < d.Len && i < y.Len; i++) {
            if (op == OP_ADD) d[i] = d[i] + y[i];
            else d[i] = d[i] * y[i];
        }
        return this.Push(op, a, b, r, Tensor.Zeros(0, 0));
    }

    public u32 Relu(ref this, u32 a) => this.Unary(OP_RELU, a);
    public u32 Tanh(ref this, u32 a) => this.Unary(OP_TANH, a);
    public u32 Sigmoid(ref this, u32 a) => this.Unary(OP_SIGMOID, a);

    u32 Unary(ref this, u8 op, u32 a) {
        Tensor r = this.Vals.AsSlice()[a as usize].Copy();
        mut f32[] d = r.D.AsMutSlice();
        for (usize i = 0; i < d.Len; i++) {
            f32 x = d[i];
            if (op == OP_RELU) {
                if (x < 0.0) d[i] = 0.0;
            } else if (op == OP_TANH) {
                d[i] = Tanh(x);
            } else {
                d[i] = 1.0 / (1.0 + cm.Exp(0.0 - x as f64) as f32);
            }
        }
        return this.Push(op, a, 0, r, Tensor.Zeros(0, 0));
    }

    // The mean of (a - target)^2: a 1 × 1 loss.
    public u32 Mse(ref this, u32 a, in Tensor target) {
        f32[] x = this.Vals.AsSlice()[a as usize].D.AsSlice();
        f32[] t = target.D.AsSlice();
        f32 s = 0.0;
        for (usize i = 0; i < x.Len; i++) {
            f32 d = x[i] - t[i];
            s += d * d;
        }
        Tensor r = Tensor.Zeros(1, 1);
        r.Set(0, 0, s / (x.Len as f32));
        return this.Push(OP_MSE, a, 0, r, target.Copy());
    }

    // The mean over rows of softmax cross-entropy, labels one-hot (rows × classes).
    public u32 SoftmaxCrossEntropy(ref this, u32 logits, in Tensor labels) {
        Tensor p = Softmax(this.Vals.AsSlice()[logits as usize]);
        f32 s = 0.0;
        for (u32 i = 0; i < p.R; i++) {
            for (u32 j = 0; j < p.C; j++) {
                f32 y = labels.At(i, j);
                if (y != 0.0) s -= y * cm.Ln(cm.FMax(p.At(i, j) as f64, 1e-30)) as f32;
            }
        }
        Tensor r = Tensor.Zeros(1, 1);
        r.Set(0, 0, s / (p.R as f32));
        return this.Push(OP_XENT, logits, 0, r, labels.Copy());
    }

    // Fills every node's gradient of node loss (a 1 × 1 value), walking back from it.
    public void Backward(ref this, u32 loss) {
        mut Tensor[] gs = this.Grads.AsMutSlice();
        gs[loss as usize].Set(0, 0, 1.0);
        u32 n = loss + 1;
        while (n > 0) {
            n--;
            Node node = this.Nodes.Get(n as usize);
            if (node.Op == OP_LEAF) continue;
            this.Step(n, node);
        }
    }

    // Passes node n's gradient to its inputs.
    void Step(ref this, u32 n, Node node) {
        Tensor g = this.Grads.AsSlice()[n as usize].Copy();
        Tensor[] v = this.Vals.AsSlice();
        if (node.Op == OP_MATMUL) {
            Tensor da = g.MatMul(v[node.B as usize].Transpose());
            Tensor db = v[node.A as usize].Transpose().MatMul(g);
            this.Accumulate(node.A, da);
            this.Accumulate(node.B, db);
            return;
        }
        if (node.Op == OP_ADD_ROW) {
            Tensor db = Tensor.Zeros(1, g.C);
            for (u32 i = 0; i < g.R; i++) {
                for (u32 j = 0; j < g.C; j++) db.D.AsMutSlice()[j as usize] += g.At(i, j);
            }
            this.Accumulate(node.A, g.Copy());
            this.Accumulate(node.B, db);
            return;
        }
        if (node.Op == OP_ADD) {
            this.Accumulate(node.A, g.Copy());
            this.Accumulate(node.B, g);
            return;
        }
        if (node.Op == OP_MUL) {
            Tensor da = g.Copy();
            Tensor db = g.Copy();
            f32[] a = v[node.A as usize].D.AsSlice();
            f32[] b = v[node.B as usize].D.AsSlice();
            mut f32[] x = da.D.AsMutSlice();
            for (usize i = 0; i < x.Len; i++) x[i] = x[i] * b[i];
            mut f32[] y = db.D.AsMutSlice();
            for (usize i = 0; i < y.Len; i++) y[i] = y[i] * a[i];
            this.Accumulate(node.A, da);
            this.Accumulate(node.B, db);
            return;
        }
        if (node.Op == OP_RELU || node.Op == OP_TANH || node.Op == OP_SIGMOID) {
            Tensor da = g.Copy();
            f32[] out0 = v[n as usize].D.AsSlice();
            f32[] inp = v[node.A as usize].D.AsSlice();
            mut f32[] d = da.D.AsMutSlice();
            for (usize i = 0; i < d.Len; i++) {
                if (node.Op == OP_RELU) {
                    if (inp[i] <= 0.0) d[i] = 0.0;
                } else if (node.Op == OP_TANH) {
                    d[i] = d[i] * (1.0 - out0[i] * out0[i]);
                } else {
                    d[i] = d[i] * out0[i] * (1.0 - out0[i]);
                }
            }
            this.Accumulate(node.A, da);
            return;
        }
        if (node.Op == OP_MSE) {
            f32 gl = g.At(0, 0);
            Tensor x = v[node.A as usize].Copy();
            f32[] t = this.Consts.AsSlice()[n as usize].D.AsSlice();
            mut f32[] d = x.D.AsMutSlice();
            f32 k = 2.0 / (d.Len as f32);
            for (usize i = 0; i < d.Len; i++) d[i] = gl * k * (d[i] - t[i]);
            this.Accumulate(node.A, x);
            return;
        }
        // OP_XENT: (softmax - labels) / rows
        f32 gl = g.At(0, 0);
        Tensor p = Softmax(v[node.A as usize]);
        f32[] y = this.Consts.AsSlice()[n as usize].D.AsSlice();
        mut f32[] d = p.D.AsMutSlice();
        f32 k = gl / (p.R as f32);
        for (usize i = 0; i < d.Len; i++) d[i] = k * (d[i] - y[i]);
        this.Accumulate(node.A, p);
    }

    void Accumulate(ref this, u32 id, in Tensor g) {
        mut Tensor[] gs = this.Grads.AsMutSlice();
        mut f32[] d = gs[id as usize].D.AsMutSlice();
        f32[] x = g.D.AsSlice();
        for (usize i = 0; i < d.Len && i < x.Len; i++) d[i] = d[i] + x[i];
    }
}

// Each row's softmax.
public Tensor Softmax(in Tensor x) {
    Tensor r = x.Copy();
    mut f32[] d = r.D.AsMutSlice();
    for (u32 i = 0; i < r.R; i++) {
        usize row = (i * r.C) as usize;
        f32 m = d[row];
        for (u32 j = 1; j < r.C; j++) m = cm.FMax(m as f64, d[row + j as usize] as f64) as f32;
        f32 s = 0.0;
        for (u32 j = 0; j < r.C; j++) {
            f32 e = cm.Exp((d[row + j as usize] - m) as f64) as f32;
            d[row + j as usize] = e;
            s += e;
        }
        for (u32 j = 0; j < r.C; j++) d[row + j as usize] = d[row + j as usize] / s;
    }
    return r;
}

f32 Tanh(f32 x) {
    if (x > 20.0) return 1.0;
    if (x < -20.0) return -1.0;
    f64 e = cm.Exp(2.0 * x as f64);
    return ((e - 1.0) / (e + 1.0)) as f32;
}

// ------------------------------------------------------------------ optimizers

// Gradient descent: param -= rate × grad.
public void Sgd(ref Tensor param, in Tensor grad, f32 rate) {
    mut f32[] p = param.D.AsMutSlice();
    f32[] g = grad.D.AsSlice();
    for (usize i = 0; i < p.Len && i < g.Len; i++) p[i] = p[i] - rate * g[i];
}

// Adam's moving averages for one parameter.
public struct Adam {
    Tensor M;
    Tensor V;
    u32 T;

    public static Adam For(in Tensor param) => new Adam { M = Tensor.Zeros(param.R, param.C), V = Tensor.Zeros(param.R, param.C), T = 0 };

    // One step (beta1 0.9, beta2 0.999, epsilon 1e-8).
    public void Step(ref this, ref Tensor param, in Tensor grad, f32 rate) {
        this.T++;
        f64 b1t = 1.0 - cm.PowF(0.9, this.T as f64);
        f64 b2t = 1.0 - cm.PowF(0.999, this.T as f64);
        mut f32[] p = param.D.AsMutSlice();
        f32[] g = grad.D.AsSlice();
        mut f32[] m = this.M.D.AsMutSlice();
        mut f32[] v = this.V.D.AsMutSlice();
        for (usize i = 0; i < p.Len && i < g.Len; i++) {
            m[i] = 0.9 * m[i] + 0.1 * g[i];
            v[i] = 0.999 * v[i] + 0.001 * g[i] * g[i];
            f64 mh = m[i] as f64 / b1t;
            f64 vh = v[i] as f64 / b2t;
            p[i] = p[i] - (rate as f64 * mh / (cm.Sqrt(vh) + 1e-8)) as f32;
        }
    }
}

// ------------------------------------------------------------------ language models

// Local inference (PLAN D60): the Llama family of decoder-only transformers (llama,
// mistral, qwen2, qwen3) from a GGUF file, on the CPU. Weights are dequantized to f32 on
// load, so a model takes four bytes per parameter in memory: small models first.

const u8 ROPE_PAIRS = 0;    // rotate (x[2i], x[2i+1]): llama, mistral
const u8 ROPE_HALVES = 1;   // rotate (x[i], x[i + d/2]): qwen2, qwen3

const u8 CHAT_NONE = 0;
const u8 CHAT_ML = 1;       // <|im_start|>user …
const u8 CHAT_LLAMA3 = 2;   // <|start_header_id|>user<|end_header_id|> …
const u8 CHAT_INST = 3;     // [INST] … [/INST]
const u8 CHAT_ZEPHYR = 4;   // <|user|> … <|assistant|>

// A weight matrix: Rows × Cols, row-major; y = W x.
struct Mat {
    u32 Rows;
    u32 Cols;
    List<f32> W;

    static Mat Empty() => new Mat { Rows = 0, Cols = 0, W = List<f32>.New() };
    bool IsEmpty(in this) => this.Rows == 0;
}

struct Block {
    List<f32> AttnNorm;
    Mat Wq;
    Mat Wk;
    Mat Wv;
    Mat Wo;
    List<f32> Bq;           // biases (qwen2), empty if none
    List<f32> Bk;
    List<f32> Bv;
    List<f32> QNorm;        // per-head norms (qwen3), empty if none
    List<f32> KNorm;
    List<f32> FfnNorm;
    Mat Gate;
    Mat Up;
    Mat Down;
}

public struct Model {
    u32 Dim;
    u32 Hidden;
    u32 Heads;
    u32 KvHeads;
    u32 HeadDim;
    u32 Vocab;
    u32 Ctx;
    f32 Eps;
    f32 RopeBase;
    u8 Rope;
    List<f32> Embed;        // Vocab × Dim
    List<Block> Blocks;
    List<f32> OutNorm;
    Mat Out;                // empty when the output shares the embedding
    tokenizer.Tokenizer Tok;
    List<bool> Control;     // per token: a control token (generation stops at one)
    bool AddBos;
    u8 Chat;
    bool Think;             // the template has <think> (qwen3): Ask turns thinking off
    f32 Temp;
    u64 Seed;
    u32 MaxNew;

    // The model in the GGUF file at file.
    public static Result<Model, string> Load(str file) {
        var r = gguf.File.Load(file);
        if (r.IsErr()) return Err(r.UnwrapErr());
        gguf.File f = r.Unwrap();
        return Model.From(f);
    }

    // The model in a GGUF file already read.
    public static Result<Model, string> From(in gguf.File f) {
        str? archOr = f.Str("general.architecture");
        if (archOr.IsNone()) return Err(string.From("the file names no architecture"));
        str arch = archOr.Unwrap();
        u8 rope = ROPE_PAIRS;
        if (Is(arch, "qwen2") || Is(arch, "qwen3")) rope = ROPE_HALVES;
        else if (!Is(arch, "llama") && !Is(arch, "mistral")) {
            string why = string.From("an unsupported architecture: ");
            why.Append(arch);
            return Err(why);
        }
        u32 dim = KeyU32(f, arch, ".embedding_length", 0);
        u32 layers = KeyU32(f, arch, ".block_count", 0);
        u32 heads = KeyU32(f, arch, ".attention.head_count", 0);
        u32 hidden = KeyU32(f, arch, ".feed_forward_length", 0);
        if (dim == 0 || layers == 0 || heads == 0 || hidden == 0 || layers > 512) return Err(string.From("the file lacks the model's sizes"));
        u32 kv = KeyU32(f, arch, ".attention.head_count_kv", heads);
        u32 hd = KeyU32(f, arch, ".attention.key_length", dim / heads);
        if (kv == 0 || heads % kv != 0 || hd == 0 || hd % 2 != 0) return Err(string.From("bad attention sizes"));
        u32 ctx = KeyU32(f, arch, ".context_length", 2048);
        if (ctx > 4096) ctx = 4096;
        f32 eps = KeyF32(f, arch, ".attention.layer_norm_rms_epsilon", 0.00001);
        f32 base0 = KeyF32(f, arch, ".rope.freq_base", 10000.0);

        Model m = new Model {
            Dim = dim, Hidden = hidden, Heads = heads, KvHeads = kv, HeadDim = hd, Vocab = 0, Ctx = ctx,
            Eps = eps, RopeBase = base0, Rope = rope, Embed = List<f32>.New(), Blocks = List<Block>.New(),
            OutNorm = List<f32>.New(), Out = Mat.Empty(),
            Tok = tokenizer.Tokenizer.Bpe(List<str>.New().AsSlice(), List<str>.New().AsSlice()),
            Control = List<bool>.New(), AddBos = false, Chat = CHAT_NONE, Think = false,
            Temp = 0.0, Seed = 1, MaxNew = 256
        };
        // the embedding: Vocab rows of Dim
        usize te = f.Find("token_embd.weight");
        if (te == f.TensorCount() || f.TensorDims(te)[0] != dim as u64 || f.TensorDims(te).Len != 2) return Err(string.From("no token embedding of the right size"));
        m.Vocab = f.TensorDims(te)[1] as u32;
        m.Embed = f.Floats(te);
        string why = string.From("");
        for (u32 l = 0; l < layers && why.Len() == 0; l++) {
            Block b = new Block {
                AttnNorm = Vec(f, l, "attn_norm.weight", dim, true, ref why),
                Wq = Weight(f, l, "attn_q.weight", heads * hd, dim, ref why),
                Wk = Weight(f, l, "attn_k.weight", kv * hd, dim, ref why),
                Wv = Weight(f, l, "attn_v.weight", kv * hd, dim, ref why),
                Wo = Weight(f, l, "attn_output.weight", dim, heads * hd, ref why),
                Bq = Vec(f, l, "attn_q.bias", heads * hd, false, ref why),
                Bk = Vec(f, l, "attn_k.bias", kv * hd, false, ref why),
                Bv = Vec(f, l, "attn_v.bias", kv * hd, false, ref why),
                QNorm = Vec(f, l, "attn_q_norm.weight", hd, false, ref why),
                KNorm = Vec(f, l, "attn_k_norm.weight", hd, false, ref why),
                FfnNorm = Vec(f, l, "ffn_norm.weight", dim, true, ref why),
                Gate = Weight(f, l, "ffn_gate.weight", hidden, dim, ref why),
                Up = Weight(f, l, "ffn_up.weight", hidden, dim, ref why),
                Down = Weight(f, l, "ffn_down.weight", dim, hidden, ref why)
            };
            m.Blocks.Push(b);
        }
        if (why.Len() > 0) return Err(why);
        usize on = f.Find("output_norm.weight");
        if (on == f.TensorCount()) return Err(string.From("no output_norm.weight"));
        m.OutNorm = f.Floats(on);
        if (m.OutNorm.Len() != dim as usize) return Err(string.From("output_norm.weight has the wrong size"));
        usize ow = f.Find("output.weight");
        if (ow < f.TensorCount()) {
            u64[] d = f.TensorDims(ow);
            if (d.Len != 2 || d[0] != dim as u64 || d[1] != m.Vocab as u64) return Err(string.From("output.weight has the wrong size"));
            m.Out = new Mat { Rows = m.Vocab, Cols = dim, W = f.Floats(ow) };
        }
        string tw = m.LoadTokenizer(f);
        if (tw.Len() > 0) return Err(tw);
        return Ok(m);
    }

    string LoadTokenizer(ref this, in gguf.File f) {
        str? kind = f.Str("tokenizer.ggml.model");
        if (kind.IsNone()) return string.From("the file has no tokenizer");
        string[] toks = f.Strings("tokenizer.ggml.tokens");
        if (toks.Len != this.Vocab as usize) return string.From("the tokenizer's vocabulary does not match the model");
        List<str> vocab = List<str>.New();
        foreach (var t in toks) vocab.Push(t.AsStr());
        if (Is(kind.Unwrap(), "llama")) {
            List<f32> scores = List<f32>.New();
            foreach (var s in f.Numbers("tokenizer.ggml.scores")) scores.Push(s as f32);
            this.Tok = tokenizer.Tokenizer.Spm(vocab.AsSlice(), scores.AsSlice());
            this.AddBos = true;
        } else if (Is(kind.Unwrap(), "gpt2")) {
            List<str> merges = List<str>.New();
            foreach (var t in f.Strings("tokenizer.ggml.merges")) merges.Push(t.AsStr());
            this.Tok = tokenizer.Tokenizer.Bpe(vocab.AsSlice(), merges.AsSlice());
        } else {
            return string.From("an unsupported tokenizer");
        }
        u64? addBos = f.Uint("tokenizer.ggml.add_bos_token");
        if (addBos.IsSome()) this.AddBos = addBos.Unwrap() != 0;
        u32 bos = 0xFFFFFFFF;
        u32 eos = 0xFFFFFFFF;
        u64? b = f.Uint("tokenizer.ggml.bos_token_id");
        if (b.IsSome() && b.Unwrap() < this.Vocab as u64) bos = b.Unwrap() as u32;
        u64? e = f.Uint("tokenizer.ggml.eos_token_id");
        if (e.IsSome() && e.Unwrap() < this.Vocab as u64) eos = e.Unwrap() as u32;
        if (bos == 0xFFFFFFFF) this.AddBos = false;
        this.Tok.SetSpecial(bos, eos);
        f64[] types = f.Numbers("tokenizer.ggml.token_type");
        for (u32 i = 0; i < this.Vocab; i++) {
            f64 t = 1.0;
            if ((i as usize) < types.Len) t = types[i as usize];
            this.Control.Push(t == 3.0 || i == eos);
            if (t == 3.0 || t == 4.0) this.Tok.MarkSpecial(i);
        }
        str? tpl = f.Str("tokenizer.chat_template");
        if (tpl.IsSome()) {
            str t = tpl.Unwrap();
            if (Has(t, "<|im_start|>")) this.Chat = CHAT_ML;
            else if (Has(t, "<|start_header_id|>")) this.Chat = CHAT_LLAMA3;
            else if (Has(t, "[INST]")) this.Chat = CHAT_INST;
            else if (Has(t, "<|user|>")) this.Chat = CHAT_ZEPHYR;
            this.Think = Has(t, "<think>");
        }
        return string.From("");
    }

    public u32 VocabSize(in this) => this.Vocab;
    public u32 Layers(in this) => this.Blocks.Len() as u32;
    public u32 Width(in this) => this.Dim;
    public u32 ContextLength(in this) => this.Ctx;

    // 0 picks the likeliest token every time (the default); above 0 samples, more
    // freely the higher it is, from a generator seeded with seed.
    public void SetTemperature(ref this, f32 t, u64 seed) {
        this.Temp = t;
        this.Seed = seed;
    }

    // The most tokens Ask and Complete generate (256 by default).
    public void SetMaxTokens(ref this, u32 n) {
        this.MaxNew = n;
    }

    // A fresh context: the attention cache of one sequence of tokens.
    public Context NewContext(in this) {
        Context c = new Context { K = List<List<f32>>.New(), V = List<List<f32>>.New(), Pos = 0, Gen = Rng.Seeded(this.Seed) };
        for (usize l = 0; l < this.Blocks.Len(); l++) {
            c.K.Push(List<f32>.New());
            c.V.Push(List<f32>.New());
        }
        return c;
    }

    // The tokens of text, as the model reads them (no begin token).
    public List<u32> Encode(in this, str text) => this.Tok.Encode(text);
    public string Decode(in this, u32[] ids) => this.Tok.Decode(ids);

    // Feeds token at the next position and returns the scores (logits) of every token
    // to come next.
    public List<f32> Next(in this, ref Context c, u32 token) {
        if (c.Pos >= this.Ctx) panic("ai: the model's context is full");
        if (token >= this.Vocab) panic("ai: a token outside the vocabulary");
        if (c.K.Len() != this.Blocks.Len()) panic("ai: a context from another model");
        u32 pos = c.Pos;
        c.Pos++;
        u32 d = this.Dim;
        u32 hd = this.HeadDim;
        u32 kvd = this.KvHeads * hd;
        List<f32> x = List<f32>.New();
        f32[] emb = this.Embed.AsSlice();
        for (u32 i = 0; i < d; i++) x.Push(emb[(token * d + i) as usize]);
        List<f32> att = Zeros(this.Heads * hd);
        List<f32> sc = Zeros(pos + 1);
        for (usize l = 0; l < this.Blocks.Len(); l++) {
            Block[] bs = this.Blocks.AsSlice();
            List<f32> xb = RmsNorm(x.AsSlice(), bs[l].AttnNorm.AsSlice(), this.Eps);
            List<f32> q = MatVec(bs[l].Wq, xb.AsSlice(), bs[l].Bq.AsSlice());
            List<f32> k = MatVec(bs[l].Wk, xb.AsSlice(), bs[l].Bk.AsSlice());
            List<f32> v = MatVec(bs[l].Wv, xb.AsSlice(), bs[l].Bv.AsSlice());
            if (bs[l].QNorm.Len() > 0) {
                HeadNorm(ref q, bs[l].QNorm.AsSlice(), hd, this.Eps);
                HeadNorm(ref k, bs[l].KNorm.AsSlice(), hd, this.Eps);
            }
            Rotate(ref q, hd, pos, this.RopeBase, this.Rope);
            Rotate(ref k, hd, pos, this.RopeBase, this.Rope);
            {
                mut List<f32>[] kcs = c.K.AsMutSlice();
                foreach (var e in k.AsSlice()) kcs[l].Push(e);
                mut List<f32>[] vcs = c.V.AsMutSlice();
                foreach (var e in v.AsSlice()) vcs[l].Push(e);
            }
            f32[] kc = c.K.AsSlice()[l].AsSlice();
            f32[] vc = c.V.AsSlice()[l].AsSlice();
            f32[] qs = q.AsSlice();
            mut f32[] a = att.AsMutSlice();
            mut f32[] s = sc.AsMutSlice();
            u32 group = this.Heads / this.KvHeads;
            f32 scale = (1.0 / cm.Sqrt(hd as f64)) as f32;
            for (u32 h = 0; h < this.Heads; h++) {
                u32 qo = h * hd;
                u32 ko = (h / group) * hd;
                f32 top = 0.0;
                for (u32 t = 0; t <= pos; t++) {
                    f32 dot = 0.0;
                    u32 kb = t * kvd + ko;
                    for (u32 i = 0; i < hd; i++) dot += qs[(qo + i) as usize] * kc[(kb + i) as usize];
                    dot = dot * scale;
                    s[t as usize] = dot;
                    if (t == 0 || dot > top) top = dot;
                }
                f32 sum = 0.0;
                for (u32 t = 0; t <= pos; t++) {
                    f32 e = cm.Exp((s[t as usize] - top) as f64) as f32;
                    s[t as usize] = e;
                    sum += e;
                }
                for (u32 i = 0; i < hd; i++) a[(qo + i) as usize] = 0.0;
                for (u32 t = 0; t <= pos; t++) {
                    f32 w = s[t as usize] / sum;
                    u32 vb = t * kvd + ko;
                    for (u32 i = 0; i < hd; i++) a[(qo + i) as usize] += w * vc[(vb + i) as usize];
                }
            }
            List<f32> o = MatVec(bs[l].Wo, att.AsSlice(), List<f32>.New().AsSlice());
            AddInto(ref x, o.AsSlice());
            List<f32> xf = RmsNorm(x.AsSlice(), bs[l].FfnNorm.AsSlice(), this.Eps);
            List<f32> g = MatVec(bs[l].Gate, xf.AsSlice(), List<f32>.New().AsSlice());
            List<f32> u = MatVec(bs[l].Up, xf.AsSlice(), List<f32>.New().AsSlice());
            mut f32[] gs = g.AsMutSlice();
            f32[] us = u.AsSlice();
            for (usize i = 0; i < gs.Len; i++) {
                f32 z = gs[i];
                gs[i] = z / (1.0 + cm.Exp(0.0 - z as f64) as f32) * us[i];
            }
            List<f32> dn = MatVec(bs[l].Down, g.AsSlice(), List<f32>.New().AsSlice());
            AddInto(ref x, dn.AsSlice());
        }
        List<f32> xn = RmsNorm(x.AsSlice(), this.OutNorm.AsSlice(), this.Eps);
        if (this.Out.IsEmpty()) {
            return MatVecRows(this.Embed.AsSlice(), this.Vocab, d, xn.AsSlice());
        }
        return MatVec(this.Out, xn.AsSlice(), List<f32>.New().AsSlice());
    }

    // The token to follow, from scores: the likeliest, or sampled at the temperature.
    public u32 Pick(in this, ref Context c, f32[] logits) {
        u32 best = 0;
        for (u32 i = 1; i < logits.Len as u32; i++) {
            if (logits[i as usize] > logits[best as usize]) best = i;
        }
        if (this.Temp <= 0.0) return best;
        f64 sum = 0.0;
        List<f64> p = List<f64>.New();
        for (usize i = 0; i < logits.Len; i++) {
            f64 e = cm.Exp(((logits[i] - logits[best as usize]) / this.Temp) as f64);
            p.Push(e);
            sum += e;
        }
        f64 r = c.Gen.Next() as f64 * sum;
        for (usize i = 0; i < p.Len(); i++) {
            r -= p.Get(i);
            if (r < 0.0) return i as u32;
        }
        return best;
    }

    // Generates up to max tokens after prompt in a fresh context, stopping at a control
    // or end token. Returns only the new tokens.
    public List<u32> Generate(in this, u32[] prompt, u32 max) {
        Context c = this.NewContext();
        List<u32> got = List<u32>.New();
        if (prompt.Len == 0) return got;
        List<f32> logits = List<f32>.New();
        foreach (var t in prompt) {
            if (c.Pos >= this.Ctx) return got;
            logits = this.Next(ref c, t);
        }
        for (u32 n = 0; n < max && c.Pos < this.Ctx; n++) {
            u32 t = this.Pick(ref c, logits.AsSlice());
            if (this.Control.Get(t as usize)) break;
            got.Push(t);
            if (n + 1 < max) logits = this.Next(ref c, t);
        }
        return got;
    }

    // Continues text as it is (no chat template).
    public string Complete(in this, str text) {
        List<u32> ids = this.Prompt(text);
        List<u32> got = this.Generate(ids.AsSlice(), this.MaxNew);
        return this.Tok.Decode(got.AsSlice());
    }

    // The model's answer to prompt, in its chat format when its file names one.
    public string Ask(in this, str prompt) {
        string text = string.From("");
        if (this.Chat == CHAT_ML) {
            text.Append("<|im_start|>user\n");
            text.Append(prompt);
            text.Append("<|im_end|>\n<|im_start|>assistant\n");
            if (this.Think) text.Append("<think>\n\n</think>\n\n");
        } else if (this.Chat == CHAT_LLAMA3) {
            text.Append("<|start_header_id|>user<|end_header_id|>\n\n");
            text.Append(prompt);
            text.Append("<|eot_id|><|start_header_id|>assistant<|end_header_id|>\n\n");
        } else if (this.Chat == CHAT_INST) {
            text.Append("[INST] ");
            text.Append(prompt);
            text.Append(" [/INST]");
        } else if (this.Chat == CHAT_ZEPHYR) {
            text.Append("<|user|>\n");
            text.Append(prompt);
            text.Append("</s>\n<|assistant|>\n");
        } else {
            text.Append(prompt);
        }
        string answer = this.Complete(text.AsStr());
        return Trimmed(answer.AsStr());
    }

    List<u32> Prompt(in this, str text) {
        List<u32> ids = List<u32>.New();
        if (this.AddBos) ids.Push(this.Tok.BeginId());
        List<u32> rest = this.Tok.Encode(text);
        foreach (var t in rest.AsSlice()) ids.Push(t);
        return ids;
    }
}

// The attention cache of one sequence: the keys and values of every token so far.
public struct Context {
    List<List<f32>> K;      // per block: Pos × KvHeads × HeadDim
    List<List<f32>> V;
    u32 Pos;
    Rng Gen;

    // How many tokens it holds.
    public u32 Len(in this) => this.Pos;
}

// The model in the GGUF file at file; panics with the reason if it cannot be loaded.
public Model Load(str file) {
    var r = Model.Load(file);
    if (r.IsOk()) return r.Unwrap();
    string why = r.UnwrapErr();
    write(2, "ai: ");
    write(2, file);
    write(2, ": ");
    write(2, why.AsStr());
    write(2, "\n");
    panic("ai: cannot load the model");
}

bool Is(str a, str b) {
    if (a.Len != b.Len) return false;
    for (usize i = 0; i < a.Len; i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

bool Has(str s, str part) {
    if (part.Len > s.Len) return false;
    for (usize i = 0; i + part.Len <= s.Len; i++) {
        bool same = true;
        for (usize k = 0; k < part.Len && same; k++) same = s[i + k] == part[k];
        if (same) return true;
    }
    return false;
}

string Trimmed(str s) {
    usize a = 0;
    usize b = s.Len;
    while (a < b && (s[a] == ' ' as u8 || s[a] == '\n' as u8)) a++;
    while (b > a && (s[b - 1] == ' ' as u8 || s[b - 1] == '\n' as u8)) b--;
    string r = string.From("");
    for (usize i = a; i < b; i++) r.AppendByte(s[i]);
    return r;
}

string Key(str arch, str suffix) {
    string k = string.From(arch);
    k.Append(suffix);
    return k;
}

u32 KeyU32(in gguf.File f, str arch, str suffix, u32 other) {
    string k = Key(arch, suffix);
    u64? v = f.Uint(k.AsStr());
    if (v.IsNone() || v.Unwrap() > 0xFFFFFFFF) return other;
    return v.Unwrap() as u32;
}

f32 KeyF32(in gguf.File f, str arch, str suffix, f32 other) {
    string k = Key(arch, suffix);
    f64? v = f.Number(k.AsStr());
    if (v.IsNone()) return other;
    return v.Unwrap() as f32;
}

string TensorName(u32 layer, str name) {
    string n = string.From("blk.");
    n.Append(text.Uint(layer as u64).AsStr());
    n.AppendByte('.' as u8);
    n.Append(name);
    return n;
}

// Block layer's vector name of len values (empty if it is optional and absent).
List<f32> Vec(in gguf.File f, u32 layer, str name, u32 len, bool needed, ref string why) {
    string n = TensorName(layer, name);
    usize i = f.Find(n.AsStr());
    if (i == f.TensorCount()) {
        if (needed && why.Len() == 0) {
            why.Append("missing ");
            why.Append(n.AsStr());
        }
        return List<f32>.New();
    }
    List<f32> v = f.Floats(i);
    if (v.Len() != len as usize && why.Len() == 0) {
        why.Append("the wrong size: ");
        why.Append(n.AsStr());
    }
    return v;
}

// Block layer's matrix name, rows × cols (in GGUF: cols innermost).
Mat Weight(in gguf.File f, u32 layer, str name, u32 rows, u32 cols, ref string why) {
    string n = TensorName(layer, name);
    usize i = f.Find(n.AsStr());
    if (i == f.TensorCount()) {
        if (why.Len() == 0) {
            why.Append("missing ");
            why.Append(n.AsStr());
        }
        return Mat.Empty();
    }
    u64[] d = f.TensorDims(i);
    if (d.Len != 2 || d[0] != cols as u64 || d[1] != rows as u64) {
        if (why.Len() == 0) {
            why.Append("the wrong size: ");
            why.Append(n.AsStr());
        }
        return Mat.Empty();
    }
    return new Mat { Rows = rows, Cols = cols, W = f.Floats(i) };
}

List<f32> Zeros(u32 n) {
    List<f32> v = List<f32>.New();
    for (u32 i = 0; i < n; i++) v.Push(0.0);
    return v;
}

// W x (+ bias, if there is one).
List<f32> MatVec(in Mat m, f32[] x, f32[] bias) {
    List<f32> y = MatVecRows(m.W.AsSlice(), m.Rows, m.Cols, x);
    if (bias.Len > 0) AddInto(ref y, bias);
    return y;
}

List<f32> MatVecRows(f32[] w, u32 rows, u32 cols, f32[] x) {
    List<f32> y = List<f32>.New();
    for (u32 r = 0; r < rows; r++) {
        usize at = (r * cols) as usize;
        f32 s0 = 0.0;
        f32 s1 = 0.0;
        f32 s2 = 0.0;
        f32 s3 = 0.0;
        usize c = 0;
        usize n = cols as usize;
        while (c + 4 <= n) {
            s0 += w[at + c] * x[c];
            s1 += w[at + c + 1] * x[c + 1];
            s2 += w[at + c + 2] * x[c + 2];
            s3 += w[at + c + 3] * x[c + 3];
            c += 4;
        }
        while (c < n) {
            s0 += w[at + c] * x[c];
            c++;
        }
        y.Push((s0 + s1) + (s2 + s3));
    }
    return y;
}

void AddInto(ref List<f32> x, f32[] y) {
    mut f32[] d = x.AsMutSlice();
    for (usize i = 0; i < d.Len && i < y.Len; i++) d[i] = d[i] + y[i];
}

List<f32> RmsNorm(f32[] x, f32[] w, f32 eps) {
    f64 ss = 0.0;
    foreach (var v in x) ss += (v * v) as f64;
    f32 k = (1.0 / cm.Sqrt(ss / (x.Len as f64) + eps as f64)) as f32;
    List<f32> y = List<f32>.New();
    for (usize i = 0; i < x.Len; i++) y.Push(x[i] * k * w[i]);
    return y;
}

// RMSNorm over each head of x.
void HeadNorm(ref List<f32> x, f32[] w, u32 hd, f32 eps) {
    mut f32[] d = x.AsMutSlice();
    for (usize h = 0; h + hd as usize <= d.Len; h += hd as usize) {
        f64 ss = 0.0;
        for (usize i = 0; i < hd as usize; i++) ss += (d[h + i] * d[h + i]) as f64;
        f32 k = (1.0 / cm.Sqrt(ss / (hd as f64) + eps as f64)) as f32;
        for (usize i = 0; i < hd as usize; i++) d[h + i] = d[h + i] * k * w[i];
    }
}

// Rotary position embedding, head by head.
void Rotate(ref List<f32> x, u32 hd, u32 pos, f32 base0, u8 mode) {
    mut f32[] d = x.AsMutSlice();
    u32 half = hd / 2;
    for (u32 i = 0; i < half; i++) {
        f64 freq = cm.PowF(base0 as f64, 0.0 - (2 * i) as f64 / hd as f64);
        f64 angle = pos as f64 * freq;
        f32 c = cm.Cos(angle) as f32;
        f32 s = cm.Sin(angle) as f32;
        for (usize h = 0; h + hd as usize <= d.Len; h += hd as usize) {
            usize a = h + (2 * i) as usize;
            usize b = a + 1;
            if (mode == ROPE_HALVES) {
                a = h + i as usize;
                b = a + half as usize;
            }
            f32 x0 = d[a];
            f32 x1 = d[b];
            d[a] = x0 * c - x1 * s;
            d[b] = x0 * s + x1 * c;
        }
    }
}

// ------------------------------------------------------------------ embeddings

// A text encoder (PLAN D62): nomic-bert from a GGUF file, the architecture of
// nomic-embed-text. Bidirectional attention with rotary positions, a SwiGLU feed-forward
// and post-layer norms; the embedding is the mean of the last layer, scaled to length 1.
// Encode with the task prefix the model expects ("search_query: ", "search_document: ").

struct EncBlock {
    Mat Qkv;
    List<f32> Bqkv;
    Mat Wo;
    List<f32> Bo;
    List<f32> N1w;          // after attention and the residual
    List<f32> N1b;
    Mat Up;
    Mat Gate;
    Mat Down;
    List<f32> N2w;          // after the feed-forward and the residual
    List<f32> N2b;
}

public struct Encoder {
    u32 Dim;
    u32 Heads;
    u32 HeadDim;
    u32 Ctx;
    u32 Vocab;
    f32 Eps;
    f32 RopeBase;
    List<f32> Emb;          // Vocab × Dim
    List<f32> TypeRow;      // token type 0's embedding
    List<f32> EmbNormW;
    List<f32> EmbNormB;
    List<EncBlock> Blocks;
    tokenizer.Tokenizer Tok;
    u32 Cls;
    u32 Sep;

    public static Result<Encoder, string> Load(str file) {
        var r = gguf.File.Load(file);
        if (r.IsErr()) return Err(r.UnwrapErr());
        gguf.File f = r.Unwrap();
        return Encoder.From(f);
    }

    public static Result<Encoder, string> From(in gguf.File f) {
        str? archOr = f.Str("general.architecture");
        if (archOr.IsNone() || !Is(archOr.Unwrap(), "nomic-bert")) return Err(string.From("not a nomic-bert model"));
        str arch = "nomic-bert";
        u32 dim = KeyU32(f, arch, ".embedding_length", 0);
        u32 layers = KeyU32(f, arch, ".block_count", 0);
        u32 heads = KeyU32(f, arch, ".attention.head_count", 0);
        u32 hidden = KeyU32(f, arch, ".feed_forward_length", 0);
        if (dim == 0 || layers == 0 || heads == 0 || hidden == 0 || dim % heads != 0 || layers > 256) return Err(string.From("the file lacks the model's sizes"));
        u32 ctx = KeyU32(f, arch, ".context_length", 512);
        if (ctx > 2048) ctx = 2048;
        Encoder e = new Encoder {
            Dim = dim, Heads = heads, HeadDim = dim / heads, Ctx = ctx, Vocab = 0,
            Eps = KeyF32(f, arch, ".attention.layer_norm_epsilon", 0.000000000001),
            RopeBase = KeyF32(f, arch, ".rope.freq_base", 1000.0),
            Emb = List<f32>.New(), TypeRow = List<f32>.New(), EmbNormW = List<f32>.New(), EmbNormB = List<f32>.New(),
            Blocks = List<EncBlock>.New(), Tok = tokenizer.Tokenizer.WordPiece(List<str>.New().AsSlice(), 0), Cls = 0, Sep = 0
        };
        usize te = f.Find("token_embd.weight");
        if (te == f.TensorCount() || f.TensorDims(te)[0] != dim as u64 || f.TensorDims(te).Len != 2) return Err(string.From("no token embedding of the right size"));
        e.Vocab = f.TensorDims(te)[1] as u32;
        e.Emb = f.Floats(te);
        string why = string.From("");
        List<f32> types = Whole(f, "token_types.weight", 0, ref why);
        for (u32 i = 0; i < dim && (i as usize) < types.Len(); i++) e.TypeRow.Push(types.Get(i as usize));
        e.EmbNormW = Whole(f, "token_embd_norm.weight", dim, ref why);
        e.EmbNormB = Whole(f, "token_embd_norm.bias", dim, ref why);
        if (e.TypeRow.Len() != dim as usize && why.Len() == 0) why.Append("token_types.weight is too small");
        for (u32 l = 0; l < layers && why.Len() == 0; l++) {
            EncBlock b = new EncBlock {
                Qkv = Weight(f, l, "attn_qkv.weight", 3 * dim, dim, ref why),
                Bqkv = Vec(f, l, "attn_qkv.bias", 3 * dim, false, ref why),
                Wo = Weight(f, l, "attn_output.weight", dim, dim, ref why),
                Bo = Vec(f, l, "attn_output.bias", dim, false, ref why),
                N1w = Vec(f, l, "attn_output_norm.weight", dim, true, ref why),
                N1b = Vec(f, l, "attn_output_norm.bias", dim, true, ref why),
                Up = Weight(f, l, "ffn_up.weight", hidden, dim, ref why),
                Gate = Weight(f, l, "ffn_gate.weight", hidden, dim, ref why),
                Down = Weight(f, l, "ffn_down.weight", dim, hidden, ref why),
                N2w = Vec(f, l, "layer_output_norm.weight", dim, true, ref why),
                N2b = Vec(f, l, "layer_output_norm.bias", dim, true, ref why)
            };
            e.Blocks.Push(b);
        }
        if (why.Len() > 0) return Err(why);
        str? kind = f.Str("tokenizer.ggml.model");
        if (kind.IsNone() || !Is(kind.Unwrap(), "bert")) return Err(string.From("not a WordPiece tokenizer"));
        string[] toks = f.Strings("tokenizer.ggml.tokens");
        if (toks.Len != e.Vocab as usize) return Err(string.From("the tokenizer's vocabulary does not match the model"));
        List<str> vocab = List<str>.New();
        foreach (var t in toks) vocab.Push(t.AsStr());
        u32 unk = KeyU32(f, "tokenizer.ggml", ".unknown_token_id", 100);
        e.Cls = KeyU32(f, "tokenizer.ggml", ".bos_token_id", 101);
        e.Sep = KeyU32(f, "tokenizer.ggml", ".seperator_token_id", KeyU32(f, "tokenizer.ggml", ".eos_token_id", 102));
        if (unk >= e.Vocab || e.Cls >= e.Vocab || e.Sep >= e.Vocab) return Err(string.From("special tokens outside the vocabulary"));
        e.Tok = tokenizer.Tokenizer.WordPiece(vocab.AsSlice(), unk);
        return Ok(e);
    }

    public u32 Width(in this) => this.Dim;

    // The tokens the model reads for text: [CLS], its pieces, [SEP].
    public List<u32> Tokens(in this, str text) {
        List<u32> ids = List<u32>.New();
        ids.Push(this.Cls);
        List<u32> mid = this.Tok.Encode(text);
        foreach (var t in mid.AsSlice()) {
            if (ids.Len() + 1 < this.Ctx as usize) ids.Push(t);
        }
        ids.Push(this.Sep);
        return ids;
    }

    // text's embedding: Width() values, length 1.
    public List<f32> Embed(in this, str text) {
        List<u32> ids = this.Tokens(text);
        u32 n = ids.Len() as u32;
        u32 d = this.Dim;
        u32 hd = this.HeadDim;
        // x: n rows of d
        List<f32> x = List<f32>.New();
        f32[] emb = this.Emb.AsSlice();
        f32[] ty = this.TypeRow.AsSlice();
        for (u32 i = 0; i < n; i++) {
            u32 t = ids.Get(i as usize);
            List<f32> row = List<f32>.New();
            for (u32 k = 0; k < d; k++) row.Push(emb[(t * d + k) as usize] + ty[k as usize]);
            List<f32> nr = LayerNorm(row.AsSlice(), this.EmbNormW.AsSlice(), this.EmbNormB.AsSlice(), this.Eps);
            foreach (var v in nr.AsSlice()) x.Push(v);
        }
        f32 scale = (1.0 / cm.Sqrt(hd as f64)) as f32;
        foreach (var b in this.Blocks.AsSlice()) {
            f32[] xs = x.AsSlice();
            // q, k, v for every token, rotated
            List<f32> q = List<f32>.New();
            List<f32> k = List<f32>.New();
            List<f32> v = List<f32>.New();
            for (u32 i = 0; i < n; i++) {
                List<f32> qkv = MatVec(b.Qkv, xs[(i * d) as usize..((i + 1) * d) as usize], b.Bqkv.AsSlice());
                f32[] a = qkv.AsSlice();
                List<f32> qi = List<f32>.New();
                List<f32> ki = List<f32>.New();
                for (u32 c = 0; c < d; c++) {
                    qi.Push(a[c as usize]);
                    ki.Push(a[(d + c) as usize]);
                    v.Push(a[(2 * d + c) as usize]);
                }
                Rotate(ref qi, hd, i, this.RopeBase, ROPE_HALVES);
                Rotate(ref ki, hd, i, this.RopeBase, ROPE_HALVES);
                foreach (var e in qi.AsSlice()) q.Push(e);
                foreach (var e in ki.AsSlice()) k.Push(e);
            }
            f32[] qs = q.AsSlice();
            f32[] ks = k.AsSlice();
            f32[] vs = v.AsSlice();
            List<f32> next = List<f32>.New();
            List<f32> sc = Zeros(n);
            for (u32 i = 0; i < n; i++) {
                List<f32> att = Zeros(d);
                mut f32[] at = att.AsMutSlice();
                mut f32[] s = sc.AsMutSlice();
                for (u32 h = 0; h < this.Heads; h++) {
                    u32 o = h * hd;
                    f32 top = 0.0;
                    for (u32 j = 0; j < n; j++) {
                        f32 dot = 0.0;
                        for (u32 c = 0; c < hd; c++) dot += qs[(i * d + o + c) as usize] * ks[(j * d + o + c) as usize];
                        dot = dot * scale;
                        s[j as usize] = dot;
                        if (j == 0 || dot > top) top = dot;
                    }
                    f32 sum = 0.0;
                    for (u32 j = 0; j < n; j++) {
                        f32 e = cm.Exp((s[j as usize] - top) as f64) as f32;
                        s[j as usize] = e;
                        sum += e;
                    }
                    for (u32 j = 0; j < n; j++) {
                        f32 w = s[j as usize] / sum;
                        for (u32 c = 0; c < hd; c++) at[(o + c) as usize] += w * vs[(j * d + o + c) as usize];
                    }
                }
                List<f32> h1 = MatVec(b.Wo, att.AsSlice(), b.Bo.AsSlice());
                AddInto(ref h1, xs[(i * d) as usize..((i + 1) * d) as usize]);
                List<f32> hn = LayerNorm(h1.AsSlice(), b.N1w.AsSlice(), b.N1b.AsSlice(), this.Eps);
                List<f32> g = MatVec(b.Gate, hn.AsSlice(), List<f32>.New().AsSlice());
                List<f32> u = MatVec(b.Up, hn.AsSlice(), List<f32>.New().AsSlice());
                mut f32[] gs = g.AsMutSlice();
                f32[] us = u.AsSlice();
                for (usize c = 0; c < gs.Len; c++) {
                    f32 z = gs[c];
                    gs[c] = z / (1.0 + cm.Exp(0.0 - z as f64) as f32) * us[c];
                }
                List<f32> dn = MatVec(b.Down, g.AsSlice(), List<f32>.New().AsSlice());
                AddInto(ref dn, hn.AsSlice());
                List<f32> out0 = LayerNorm(dn.AsSlice(), b.N2w.AsSlice(), b.N2b.AsSlice(), this.Eps);
                foreach (var e in out0.AsSlice()) next.Push(e);
            }
            x = next;
        }
        // the mean over tokens, scaled to length 1
        List<f32> mean = Zeros(d);
        mut f32[] m = mean.AsMutSlice();
        f32[] xs = x.AsSlice();
        for (u32 i = 0; i < n; i++) {
            for (u32 c = 0; c < d; c++) m[c as usize] += xs[(i * d + c) as usize];
        }
        return Normalized(mean.AsSlice());
    }
}

List<f32> Whole(in gguf.File f, str name, u32 len, ref string why) {
    usize i = f.Find(name);
    if (i == f.TensorCount()) {
        if (why.Len() == 0) {
            why.Append("missing ");
            why.Append(name);
        }
        return List<f32>.New();
    }
    List<f32> v = f.Floats(i);
    if (len != 0 && v.Len() != len as usize && why.Len() == 0) {
        why.Append("the wrong size: ");
        why.Append(name);
    }
    return v;
}

List<f32> LayerNorm(f32[] x, f32[] w, f32[] b, f32 eps) {
    f64 mean = 0.0;
    foreach (var v in x) mean += v as f64;
    mean = mean / (x.Len as f64);
    f64 var0 = 0.0;
    foreach (var v in x) var0 += (v as f64 - mean) * (v as f64 - mean);
    var0 = var0 / (x.Len as f64);
    f64 k = 1.0 / cm.Sqrt(var0 + eps as f64);
    List<f32> y = List<f32>.New();
    for (usize i = 0; i < x.Len; i++) y.Push(((x[i] as f64 - mean) * k) as f32 * w[i] + b[i]);
    return y;
}

// ------------------------------------------------------------------ vector search

// v scaled to length 1 (all zeros stays zeros).
public List<f32> Normalized(f32[] v) {
    f64 ss = 0.0;
    foreach (var x in v) ss += (x * x) as f64;
    List<f32> r = List<f32>.New();
    f64 k = 0.0;
    if (ss > 0.0) k = 1.0 / cm.Sqrt(ss);
    foreach (var x in v) r.Push((x as f64 * k) as f32);
    return r;
}

// The cosine of the angle between a and b: 1 for the same direction, 0 for unrelated.
public f32 Cosine(f32[] a, f32[] b) {
    f64 ab = 0.0;
    f64 aa = 0.0;
    f64 bb = 0.0;
    for (usize i = 0; i < a.Len && i < b.Len; i++) {
        ab += (a[i] * b[i]) as f64;
        aa += (a[i] * a[i]) as f64;
        bb += (b[i] * b[i]) as f64;
    }
    if (aa == 0.0 || bb == 0.0) return 0.0;
    return (ab / cm.Sqrt(aa * bb)) as f32;
}

// One search result: the id given to Add and its cosine similarity to the query.
public struct Hit {
    u32 Key;
    f32 Score;

    public u32 Id(in this) => this.Key;
    public f32 Similarity(in this) => this.Score;
}

f32 Dot(f32[] a, usize at, f32[] b) {
    f32 s0 = 0.0;
    f32 s1 = 0.0;
    usize i = 0;
    while (i + 2 <= b.Len) {
        s0 += a[at + i] * b[i];
        s1 += a[at + i + 1] * b[i + 1];
        i += 2;
    }
    if (i < b.Len) s0 += a[at + i] * b[i];
    return s0 + s1;
}

// Inserts h into hits, kept best first; at most cap.
void Keep(ref List<Hit> hits, Hit h, usize cap) {
    if (hits.Len() >= cap && hits.Get(hits.Len() - 1).Score >= h.Score) return;
    hits.Push(h);
    mut Hit[] s = hits.AsMutSlice();
    usize i = s.Len - 1;
    while (i > 0 && (s[i - 1].Score < s[i].Score || (s[i - 1].Score == s[i].Score && s[i - 1].Key > s[i].Key))) {
        Hit t = s[i - 1];
        s[i - 1] = s[i];
        s[i] = t;
        i--;
    }
    if (hits.Len() > cap) hits.Pop();
}

// Exact nearest neighbours: every vector compared. The reference for Hnsw.
public struct Index {
    u32 Dim;
    List<f32> Vecs;         // normalized, one after another
    List<u32> Keys;

    public static Index New(u32 dim) => new Index { Dim = dim, Vecs = List<f32>.New(), Keys = List<u32>.New() };

    public usize Len(in this) => this.Keys.Len();

    public void Add(ref this, u32 id, f32[] v) {
        if (v.Len != this.Dim as usize) panic("ai: a vector of the wrong width");
        List<f32> n = Normalized(v);
        foreach (var x in n.AsSlice()) this.Vecs.Push(x);
        this.Keys.Push(id);
    }

    // The k most similar vectors to q, best first.
    public List<Hit> Nearest(in this, f32[] q, u32 k) {
        List<f32> qn = Normalized(q);
        List<Hit> hits = List<Hit>.New();
        f32[] vs = this.Vecs.AsSlice();
        for (usize i = 0; i < this.Keys.Len(); i++) {
            Keep(ref hits, new Hit { Key = this.Keys.Get(i), Score = Dot(vs, i * this.Dim as usize, qn.AsSlice()) }, k as usize);
        }
        return hits;
    }
}

// Approximate nearest neighbours: a hierarchical navigable small world graph (HNSW).
// Each vector joins layers 0..L (L random, geometric) and links to its M nearest on each;
// a search descends greedily from the top and widens to ef candidates on layer 0.
// Deterministic for a seed and an order of Adds.
public struct Hnsw {
    u32 Dim;
    u32 M;
    u32 EfBuild;
    u32 Ef;
    List<f32> Vecs;
    List<u32> Keys;
    List<u32> Level;        // per node: its top layer
    List<u32> LinkAt;       // per node: its layer 0 list in Links (layer l is LinkAt + l)
    List<List<u32>> Links;
    u32 Entry;
    u32 Top;
    Rng Gen;

    // m links per node (2m on layer 0), ef candidates while building and searching.
    public static Hnsw New(u32 dim, u32 m, u32 ef, u64 seed) => new Hnsw {
        Dim = dim, M = m, EfBuild = ef, Ef = ef, Vecs = List<f32>.New(), Keys = List<u32>.New(),
        Level = List<u32>.New(), LinkAt = List<u32>.New(), Links = List<List<u32>>.New(), Entry = 0, Top = 0,
        Gen = Rng.Seeded(seed)
    };

    public usize Len(in this) => this.Keys.Len();

    // Candidates searched (at least k); more finds more of the true nearest, slower.
    public void SetEf(ref this, u32 ef) {
        this.Ef = ef;
    }

    f32 Sim(in this, u32 node, f32[] q) => Dot(this.Vecs.AsSlice(), (node * this.Dim) as usize, q);

    u32[] LinksOf(in this, u32 node, u32 layer) => this.Links.AsSlice()[(this.LinkAt.Get(node as usize) + layer) as usize].AsSlice();

    // The ef nodes nearest q on layer, searching out from entry.
    List<Hit> Layer(in this, f32[] q, u32 entry, u32 ef, u32 layer) {
        Map<u32, bool> seen = Map<u32, bool>.New();
        seen.Set(entry, true);
        Hit first = new Hit { Key = entry, Score = this.Sim(entry, q) };
        List<Hit> frontier = List<Hit>.New();
        List<Hit> best = List<Hit>.New();
        frontier.Push(first);
        best.Push(first);
        while (frontier.Len() > 0) {
            Hit c = frontier.Get(0);
            // take the frontier's best
            mut Hit[] fs = frontier.AsMutSlice();
            for (usize i = 0; i + 1 < fs.Len; i++) fs[i] = fs[i + 1];
            frontier.Pop();
            if (best.Len() >= ef as usize && c.Score < best.Get(best.Len() - 1).Score) break;
            u32[] ns = this.LinksOf(c.Key, layer);
            foreach (var n in ns) {
                if (seen.Has(n)) continue;
                seen.Set(n, true);
                f32 s = this.Sim(n, q);
                if (best.Len() < ef as usize || s > best.Get(best.Len() - 1).Score) {
                    Keep(ref frontier, new Hit { Key = n, Score = s }, 1000000);
                    Keep(ref best, new Hit { Key = n, Score = s }, ef as usize);
                }
            }
        }
        return best;
    }

    public void Add(ref this, u32 id, f32[] v) {
        if (v.Len != this.Dim as usize) panic("ai: a vector of the wrong width");
        List<f32> qn = Normalized(v);
        u32 node = this.Keys.Len() as u32;
        foreach (var x in qn.AsSlice()) this.Vecs.Push(x);
        this.Keys.Push(id);
        // the node's top layer: geometric, mean 1 / ln M
        f64 u = 1.0 - this.Gen.Next() as f64;
        u32 level = (0.0 - cm.Ln(u) / cm.Ln(this.M as f64)) as u32;
        if (level > 16) level = 16;
        this.Level.Push(level);
        this.LinkAt.Push(this.Links.Len() as u32);
        for (u32 l = 0; l <= level; l++) this.Links.Push(List<u32>.New());
        if (node == 0) {
            this.Entry = 0;
            this.Top = level;
            return;
        }
        u32 ep = this.Entry;
        u32 l = this.Top;
        while (l > level) {
            List<Hit> h = this.Layer(qn.AsSlice(), ep, 1, l);
            ep = h.Get(0).Key;
            l--;
        }
        u32 start = level;
        if (this.Top < start) start = this.Top;
        u32 layer = start + 1;
        while (layer > 0) {
            layer--;
            List<Hit> near = this.Layer(qn.AsSlice(), ep, this.EfBuild, layer);
            u32 cap = this.M;
            if (layer == 0) cap = 2 * this.M;
            usize take = near.Len();
            if (take > this.M as usize) take = this.M as usize;
            for (usize i = 0; i < take; i++) {
                u32 nb = near.Get(i).Key;
                this.Link(node, nb, layer, cap);
                this.Link(nb, node, layer, cap);
            }
            ep = near.Get(0).Key;
        }
        if (level > this.Top) {
            this.Top = level;
            this.Entry = node;
        }
    }

    // Links from to to on layer, keeping from's cap nearest.
    void Link(ref this, u32 from, u32 to, u32 layer, u32 cap) {
        usize at = (this.LinkAt.Get(from as usize) + layer) as usize;
        mut List<u32>[] all = this.Links.AsMutSlice();
        all[at].Push(to);
        if (all[at].Len() <= cap as usize) return;
        // too many: keep the nearest to from
        List<Hit> keep = List<Hit>.New();
        f32[] vs = this.Vecs.AsSlice();
        usize fo = (from * this.Dim) as usize;
        foreach (var n in all[at].AsSlice()) {
            f32 s = 0.0;
            usize no = (n * this.Dim) as usize;
            for (usize i = 0; i < this.Dim as usize; i++) s += vs[fo + i] * vs[no + i];
            Keep(ref keep, new Hit { Key = n, Score = s }, cap as usize);
        }
        List<u32> kept = List<u32>.New();
        foreach (var h in keep.AsSlice()) kept.Push(h.Key);
        all[at] = kept;
    }

    // The k vectors most similar to q, best first (approximately).
    public List<Hit> Nearest(in this, f32[] q, u32 k) {
        List<Hit> got = List<Hit>.New();
        if (this.Keys.Len() == 0) return got;
        List<f32> qn = Normalized(q);
        u32 ep = this.Entry;
        u32 l = this.Top;
        while (l > 0) {
            List<Hit> h = this.Layer(qn.AsSlice(), ep, 1, l);
            ep = h.Get(0).Key;
            l--;
        }
        u32 ef = this.Ef;
        if (ef < k) ef = k;
        List<Hit> near = this.Layer(qn.AsSlice(), ep, ef, 0);
        for (usize i = 0; i < near.Len() && i < k as usize; i++) {
            Hit h = near.Get(i);
            got.Push(new Hit { Key = this.Keys.Get(h.Key as usize), Score = h.Score });
        }
        return got;
    }
}
