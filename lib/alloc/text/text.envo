// alloc.text: text helpers that return new text (a `string`) or lists. The searching and
// classifying helpers that need no allocation are in core.text; these build on them.
namespace alloc.text;

use core.fmt;
use core.math;
use core.text as ct;

// Sorts items into byte order (core.text.Compare). Stable; an insertion sort, for the
// short lists of names it is used on (directory entries).
public void Sort(ref List<string> items) {
    unsafe {
        *string d = items.Data;
        for (usize i = 1; i < items.Count; i++) {
            usize j = i;
            while (j > 0 && ct.Compare(d[j - 1].AsStr(), d[j].AsStr()) > 0) {
                // a raw swap: neither value is dropped
                string t = d[j];
                d[j] = d[j - 1];
                d[j - 1] = t;
                j--;
            }
        }
    }
}

// v in decimal.
public string Int(i64 v) {
    u8[24] buf;
    usize n = fmt.WriteI64(buf[0..24], v);
    return FromDigits(buf[0..n]);
}

// v in decimal.
public string Uint(u64 v) {
    u8[24] buf;
    usize n = fmt.WriteU64(buf[0..24], v);
    return FromDigits(buf[0..n]);
}

// v in lowercase hexadecimal, at least minDigits digits.
public string Hex(u64 v, usize minDigits) {
    u8[24] buf;
    usize n = fmt.WriteHex(buf[0..24], v, minDigits);
    return FromDigits(buf[0..n]);
}

// ASCII digits and letters as a string.
string FromDigits(u8[] b) {
    string r = string.New();
    for (usize i = 0; i < b.Len; i++) r.AppendByte(b[i]);
    return r;
}

// The pieces of s between the separators. An empty separator splits nothing.
public List<str> Split(str s, str sep) {
    List<str> parts = List<str>.New();
    if (sep.Len == 0) {
        parts.Push(s);
        return parts;
    }
    usize start = 0;
    usize i = 0;
    while (i + sep.Len <= s.Len) {
        if (ct.MatchesAt(s, i, sep)) {
            parts.Push(s[start..i]);
            i += sep.Len;
            start = i;
        } else {
            i++;
        }
    }
    parts.Push(s[start..s.Len]);
    return parts;
}

// The lines of s, without their line endings (`\n` or `\r\n`); no empty last line for
// a final line break.
public List<str> Lines(str s) {
    List<str> lines = List<str>.New();
    usize start = 0;
    for (usize i = 0; i < s.Len; i++) {
        if (s[i] == 10) {
            usize end = i;
            if (end > start && s[end - 1] == 13) end--;
            lines.Push(s[start..end]);
            start = i + 1;
        }
    }
    if (start < s.Len) lines.Push(s[start..s.Len]);
    return lines;
}

// The parts, with sep between them.
public string Join(str[] parts, str sep) {
    string joined = string.New();
    for (usize i = 0; i < parts.Len; i++) {
        if (i > 0) joined.Append(sep);
        joined.Append(parts[i]);
    }
    return joined;
}

// s with every from replaced by to (left to right, not overlapping).
public string Replace(str s, str from, str to) {
    string r = string.New();
    if (from.Len == 0) {
        r.Append(s);
        return r;
    }
    usize i = 0;
    usize start = 0;
    while (i + from.Len <= s.Len) {
        if (ct.MatchesAt(s, i, from)) {
            r.Append(s[start..i]);
            r.Append(to);
            i += from.Len;
            start = i;
        } else {
            i++;
        }
    }
    r.Append(s[start..s.Len]);
    return r;
}

// s, n times.
public string Repeat(str s, usize n) {
    string r = string.New();
    for (usize i = 0; i < n; i++) r.Append(s);
    return r;
}

// ASCII letters in lower case; everything else unchanged.
public string Lower(str s) {
    string r = string.New();
    for (usize i = 0; i < s.Len; i++) r.AppendByte(ct.ToLower(s[i]));
    return r;
}

// ASCII letters in upper case; everything else unchanged.
public string Upper(str s) {
    string r = string.New();
    for (usize i = 0; i < s.Len; i++) r.AppendByte(ct.ToUpper(s[i]));
    return r;
}

// s padded on the left with fill to at least width characters.
public string PadLeft(str s, usize width, u8 fill) {
    string r = string.New();
    usize n = ct.CharCount(s);
    while (n < width) {
        r.AppendByte(fill);
        n++;
    }
    r.Append(s);
    return r;
}

// s padded on the right with fill to at least width characters.
public string PadRight(str s, usize width, u8 fill) {
    string r = string.From(s);
    usize n = ct.CharCount(s);
    while (n < width) {
        r.AppendByte(fill);
        n++;
    }
    return r;
}

// v with digits digits after the point (at most 17): "19.635", "-0.50", "1.000e+20" for
// magnitudes of 10^15 and up, "NaN", "inf", "-inf" (RFC 0006). The last digit is
// rounded, halves away from zero.
public string Float(f64 v, u32 digits) {
    string s = string.New();
    if (v != v) return string.From("NaN");
    f64 x = v;
    if (math.Bits(x) >> 63 == 1) {
        s.AppendByte('-');
        x = 0.0 - x;
    }
    if (math.IsInfinite(x)) {
        s.Append("inf");
        return s;
    }
    u32 d = digits;
    if (d > 17) d = 17;
    if (x >= 1e15) {
        // scientific: one digit, the point, d digits, the exponent
        i64 e = 0;
        f64 m = x;
        while (m >= 10.0) {
            m = m / 10.0;
            e++;
        }
        AppendFixed(ref s, m, d);
        s.Append("e+");
        s.Append(Int(e).AsStr());
        return s;
    }
    AppendFixed(ref s, x, d);
    return s;
}

// x (0 <= x < 10^15) with d digits after the point.
void AppendFixed(ref string s, f64 x, u32 d) {
    u64 scale = 1;
    for (u32 k = 0; k < d; k++) scale = scale * 10;
    f64 whole = math.Floor(x);
    f64 frac = math.Round((x - whole) * (scale as f64));
    u64 w = whole as u64;
    u64 f = frac as u64;
    if (f >= scale) {
        // the fraction rounded up to the next whole number
        w++;
        f -= scale;
    }
    s.Append(Uint(w).AsStr());
    if (d == 0) return;
    s.AppendByte('.');
    string fs = Uint(f);
    for (usize k = fs.Len(); k < d as usize; k++) s.AppendByte('0');
    s.Append(fs.AsStr());
}

// v with up to 15 significant digits and no trailing zeros: "0.1", "19.635", "3", "1e+20".
public string FloatShort(f64 v) {
    if (v != v || math.IsInfinite(v)) return Float(v, 0);
    f64 a = math.FAbs(v);
    u32 digits = 15;
    if (a >= 1e15) {
        digits = 14;
    } else if (a >= 1.0) {
        // 15 significant digits: fewer after the point as the whole part grows
        f64 p = 1.0;
        while (p * 10.0 <= a && digits > 1) {
            p = p * 10.0;
            digits--;
        }
        digits--;
    }
    string s = Float(v, digits);
    // drop trailing zeros after the point (not in an exponent)
    str t = s.AsStr();
    if (!ct.Contains(t, ".")) return s;
    usize ePos = t.Len;
    usize? ei = ct.IndexOfByte(t, 'e');
    if (ei.IsSome()) ePos = ei.Unwrap();
    usize end = ePos;
    while (end > 0 && t[end - 1] == '0') end--;
    if (end > 0 && t[end - 1] == '.') end--;
    string r = string.From(t[0..end]);
    r.Append(t[ePos..t.Len]);
    return r;
}
