; =============================================================================
; envoc0-windows.eas - top-level build unit: envoc0 for x86-64 Windows (PE32+)
;
; Assemble as one flat binary (Phase A: nasm -f bin -I bootstrap/stage0/).
; The platform file must come first because it holds the executable header.
; =============================================================================
        bits    64
        default rel

%include "platform/windows.eas"

; Shared sources, in dependency order: constants are defined before code that
; uses them (docs/spec/eas.md section 4), and data tables come first.
%include "src/tokens.eas"
%include "src/diag.eas"
%include "src/mem.eas"
%include "src/io.eas"
%include "src/utf8.eas"
%include "src/lexer.eas"
%include "src/main.eas"

image_end:
        ; Pad the file to the PE file alignment; SizeOfRawData is a multiple of it.
        times (PE_ALIGN - (($ - $$) % PE_ALIGN)) % PE_ALIGN db 0
pe_file_end:
