// Declarations: the three passes over the program, and everything they resolve lazily
// (types, struct layouts, enum values, constants, signatures). Follows Stage 0's
// check_program, resolve_type, size_of, struct_layout, enum_declare, const_resolve,
// static_declare and fn_signature.

// Checks a parsed program. Reports the first error and exits; returns if it is valid.
void CheckProgram(*Checker c, u32 program) {
    InitScope(c);
    u32 first = CNode(c, program).A;
    // pass 1: collect item names
    u32 n = first;
    while (n != 0) {
        u16 k = NKind(c, n);
        u8 sk = 0;
        if (k == NK_FN) sk = SK_FN;
        else if (k == NK_STRUCT) sk = SK_STRUCT;
        else if (k == NK_ENUM) sk = SK_ENUM;
        else if (k == NK_CONST) sk = SK_CONST;
        else if (k == NK_STATIC) sk = SK_STATIC;
        if (sk != 0) DefineItem(c, n, sk);
        n = CNode(c, n).Next;
    }
    // pass 2: declarations, in program order
    n = first;
    while (n != 0) {
        u16 k = NKind(c, n);
        u32 s = NSym(c, n);
        if (k == NK_STRUCT) StructLayout(c, s, 0);
        else if (k == NK_ENUM) EnumDeclare(c, s);
        else if (k == NK_CONST) ConstResolve(c, s, 0);
        else if (k == NK_STATIC) StaticDeclare(c, s);
        else if (k == NK_FN) FnSignature(c, s);
        n = CNode(c, n).Next;
    }
    // pass 3: bodies; the top-level statements are the body of main
    unsafe {
        c.LSP = 0;
        c.LBase = 0;
    }
    n = first;
    while (n != 0) {
        u16 k = NKind(c, n);
        if (k == NK_FN) {
            FnBody(c, NSym(c, n));
        } else if (!NodeIsItem(k)) {
            unsafe {
                c.Ret = T_I32;
                c.Top = true;
                c.Unsafe = 0;
                c.Loops = 0;
            }
            CheckStmt(c, n);
        }
        n = CNode(c, n).Next;
    }
}

// Pass 1 for one item: its symbol (E0201 if the name is taken).
void DefineItem(*Checker c, u32 n, u8 kind) {
    u32 tok = NTok(c, n);
    if (GFind(c, TokText(c, tok)) != 0) CFailName(c, tok, E_DUPLICATE, "`", tok, "` is already defined");
    u32 s = SymNew(c, kind, n);
    SetNSym(c, n, s);
    if (kind == SK_STRUCT || kind == SK_ENUM) {
        u8 tk = TYK_STRUCT;
        if (kind == SK_ENUM) tk = TYK_ENUM;
        u32 t = TypeNamed(c, tk, s);
        unsafe { SymPtr(c, s).Type = t; }
    }
    GAdd(c, s);
}

// The type a type node denotes ([core.name.3], [core.type.1]).
u32 ResolveType(*Checker c, u32 n, bool voidOk) {
    Node node = CNode(c, n);
    u32 t = 0;
    if (node.Kind == NK_TPTR) {
        t = TypePtrTo(c, ResolveType(c, node.A, false));
    } else if (node.Kind == NK_TSLICE) {
        t = TypeDerived(c, TYK_SLICE, ResolveType(c, node.A, false), 0);
    } else if (node.Kind == NK_TARRAY) {
        u32 elem = ResolveType(c, node.A, false);
        u32 countNode = node.B;
        u32 countTok = NTok(c, countNode);
        u64 count = 0;
        if (NKind(c, countNode) == NK_INT) {
            bool overflow;
            unsafe { count = LiteralValue(c, countTok, &overflow); }
            if (overflow) DoesNotFit(c, countTok, T_USIZE);
            SetNType(c, countNode, T_USIZE);
        } else {
            u32 s = GFind(c, TokText(c, countTok));
            if (s == 0) CFailName(c, countTok, E_UNKNOWN_NAME, "unknown name `", countTok, "`");
            if (SymGet(c, s).Kind != SK_CONST) CError(c, E_NOT_CONSTANT, countTok);
            ConstResolve(c, s, countTok);
            Sym sym = SymGet(c, s);
            if (!IsIntType(c, sym.Type)) CError(c, E_NOT_CONSTANT, countTok);
            SetNType(c, countNode, sym.Type);
            count = sym.Value;
            if (TypeGet(c, sym.Type).Signed && (count as i64) < 0) CError(c, E_NOT_CONSTANT, countTok);
        }
        u32 saturated = 0x80000000;
        if (count < 0x80000000) saturated = count as u32;
        t = TypeDerived(c, TYK_ARRAY, elem, saturated);
    } else {
        u32 tok = node.Tok;
        u32 s = GFind(c, TokText(c, tok));
        if (s == 0) CFailName(c, tok, E_UNKNOWN_TYPE, "unknown type `", tok, "`");
        u8 k = SymGet(c, s).Kind;
        if (k != SK_TYPE && k != SK_STRUCT && k != SK_ENUM) CFailName(c, tok, E_NOT_A_TYPE, "`", tok, "` is not a type");
        t = SymGet(c, s).Type;
    }
    if (t == T_VOID && !voidOk) CError(c, E_VOID_TYPE, node.Tok);
    return t;
}

// Size and alignment of a type, laying out structs on demand. blame is the token to
// report a struct cycle or a size overflow at.
u64 SizeOf(*Checker c, u32 t, u32 blame, *u64 align) {
    Type ty = TypeGet(c, t);
    unsafe {
        if (ty.Kind == TYK_STRUCT) {
            StructLayout(c, ty.Sym, blame);
            Sym s = SymGet(c, ty.Sym);
            *align = s.Aux2 as u64;
            return s.Aux as u64;
        }
        if (ty.Kind == TYK_ENUM) {
            EnumDeclare(c, ty.Sym);
            Type repr = TypeGet(c, SymGet(c, ty.Sym).Aux);
            *align = repr.Align as u64;
            return repr.Size as u64;
        }
        if (ty.Kind == TYK_ARRAY) {
            u64 elemSize = SizeOf(c, ty.Elem, blame, align);
            // both factors are below 2^31, so the product fits in 64 bits
            u64 size = elemSize * ty.Count as u64;
            if (size > MAX_TYPE_SIZE) CError(c, E_TOO_LARGE, blame);
            return size;
        }
        *align = ty.Align as u64;
    }
    return ty.Size as u64;
}

// Lays out struct symbol s ([core.type.2]). blame: the token to report E0303 at.
void StructLayout(*Checker c, u32 s, u32 blame) {
    Sym sym = SymGet(c, s);
    if (sym.LState == 2) return;
    if (sym.LState == 1) CFailName(c, blame, E_RECURSIVE, "struct `", NTok(c, sym.Node), "` contains itself");
    unsafe { SymPtr(c, s).LState = 1; }
    u64 offset = 0;
    u64 maxAlign = 1;
    u32 first = CNode(c, sym.Node).A;
    u32 f = first;
    while (f != 0) {
        CheckDuplicateInList(c, first, f);
        u32 ft = ResolveType(c, CNode(c, f).A, false);
        u64 align;
        u64 size;
        unsafe { size = SizeOf(c, ft, NTok(c, f), &align); }
        offset = (offset + align - 1) & ~(align - 1);
        if (maxAlign < align) maxAlign = align;
        SetNValue(c, f, offset);
        SetNType(c, f, ft);
        offset += size;
        if (offset > MAX_TYPE_SIZE) CError(c, E_TOO_LARGE, NTok(c, sym.Node));
        f = CNode(c, f).Next;
    }
    offset = (offset + maxAlign - 1) & ~(maxAlign - 1);
    if (offset > MAX_TYPE_SIZE) CError(c, E_TOO_LARGE, NTok(c, sym.Node));
    unsafe {
        *Sym p = SymPtr(c, s);
        p.Aux = offset as u32;
        p.Aux2 = maxAlign as u32;
        p.LState = 2;
    }
}

// E0201 if node n's name matches an earlier node in the list starting at first.
void CheckDuplicateInList(*Checker c, u32 first, u32 n) {
    u32 tok = NTok(c, n);
    u32 m = first;
    while (m != n) {
        if (SameName(c, NTok(c, m), tok)) CFailName(c, tok, E_DUPLICATE, "`", tok, "` is already defined");
        m = CNode(c, m).Next;
    }
}

// Representation and variant values of enum symbol s ([core.type.4]). Re-entry while in
// progress returns quietly: a value that names a later variant then reports E0206.
void EnumDeclare(*Checker c, u32 s) {
    Sym sym = SymGet(c, s);
    if (sym.State != 0) return;
    unsafe { SymPtr(c, s).State = 1; }
    u32 repr = T_I32;
    Node en = CNode(c, sym.Node);
    if (en.A != 0) {
        repr = ResolveType(c, en.A, false);
        if (!IsIntType(c, repr)) CError(c, E_BAD_REPR, NTok(c, en.A));
    }
    unsafe { SymPtr(c, s).Aux = repr; }
    u32 first = en.B;
    u32 v = first;
    u64 prev = 0;
    bool seen = false;
    while (v != 0) {
        CheckDuplicateInList(c, first, v);
        u32 valueNode = CNode(c, v).A;
        u64 value = 0;
        if (valueNode != 0) {
            ExpectType(c, valueNode, repr);
            value = ConstEval(c, valueNode);
            if (!ValueFits(c, value, repr)) DoesNotFit(c, NTok(c, valueNode), repr);
        } else if (seen) {
            if (prev == TypeMax(c, repr)) DoesNotFit(c, NTok(c, v), repr);
            value = prev +% 1;
        }
        // [core.type.4] values must be distinct
        u32 w = first;
        while (w != v) {
            if (NValue(c, w) == value) CError(c, E_DUPLICATE_VALUE, NTok(c, v));
            w = CNode(c, w).Next;
        }
        SetNValue(c, v, value);
        SetNType(c, v, sym.Type);      // marks the variant as defined
        prev = value;
        seen = true;
        v = CNode(c, v).Next;
    }
    unsafe { SymPtr(c, s).State = 2; }
}

// Type and value of const symbol s ([core.const.2]). blame: where to report E0309.
void ConstResolve(*Checker c, u32 s, u32 blame) {
    Sym sym = SymGet(c, s);
    if (sym.State == 2) return;
    if (sym.State == 1) CFailName(c, blame, E_CONST_CYCLE, "constant `", NTok(c, sym.Node), "` depends on itself");
    unsafe { SymPtr(c, s).State = 1; }
    Node n = CNode(c, sym.Node);
    u32 t = ResolveType(c, n.A, false);
    unsafe { SymPtr(c, s).Type = t; }
    ExpectType(c, n.B, t);
    u64 value = ConstEval(c, n.B);
    unsafe {
        *Sym p = SymPtr(c, s);
        p.Value = value;
        p.State = 2;
    }
}

// Type and initial value of static symbol s ([core.const.3]).
void StaticDeclare(*Checker c, u32 s) {
    Sym sym = SymGet(c, s);
    Node n = CNode(c, sym.Node);
    u32 t = ResolveType(c, n.A, false);
    u64 align;
    unsafe { SizeOf(c, t, n.Tok, &align); }
    unsafe { SymPtr(c, s).Type = t; }
    if (n.B == 0) return;
    ExpectType(c, n.B, t);
    u64 value = ConstEval(c, n.B);     // must be a constant
    if (IsScalarValue(c, t)) {
        unsafe {
            *Sym p = SymPtr(c, s);
            p.Value = value;
            p.State = 2;        // the dump prints " = value"
        }
    }
}

// Is type t an integer, bool or enum (a printable constant)?
bool IsScalarValue(*Checker c, u32 t) {
    u8 k = TyKind(c, t);
    return k == TYK_INT || k == TYK_BOOL || k == TYK_ENUM;
}

// Return and parameter types of function symbol s.
void FnSignature(*Checker c, u32 s) {
    Node fn = CNode(c, SymGet(c, s).Node);
    u32 ret = ResolveType(c, fn.A, true);
    u32 count = 0;
    u32 p = fn.B;
    while (p != 0) {
        count++;
        p = CNode(c, p).Next;
    }
    unsafe {
        *Sym sym = SymPtr(c, s);
        sym.Type = ret;
        sym.Aux = count;
        sym.Params = VecLen(&c.ParamTypes) as u32;
        for (u32 i = 0; i < count; i++) VecPush(&c.ParamTypes);
    }
    u32 first = fn.B;
    p = first;
    u32 i = 0;
    while (p != 0) {
        CheckDuplicateInList(c, first, p);
        u32 pt = ResolveType(c, CNode(c, p).A, false);
        u64 align;
        unsafe {
            SizeOf(c, pt, NTok(c, p), &align);
            MemStoreU32(VecAt(&c.ParamTypes, (SymGet(c, s).Params + i) as usize), pt);
        }
        SetNType(c, p, pt);
        i++;
        p = CNode(c, p).Next;
    }
}

// Checks the body of function symbol s.
void FnBody(*Checker c, u32 s) {
    Sym sym = SymGet(c, s);
    Node fn = CNode(c, sym.Node);
    usize saved;
    unsafe {
        saved = c.LSP;
        c.LBase = saved;        // main's locals are not visible here
        c.Ret = sym.Type;
        c.Top = false;
        c.Unsafe = 0;
        c.Loops = 0;
    }
    // the parameters are the first locals
    u32 p = fn.B;
    while (p != 0) {
        LocalPush(c, p, NType(c, p));
        p = CNode(c, p).Next;
    }
    bool terminates = false;
    if (NKind(c, fn.C) == NK_BLOCK) {
        terminates = CheckStmt(c, fn.C);
    } else if (sym.Type == T_VOID) {
        if (NKind(c, fn.C) != NK_CALL) CError(c, E_NO_EFFECT, NTok(c, fn.C));
        CheckExpr(c, fn.C, 0);
        terminates = IsNoreturnCall(c, fn.C);
    } else {
        ExpectType(c, fn.C, sym.Type);
        terminates = true;
    }
    if (sym.Type != T_VOID && !terminates) CError(c, E_MISSING_RETURN, fn.Tok);
    unsafe {
        c.LSP = saved;
        c.LBase = 0;
    }
}
