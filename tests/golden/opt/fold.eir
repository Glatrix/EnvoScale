eir 1 target "x86_64-linux"

; constants fold through arithmetic, compares and conversions; a checked add that
; overflows and a division by zero stay, since they must panic
func @Fold() -> i32 {
^bb0:
  %0 = const i32 6
  %1 = const i32 7
  %2 = mul.chk i32 %0, %1
  %3 = const i8 127
  %4 = const i8 1
  %5 = add.wrap i8 %3, %4
  %6 = sext i8 -> i32 %5
  %7 = add.chk i32 %2, %6
  %8 = cmp.lt i32 %7, %0
  %9 = select i32 %8, %0, %7
  ret %9
}

func @Overflow() -> u8 {
^bb0:
  %0 = const u8 255
  %1 = const u8 1
  %2 = add.chk u8 %0, %1
  %3 = const u8 0
  %4 = div u8 %1, %3
  ret %2
}
