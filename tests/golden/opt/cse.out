eir 1 target "x86_64-linux"

func @Twice(%0: ptr, %1: i64, %2: i64) -> i64 {
^bb0:
  %3 = add.wrap i64 %1, %2
  store i64 %3, %0
  %4 = add.wrap i64 %3, %3
  %5 = add.wrap i64 %4, %3
  ret %5
}

func @Checked(%0: u64, %1: u64) -> u64 {
^bb0:
  %2 = cmp.lt u64 %0, %1
  condbr %2, ^bb1, ^bb2
^bb1:
  br ^bb2
^bb2:
  ret %0
}
