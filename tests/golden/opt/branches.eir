eir 1 target "x86_64-linux"

; a branch on a constant becomes a jump; the dead arm goes, the blocks merge, and the
; block parameter that gets one value is replaced by it
func @Pick(%0: i64) -> i64 {
^bb0:
  %1 = const bool 1
  condbr %1, ^bb1(%0), ^bb2
^bb1(%2: i64):
  %3 = const i64 1
  %4 = add.wrap i64 %2, %3
  br ^bb3(%4)
^bb2:
  panic "unreachable code reached"
^bb3(%5: i64):
  ret %5
}

; a loop keeps its blocks; a parameter passed itself or one value is that value
func @Loop(%0: i64) -> i64 {
^bb0:
  br ^bb1(%0, %0)
^bb1(%1: i64, %2: i64):
  %3 = const i64 1
  %4 = sub.wrap i64 %1, %3
  %5 = const i64 0
  %6 = cmp.eq i64 %4, %5
  condbr %6, ^bb2(%2), ^bb1(%4, %2)
^bb2(%7: i64):
  ret %7
}
