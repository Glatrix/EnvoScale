eir 1 target "x86_64-linux"

type $Pair = { i64, i64 }

func @Second(%0: ptr) -> i64 {
^bb0:
  %1 = slot $Pair
  %2 = const u64 16
  copy %1, %0, %2
  %3 = fieldaddr $Pair %1, 1
  %4 = load i64 %3
  ret %4
}

func @Use(%0: ptr) -> i64 {
^bb0:
  %1 = slot $Pair
  %2 = slot $Pair
  %3 = const u64 16
  zero %1, %3
  %4 = const u64 16
  copy %1, %0, %4
  %5 = fieldaddr $Pair %1, 1
  %6 = load i64 %5
  %7 = const u64 16
  zero %2, %7
  %8 = const u64 16
  copy %2, %0, %8
  %9 = fieldaddr $Pair %2, 1
  %10 = load i64 %9
  %11 = add.wrap i64 %6, %10
  ret %11
}
