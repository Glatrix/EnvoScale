eir 1 target "x86_64-linux"

type $Point = { i64, i64 }

global @msg: [5 x u8] readonly = bytes "hello"
global @origin: $Point = zero
global @table: ptr = @msg

func @Main() -> void {
^bb0:
  %0 = slot $Point
  %1 = fieldaddr $Point %0, 0
  %2 = const i64 1
  store i64 %2, %1
  %3 = addr @msg
  %4 = const u64 5
  %5 = const i32 1
  intrinsic write(%5, %3, %4)
  %6 = load i64 %1
  %7 = call @Pick(%6)
  switch i64 %7, [-1: ^bb1, 0: ^bb2], ^bb3
^bb1:
  panic "integer overflow"
^bb2:
  unreachable
^bb3:
  slot.end %0
  ret
}

func @Pick(%0: i64) -> i64 {
^bb0:
  ret %0
}

extern @puts(%0: ptr) -> i32 abi "C"
