// A small complete Envo-Core program: count the lines of a file.
const usize BUF_SIZE = 4096;

struct Counter {
    usize Lines;
    usize Bytes;
}

void Feed(*Counter c, *u8 data, usize n) {
    unsafe {
        for (usize i = 0; i < n; i++) {
            c.Bytes++;
            if (data[i] == '\n') c.Lines++;
        }
    }
}

i32 CountFile(str path) {
    i32 fd = open(path, 0);
    if (fd < 0) return -1;
    Counter c = new Counter {};
    *u8 buf = alloc(BUF_SIZE);
    while (true) {
        isize got = read(fd, buf, BUF_SIZE);
        if (got <= 0) break;
        unsafe { Feed(&c, buf, got as usize); }
    }
    close(fd);
    return c.Lines as i32;
}

if (argc() < 2) {
    print("usage: count <file>");
    return 2;
}
i32 lines = CountFile(arg(1));
if (lines < 0) panic("cannot read the file");
return 0;
