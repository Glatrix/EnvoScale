// Fields, views, indexing, variants and `new` ([core.expr.6], [core.expr.7], [core.expr.10]).
struct Inner { i32 V; u8[4] Bytes; }
struct Outer { Inner In; *Inner Ref; str Label; }
enum Kind : u8 { First = 1, Second }
