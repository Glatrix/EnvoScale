// Views, slicing and foreach ([expr.slice.1]–[expr.slice.5], [view.1]–[view.6],
// [s1.stmt.1]): slices of arrays, views and `str` (on character boundaries), every bound
// form, `mut T[]` writes and reborrows, `slice_from`, and foreach over arrays, views,
// `str` bytes and ranges, with `break` and `continue`.
// expect: 15 2 3 4 5
// expect: 3 4 3 5
// expect: héllo é llo
// expect: 1 4 9 16 25
// expect: 0 1 2 3 x 5
// expect: 104 105
// expect: 15 10 45
// expect: 6
// expect-panic: str slice is not on a character boundary
str Num(i64 v) {
    *u8 buf = alloc(24);
    usize at = 24;
    bool negative = v < 0;
    u64 n;
    if (negative) { n = (0 -% v) as u64; } else { n = v as u64; }
    unsafe {
        while (true) {
            at--;
            buf[at] = (48 + n % 10) as u8;
            n /= 10;
            if (n == 0) break;
        }
        if (negative) { at--; buf[at] = '-'; }
        return str_from(&buf[at], 24 - at);
    }
}
void W(i64 v) { write(1, Num(v)); write(1, " "); }

i64 Sum(i64[] xs) {
    i64 s = 0;
    foreach (var x in xs) s += x;
    return s;
}

void Square(mut i64[] xs) {
    for (usize i = 0; i < xs.Len; i++) xs[i] = xs[i] * xs[i];
}

// a `mut T[]` passed on is reborrowed, so it can be used again
void SquareTwice(mut i64[] xs) {
    Square(xs);
    Square(xs[0..1]);
}

i64[5] a;
for (usize i = 0; i < 5; i++) a[i] = (i + 1) as i64;
W(Sum(a[..]));
i64[] tail = a[1..];
foreach (var x in tail) {
    if (x == 5) print(Num(x));
    else W(x);
}

i64[] mid = a[2..4];
W(mid[0]);
W(mid.Len as i64 + 2);
W(a[..=2].Len as i64);
print(Num(a[4..=4][0]));

str word = "héllo";
write(1, word);
write(1, " ");
write(1, word[1..3]);
write(1, " ");
print(word[3..]);

// `a` is borrowed by the views above, so the squares go into a copy
i64[5] sq = a;
Square(sq[..]);
foreach (var x in sq) {
    if (x == 25) print(Num(x));
    else W(x);
}

i64[6] b;
foreach (var i in 0..6) b[i] = i as i64;
foreach (var i in 0..=5) {
    if (i == 4) {
        write(1, "x ");
        continue;
    }
    if (i == 5) {
        print(Num(b[i]));
        break;
    }
    W(b[i]);
}

foreach (var ch in "hi") {
    if (ch == 'i') print(Num(ch as i64));
    else W(ch as i64);
}

i64[3] c;
c[0] = 1;
c[1] = 2;
c[2] = 3;
SquareTwice(c[..]);
W(Sum(c[..]) + 1);
unsafe {
    i64[] raw = slice_from(&c[0], 2);
    W(raw[0] + raw[1] + 5);
    mut i64[] w = slice_from_mut<i64>(&c[1], 2);
    w[1] = 40;
}
print(Num(c[2] + 5));

u8 last = 0;
foreach (var i in 250..=255) last = i as u8;
print(Num(last as i64 - 249));

str bad = word[0..2];
print(bad);
