// Fuzz target (tools/fuzz): eon on the bytes of the file named by the first argument.
// A panic is a bug. Run: envo fuzz tests/fuzz/eon.envol --corpus <a copy of corpus/eon>
use std.env;
use std.fs;
use envo.eon;
var r = fs.ReadText(env.Arg(1));
if (r.IsErr()) return;
string data = r.Unwrap();
str d = data.AsStr();
var p = eon.Parse(d);
if (p.IsOk()) {
    eon.Value v = p.Unwrap();
    string w = eon.Write(v);
}
