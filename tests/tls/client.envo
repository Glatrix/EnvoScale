// The TLS 1.3 client against a real server (tests/tls/README.md): envo.tls connects to
// 127.0.0.1:<port> as "localhost", trusting only the CA in <ca.pem>, sends a GET and
// prints the response's first line, or why the connection failed.
// args: <ca.pem> <port>
use envo.tls;
use envo.crypto.x509;
use std.env;
use std.fs;
use core.text as ct;
use ports.{INet, IoError};
use platform;

string pem = fs.ReadText(env.Arg(1)).Unwrap();
str portText = env.Arg(2);
u16 port = 0;
for (usize i = 0; i < portText.Len; i++) port = port * 10 + (portText[i] - '0') as u16;
List<x509.Certificate> trust = tls.RootsFromPem(pem.AsStr());
var net = platform.Net();
Result<tls.Conn, string> r = tls.ConnectWith(ref net, "localhost", port, trust, "");
match r {
    Err(why) => {
        write(1, "failed: ");
        print(why.AsStr());
    }
    Ok(conn) => {
        tls.Conn c = conn;
        str req = "GET / HTTP/1.0\r\n\r\n";
        List<u8> b = List<u8>.New();
        for (usize i = 0; i < req.Len; i++) b.Push(req[i]);
        tls.Send(ref net, ref c, b.AsSlice());
        string got = string.New();
        u8[4096] buf;
        while (true) {
            Result<usize, IoError> n = tls.Recv(ref net, ref c, buf[0..4096]);
            if (n.IsErr() || n.Unwrap() == 0) break;
            for (usize i = 0; i < n.Unwrap(); i++) got.AppendByte(buf[i]);
        }
        usize? end = ct.IndexOfByte(got.AsStr(), 13);
        if (end.IsSome()) print(got.AsStr()[0..end.Unwrap()]);
        else print("no response");
    }
}
