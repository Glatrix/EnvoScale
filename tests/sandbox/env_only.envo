// --allow env,read:env_only.envo: a comma list; environment variables, and reading one
// named file.
// allow: env,read:env_only.envo
// expect: env ok
// expect: this file ok
// expect: other denied
use std.fs;
use std.env;
use ports.{IoError};

bool IsDenied<T>(Result<T, IoError> r) {
    match r {
        Ok(_) => { return false; }
        Err(e) => { return e == IoError.Denied; }
    }
}

if (env.Var("PATH").IsSome()) print("env ok");
if (fs.ReadText("env_only.envo").IsOk()) print("this file ok");
if (IsDenied(fs.ReadText("paths.envo"))) print("other denied");
