// --allow fs:box: reading and writing under box/ only; `..` cannot climb out of it.
// allow: fs:box
// expect: box ok
// expect: outside denied
// expect: climb denied
// expect: read outside denied
// expect-stderr: envo: permission denied: the script needs `--allow write` (or `--allow write:
use std.fs;
use ports.{IoError};

bool IsDenied<T>(Result<T, IoError> r) {
    match r {
        Ok(_) => { return false; }
        Err(e) => { return e == IoError.Denied; }
    }
}

fs.Delete("box/a.txt");
fs.RemoveDir("box");
bool made = fs.CreateDir("box").IsOk();
if (made && fs.WriteText("box/a.txt", "inside").IsOk() && fs.ReadText("box/a.txt").IsOk() && fs.Delete("box/a.txt").IsOk()) print("box ok");
if (IsDenied(fs.WriteText("outside.txt", "x"))) print("outside denied");
if (IsDenied(fs.WriteText("box/../climb.txt", "x"))) print("climb denied");
if (IsDenied(fs.ReadText("paths.envol"))) print("read outside denied");
fs.RemoveDir("box");
