// Without --allow a script has its console and nothing else: files, environment
// variables and other programs are denied, and envo says what to allow.
// expect: console ok
// expect: read denied
// expect: write denied
// expect: list denied
// expect: mkdir denied
// expect: env none
// expect: run refused
// expect-stderr: envo: permission denied: the script needs `--allow read`
// expect-stderr: envo: permission denied: the script needs `--allow write`
use std.fs;
use std.env;
use std.process;
use ports.{IoError};

bool IsDenied<T>(Result<T, IoError> r) {
    match r {
        Ok(_) => { return false; }
        Err(e) => { return e == IoError.Denied; }
    }
}

print("console ok");
if (IsDenied(fs.ReadText("nothing.envol"))) print("read denied");
if (IsDenied(fs.WriteText("out.txt", "x"))) print("write denied");
if (IsDenied(fs.ListDir("."))) print("list denied");
if (IsDenied(fs.CreateDir("made"))) print("mkdir denied");
if (env.Var("PATH").IsNone()) print("env none");
List<str> none = List<str>.New();
if (process.Run("envo-sandbox-no-such-program", none.AsSlice()).IsErr()) print("run refused");
