// The EnvoScale website (website/PLAN.md, phase 1; PLAN D52), written in Envo. The home
// page uses Lumen's Landing template; every Markdown document of the repository uses
// the Docs template. Pages keep the repository's paths (docs/spec/eir.md becomes
// docs/spec/eir.html), so the documents' links to each other work, and every link is
// relative, so the site works under any address.
//
//   envo build website/site.envo -o build/site-tool    (or envoc build --lib .)
//   build/site-tool build [folder]    static files into folder (default build/site)
//   build/site-tool serve [port]      the same pages, rendered per request (default 8080)
//
// Run it from the repository's root. Static generation and serving are one code path:
// a page is a function from a request to a response (envo.web).
use envo.web;
use envo.web.templates;
use envo.markdown;
use envo.lumen;
use envo.http;
use std.fs;
use std.env;
use alloc.text;

const str SITE = "EnvoScale";

// ------------------------------------------------------------------ the pages

// The Markdown files the site publishes, as repository paths ("docs/spec/eir.md").
List<string> Sources() {
    List<string> all = List<string>.New();
    List<string> dirs = List<string>.New();
    dirs.Push(string.From("."));
    while (dirs.Len() > 0) {
        string dir = dirs.Pop().Unwrap();
        var r = fs.ListDir(dir.AsStr());
        if (r.IsErr()) continue;
        List<string> names = r.Unwrap();
        string[] ns = names.AsSlice();
        for (usize i = 0; i < ns.Len; i++) {
            str n = ns[i].AsStr();
            if (n.Len == 0 || n[0] == '.') continue;
            string p = string.New();
            if (!dir.Equals(".")) {
                p.Append(dir.AsStr());
                p.AppendByte('/');
            }
            p.Append(n);
            if (fs.IsDir(p.AsStr())) {
                if (IsText(n, "build") || IsText(n, "node_modules")) continue;
                dirs.Push(p);
            } else if (HasSuffix(n, ".md") && !IsText(n, "ENVOSCALE_PROMPT.md")) {
                all.Push(p);
            }
        }
    }
    return all;
}

// The site path of a repository Markdown file: "/docs/spec/eir.html".
string PageOf(str source) {
    string s = string.From("/");
    s.Append(source[0..source.Len - 3]);
    s.Append(".html");
    return s;
}

// target, relative to the page at path from (both site paths starting with "/").
string Rel(str from, str target) {
    string s = string.New();
    for (usize i = 1; i < from.Len; i++) {
        if (from[i] == '/') s.Append("../");
    }
    if (target.Len <= 1) s.Append("index.html");
    else s.Append(target[1..target.Len]);
    return s;
}

// A document's title: its first level-1 heading (only that line is rendered), else its
// file name.
string TitleOf(str source) {
    var r = fs.ReadText(source);
    if (r.IsOk()) {
        string src = r.Unwrap();
        str t = src.AsStr();
        usize i = 0;
        while (i < t.Len) {
            usize e = i;
            while (e < t.Len && t[e] != 10) e++;
            if (e - i > 2 && t[i] == '#' && t[i + 1] == ' ') {
                markdown.Doc d = markdown.Render(t[i..e], markdown.Options.Site());
                if (d.Title().Len > 0) return string.From(d.Title());
            }
            i = e + 1;
        }
    }
    return string.From(source);
}

void Add(ref List<templates.NavItem> nav, str from, str title, str source, u32 depth) {
    if (!fs.IsFile(source)) return;
    string page = PageOf(source);
    string href = Rel(from, page.AsStr());
    nav.Push(templates.NavItem.Link(title, href.AsStr(), depth));
}

void Group(ref List<templates.NavItem> nav, str from, str title, str dir) {
    nav.Push(templates.NavItem.Heading(title));
    var r = fs.ListDir(dir);
    if (r.IsErr()) return;
    List<string> names = r.Unwrap();
    string[] ns = names.AsSlice();
    for (usize i = 0; i < ns.Len; i++) {
        str n = ns[i].AsStr();
        if (!HasSuffix(n, ".md")) continue;
        string source = string.From(dir);
        source.AppendByte('/');
        source.Append(n);
        string title2 = TitleOf(source.AsStr());
        if (IsText(n, "README.md")) {
            // the folder's overview first
            Add(ref nav, from, "Overview", source.AsStr(), 0);
        }
    }
    for (usize i = 0; i < ns.Len; i++) {
        str n = ns[i].AsStr();
        if (!HasSuffix(n, ".md") || IsText(n, "README.md")) continue;
        string source = string.From(dir);
        source.AppendByte('/');
        source.Append(n);
        string title2 = TitleOf(source.AsStr());
        Add(ref nav, from, title2.AsStr(), source.AsStr(), 0);
    }
}

// The library modules that have landed, by their READMEs' status line.
void Library(ref List<templates.NavItem> nav, str from) {
    nav.Push(templates.NavItem.Heading("Library"));
    Add(ref nav, from, "Overview", "lib/README.md", 0);
    List<str> roots = List<str>.New();
    roots.Push("lib");
    roots.Push("lib/envo");
    str[] rs = roots.AsSlice();
    for (usize k = 0; k < rs.Len; k++) {
        var r = fs.ListDir(rs[k]);
        if (r.IsErr()) continue;
        List<string> names = r.Unwrap();
        string[] ns = names.AsSlice();
        for (usize i = 0; i < ns.Len; i++) {
            string readme = string.From(rs[k]);
            readme.AppendByte('/');
            readme.Append(ns[i].AsStr());
            readme.Append("/README.md");
            if (!fs.IsFile(readme.AsStr()) || IsText(ns[i].AsStr(), "envo")) continue;
            var text0 = fs.ReadText(readme.AsStr());
            if (text0.IsErr()) continue;
            string t = text0.Unwrap();
            if (HasText(t.AsStr(), "Not started")) continue;
            string label = string.New();
            if (IsText(rs[k], "lib/envo")) label.Append("envo.");
            label.Append(ns[i].AsStr());
            Add(ref nav, from, label.AsStr(), readme.AsStr(), 1);
        }
    }
}

// The side navigation, its links relative to the page at from.
List<templates.NavItem> Nav(str from) {
    List<templates.NavItem> nav = List<templates.NavItem>.New();
    nav.Push(templates.NavItem.Heading("Start"));
    Add(ref nav, from, "Overview", "README.md", 0);
    Add(ref nav, from, "Status", "STATUS.md", 0);
    Add(ref nav, from, "Plan", "docs/PLAN.md", 0);
    Add(ref nav, from, "Charter", "CHARTER.md", 0);
    Add(ref nav, from, "Documentation", "docs/README.md", 0);
    Add(ref nav, from, "Guides", "docs/guides/README.md", 0);
    Group(ref nav, from, "Language", "docs/spec");
    Group(ref nav, from, "Architecture", "docs/architecture");
    Library(ref nav, from);
    nav.Push(templates.NavItem.Heading("Design"));
    Add(ref nav, from, "Lumen", "docs/lumen/README.md", 0);
    Add(ref nav, from, "Porting", "docs/porting/README.md", 0);
    nav.Push(templates.NavItem.Heading("Project"));
    Add(ref nav, from, "Contributing", "CONTRIBUTING.md", 0);
    Add(ref nav, from, "RFCs", "docs/rfcs/README.md", 0);
    Add(ref nav, from, "Security", "SECURITY.md", 0);
    Add(ref nav, from, "Licensing", "LICENSING.md", 0);
    Add(ref nav, from, "Trademarks", "TRADEMARKS.md", 0);
    Add(ref nav, from, "Code of conduct", "CODE_OF_CONDUCT.md", 0);
    return nav;
}

templates.Frame FrameFor(str page) {
    string home = Rel(page, "/");
    string css = Rel(page, "/lumen.css");
    templates.Frame f = templates.Frame.New(SITE, home.AsStr(), css.AsStr());
    f.Top.Push(templates.NavItem.Link("Docs", Rel(page, "/docs/README.html").AsStr(), 0));
    f.Top.Push(templates.NavItem.Link("Learn", Rel(page, "/docs/guides/README.html").AsStr(), 0));
    f.Top.Push(templates.NavItem.Link("Language", Rel(page, "/docs/spec/README.html").AsStr(), 0));
    f.Top.Push(templates.NavItem.Link("Sandbox", Rel(page, "/sandbox/").AsStr(), 0));
    f.Top.Push(templates.NavItem.Link("Status", Rel(page, "/STATUS.html").AsStr(), 0));
    f.Footer = string.From("EnvoScale. This site is built by an Envo program (website/site.envo) with envo.web and Lumen.");
    return f;
}

http.Response Home() {
    templates.Frame f = FrameFor("/");
    templates.Landing l = templates.Landing.New("One environment, every platform, built from the first byte up.", "One language, Envo, one toolchain and one standard platform for systems code, scripts, desktop apps, websites, terminals, graphics, crypto and networking. No third-party dependencies, and a compiler bootstrapped from assembly, so the whole chain can be audited.");
    l.PrimaryText = string.From("Read the docs");
    l.PrimaryHref = string.From("docs/README.html");
    l.SecondaryText = string.From("See where it stands");
    l.SecondaryHref = string.From("STATUS.html");
    l.Features.Push(templates.Feature.Of("One language", "Envo reads like C# and compiles to native code: scripts, apps, servers and low-level code in one language, from a one-line program up.", "docs/spec/README.html"));
    l.Features.Push(templates.Feature.Of("Built from the first byte", "Assembly builds Stage 1, Stage 1 builds the compiler, and the compiler rebuilds itself to the same bytes. Every step is checked in CI.", "docs/architecture/bootstrap.html"));
    l.Features.Push(templates.Feature.Of("Every platform is an adapter", "Programs talk to ports; Windows, Linux and WebAssembly are adapters behind them, and each passes the same conformance suites.", "docs/architecture/ports-and-adapters.html"));
    l.Features.Push(templates.Feature.Of("Batteries, not dependencies", "Crypto and TLS, HTTP, terminal and desktop UI, fonts, 2D and GPU drawing, all in the standard platform, all written in Envo.", "lib/README.html"));
    markdown.Doc body = markdown.Render(HOME_BODY, markdown.Options.Site());
    l.Body = string.From(body.HtmlOf());
    return http.Response.Html(200, templates.LandingPage(f, l).AsStr());
}

const str HOME_BODY = "## Hello, World\n\n```envo\nprint(\"Hello, World!\");\n```\n\nOne line is a whole program. The same holds for a website, a terminal UI or a window: the [Hello World Gallery](README.html#hello-world-gallery) shows each, and CI fails if one grows past its limit.\n\n## Try it\n\nBuild from source with nothing but NASM: `bootstrap.ps1 build` on Windows, `bootstrap.sh build` on Linux. The [status page](STATUS.html) says what works today.\n";

http.Response DocPage(str page, str source) {
    var r = fs.ReadText(source);
    if (r.IsErr()) return http.Response.Html(404, "<!doctype html>\n<title>Not found</title>\n<h1>Not found</h1>\n");
    string src = r.Unwrap();
    markdown.Doc d = markdown.Render(src.AsStr(), markdown.Options.Site());
    string title = string.From(d.Title());
    if (title.Len() == 0) title = string.From(source);
    templates.Frame f = FrameFor(page);
    List<templates.NavItem> nav = Nav(page);
    string current = Rel(page, page);
    string html = templates.Docs(f, title.AsStr(), "", nav, current.AsStr(), d);
    return http.Response.Html(200, html.AsStr());
}

// The sandbox: the compiler, built for WebAssembly (build/envoc.wasm), compiles and runs
// programs in the page (website/PLAN.md, phase 3b).
http.Response Sandbox() {
    templates.Frame f = FrameFor("/sandbox/index.html");
    templates.Landing l = templates.Landing.New("Sandbox", "Envo in your browser: the compiler itself, built for WebAssembly, compiles your program on this page and runs it there. Nothing you type leaves your machine.");
    l.Body = string.From(SANDBOX_BODY);
    return http.Response.Html(200, templates.LandingPage(f, l).AsStr());
}

const str SANDBOX_BODY = "<div class=\"sandbox\">\n<div class=\"toolbar\">\n<label for=\"example\">Example</label>\n<select id=\"example\">\n<option value=\"hello\">Hello, World</option>\n<option value=\"fizzbuzz\">FizzBuzz</option>\n<option value=\"structs\">Structs and methods</option>\n<option value=\"generics\">Generics</option>\n<option value=\"panic\">A panic</option>\n</select>\n<button id=\"run\" class=\"button primary\" type=\"button\" disabled>Run</button>\n<button id=\"share\" class=\"button\" type=\"button\">Share</button>\n</div>\n<label for=\"code\" class=\"visually-hidden\">Program</label>\n<textarea id=\"code\" class=\"code\" spellcheck=\"false\" autocapitalize=\"off\" autocomplete=\"off\"></textarea>\n<h2>Output</h2>\n<pre id=\"out\" class=\"output\" aria-live=\"polite\">Loading the compiler…</pre>\n<p>The sandbox has the language and its prelude (List, string, Option, Result). The standard platform (std, envo.*) is not in the page yet.</p>\n</div>\n<script src=\"envo.js\"></script>\n<script src=\"sandbox.js\"></script>\n";

// A file of the repository as a response of type type, or 404.
http.Response FileOf(str source, str type) {
    var r = fs.ReadText(source);
    if (r.IsErr()) return http.Response.Html(404, "<!doctype html>\n<title>Not found</title>\n<h1>Not found</h1>\n");
    string body = r.Unwrap();
    http.Response resp = http.Response.Text(200, body.AsStr());
    resp.SetHeader("Content-Type", type);
    return resp;
}

// Every page of the site, by its path.
http.Response SitePage(in http.Request req, in web.Params ps) {
    str path = ps.Get("path");
    if (path.Len == 0 || IsText(path, "index.html")) return Home();
    if (IsText(path, "sandbox") || IsText(path, "sandbox/") || IsText(path, "sandbox/index.html")) return Sandbox();
    if (IsText(path, "sandbox/envo.js")) return FileOf("adapters/interop/js/envo.js", "text/javascript; charset=utf-8");
    if (IsText(path, "sandbox/sandbox.js")) return FileOf("adapters/interop/js/sandbox.js", "text/javascript; charset=utf-8");
    if (IsText(path, "sandbox/envoc.wasm")) return FileOf("build/envoc.wasm", "application/wasm");
    if (IsText(path, "lumen.css")) {
        http.Response css = http.Response.Text(200, templates.Css(lumen.Light(), lumen.Dark()).AsStr());
        css.SetHeader("Content-Type", "text/css; charset=utf-8");
        return css;
    }
    if (HasSuffix(path, ".html") && !HasText(path, "..")) {
        string source = string.From(path[0..path.Len - 5]);
        source.Append(".md");
        if (fs.IsFile(source.AsStr())) {
            string page = string.From("/");
            page.Append(path);
            return DocPage(page.AsStr(), source.AsStr());
        }
    }
    return http.Response.Html(404, "<!doctype html>\n<title>Not found</title>\n<h1>Not found</h1>\n");
}

// ------------------------------------------------------------------ the program

web.App app = web.App.New();
app.Get("/*path", new web.Page { Fn = SitePage });
List<str> args = env.Args();
str[] a = args.AsSlice();
str command = "build";
if (a.Len > 0) command = a[0];
if (IsText(command, "serve")) {
    u16 port = 8080;
    if (a.Len > 1) port = ParsePort(a[1]);
    write(1, "serving the site on http://127.0.0.1:");
    print(text.Uint(port as u64).AsStr());
    web.Serve(ref app, "127.0.0.1", port);
} else if (IsText(command, "build")) {
    str out0 = "build/site";
    if (a.Len > 1) out0 = a[1];
    List<string> sources = Sources();
    List<string> pages = List<string>.New();
    pages.Push(string.From("/"));
    pages.Push(string.From("/lumen.css"));
    pages.Push(string.From("/sandbox/"));
    pages.Push(string.From("/sandbox/envo.js"));
    pages.Push(string.From("/sandbox/sandbox.js"));
    if (fs.IsFile("build/envoc.wasm")) pages.Push(string.From("/sandbox/envoc.wasm"));
    string[] ss = sources.AsSlice();
    for (usize i = 0; i < ss.Len; i++) pages.Push(PageOf(ss[i].AsStr()));
    List<str> paths = List<str>.New();
    string[] ps = pages.AsSlice();
    for (usize i = 0; i < ps.Len; i++) paths.Push(ps[i].AsStr());
    var files = platform.FileSystem();
    var r = web.Build(ref files, app, paths.AsSlice(), out0);
    if (r.IsErr()) {
        print("site: the build failed");
        exit(1);
    }
    write(1, "site: ");
    write(1, text.Uint(r.Unwrap() as u64).AsStr());
    write(1, " files in ");
    print(out0);
} else {
    print("usage: site build [folder] | site serve [port]");
    exit(2);
}

u16 ParsePort(str s) {
    u32 v = 0;
    for (usize i = 0; i < s.Len; i++) {
        if (s[i] < '0' || s[i] > '9') return 8080;
        v = v * 10 + (s[i] - '0') as u32;
        if (v > 65535) return 8080;
    }
    return v as u16;
}

bool IsText(str a, str b) {
    if (a.Len != b.Len) return false;
    for (usize i = 0; i < a.Len; i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

bool HasSuffix(str s, str t) {
    if (s.Len < t.Len) return false;
    for (usize i = 0; i < t.Len; i++) {
        if (s[s.Len - t.Len + i] != t[i]) return false;
    }
    return true;
}

bool HasText(str s, str t) {
    if (t.Len == 0) return true;
    for (usize i = 0; i + t.Len <= s.Len; i++) {
        bool all = true;
        for (usize k = 0; k < t.Len; k++) {
            if (s[i + k] != t[k]) {
                all = false;
                break;
            }
        }
        if (all) return true;
    }
    return false;
}
