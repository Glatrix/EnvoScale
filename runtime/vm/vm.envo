// The script runtime (PLAN D31, D32; runtime/vm/README.md): an interpreter for EIR
// modules made for the host target, with the runtime in them. It runs on host memory:
// a pointer is a host address, a slot is a piece of the VM's own stack, a global is a
// host allocation. So layouts, wrapping, checks and panics are the native program's,
// and a panic goes through the interpreted `__rt_trap` as it does natively. The two
// target intrinsics are forwarded to the host through `platform.RawCall`, past the
// permission checks (sandbox.envo).
namespace envo.vm;

use envoc.util;
use envoc.eir;
use platform;

// A function value: a tagged function index rather than a code address.
const u64 FN_TAG = 0x7E00000000000000;
const u64 FN_MASK = 0xFF00000000000000;

// The VM's stacks: values (8 bytes each) and slot memory.
const usize VALUE_STACK = 4 << 20;          // 4M values, 32 MiB
const usize SLOT_STACK = 32 << 20;          // 32 MiB
const usize FRAME_STACK = 1 << 20;          // calls deep

// A call in progress.
struct Frame {
    u32 Func;
    u32 Inst;           // the next instruction
    usize Base;         // its values start here on the value stack
    u32 First;          // the value id of its first value
    u32 Ret;            // the caller's frame index that gets the result, or NO_RESULT
    usize SlotMark;     // the slot stack's top when it started
}

// Each instruction in the form the VM runs, worked out before running: what it needs,
// without the module's bigger records.
struct Pre {
    u16 Op;
    bool Signed;    // the type operand is a signed integer
    bool IsBool;    // the type operand is bool
    u32 Size;       // the type operand's size
    u32 FirstOp;    // operands, in OpV and OpIsVal
    u32 NOps;
    u32 Result;     // the result's index in its frame, or NO_RESULT
    u64 Imm;
    u64 Aux;        // field offset, element size, address, callee, alignment, conversion
}

const u32 NO_RESULT = 0xFFFFFFFF;

public struct Vm {
    Module M;
    List<Pre> Pres;             // per instruction
    List<u64> OpV;              // per operand: its value's index in the frame, or the constant
    List<bool> OpIsVal;         // per operand: is it a value (else a constant)
    List<u64> GlobalAddr;       // per global
    *u64 Values;
    usize ValueTop;
    *u8 Slots;
    usize SlotTop;
    *Frame Frames;
    usize Depth;
    u32 TrapFunc;               // __rt_trap
    Sandbox Box;

    // A VM for module m (made for the host target, runtime included).
    public static Vm New(Module m, Sandbox box) {
        unsafe {
            *u64 values = alloc(VALUE_STACK * 8) as *u64;
            *u8 slots = alloc(SLOT_STACK);
            *Frame frames = alloc(FRAME_STACK * sizeof(Frame)) as *Frame;
            Vm vm = new Vm {
                M = m, Pres = List<Pre>.New(), OpV = List<u64>.New(), OpIsVal = List<bool>.New(),
                GlobalAddr = List<u64>.New(),
                Values = values, ValueTop = 0, Slots = slots, SlotTop = 0, Frames = frames, Depth = 0,
                TrapFunc = 0, Box = box,
            };
            vm.Prepare();
            return vm;
        }
    }

    // ------------------------------------------------------------------ preparation

    u32 FuncNamed(in this, str name) {
        u64? named = this.M.Names.Get(name);
        if (named.IsNone() || named.Unwrap() >> 32 != NAME_FUNC) return 0;
        return (named.Unwrap() & 0xFFFFFFFF) as u32;
    }

    // The address an `addr` operand or an initializer names.
    u64 AddressOf(in this, str name) {
        u64? named = this.M.Names.Get(name);
        if (named.IsNone()) return 0;
        u64 v = named.Unwrap();
        u32 index = (v & 0xFFFFFFFF) as u32;
        if (v >> 32 == NAME_FUNC) return FN_TAG | index as u64;
        return this.GlobalAddr.Get(index as usize);
    }

    // Lays out every type, places and fills the globals, and works out each
    // instruction's constants.
    void Prepare(ref this) {
        for (u32 t = 1; t < this.M.Types.Len() as u32; t++) this.M.Layout(t);
        // globals: storage first, so initializers can name any of them
        this.GlobalAddr.Push(0);
        for (u32 g = 1; g < this.M.Globals.Len() as u32; g++) {
            EGlobal gl = this.M.Global(g);
            usize size = this.M.Ty(gl.Type).Size as usize;
            if (size == 0) size = 1;
            unsafe { this.GlobalAddr.Push(alloc(size) as usize as u64); }
        }
        for (u32 g = 1; g < this.M.Globals.Len() as u32; g++) {
            EGlobal gl = this.M.Global(g);
            if (gl.Init != 0) this.Fill(this.GlobalAddr.Get(g as usize), gl.Type, gl.Init);
        }
        // operands: values become indexes in their function's frame
        for (u32 o = 0; o < this.M.Ops.Len() as u32; o++) {
            this.OpV.Push(this.M.Op(o).Int);
            this.OpIsVal.Push(false);
        }
        // each instruction's function, from the blocks that hold it (the optimizer moves
        // instructions between blocks without renaming their block)
        List<u32> firsts = List<u32>.New();
        for (u32 i = 0; i < this.M.Insts.Len() as u32; i++) firsts.Push(0);
        for (u32 f = 1; f < this.M.Funcs.Len() as u32; f++) {
            EFunc fn = this.M.Func(f);
            for (u32 bk = fn.FirstBlock; bk < fn.FirstBlock + fn.NBlocks; bk++) {
                EBlock blk = this.M.Block(bk);
                for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) firsts.Set(i as usize, fn.FirstValue);
            }
        }
        for (u32 i = 0; i < this.M.Insts.Len() as u32; i++) {
            EInst inst = this.M.Inst(i);
            ETy ty = this.M.Ty(inst.Ty);
            u32 first = firsts.Get(i as usize);
            for (u32 k = 0; k < inst.NOps; k++) {
                EOp op = this.M.Op(inst.FirstOp + k);
                if (op.Kind == OK_VALUE) {
                    this.OpV.Set((inst.FirstOp + k) as usize, (op.Ref - first) as u64);
                    this.OpIsVal.Set((inst.FirstOp + k) as usize, true);
                }
            }
            u32 result = NO_RESULT;
            if (inst.Result != 0) result = inst.Result - first;
            Pre p = new Pre {
                Op = inst.Op, Signed = this.M.IsSigned(inst.Ty), IsBool = inst.Ty == ET_BOOL, Size = ty.Size,
                FirstOp = inst.FirstOp, NOps = inst.NOps, Result = result, Imm = inst.Imm, Aux = 0,
            };
            if (inst.Op == 2) {
                // addr @g
                EOp rf = this.M.Op(inst.FirstOp);
                if (rf.Int == NAME_FUNC) p.Aux = FN_TAG | rf.Ref as u64;
                else p.Aux = this.GlobalAddr.Get(rf.Ref as usize);
            } else if (inst.Op == 44) {
                p.Aux = this.M.FieldOffset(inst.Ty, inst.Imm as u32);
            } else if (inst.Op == 45) {
                p.Aux = ty.Size as u64;
            } else if (inst.Op == 52) {
                p.Aux = this.M.Op(inst.FirstOp).Ref as u64;
            } else if (inst.Op == 3) {
                p.Aux = ty.Align as u64;
            } else if (inst.Op >= 32 && inst.Op <= 41) {
                ETy to = this.M.Ty(inst.Ty2);
                p.Aux = to.Size as u64;
                if (this.M.IsSigned(inst.Ty2)) p.Aux = p.Aux | 0x100;
            }
            this.Pres.Push(p);
        }
        this.TrapFunc = this.FuncNamed("__rt_trap");
    }

    // Writes initializer init of type t at address at.
    void Fill(ref this, u64 at, u32 t, u32 init) {
        EInit e = this.M.Init(init);
        ETy ty = this.M.Ty(t);
        unsafe {
            *u8 p = at as usize as *u8;
            if (e.Kind == EI_BYTES) {
                for (usize i = 0; i < e.Bytes.Len; i++) p[i] = e.Bytes.Ptr[i];
            } else if (e.Kind == EI_INT) {
                Store(at, e.Int, ty.Size);
            } else if (e.Kind == EI_ADDR) {
                Store(at, this.AddressOf(TextStr(e.Bytes)), 8);
            } else if (e.Kind == EI_LIST) {
                u32 k = 0;
                u32 item = e.First;
                while (item != 0) {
                    if (ty.Kind == EK_ARRAY) {
                        ETy el = this.M.Ty(ty.Elem);
                        this.Fill(at + k as u64 * el.Size as u64, ty.Elem, item);
                    } else {
                        u32 ft = this.M.Field(ty.Fields + k);
                        this.Fill(at + this.M.FieldOffset(t, k), ft, item);
                    }
                    k++;
                    item = this.M.Init(item).Next;
                }
            }
        }
    }

    // ------------------------------------------------------------------ running

    // Runs the program with its arguments (args[0] is its name) and gives its exit code.
    public i32 Run(ref this, in List<string> args) {
        u32 init = this.FuncNamed("__rt_init");
        u32 setArgs = this.FuncNamed("__rt_set_args");
        u32 main = this.FuncNamed("__main");
        u32 exitFn = this.FuncNamed("__rt_exit");
        if (init == 0 || setArgs == 0 || main == 0) {
            write(2, "envo: error: the program has no entry point\n");
            return 70;
        }
        usize argc = args.Len();
        u64 stack = 0;
        u64 strs = 0;
        unsafe {
            // a Linux-shaped initial stack (argc, then argv) for __os_init, and the
            // arguments as `str`s for __rt_set_args
            *u64 sp = alloc((argc + 2) * 8) as *u64;
            *u64 sa = alloc(argc * 16 + 16) as *u64;
            sp[0] = argc as u64;
            for (usize i = 0; i < argc; i++) {
                str a = args.AsSlice()[i].AsStr();
                *u8 c = alloc(a.Len + 1);
                for (usize k = 0; k < a.Len; k++) c[k] = a[k];
                sp[i + 1] = c as usize as u64;
                sa[2 * i] = c as usize as u64;
                sa[2 * i + 1] = a.Len as u64;
            }
            stack = sp as usize as u64;
            strs = sa as usize as u64;
        }
        this.SetArg(0, stack);
        this.Invoke(init);
        this.SetArg(0, argc as u64);
        this.SetArg(1, strs);
        this.Invoke(setArgs);
        u64 code = this.Invoke(main);
        if (exitFn != 0) {
            this.SetArg(0, code);
            this.Invoke(exitFn);
        }
        return code as i32;
    }

    // Ends the program with a panic of the given reason, as the native code does.
    // Puts argument k of the next call at the top of the value stack.
    void SetArg(ref this, usize k, u64 v) {
        unsafe { this.Values[this.ValueTop + k] = v; }
    }

    void Trap(ref this, u64 reason) {
        this.SetArg(0, reason);
        this.Invoke(this.TrapFunc);
        exit(101);
    }

    // The value of operand o in the frame at fb.
    u64 Operand(in this, usize fb, u32 first, u32 o) {
        unsafe {
            if (this.OpIsVal.Data[o]) return this.Values[fb + this.OpV.Data[o] as usize];
            return this.OpV.Data[o];
        }
    }

    // Moves the arguments of branch target o into its block's parameters (a parallel
    // copy through the space above the frame) and gives the block.
    u32 Branch(ref this, usize fb, u32 first, u32 o) {
        unsafe {
            var op = this.M.Ops.Data[o];
            var target = this.M.Blocks.Data[op.Ref];
            usize tmp = this.ValueTop;
            for (u32 k = 0; k < op.NArgs; k++) {
                u32 v = this.M.Args.Data[op.Args + k];
                this.Values[tmp + k as usize] = this.Values[fb + (v - first) as usize];
            }
            for (u32 k = 0; k < op.NArgs; k++) {
                this.Values[fb + (target.FirstParam + k - first) as usize] = this.Values[tmp + k as usize];
            }
            return op.Ref;
        }
    }

    // Starts a frame for function f, whose arguments are at the top of the value stack.
    // ret is the caller's value that gets the result (0 for none).
    void Enter(ref this, u32 f, u32 ret) {
        EFunc fn = this.M.Func(f);
        if (fn.Extern || fn.NBlocks == 0) {
            write(2, "envo: error: the script calls a function with no body: ");
            write(2, TextStr(fn.Name));
            write(2, "\n");
            exit(70);
        }
        usize fb = this.ValueTop;
        // the frame, and room above it for branch copies and call arguments
        if (fb + fn.NValues as usize + 64 >= VALUE_STACK || this.Depth + 1 >= FRAME_STACK) {
            write(2, "envo: error: the script's stack overflowed\n");
            exit(101);
        }
        unsafe {
            *Frame fr = &this.Frames[this.Depth];
            fr.Func = f;
            fr.Base = fb;
            fr.First = fn.FirstValue;
            fr.SlotMark = this.SlotTop;
            fr.Ret = ret;
            EBlock blk = this.M.Block(fn.FirstBlock);
            fr.Inst = blk.FirstInst;
        }
        this.Depth++;
        this.ValueTop = fb + fn.NValues as usize;
    }

    // Calls function f, whose arguments are at the top of the value stack, and gives
    // its result. Calls inside it run in the same loop, on the VM's own frame stack.
    u64 Invoke(ref this, u32 f) {
        usize bottom = this.Depth;
        this.Enter(f, NO_RESULT);
        unsafe {
            while (true) {
                *Frame fr = &this.Frames[this.Depth - 1];
                usize fb = fr.Base;
                u32 first = fr.First;
                u32 i = fr.Inst;
                *Pre pre = &this.Pres.Data[i];
                u16 op = pre.Op;
                u32 o = pre.FirstOp;
                u32 size = pre.Size;
                bool signed = pre.Signed;
                u64 result = 0;
                fr.Inst = i + 1;
                // the most frequent operations first
                if (op == 42) {
                    result = Norm(Load(this.Operand(fb, first, o), size), size, signed);
                } else if (op == 1) {
                    result = pre.Imm;
                } else if (op == 43) {
                    Store(this.Operand(fb, first, o + 1), this.Operand(fb, first, o), size);
                } else if (op == 44) {
                    result = this.Operand(fb, first, o) +% pre.Aux;
                } else if (op == 56) {
                    if (this.Operand(fb, first, o) != 0) this.Jump(fr, this.Branch(fb, first, o + 1));
                    else this.Jump(fr, this.Branch(fb, first, o + 2));
                    continue;
                } else if (op == 55) {
                    this.Jump(fr, this.Branch(fb, first, o));
                    continue;
                } else if (op >= 5 && op <= 19) {
                    u64 a = this.Operand(fb, first, o);
                    u64 c = 0;
                    if (op != 11 && op != 17) c = this.Operand(fb, first, o + 1);
                    result = this.Arith(op, a, c, size, signed, pre.IsBool);
                } else if (op >= 20 && op <= 25) {
                    u64 a = this.Operand(fb, first, o);
                    u64 c = this.Operand(fb, first, o + 1);
                    bool r = false;
                    if (op == 20) r = a == c;
                    else if (op == 21) r = a != c;
                    else if (signed) {
                        i64 x = a as i64;
                        i64 y = c as i64;
                        if (op == 22) r = x < y;
                        else if (op == 23) r = x <= y;
                        else if (op == 24) r = x > y;
                        else r = x >= y;
                    } else {
                        if (op == 22) r = a < c;
                        else if (op == 23) r = a <= c;
                        else if (op == 24) r = a > c;
                        else r = a >= c;
                    }
                    if (r) result = 1;
                } else if (op == 52 || op == 53) {
                    // the arguments go to the top of the stack, where the callee's
                    // parameters are; the callee runs in this loop
                    u32 n = pre.NOps;
                    u32 callee = pre.Aux as u32;
                    u32 from = 1;
                    u32 count = n - 1;
                    if (op == 53) {
                        u64 fp = this.Operand(fb, first, o + n - 1);
                        if (fp & FN_MASK != FN_TAG) {
                            write(2, "envo: error: the script called something that is not a function\n");
                            exit(101);
                        }
                        callee = (fp & 0xFFFFFFFF) as u32;
                        from = 0;
                    }
                    usize top = this.ValueTop;
                    for (u32 k = 0; k < count; k++) this.Values[top + k as usize] = this.Operand(fb, first, o + from + k);
                    this.Enter(callee, pre.Result);
                    continue;
                } else if (op == 58) {
                    u64 r = 0;
                    if (pre.NOps == 1) r = this.Operand(fb, first, o);
                    u32 ret = fr.Ret;
                    this.ValueTop = fb;
                    this.SlotTop = fr.SlotMark;
                    this.Depth--;
                    if (this.Depth == bottom) return r;
                    if (ret != NO_RESULT) {
                        *Frame caller = &this.Frames[this.Depth - 1];
                        this.Values[caller.Base + ret as usize] = r;
                    }
                    continue;
                } else if (op == 45) {
                    result = this.Operand(fb, first, o) +% this.Operand(fb, first, o + 1) *% pre.Aux;
                } else if (op == 46) {
                    result = this.Operand(fb, first, o) +% this.Operand(fb, first, o + 1);
                } else if (op == 3) {
                    // slot: zeroed, aligned for its type
                    usize align = pre.Aux as usize;
                    if (align < 8) align = 8;
                    usize at = (this.SlotTop + align - 1) & ~(align - 1);
                    usize n = size as usize;
                    if (at + n > SLOT_STACK) {
                        write(2, "envo: error: the script's stack overflowed\n");
                        exit(101);
                    }
                    *u8 p = &this.Slots[at];
                    for (usize k = 0; k < n; k++) p[k] = 0;
                    this.SlotTop = at + n;
                    result = p as usize as u64;
                } else if (op == 2) {
                    result = pre.Aux;
                } else if (op == 47) {
                    *u8 dst = this.Operand(fb, first, o) as usize as *u8;
                    *u8 src = this.Operand(fb, first, o + 1) as usize as *u8;
                    usize n = this.Operand(fb, first, o + 2) as usize;
                    usize k = 0;
                    while (k + 8 <= n) {
                        (&dst[k] as *u64)[0] = (&src[k] as *u64)[0];
                        k += 8;
                    }
                    while (k < n) {
                        dst[k] = src[k];
                        k++;
                    }
                } else if (op == 48) {
                    *u8 dst = this.Operand(fb, first, o) as usize as *u8;
                    usize n = this.Operand(fb, first, o + 1) as usize;
                    usize k = 0;
                    while (k + 8 <= n) {
                        (&dst[k] as *u64)[0] = 0;
                        k += 8;
                    }
                    while (k < n) {
                        dst[k] = 0;
                        k++;
                    }
                } else if (op == 49) {
                    u64 x = this.Operand(fb, first, o);
                    u64 len = this.Operand(fb, first, o + 1);
                    if ((signed && (x as i64) < 0) || x >= len) this.Trap(1);
                } else if (op >= 32 && op <= 41) {
                    u64 a = this.Operand(fb, first, o);
                    u32 toSize = (pre.Aux & 0xFF) as u32;
                    bool toSigned = pre.Aux & 0x100 != 0;
                    if (op == 32 || op == 41) result = Norm(a, toSize, toSigned);
                    else if (op == 33) result = Norm(Norm(a, size, false), toSize, toSigned);
                    else if (op == 34) result = Norm(Norm(a, size, true), toSize, toSigned);
                    else if (op == 39 || op == 40) result = a;
                    else this.NoFloats();
                } else if (op == 26) {
                    if (this.Operand(fb, first, o) != 0) result = this.Operand(fb, first, o + 1);
                    else result = this.Operand(fb, first, o + 2);
                } else if (op == 57) {
                    u64 v = this.Operand(fb, first, o);
                    u32 n = pre.NOps;
                    u32 k = 1;
                    u32 target = o + n - 1;
                    while (k + 1 < n) {
                        if (this.M.Ops.Data[o + k].Int == v) {
                            target = o + k + 1;
                            break;
                        }
                        k += 2;
                    }
                    this.Jump(fr, this.Branch(fb, first, target));
                    continue;
                } else if (op == 4) {
                    // slot.end: storage is freed when the function returns
                } else if (op == 50) {
                    u64 lo = this.Operand(fb, first, o);
                    u64 hi = this.Operand(fb, first, o + 1);
                    u64 len = this.Operand(fb, first, o + 2);
                    if (lo > hi || hi > len) this.Trap(1);
                } else if (op == 51) {
                    *u8 p = this.Operand(fb, first, o) as usize as *u8;
                    u64 len = this.Operand(fb, first, o + 1);
                    u64 at = this.Operand(fb, first, o + 2);
                    if (at != 0 && at != len && p[at as usize] & 0xC0 == 0x80) this.Trap(6);
                } else if (op == 54) {
                    Text name = this.M.Inst(i).Str;
                    result = this.Intrinsic(fb, first, pre.FirstOp, pre.NOps, TextStr(name));
                } else if (op == 59) {
                    this.Trap(pre.Imm);
                } else if (op == 60) {
                    this.Trap(5);
                } else {
                    this.NoFloats();
                }
                if (pre.Result != NO_RESULT) this.Values[fb + pre.Result as usize] = result;
            }
        }
        return 0;
    }

    // Continues frame fr at the start of block b.
    void Jump(ref this, *Frame fr, u32 b) {
        unsafe {
            EBlock blk = this.M.Block(b);
            fr.Inst = blk.FirstInst;
        }
    }

    void NoFloats(ref this) {
        write(2, "envo: error: the script runtime does not run floating-point code yet\n");
        exit(70);
    }

    // Integer arithmetic (ops 5-19) as the native code does it: wrapping or checked,
    // the result normalized to its type.
    u64 Arith(ref this, u16 op, u64 a, u64 c, u32 size, bool signed, bool isBool) {
        if (op == 5) return Norm(a +% c, size, signed);
        if (op == 6) return Norm(a -% c, size, signed);
        if (op == 7) return Norm(a *% c, size, signed);
        if (op == 8 || op == 9 || op == 10) {
            u64 r = 0;
            bool over = false;
            if (op == 8) r = a +% c;
            else if (op == 9) r = a -% c;
            else r = a *% c;
            if (size < 8) {
                // the operands are normalized, so the exact result fits in 64 bits
                over = Norm(r, size, signed) != r;
            } else if (signed) {
                i64 x = a as i64;
                i64 y = c as i64;
                i64 z = r as i64;
                if (op == 8) over = (x >= 0 && y >= 0 && z < 0) || (x < 0 && y < 0 && z >= 0);
                else if (op == 9) over = (x >= 0 && y < 0 && z < 0) || (x < 0 && y >= 0 && z >= 0);
                else over = x != 0 && y != 0 && ((x == -1 && y as u64 == 0x8000000000000000) || (y == -1 && x as u64 == 0x8000000000000000) || z / y != x);
            } else {
                if (op == 8) over = r < a;
                else if (op == 9) over = a < c;
                else over = a != 0 && r / a != c;
            }
            if (over) this.Trap(0);
            return r;
        }
        if (op == 11) {
            if (signed) {
                u64 r = 0 -% a;
                if (size == 8 && a == 0x8000000000000000) this.Trap(0);
                if (size < 8 && Norm(r, size, true) != r) this.Trap(0);
                return r;
            }
            if (a != 0) this.Trap(0);
            return 0;
        }
        if (op == 12 || op == 13) {
            if (c == 0) this.Trap(2);
            if (signed) {
                i64 x = a as i64;
                i64 y = c as i64;
                if (size == 8 && y == -1 && a == 0x8000000000000000) this.Trap(0);
                if (op == 13) return Norm((x % y) as u64, size, true);
                u64 q = (x / y) as u64;
                if (size < 8 && Norm(q, size, true) != q) this.Trap(0);
                return q;
            }
            if (op == 13) return a % c;
            return a / c;
        }
        if (op == 14) return a & c;
        if (op == 15) return a | c;
        if (op == 16) return a ^ c;
        if (op == 17) {
            if (isBool) return a ^ 1;
            return Norm(~a, size, signed);
        }
        // shifts
        if (signed && (c as i64) < 0) this.Trap(4);
        if (c >= size as u64 * 8) this.Trap(4);
        if (op == 18) return Norm(a << c, size, signed);
        if (signed) return Norm(((a as i64) >> c) as u64, size, signed);
        return a >> c;
    }

    // ------------------------------------------------------------------ intrinsics

    u64 Intrinsic(ref this, usize fb, u32 first, u32 o, u32 n, str name) {
        u64[13] a;
        for (u32 k = 0; k < n && k < 13; k++) a[k] = this.Operand(fb, first, o + k);
        if (Same(name, "syscall")) {
            if (!this.Box.AllowSyscall(a[0] as i64, a[1] as i64, a[2] as i64, a[3] as i64)) return Denied(1);
            return platform.RawCall(1, a[0] as i64, a[1] as i64, a[2] as i64, a[3] as i64, a[4] as i64, a[5] as i64, a[6] as i64, 0, 0, 0, 0, 0, 0) as u64;
        }
        if (Same(name, "wincall")) {
            if (a[0] == 8 && this.Box.PendingDenied()) return 5;       // GetLastError after a denial: ACCESS_DENIED
            if (a[0] == 42 && this.Box.PendingDenied()) return 10013;  // WSAGetLastError: WSAEACCES
            if (!this.Box.AllowWincall(a[0] as i64, a[1] as i64, a[2] as i64, a[5] as i64)) return DeniedWin(a[0]);
            return platform.RawCall(2, a[0] as i64, a[1] as i64, a[2] as i64, a[3] as i64, a[4] as i64, a[5] as i64, a[6] as i64, a[7] as i64, a[8] as i64, a[9] as i64, a[10] as i64, a[11] as i64, a[12] as i64) as u64;
        }
        if (Same(name, "wincallp")) {
            // a call through a function pointer reaches code the sandbox cannot see
            if (!this.Box.AllowPointerCall()) return 0;
            return platform.RawCall(3, a[0] as i64, a[1] as i64, a[2] as i64, a[3] as i64, a[4] as i64, a[5] as i64, a[6] as i64, a[7] as i64, a[8] as i64, a[9] as i64, a[10] as i64, a[11] as i64, a[12] as i64) as u64;
        }
        write(2, "envo: error: the script runtime does not handle the intrinsic ");
        write(2, name);
        write(2, "\n");
        exit(70);
        return 0;
    }
}

// What a denied system call returns: -EACCES.
u64 Denied(u32 kind) => (0 -% 13) as u64;

// What a denied Windows call returns: the function's own failure value (GetLastError then
// reports ACCESS_DENIED). CreateFileW and FindFirstFileW give INVALID_HANDLE_VALUE,
// GetFileAttributesW INVALID_FILE_ATTRIBUTES, the others 0 (FALSE, or no variable).
u64 DeniedWin(u64 k) {
    if (k == 2 || k == 22) return 0xFFFFFFFFFFFFFFFF;
    if (k == 18) return 0xFFFFFFFF;
    if (k == 32) return 0xFFFFFFFFFFFFFFFF;      // INVALID_SOCKET
    if (k == 40) return 10013;                   // getaddrinfo: WSAEACCES
    return 0;
}

// x normalized to an integer of size bytes: sign- or zero-extended from its low bits.
u64 Norm(u64 x, u32 size, bool signed) {
    if (size >= 8 || size == 0) return x;
    u64 bits = size as u64 * 8;
    u64 mask = (1 << bits) - 1;
    u64 v = x & mask;
    if (signed && (v >> (bits - 1)) & 1 != 0) v = v | ~mask;
    return v;
}

u64 Load(u64 at, u32 size) {
    unsafe {
        if (size == 8) return (at as usize as *u64)[0];
        if (size == 4) return (at as usize as *u32)[0] as u64;
        if (size == 2) return (at as usize as *u16)[0] as u64;
        return (at as usize as *u8)[0] as u64;
    }
}

void Store(u64 at, u64 v, u32 size) {
    unsafe {
        if (size == 8) (at as usize as *u64)[0] = v;
        else if (size == 4) (at as usize as *u32)[0] = v as u32;
        else if (size == 2) (at as usize as *u16)[0] = v as u16;
        else (at as usize as *u8)[0] = v as u8;
    }
}
