// Dependencies (PLAN D66): a package's `dependencies` block names other packages, by path
// or from a registry:
//
//     dependencies {
//         greet = { path = "../greet" }
//         words = { version = "1.2.0", registry = "../registry" }
//     }
//
// Their sources are compiled with the package's (each keeps its own namespaces). A
// registry package arrives as an archive (.envopkg: its files, sorted, with sizes), is
// checked against its SHA-256 in `envo.lock.envon` and, when the manifest lists trusted
// keys, against an Ed25519 signature, and is unpacked into build/deps. `envo fetch`
// resolves everything and writes the lock; builds use the lock and fail if an archive
// changed. Registries are reached through IRegistry (tools/envo/registry.envo):
// a folder today; the network registry is the owner's to set up.
use std.fs;
use std.path;
use core.text as ct;
use alloc.text;
use envo.eon;
use envo.crypto;
use envo.crypto.curve25519;
use core.fmt;
use std.env;
use ports.{IoError};

struct Dep {
    string Name;
    string Version;         // "" for a path dependency
    string Dir;             // where its sources are
    string Sha256;          // registry: the archive's digest, hex
    string Registry;
}

// The packages pkg depends on, directly or not, each once, in a fixed order (by name);
// registry packages are fetched as needed. locked: fail if an archive differs from the
// lock (rather than updating it).
List<Dep> ResolveDeps(in Package pkg, bool locked) {
    List<Dep> got = List<Dep>.New();
    List<string> seen = List<string>.New();
    seen.Push(string.From(pkg.Name.AsStr()));
    eon.Value lock = ReadLock(pkg.Dir.AsStr());
    Visit(pkg.Dir.AsStr(), ref got, ref seen, lock, locked, pkg.Dir.AsStr());
    // sorted by name, so the sources go in the same order every time
    mut Dep[] d = got.AsMutSlice();
    for (usize a = 1; a < d.Len; a++) {
        usize b = a;
        while (b > 0 && ct.Compare(d[b].Name.AsStr(), d[b - 1].Name.AsStr()) < 0) {
            Dep t = Dep.Copy(d[b]);
            d[b] = Dep.Copy(d[b - 1]);
            d[b - 1] = t;
            b--;
        }
    }
    return got;
}

impl Dep {
    static Dep Copy(in Dep d) => new Dep {
        Name = string.From(d.Name.AsStr()), Version = string.From(d.Version.AsStr()), Dir = string.From(d.Dir.AsStr()),
        Sha256 = string.From(d.Sha256.AsStr()), Registry = string.From(d.Registry.AsStr())
    };
}

void Visit(str dir, ref List<Dep> got, ref List<string> seen, in eon.Value lock, bool locked, str root) {
    string manifest = path.Join(dir, "envo.envon");
    eon.Value doc = LoadManifest(manifest.AsStr());
    eon.Value[] block = doc.Field("dependencies");
    if (block.Len == 0 || !block[0].IsBlock()) return;
    eon.Value[] items = block[0].Elements();
    for (usize i = 0; i < items.Len; i++) {
        str name = block[0].KeyAt(i);
        if (!GoodName(name)) DepFail(manifest.AsStr(), name, "is not a package name");
        bool dup = false;
        foreach (var s in seen.AsSlice()) {
            if (s.Equals(name)) dup = true;
        }
        if (dup) continue;
        seen.Push(string.From(name));
        Dep d = new Dep { Name = string.From(name), Version = string.New(), Dir = string.New(), Sha256 = string.New(), Registry = string.New() };
        str? p = items[i].GetStr("path");
        str? v = items[i].GetStr("version");
        if (p.IsSome()) {
            d.Dir = path.Join(dir, p.Unwrap());
            if (!IsPackageDir(d.Dir.AsStr())) DepFail(manifest.AsStr(), name, "has no package at its path");
        } else if (v.IsSome()) {
            str? reg = items[i].GetStr("registry");
            if (reg.IsNone()) DepFail(manifest.AsStr(), name, "needs `registry = \"…\"` (a folder) with its version");
            d.Version = string.From(v.Unwrap());
            d.Registry = path.Join(dir, reg.Unwrap());
            Fetch(ref d, lock, locked, root, doc);
        } else {
            DepFail(manifest.AsStr(), name, "needs `path = \"…\"`, or `version` and `registry`");
        }
        // its own dependencies
        string sub = string.From(d.Dir.AsStr());
        got.Push(d);
        Visit(sub.AsStr(), ref got, ref seen, lock, locked, root);
    }
}

void DepFail(str manifest, str name, str why) {
    string msg = string.From(manifest);
    msg.Append(": the dependency `");
    msg.Append(name);
    msg.Append("` ");
    msg.Append(why);
    EnvoFail(msg.AsStr(), 1);
}

// The lock in dir (an empty block if there is none).
eon.Value ReadLock(str dir) {
    string f = path.Join(dir, "envo.lock.envon");
    if (!fs.IsFile(f.AsStr())) return eon.Value.NewBlock();
    return LoadManifest(f.AsStr());
}

// The locked digest of name@version, or "".
str Locked(in eon.Value lock, str name, str version) {
    eon.Value[] ps = lock.Field("package");
    foreach (var p in ps) {
        str? n = p.GetStr("name");
        str? v = p.GetStr("version");
        if (n.IsSome() && v.IsSome() && Eq(n.Unwrap(), name) && Eq(v.Unwrap(), version)) {
            str? h = p.GetStr("sha256");
            if (h.IsSome()) return h.Unwrap();
        }
    }
    return "";
}

// Gets d's archive from its registry, checks it, and unpacks it into build/deps.
void Fetch(ref Dep d, in eon.Value lock, bool locked, str root, in eon.Value manifest) {
    RegistryFolder reg = RegistryFolder.At(d.Registry.AsStr());
    var r = reg.Archive(d.Name.AsStr(), d.Version.AsStr());
    if (r.IsErr()) {
        string msg = string.From("cannot get ");
        msg.Append(d.Name.AsStr());
        msg.AppendByte('@');
        msg.Append(d.Version.AsStr());
        msg.Append(" from the registry ");
        msg.Append(d.Registry.AsStr());
        EnvoFail(msg.AsStr(), 1);
    }
    string archive = r.Unwrap();
    string digest = crypto.Sha256(archive.AsStr()).Hex();
    str want = Locked(lock, d.Name.AsStr(), d.Version.AsStr());
    if (want.Len > 0 && !Eq(want, digest.AsStr())) {
        string msg = string.From(d.Name.AsStr());
        msg.AppendByte('@');
        msg.Append(d.Version.AsStr());
        msg.Append(": the archive's SHA-256 is ");
        msg.Append(digest.AsStr());
        msg.Append(", but envo.lock.envon has ");
        msg.Append(want);
        msg.Append(" (the registry's copy changed)");
        EnvoFail(msg.AsStr(), 1);
    }
    if (want.Len == 0 && locked) {
        string msg = string.From(d.Name.AsStr());
        msg.Append(" is not in envo.lock.envon: run `envo fetch`");
        EnvoFail(msg.AsStr(), 1);
    }
    // signatures, when the manifest trusts keys
    eon.Value[] trust = manifest.Field("trust");
    if (trust.Len == 1 && trust[0].IsBlock()) {
        var sr = reg.Signature(d.Name.AsStr(), d.Version.AsStr());
        bool ok = false;
        if (sr.IsOk()) {
            string sig = sr.Unwrap();
            List<u8> sb = Unhex(ct.Trim(sig.AsStr()));
            List<u8> msgBytes = List<u8>.New();
            foreach (var c in digest.AsStr()) msgBytes.Push(c);
            eon.Value[] keys = trust[0].Field("keys");
            if (keys.Len == 1 && keys[0].IsArray() && sb.Len() == 64) {
                foreach (var k in keys[0].Elements()) {
                    List<u8> kb = Unhex(k.AsStr());
                    if (kb.Len() == 32 && curve25519.Ed25519Verify(kb.AsSlice(), msgBytes.AsSlice(), sb.AsSlice())) ok = true;
                }
            }
        }
        if (!ok) {
            string msg = string.From(d.Name.AsStr());
            msg.AppendByte('@');
            msg.Append(d.Version.AsStr());
            msg.Append(": no signature by a trusted key");
            EnvoFail(msg.AsStr(), 1);
        }
    }
    d.Sha256 = digest;
    string folder = string.From(d.Name.AsStr());
    folder.AppendByte('-');
    folder.Append(d.Version.AsStr());
    string dest = path.Join(root, "build/deps");
    dest = path.Join(dest.AsStr(), folder.AsStr());
    if (!UnpackArchive(archive.AsStr(), dest.AsStr())) {
        string msg = string.From(d.Name.AsStr());
        msg.Append(": the archive is malformed");
        EnvoFail(msg.AsStr(), 1);
    }
    d.Dir = dest;
}

// ------------------------------------------------------------------ archives

// A package's archive: "envopkg 1\n", then for each file (sorted by path, with `/`) its
// path, a newline, its size in decimal, a newline, its bytes, a newline. The manifest is
// in it; build/ folders are not.
string PackArchive(str dir) {
    List<string> files = List<string>.New();
    Collect(dir, "", ref files);
    text.Sort(ref files);
    string packed = string.From("envopkg 1\n");
    foreach (var rel in files.AsSlice()) {
        string full = path.Join(dir, rel.AsStr());
        var r = fs.ReadText(full.AsStr());
        if (r.IsErr()) continue;
        string body = r.Unwrap();
        packed.Append(rel.AsStr());
        packed.AppendByte('\n');
        packed.Append(text.Uint(body.Len() as u64).AsStr());
        packed.AppendByte('\n');
        packed.Append(body.AsStr());
        packed.AppendByte('\n');
    }
    return packed;
}

void Collect(str dir, str rel, ref List<string> files) {
    string here = string.From(dir);
    if (rel.Len > 0) here = path.Join(dir, rel);
    var r = fs.ListDir(here.AsStr());
    if (r.IsErr()) return;
    List<string> names = r.Unwrap();
    foreach (var n in names.AsSlice()) {
        str name = n.AsStr();
        if (name.Len == 0 || name[0] == '.') continue;
        string sub = string.From(name);
        if (rel.Len > 0) {
            sub = string.From(rel);
            sub.AppendByte('/');
            sub.Append(name);
        }
        string full = path.Join(dir, sub.AsStr());
        if (fs.IsDir(full.AsStr())) {
            if (Eq(name, "build")) continue;
            Collect(dir, sub.AsStr(), ref files);
        } else {
            files.Push(sub);
        }
    }
}

// Unpacks an archive into dest; false if it is malformed or names a path outside dest.
bool UnpackArchive(str a, str dest) {
    if (!ct.StartsWith(a, "envopkg 1\n")) return false;
    usize i = 10;
    fs.CreateDirAll(dest);
    while (i < a.Len) {
        usize e = i;
        while (e < a.Len && a[e] != '\n') e++;
        if (e >= a.Len) return false;
        str rel = a[i..e];
        if (rel.Len == 0 || rel[0] == '/' || ct.Contains(rel, "..") || ct.Contains(rel, ":") || ct.Contains(rel, "\\")) return false;
        usize s = e + 1;
        usize se = s;
        while (se < a.Len && a[se] != '\n') se++;
        if (se >= a.Len) return false;
        u64? n = fmt.ParseU64(a[s..se]);
        if (n.IsNone() || n.Unwrap() > (a.Len - se - 1) as u64) return false;
        usize b = se + 1;
        usize be = b + n.Unwrap() as usize;
        if (be >= a.Len || a[be] != '\n') return false;
        string full = path.Join(dest, rel);
        fs.CreateDirAll(path.Parent(full.AsStr()));
        string body = string.New();
        for (usize k = b; k < be; k++) body.AppendByte(a[k]);
        if (fs.WriteText(full.AsStr(), body.AsStr()).IsErr()) return false;
        i = be + 1;
    }
    return true;
}

string HexBytes(u8[] b) {
    string s = string.New();
    foreach (var c in b) s.Append(text.Hex(c as u64, 2).AsStr());
    return s;
}

List<u8> Unhex(str s) {
    List<u8> b = List<u8>.New();
    if (s.Len % 2 != 0) return b;
    for (usize i = 0; i + 1 < s.Len; i += 2) {
        u64? v = fmt.ParseHex(s[i..i + 2]);
        if (v.IsNone()) return List<u8>.New();
        b.Push(v.Unwrap() as u8);
    }
    return b;
}

// ------------------------------------------------------------------ commands

// The folder argument of a package command (default "."), and its options.
str PkgDir(usize from, ref string registryDir, ref string keyFile) {
    str dir = ".";
    usize i = from;
    while (i < env.ArgCount()) {
        str a = env.Arg(i);
        if (Eq(a, "--registry") && i + 1 < env.ArgCount()) {
            registryDir = string.From(env.Arg(i + 1));
            i += 2;
        } else if (Eq(a, "--key") && i + 1 < env.ArgCount()) {
            keyFile = string.From(env.Arg(i + 1));
            i += 2;
        } else if (a.Len > 0 && a[0] == '-') {
            string msg = string.From("unknown option '");
            msg.Append(a);
            msg.AppendByte('\'');
            EnvoFail(msg.AsStr(), 2);
        } else {
            dir = a;
            i++;
        }
    }
    return dir;
}

// `envo fetch [dir]`: resolves the dependencies, fetches registry packages, and writes
// envo.lock.envon.
i32 CmdEnvoFetch(usize from) {
    string reg = string.New();
    string key = string.New();
    str dir = PkgDir(from, ref reg, ref key);
    Package pkg = ReadPackage(dir);
    List<Dep> deps = ResolveDeps(pkg, false);
    string lock = string.From("#eon 1\n// Written by `envo fetch`: the exact packages this one builds with. Keep it with the sources.\n");
    usize n = 0;
    foreach (var d in deps.AsSlice()) {
        if (d.Version.Len() == 0) continue;
        lock.Append("package {\n    name = \"");
        lock.Append(d.Name.AsStr());
        lock.Append("\"\n    version = \"");
        lock.Append(d.Version.AsStr());
        lock.Append("\"\n    sha256 = \"");
        lock.Append(d.Sha256.AsStr());
        lock.Append("\"\n}\n");
        n++;
    }
    string f = path.Join(dir, "envo.lock.envon");
    fs.WriteText(f.AsStr(), lock.AsStr());
    write(1, "envo fetch: ");
    write(1, text.Uint(deps.Len() as u64).AsStr());
    write(1, " dependencies, ");
    write(1, text.Uint(n as u64).AsStr());
    print(" from registries, locked");
    return 0;
}

// `envo pack [dir]`: the package's archive in build/, and its SHA-256.
i32 CmdEnvoPack(usize from) {
    string reg = string.New();
    string key = string.New();
    str dir = PkgDir(from, ref reg, ref key);
    Package pkg = ReadPackage(dir);
    string version = PackageVersion(dir);
    string archive = PackArchive(dir);
    string name = string.From(pkg.Name.AsStr());
    name.AppendByte('-');
    name.Append(version.AsStr());
    name.Append(".envopkg");
    string bdir = path.Join(dir, "build");
    fs.CreateDirAll(bdir.AsStr());
    string file = path.Join(bdir.AsStr(), name.AsStr());
    fs.WriteText(file.AsStr(), archive.AsStr());
    string digest = crypto.Sha256(archive.AsStr()).Hex();
    write(1, file.AsStr());
    write(1, " sha256 ");
    print(digest.AsStr());
    return 0;
}

// `envo publish [dir] --registry <folder> [--key <file>]`: adds the package's archive to
// a folder registry, signed when a key file (an Ed25519 secret key, 64 hex digits) is
// given. A published version is never replaced.
i32 CmdEnvoPublish(usize from) {
    string reg = string.New();
    string key = string.New();
    str dir = PkgDir(from, ref reg, ref key);
    if (reg.Len() == 0) EnvoFail("give the registry: --registry <folder>", 2);
    Package pkg = ReadPackage(dir);
    string version = PackageVersion(dir);
    string archive = PackArchive(dir);
    string digest = crypto.Sha256(archive.AsStr()).Hex();
    string sig = string.New();
    if (key.Len() > 0) {
        var kr = fs.ReadText(key.AsStr());
        if (kr.IsErr()) EnvoFail("cannot read the key file", 1);
        string ktext = kr.Unwrap();
        List<u8> secret = Unhex(ct.Trim(ktext.AsStr()));
        if (secret.Len() != 32) EnvoFail("the key file must hold 64 hex digits (an Ed25519 secret key)", 1);
        List<u8> msg = List<u8>.New();
        foreach (var c in digest.AsStr()) msg.Push(c);
        u8[64] s;
        curve25519.Ed25519Sign(secret.AsSlice(), msg.AsSlice(), s[0..64]);
        sig = HexBytes(s[0..64]);
    }
    RegistryFolder r = RegistryFolder.At(reg.AsStr());
    if (!r.Publish(pkg.Name.AsStr(), version.AsStr(), archive.AsStr(), sig.AsStr())) {
        string msg = string.From(pkg.Name.AsStr());
        msg.AppendByte('@');
        msg.Append(version.AsStr());
        msg.Append(" is already in the registry (a published version is never replaced)");
        EnvoFail(msg.AsStr(), 1);
    }
    write(1, "published ");
    write(1, pkg.Name.AsStr());
    write(1, "@");
    write(1, version.AsStr());
    write(1, " sha256 ");
    print(digest.AsStr());
    return 0;
}

// `envo key <file>`: a new Ed25519 secret key in file; prints its public key, for a
// `trust { keys = [...] }` block.
i32 CmdEnvoKey(usize from) {
    if (from >= env.ArgCount()) EnvoFail("give the file for the new key", 2);
    str file = env.Arg(from);
    if (fs.IsFile(file)) EnvoFail("the key file exists already; give a new name", 1);
    u8[32] secret;
    crypto.RandomBytes(secret[0..32]);
    string hex = HexBytes(secret[0..32]);
    hex.AppendByte('\n');
    fs.WriteText(file, hex.AsStr());
    u8[32] pub;
    curve25519.Ed25519Public(secret[0..32], pub[0..32]);
    string p = HexBytes(pub[0..32]);
    write(1, "public key ");
    print(p.AsStr());
    return 0;
}

string PackageVersion(str dir) {
    string manifest = path.Join(dir, "envo.envon");
    eon.Value doc = LoadManifest(manifest.AsStr());
    eon.Value[] block = doc.Field("package");
    str? v = block[0].GetStr("version");
    if (v.IsNone()) {
        string msg = string.From(manifest.AsStr());
        msg.Append(": the `package` block needs `version = \"...\"` to be packed");
        EnvoFail(msg.AsStr(), 1);
    }
    return string.From(v.Unwrap());
}

// The sources of pkg's dependencies (not their main.envo), in the order of ResolveDeps.
List<string> DepSources(in Package pkg) {
    List<string> got = List<string>.New();
    List<Dep> deps = ResolveDeps(pkg, true);
    foreach (var d in deps.AsSlice()) {
        Package p = ReadPackage(d.Dir.AsStr());
        foreach (var f in p.Sources.AsSlice()) {
            if (!(p.HasMain && f.Equals(p.Sources.AsSlice()[0].AsStr()))) got.Push(string.From(f.AsStr()));
        }
    }
    return got;
}
