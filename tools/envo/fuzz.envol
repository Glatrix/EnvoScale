// `envo fuzz` (PLAN D64): coverage-guided fuzzing in the script runtime. A fuzz target is
// a program that reads the file named by its first argument and works on its bytes; a
// panic is a crash, any other ending is fine. The target is compiled once; each input
// runs in the same VM (exits and panics end the run, not the process), which notes the
// blocks that ran. An input that runs a block no earlier input ran joins the corpus, and
// new inputs are mutations of the corpus. With a seed, a session is the same on every
// machine.
//
//   envo fuzz target.envol [--runs N] [--seed N] [--max-len N] [--corpus DIR] [--allow …]
//
// The corpus folder (default build/fuzz/<target>/corpus) gives the first inputs and
// keeps the interesting ones; a crash is saved as build/fuzz/<target>/crash and shown
// by running it once more, out loud. The input reaches the target from memory (the VM
// serves its path), so a run touches no disk; `envo run target.envol <crash file>`
// replays a crash.
use std.env;
use std.fs;
use std.path;
use core.text as ct;
use alloc.text;
use envoc.eir;
use envoc.diag;
use envo.vm;
use ports.{IoError};

struct Fuzzer {
    u64 Rng;
    List<List<u8>> Corpus;
    List<u8> Seen;          // per block: covered by some input
    usize Covered;
    usize MaxLen;
    List<List<u8>> Dict;    // byte strings the target compares with
}

impl Fuzzer {
    u64 Next(ref this) {
        u64 x = this.Rng;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        this.Rng = x;
        return x;
    }

    usize Below(ref this, usize n) {
        if (n == 0) return 0;
        return (this.Next() % n as u64) as usize;
    }

    // A new input: a corpus entry changed one to four times.
    List<u8> Mutate(ref this) {
        List<u8> d = List<u8>.New();
        // the newest entries half the time: they reached the deepest so far
        usize pick = this.Below(this.Corpus.Len());
        if (this.Below(2) == 0) {
            usize recent = this.Corpus.Len();
            if (recent > 4) recent = 4;
            pick = this.Corpus.Len() - 1 - this.Below(recent);
        }
        foreach (var b in this.Corpus.AsSlice()[pick].AsSlice()) d.Push(b);
        // one change half the time (small steps keep what a parent reached), else two to four
        usize times = 1;
        if (this.Below(2) == 0) times = 2 + this.Below(3);
        for (usize t = 0; t < times; t++) this.MutateOnce(ref d);
        while (d.Len() > this.MaxLen) d.Pop();
        return d;
    }

    void MutateOnce(ref this, ref List<u8> d) {
        usize kind = this.Below(12);
        if (kind > 9) kind = 8;
        usize n = d.Len();
        if (this.Dict.Len() == 0 && kind >= 8) kind = this.Below(8);
        if (n == 0 && kind != 9) kind = 2;
        if (kind >= 8) {
            // a dictionary entry, written over the input (8) or inserted (9)
            usize w = this.Below(this.Dict.Len());
            u8[] e = this.Dict.AsSlice()[w].AsSlice();
            usize at = this.Below(n + 1);
            for (usize k = 0; k < e.Len; k++) {
                if (kind == 8 && at + k < d.Len()) d.Set(at + k, e[k]);
                else Insert(ref d, at + k, e[k]);
            }
            return;
        }
        if (kind == 0) {
            // flip a bit
            usize at = this.Below(n);
            d.Set(at, d.Get(at) ^ (1 << this.Below(8)) as u8);
        } else if (kind == 1) {
            // a random byte
            d.Set(this.Below(n), this.Next() as u8);
        } else if (kind == 2) {
            // insert a byte: random, or printable ASCII half the time
            u8 b = this.Next() as u8;
            if (this.Below(2) == 0) b = 32 + this.Below(95) as u8;
            Insert(ref d, this.Below(n + 1), b);
        } else if (kind == 3) {
            // delete a byte
            Remove(ref d, this.Below(n));
        } else if (kind == 4) {
            // an interesting value
            usize at = this.Below(n);
            usize w = this.Below(5);
            u8 v = 0;
            if (w == 1) v = 0xFF;
            else if (w == 2) v = 0x7F;
            else if (w == 3) v = 0x80;
            else if (w == 4) v = 1;
            d.Set(at, v);
        } else if (kind == 5) {
            // copy a piece of the input elsewhere in it
            usize from = this.Below(n);
            usize len = 1 + this.Below(n - from);
            if (len > 16) len = 16;
            usize to = this.Below(n + 1);
            List<u8> piece = List<u8>.New();
            for (usize k = 0; k < len; k++) piece.Push(d.Get(from + k));
            for (usize k = 0; k < len; k++) Insert(ref d, to + k, piece.Get(k));
        } else if (kind == 6) {
            // splice: the start of this input, the end of another
            usize other = this.Below(this.Corpus.Len());
            u8[] o = this.Corpus.AsSlice()[other].AsSlice();
            usize cut = this.Below(n + 1);
            while (d.Len() > cut) d.Pop();
            usize from = this.Below(o.Len + 1);
            for (usize k = from; k < o.Len; k++) d.Push(o[k]);
        } else {
            // add or subtract a little
            usize at = this.Below(n);
            u8 delta = 1 + this.Below(16) as u8;
            if (this.Below(2) == 0) d.Set(at, d.Get(at) +% delta);
            else d.Set(at, d.Get(at) -% delta);
        }
    }

    // Takes in the blocks the last run covered; true if any was new.
    bool Learn(ref this, u8[] hits) {
        bool fresh = false;
        mut u8[] seen = this.Seen.AsMutSlice();
        for (usize b = 0; b < hits.Len && b < seen.Len; b++) {
            if (hits[b] != 0 && seen[b] == 0) {
                seen[b] = 1;
                this.Covered++;
                fresh = true;
            }
        }
        return fresh;
    }
}

void Insert(ref List<u8> d, usize at, u8 b) {
    d.Push(0);
    mut u8[] s = d.AsMutSlice();
    usize i = s.Len - 1;
    while (i > at) {
        s[i] = s[i - 1];
        i--;
    }
    s[at] = b;
}

void Remove(ref List<u8> d, usize at) {
    mut u8[] s = d.AsMutSlice();
    for (usize i = at; i + 1 < s.Len; i++) s[i] = s[i + 1];
    d.Pop();
}

string BytesText(u8[] b) {
    string s = string.New();
    foreach (var c in b) s.AppendByte(c);
    return s;
}

i32 CmdEnvoFuzz(usize from) {
    BuildOpts o = new BuildOpts {
        Inputs = List<string>.New(), Output = string.New(), Target = HostTargetCode(), Opt = false,
        Os = string.New(), RunArgs = List<string>.New(), Native = false, Allows = List<string>.New(), Sbom = false, Map = string.New(),
    };
    usize runs = 10000;
    u64 seed = 1;
    usize maxLen = 256;
    string corpusDir = string.New();
    usize i = from;
    while (i < env.ArgCount()) {
        str a = env.Arg(i);
        bool more = i + 1 < env.ArgCount();
        if (Eq(a, "--runs") && more) {
            runs = ParseCount(env.Arg(i + 1), "--runs");
            i += 2;
        } else if (Eq(a, "--seed") && more) {
            seed = ParseCount(env.Arg(i + 1), "--seed") as u64;
            i += 2;
        } else if (Eq(a, "--max-len") && more) {
            maxLen = ParseCount(env.Arg(i + 1), "--max-len");
            i += 2;
        } else if (Eq(a, "--corpus") && more) {
            corpusDir = string.From(env.Arg(i + 1));
            i += 2;
        } else if (Eq(a, "-O2")) {
            o.Opt = true;
            i++;
        } else if (Eq(a, "--allow") && more) {
            o.Allows.Push(string.From(env.Arg(i + 1)));
            i += 2;
        } else if (a.Len > 0 && a[0] == '-') {
            string msg = string.From("unknown option '");
            msg.Append(a);
            msg.Append("' for `envo fuzz`; it takes --runs, --seed, --max-len, --corpus, -O2 and --allow");
            EnvoFail(msg.AsStr(), 2);
        } else {
            o.Inputs.Push(string.From(a));
            i++;
        }
    }
    if (o.Inputs.Len() != 1 || !ct.EndsWith(o.Inputs.AsSlice()[0].AsStr(), ".envol")) EnvoFail("give one fuzz target: a .envol file", 2);
    str target = o.Inputs.AsSlice()[0].AsStr();
    string stem = string.From(path.FileName(target));
    string work = path.Join("build/fuzz", stem.AsStr()[0..stem.Len() - 6]);
    fs.CreateDirAll(work.AsStr());
    if (corpusDir.Len() == 0) corpusDir = path.Join(work.AsStr(), "corpus");
    fs.CreateDirAll(corpusDir.AsStr());
    string input = path.Join(work.AsStr(), "input");
    // the target may read its input, and whatever --allow grants
    string grant = string.From("read:");
    grant.Append(input.AsStr());
    o.Allows.Push(grant);
    vm.Sandbox box = MakeSandbox(o);
    string home = EnvoHome();
    Sources src = Sources.New();
    List<string> files = List<string>.New();
    files.Push(string.From(target));
    Module m = CompileProgram(ref src, files, HostTargetCode(), false, true, -1, o.Opt, home.AsStr(), o.Os.AsStr());
    List<string> args = List<string>.New();
    args.Push(string.From(target));
    args.Push(string.From(input.AsStr()));
    vm.Vm machine = vm.Vm.New(m, box);
    machine.Cover();
    machine.CatchExits(true);

    Fuzzer z = new Fuzzer { Rng = seed *% 0x9E3779B97F4A7C15 +% 1, Corpus = List<List<u8>>.New(), Seen = List<u8>.New(), Covered = 0, MaxLen = maxLen, Dict = List<List<u8>>.New() };
    // the dictionary: each compared constant as little-endian bytes, without the zero
    // bytes above it (so 'F' is one byte, 0x1234 two)
    List<u64> consts = machine.CompareConstants();
    foreach (var c in consts.AsSlice()) {
        if (c == 0 || c == 0xFFFFFFFFFFFFFFFF) continue;
        List<u8> e = List<u8>.New();
        u64 v = c;
        while (v != 0 && e.Len() < 8) {
            e.Push(v as u8);
            v = v >> 8;
        }
        z.Dict.Push(e);
    }
    for (usize b = 0; b < machine.BlockCount(); b++) z.Seen.Push(0);
    // the first inputs: the corpus folder's files (in name order), else an empty input
    Result<List<string>, IoError> listed = fs.ListDir(corpusDir.AsStr());
    if (listed.IsOk()) {
        List<string> names = listed.Unwrap();
        text.Sort(ref names);
        foreach (var n in names.AsSlice()) {
            string f = path.Join(corpusDir.AsStr(), n.AsStr());
            var r = fs.ReadText(f.AsStr());
            if (r.IsErr()) continue;
            string body = r.Unwrap();
            List<u8> d = List<u8>.New();
            foreach (var c in body.AsStr()) d.Push(c);
            z.Corpus.Push(d);
        }
    }
    usize loaded = z.Corpus.Len();
    if (z.Corpus.Len() == 0) z.Corpus.Push(List<u8>.New());
    // run the first inputs, then mutations
    usize done = 0;
    usize added = 0;
    bool crashed = false;
    List<u8> crash = List<u8>.New();
    usize first = z.Corpus.Len();
    while (done < runs && !crashed) {
        List<u8> d = List<u8>.New();
        if (done < first) {
            foreach (var b in z.Corpus.AsSlice()[done].AsSlice()) d.Push(b);
        } else {
            d = z.Mutate();
        }
        machine.SetInput(input.AsStr(), d.AsSlice());
        machine.ClearHits();
        machine.Rerun(args);
        done++;
        if (machine.Panicked()) {
            crashed = true;
            crash = d;
            break;
        }
        if (z.Learn(machine.Hits()) && done > first) {
            added++;
            string name = string.From("input-");
            name.Append(text.PadLeft(text.Uint(added as u64).AsStr(), 5, '0').AsStr());
            string f = path.Join(corpusDir.AsStr(), name.AsStr());
            string body = BytesText(d.AsSlice());
            fs.WriteText(f.AsStr(), body.AsStr());
            z.Corpus.Push(d);
        }
    }
    string report = string.From("envo fuzz: ");
    report.Append(text.Uint(done as u64).AsStr());
    report.Append(" runs, ");
    report.Append(text.Uint(loaded as u64).AsStr());
    report.Append(" inputs given, ");
    report.Append(text.Uint(added as u64).AsStr());
    report.Append(" found; ");
    report.Append(text.Uint(z.Covered as u64).AsStr());
    report.Append(" of ");
    report.Append(text.Uint(machine.BlockCount() as u64).AsStr());
    report.Append(" blocks covered; a dictionary of ");
    report.Append(text.Uint(z.Dict.Len() as u64).AsStr());
    report.Append(" constants\n");
    write(1, report.AsStr());
    if (!crashed) {
        print("no crash");
        return 0;
    }
    string saved = path.Join(work.AsStr(), "crash");
    string body = BytesText(crash.AsSlice());
    fs.WriteText(saved.AsStr(), body.AsStr());
    write(1, "crash: ");
    write(1, text.Uint(crash.Len() as u64).AsStr());
    write(1, " bytes, saved as ");
    print(saved.AsStr());
    // run it again, out loud, so the panic shows
    machine.SetInput(input.AsStr(), crash.AsSlice());
    machine.CatchExits(false);
    machine.Rerun(args);
    return 1;
}
