// Which types are `Copy` and which need a drop ([type.copy.1], [own.drop.1]). Follows
// Stage 1's bootstrap/stage1/check/own.envol. The move and borrow checkers come in M3.5.
namespace envoc.sema;

use envoc.util;
use envoc.syntax;

impl Checker {
    // Is node n an item of the S1 prelude?
    bool IsPreludeNode(in this, u32 n) {
        if (this.PreludeFile == 0xFFFFFFFF) return false;
        return this.TokFile(this.NTok(n)) == this.PreludeFile;
    }

    // [type.copy.1], [s1.type.1]: primitives, `str` and shared views, raw pointers,
    // fieldless enums, and arrays and structs of `Copy` values without a drop are copied;
    // function values, types implementing `IDrop` and anything holding them are moved. A
    // type parameter is `Copy` when a bound says so (`where T : Copy`).
    bool IsCopy(ref this, u32 t) {
        Type ty = this.TypeAt(t);
        u8 k = ty.Kind;
        if (k == TYK_BOOL || k == TYK_INT || k == TYK_FLOAT || k == TYK_STR || k == TYK_PTR || k == TYK_ENUM) return true;
        if (k == TYK_SLICE) return ty.Count == 0;       // a `mut T[]` is exclusive ([view.1])
        if (k == TYK_ARRAY) return this.IsCopy(ty.Elem);
        if (k == TYK_PARAM) {
            u32 copy = this.CopySym;
            return copy != 0 && this.Implements(t, this.SymAt(copy).Type);
        }
        if (k == TYK_UNION) {
            if (this.HasDropImpl(t)) return false;
            return this.PayloadsAll(t, 0);
        }
        if (k != TYK_STRUCT) return false;
        if (this.HasDropImpl(t)) return false;
        u32 f = this.NodeAt(this.SymAt(ty.Sym).Node).A;
        while (f != 0) {
            u32 ft = this.FieldType(t, f);
            if (!this.IsCopy(ft)) return false;
            f = this.NNext(f);
        }
        return true;
    }

    // For tagged enum type t: what 0 (is `Copy`), 1 (needs a drop: any), 2 (needs a drop,
    // counting type parameters: any) holds of its payload fields.
    bool PayloadsAll(ref this, u32 t, u32 what) {
        this.TaggedEnumDeclare(this.TypeAt(t).Sym);
        u32 v = this.NodeAt(this.SymAt(this.TypeAt(t).Sym).Node).B;
        while (v != 0) {
            u32 f = this.NodeAt(v).E;
            while (f != 0) {
                u32 ft = this.PayloadType(t, f);
                if (what == 0 && !this.IsCopy(ft)) return false;
                if (what == 1 && this.NeedsDrop(ft)) return true;
                if (what == 2 && this.NeedsDropAt(ft)) return true;
                f = this.NNext(f);
            }
            v = this.NNext(v);
        }
        return what == 0;
    }

    // Does type t implement the prelude's `IDrop`?
    bool HasDropImpl(ref this, u32 t) {
        u32 drop = this.DropSym;
        if (drop == 0) return false;
        return this.FindImpl(t, this.SymAt(drop).Type) != 0;
    }

    // NeedsDrop for a type that may still name type parameters: a parameter may need one.
    bool NeedsDropAt(ref this, u32 t) {
        Type ty = this.TypeAt(t);
        if (ty.Kind == TYK_PARAM) return true;
        if (ty.Kind == TYK_ARRAY) return this.NeedsDropAt(ty.Elem);
        if (ty.Kind == TYK_UNION) return this.HasDropImpl(t) || this.PayloadsAll(t, 2);
        if (ty.Kind != TYK_STRUCT) return false;
        if (this.HasDropImpl(t)) return true;
        u32 f = this.NodeAt(this.SymAt(ty.Sym).Node).A;
        while (f != 0) {
            u32 ft = this.FieldType(t, f);
            if (this.NeedsDropAt(ft)) return true;
            f = this.NNext(f);
        }
        return false;
    }

    // Does dropping a value of concrete type t run code ([own.drop.1])? Its own `Drop`, or
    // that of a field or element.
    bool NeedsDrop(ref this, u32 t) {
        Type ty = this.TypeAt(t);
        if (ty.Kind == TYK_ARRAY) return this.NeedsDrop(ty.Elem);
        if (ty.Kind == TYK_UNION) return this.HasDropImpl(t) || this.PayloadsAll(t, 1);
        if (ty.Kind != TYK_STRUCT) return false;
        if (this.HasDropImpl(t)) return true;
        u32 f = this.NodeAt(this.SymAt(ty.Sym).Node).A;
        while (f != 0) {
            u32 ft = this.FieldType(t, f);
            if (this.NeedsDrop(ft)) return true;
            f = this.NNext(f);
        }
        return false;
    }
}
