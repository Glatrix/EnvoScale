// Envo-S1 function types, lambdas and function values (RFC 0003). Follows Stage 1's
// bootstrap/stage1/check/closure.envo: every function-typed value is a function value
// { code, env } ([fn.abi.2]); a lambda passed straight to a function-typed parameter
// borrows its captures ([fn.pos.1], [fn.cap.1]), any other lambda copies them.
namespace envoc.sema;

use envoc.util;
use envoc.syntax;

impl Checker {
    // The interned function type `kind fn(params) -> ret`. params and modes are n entries of
    // TypeArgs (types; 0, NF_IN or NF_REF). Type.Elem is the result, Count the kind,
    // Args/NArgs the parameter types and Sym the first mode.
    u32 FnTypeOf(ref this, u32 kind, u32 params, u32 modes, u32 n, u32 ret) {
        string key = string.From("F:");
        AppendDecimal(ref key, kind as u64);
        key.AppendByte(':');
        AppendDecimal(ref key, ret as u64);
        for (u32 i = 0; i < n; i++) {
            key.AppendByte(',');
            AppendDecimal(ref key, this.EnvGet(params, i) as u64);
            key.AppendByte('/');
            AppendDecimal(ref key, this.EnvGet(modes, i) as u64);
        }
        u32? found = this.Instances.Get(key);
        if (found.IsSome()) return found.Unwrap();
        u32 p = this.EnvNew(n);
        u32 m = this.EnvNew(n);
        for (u32 i = 0; i < n; i++) {
            this.EnvSet(p, i, this.EnvGet(params, i));
            this.EnvSet(m, i, this.EnvGet(modes, i));
        }
        u32 t = this.TypeNew(TYK_FN);
        Type ty = this.TypeAt(t);
        ty.Name = TextOf("fn");
        ty.Size = 16;
        ty.Align = 8;
        ty.Elem = ret;
        ty.Count = kind;
        ty.Args = p;
        ty.NArgs = n;
        ty.Sym = m;
        this.PutType(t, ty);
        this.Instances.Put(key, t);
        return t;
    }

    // fn type t with its types substituted.
    u32 FnTypeSubst(ref this, u32 t, u32 env, u32 n) {
        Type ty = this.TypeAt(t);
        u32 p = this.EnvNew(ty.NArgs);
        for (u32 i = 0; i < ty.NArgs; i++) {
            u32 a = this.Subst(this.EnvGet(ty.Args, i), env, n);
            this.EnvSet(p, i, a);
        }
        u32 ret = this.Subst(ty.Elem, env, n);
        return this.FnTypeOf(ty.Count, p, ty.Sym, ty.NArgs, ret);
    }

    // `[mut|once] fn(P…) -> R` ([fn.syn.*]).
    u32 ResolveFnType(ref this, u32 n) {
        Node node = this.NodeAt(n);
        u32 count = this.ListCount(node.A);
        u32 p = this.EnvNew(count);
        u32 m = this.EnvNew(count);
        u32 a = node.A;
        for (u32 i = 0; i < count; i++) {
            u32 at = this.ResolveType(a, false);
            this.EnvSet(p, i, at);
            this.EnvSet(m, i, this.NodeAt(a).Flags & (NF_IN | NF_REF));
            a = this.NNext(a);
        }
        u32 ret = T_VOID;
        if (node.B != 0) ret = this.ResolveType(node.B, true);
        u32 kind = FK_FN;
        if (node.Flags & NF_MUT != 0) kind = FK_MUT;
        if (node.Flags & NF_ONCE != 0) kind = FK_ONCE;
        return this.FnTypeOf(kind, p, m, count, ret);
    }

    void AppendFnType(in this, ref string b, Type ty) {
        if (ty.Count == FK_MUT) b.Append("mut ");
        if (ty.Count == FK_ONCE) b.Append("once ");
        b.Append("fn(");
        for (u32 i = 0; i < ty.NArgs; i++) {
            if (i > 0) b.Append(", ");
            u32 mode = this.EnvGet(ty.Sym, i);
            if (mode == NF_IN) b.Append("in ");
            if (mode == NF_REF) b.Append("ref ");
            this.AppendType(ref b, this.EnvGet(ty.Args, i));
        }
        b.AppendByte(')');
        if (ty.Elem != T_VOID) {
            b.Append(" -> ");
            this.AppendType(ref b, ty.Elem);
        }
    }

    // May a value of type got be used where want is expected? Equal types, or function
    // types that match except for a weaker kind ([fn.type.4]).
    bool Assignable(in this, u32 got, u32 want) {
        if (got == want) return true;
        Type g = this.TypeAt(got);
        Type w = this.TypeAt(want);
        // `mut T[]` is also a `T[]` ([view.5])
        if (g.Kind == TYK_SLICE && w.Kind == TYK_SLICE && g.Count == 1 && w.Count == 0 && g.Elem == w.Elem) return true;
        if (g.Kind != TYK_FN || w.Kind != TYK_FN) return false;
        if (g.Count > w.Count || g.Elem != w.Elem || g.NArgs != w.NArgs) return false;
        for (u32 i = 0; i < g.NArgs; i++) {
            if (this.EnvGet(g.Args, i) != this.EnvGet(w.Args, i)) return false;
            if (this.EnvGet(g.Sym, i) != this.EnvGet(w.Sym, i)) return false;
        }
        return true;
    }

    // ------------------------------------------------------------------ captures

    // A use of local s inside lambdas: every enclosing lambda that s is outside of captures
    // it ([fn.cap.1]). A local's Value is its index on the locals stack.
    void NoteLocalUse(ref this, u32 s) {
        u64 idx = this.SymAt(s).Value;
        usize k = this.LamStack.Len();
        while (k >= 3) {
            k -= 3;
            u32 lam = this.LamStack.Get(k);
            u32 start = this.LamStack.Get(k + 1);
            if ((start as u64) <= idx) return;
            bool seen = false;
            for (usize i = 0; i < this.CapTmp.Len(); i += 2) {
                if (this.CapTmp.Get(i) == lam && this.CapTmp.Get(i + 1) == s) seen = true;
            }
            if (!seen) {
                this.CapTmp.Push(lam);
                this.CapTmp.Push(s);
            }
        }
    }

    // The local or receiver a place expression is rooted in (through fields and array
    // elements, not through pointers), or 0.
    u32 PlaceRoot(in this, u32 n) {
        while (n != 0) {
            Node node = this.NodeAt(n);
            if (node.Kind == NK_NAME || node.Kind == NK_THIS) return n;
            if (node.Kind == NK_MEMBER) {
                if (this.TyKind(this.NType(node.A)) == TYK_PTR) return 0;
                n = node.A;
            } else if (node.Kind == NK_INDEX) {
                if (this.TyKind(this.NType(node.A)) != TYK_ARRAY) return 0;
                n = node.A;
            } else {
                return 0;
            }
        }
        return 0;
    }

    // A change to place n: lambdas that capture its root become `mut fn` ([fn.type.2]); the
    // first change is remembered for E0331.
    void MarkMutation(ref this, u32 n) {
        u32 root = this.PlaceRoot(n);
        if (root == 0) return;
        u32 s = this.NSym(root);
        if (s == 0 || this.SymKind(s) != SK_LOCAL) return;
        u64 idx = this.SymAt(s).Value;
        usize k = this.LamStack.Len();
        while (k >= 3) {
            k -= 3;
            if ((this.LamStack.Get(k + 1) as u64) <= idx) return;
            if (this.LamStack.Get(k + 2) == 0) {
                u32 tok = this.NTok(root);
                this.LamStack.Set(k + 2, tok);
            }
        }
    }

    // ------------------------------------------------------------------ lambdas

    // A lambda against target type `target` (0 if none). inferRet: the target's result is
    // not known yet (generic inference), so the body decides it ([fn.lam.1], [fn.lam.2]).
    u32 CheckLambda(ref this, u32 n, u32 target, bool inferRet) {
        Node lam = this.NodeAt(n);
        u32 count = this.ListCount(lam.A);
        bool has = target != 0 && this.TyKind(target) == TYK_FN;
        Type tt = this.TypeAt(target);
        if (target != 0 && !has) this.LambdaMismatch(n, target, count);
        if (has && tt.NArgs != count) this.LambdaMismatch(n, target, count);
        u32 pl = this.EnvNew(count);
        u32 ml = this.EnvNew(count);
        u32 p = lam.A;
        for (u32 i = 0; i < count; i++) {
            Node pn = this.NodeAt(p);
            u32 pt = 0;
            u32 mode = pn.Flags & (NF_IN | NF_REF);
            if (pn.A != 0) pt = this.ResolveType(pn.A, false);
            if (has) {
                u32 tpt = this.EnvGet(tt.Args, i);
                u32 tm = this.EnvGet(tt.Sym, i);
                if (pt == 0) pt = tpt;
                else if (pt != tpt) this.Mismatch(tpt, this.NTok(pn.A), pt);
                if (mode == 0) mode = tm;
                else if (mode != tm) this.Fail(pn.Tok, E_MISMATCH, "mismatched types: this parameter's mode differs from the target's");
            }
            if (pt == 0) this.FailName(pn.Tok, E_LAMBDA_INFER, "cannot infer the type of lambda parameter `", pn.Tok, "`; write its type");
            this.EnvSet(pl, i, pt);
            this.EnvSet(ml, i, mode);
            this.SetNType(p, pt);
            p = pn.Next;
        }
        u32 ret = T_INFER;
        if (has && !inferRet) ret = tt.Elem;
        // the body is a function of its own, inside the enclosing one's scope
        u32 sRet = this.Ret;
        bool sTop = this.Top;
        usize sUnsafe = this.Unsafe;
        usize sLoops = this.Loops;
        bool sBrk = this.Brk;
        usize sLSP = this.LSP;
        this.LamStack.Push(n);
        u32 lsp = this.LSP as u32;
        this.LamStack.Push(lsp);
        this.LamStack.Push(0);
        this.Ret = ret;
        this.Top = false;
        this.Unsafe = 0;
        this.Loops = 0;
        p = lam.A;
        for (u32 i = 0; i < count; i++) {
            u32 local = this.LocalPush(p, this.EnvGet(pl, i));
            this.SetNSym(p, local);
            u32 mode = this.EnvGet(ml, i);
            if (mode == NF_IN) this.SetSymFlags(local, SF_BYREF | SF_READONLY);
            if (mode == NF_REF) this.SetSymFlags(local, SF_BYREF);
            p = this.NNext(p);
        }
        bool terminates = false;
        u32 body = lam.B;
        if (this.NKind(body) == NK_BLOCK) {
            terminates = this.CheckStmt(body);
        } else if (ret == T_INFER) {
            if (this.NKind(body) == NK_CALL) this.Ret = this.CheckExpr(body, 0);
            else this.Ret = this.CheckValue(body, 0);
            terminates = true;
        } else if (ret == T_VOID) {
            if (this.NKind(body) != NK_CALL) this.Error(E_NO_EFFECT, this.NTok(body));
            this.CheckExpr(body, 0);
        } else {
            this.ExpectType(body, ret);
            terminates = true;
        }
        ret = this.Ret;
        if (ret == T_INFER) ret = T_VOID;
        usize top = this.LamStack.Len() - 3;
        u32 mutTok = this.LamStack.Get(top + 2);
        while (this.LamStack.Len() > top) this.LamStack.Pop();
        this.Ret = sRet;
        this.Top = sTop;
        this.Unsafe = sUnsafe;
        this.Loops = sLoops;
        this.Brk = sBrk;
        this.LSP = sLSP;
        if (ret != T_VOID && !terminates) this.Error(E_MISSING_RETURN, lam.Tok);
        this.TakeCaptures(n);
        u32 kind = FK_FN;
        if (mutTok != 0) kind = FK_MUT;
        if (has) {
            if (kind > tt.Count) this.FailName(mutTok, E_LAMBDA_KIND, "this lambda changes `", mutTok, "`, but the target is a `fn`");
            kind = tt.Count;
        }
        u32 lt = this.FnTypeOf(kind, pl, ml, count, ret);
        if (!this.Core) {
            this.SetNType(n, lt);
            this.OriginCheckLambda(n);
        }
        return lt;
    }

    // Moves lambda n's captures from CapTmp to Captures; the lambda's NValue is
    // first | count << 32.
    void TakeCaptures(ref this, u32 n) {
        u32 first = this.Captures.Len() as u32;
        usize keep = 0;
        for (usize i = 0; i < this.CapTmp.Len(); i += 2) {
            u32 lam = this.CapTmp.Get(i);
            u32 s = this.CapTmp.Get(i + 1);
            if (lam == n) {
                this.Captures.Push(s);
            } else {
                this.CapTmp.Set(keep, lam);
                this.CapTmp.Set(keep + 1, s);
                keep += 2;
            }
        }
        while (this.CapTmp.Len() > keep) this.CapTmp.Pop();
        u32 count = this.Captures.Len() as u32 - first;
        this.SetNValue(n, first as u64 | (count as u64) << 32);
    }

    void LambdaMismatch(in this, u32 n, u32 target, u32 count) {
        string b = string.From("mismatched types: expected `");
        this.AppendType(ref b, target);
        b.Append("`, found a lambda with ");
        AppendDecimal(ref b, count as u64);
        b.Append(" parameter");
        if (count != 1) b.AppendByte('s');
        this.Fail(this.NTok(n), E_MISMATCH, b);
    }

    // Marks a lambda argument for a function-typed parameter: it borrows its captures
    // ([fn.pos.1]) unless written `move`.
    void MarkParamLambda(ref this, u32 a, u32 pt) {
        if (this.NKind(a) == NK_LAMBDA && this.TyKind(pt) == TYK_FN) this.SetNSym(a, 1);
    }

    // ------------------------------------------------------------------ calls and values

    // A call through a function value ([fn.type.3]): callee is any expression of fn type.
    u32 CheckIndirectCall(ref this, u32 n, u32 callee) {
        Node node = this.NodeAt(n);
        u32 ft = this.NType(callee);
        if (ft == 0) ft = this.CheckValue(callee, 0);
        Type f = this.TypeAt(ft);
        if (f.Kind != TYK_FN) this.Error(E_NOT_CALLABLE, node.Tok);
        if (f.Count != FK_FN) {
            // a `mut fn` (or `once fn`) needs owned or exclusive access
            u32 root = this.PlaceRoot(callee);
            if (root != 0 && this.NSym(root) != 0 && this.SymAt(this.NSym(root)).Flags & SF_READONLY != 0) {
                this.FailName(this.NTok(root), E_MUT_FN_SHARED, "`", this.NTok(root), "` is a `mut fn`, so calling it needs `ref` or owned access, not a shared borrow");
            }
            this.MarkMutation(callee);
        }
        u32 count = this.ListCount(node.B);
        if (count != f.NArgs) this.ArgCount(node.Tok, f.NArgs, count);
        u32 a = node.B;
        for (u32 i = 0; i < count; i++) {
            u32 pt = this.EnvGet(f.Args, i);
            this.MarkParamLambda(a, pt);
            this.ExpectType(a, pt);
            this.CheckArgMode(a, this.EnvGet(f.Sym, i) == NF_REF);
            a = this.NNext(a);
        }
        this.SetNSym(n, 0);
        return f.Elem;
    }

    // [own.mode.1] `ref` is written at the call, on a mutable place; `in` borrows implicitly.
    void CheckArgMode(ref this, u32 a, bool refParam) {
        bool refArg = this.NodeAt(a).Flags & NF_REF != 0;
        if (refParam) {
            if (!refArg) this.Fail(this.NTok(a), E_ARG_MODE, "this parameter is `ref`; write `ref` before the argument");
            if (!this.IsMutable(a)) this.Error(E_NOT_ASSIGNABLE, this.NTok(a));
            this.MarkMutation(a);
        } else if (refArg) {
            this.Fail(this.NTok(a), E_ARG_MODE, "only `ref` parameters take `ref` arguments");
        }
    }

    // A named function used as a value ([fn.type.1]): its function type, kind `fn`.
    u32 FnItemType(ref this, u32 s, u32 tok) {
        Sym sym = this.SymAt(s);
        if (sym.Flags & (SF_METHOD | SF_GENERIC) != 0) this.NotCore("generic functions and methods as values; wrap the call in a lambda", tok);
        u32 p = this.EnvNew(sym.Aux);
        u32 m = this.EnvNew(sym.Aux);
        u32 pn = this.FirstParam(s);
        for (u32 i = 0; i < sym.Aux; i++) {
            this.EnvSet(p, i, this.ParamType(s, i));
            this.EnvSet(m, i, this.NodeAt(pn).Flags & (NF_IN | NF_REF));
            pn = this.NNext(pn);
        }
        return this.FnTypeOf(FK_FN, p, m, sym.Aux, sym.Type);
    }
}
