// Declarations: the three passes over the program, and everything they resolve lazily
// (types, struct layouts, enum values, constants, signatures). Follows Stage 1's
// bootstrap/stage1/check/decl.envo.
namespace envoc.sema;

use envoc.util;
use envoc.syntax;

impl Checker {
    // Checks the program. Reports the first error and exits; returns if it is valid.
    public void CheckProgram(ref this) {
        this.InitScope();
        u32 first = this.NodeAt(this.T.Root).A;
        if (!this.Core) this.CollectNamespaces(first);
        // pass 1: collect item names
        u32 n = first;
        while (n != 0) {
            u16 k = this.NKind(n);
            u8 sk = 0;
            if (k == NK_FN) sk = SK_FN;
            else if (k == NK_STRUCT) sk = SK_STRUCT;
            else if (k == NK_ENUM) sk = SK_ENUM;
            else if (k == NK_CONST) sk = SK_CONST;
            else if (k == NK_STATIC) sk = SK_STATIC;
            else if (k == NK_INTERFACE) sk = SK_IFACE;
            if (sk != 0) this.DefineItem(n, sk);
            n = this.NNext(n);
        }
        // pass 2: declarations, in program order
        n = first;
        while (n != 0) {
            u16 k = this.NKind(n);
            u32 s = this.NSym(n);
            if (k == NK_STRUCT) {
                this.StructLayout(s, 0);
                this.DeclareStructMethods(s);
            } else if (k == NK_ENUM) this.EnumDeclare(s);
            else if (k == NK_CONST) this.ConstResolve(s, 0);
            else if (k == NK_STATIC) this.StaticDeclare(s);
            else if (k == NK_FN) this.FnSignature(s);
            else if (k == NK_INTERFACE) this.DeclareIfaceMethods(s);
            else if (k == NK_IMPL) this.DeclareImpl(n);
            n = this.NNext(n);
        }
        this.CheckImpls();
        // pass 3: bodies; the top-level statements are the body of main
        this.LSP = 0;
        this.LBase = 0;
        n = first;
        while (n != 0) {
            u16 k = this.NKind(n);
            if (k == NK_FN) {
                this.FnBody(this.NSym(n));
            } else if (k == NK_STRUCT) {
                this.MethodBodies(this.NodeAt(n).G);
            } else if (k == NK_IMPL) {
                this.MethodBodies(this.NodeAt(n).C);
            } else if (k == NK_INTERFACE) {
                this.MethodBodies(this.NodeAt(n).A);
            } else if (!NodeIsItem(k)) {
                this.Ret = T_I32;
                this.Top = true;
                this.Unsafe = 0;
                this.Loops = 0;
                this.CheckStmt(n);
            }
            n = this.NNext(n);
        }
        if (!this.Core) {
            this.MoveCheckMain(first);
            this.OriginCheckMain(first);
        }
        this.CollectInstances();
    }

    // The bodies of a list of methods (an interface method without a body is skipped).
    void MethodBodies(ref this, u32 m) {
        while (m != 0) {
            if (this.NodeAt(m).C != 0) this.FnBody(this.NSym(m));
            m = this.NNext(m);
        }
    }

    // Pass 1 for one item: its symbol (E0201 if the name is taken).
    void DefineItem(ref this, u32 n, u8 kind) {
        u32 tok = this.NTok(n);
        // an item of a namespace is `ns.Name` in program scope ([s1.item.1])
        Text ns = this.FileNamespace(this.TokFile(tok));
        Text key = this.JoinName(ns, this.TokName(tok));
        u32 prev = this.GFind(TextStr(key));
        bool prelude = this.IsPreludeNode(n);
        // the prelude comes last, so a program's own item of the same name hides it
        bool hidden = prev != 0 && prelude;
        if (prev != 0 && !prelude && this.SymAt(prev).Flags & SF_PRELUDE == 0) this.FailName(tok, E_DUPLICATE, "`", tok, "` is already defined");
        u32 s = this.SymNew(kind, n);
        this.SetNSym(n, s);
        Sym x = this.SymAt(s);
        x.Ns = ns;
        if (this.NodeAt(n).Flags & (NF_PUBLIC | NF_INTERNAL) != 0) x.Flags = SF_PUBLIC;
        this.PutSym(s, x);
        if (prelude) {
            this.AddSymFlags(s, SF_PRELUDE);
            str name = this.SymName(s);
            if (kind == SK_IFACE && Same(name, "IDrop")) this.DropSym = s;
            if (kind == SK_ENUM && Same(name, "Option")) this.OptionSym = s;
            if (kind == SK_ENUM && Same(name, "Result")) this.ResultSym = s;
            if (kind == SK_STRUCT && Same(name, "string")) this.StringSym = s;
        }
        u32 tps = this.NodeAt(n).E;
        bool tagged = kind == SK_ENUM && this.IsTaggedEnumNode(n);
        if (tagged) this.DefineTaggedEnum(s, n);
        if (kind == SK_STRUCT || (kind == SK_ENUM && !tagged)) {
            u8 tk = TYK_STRUCT;
            if (kind == SK_ENUM) tk = TYK_ENUM;
            u32 t = 0;
            if (tps == 0) {
                t = this.TypeNamed(tk, s);
            } else {
                u32 count = this.DeclareTParams(tps, 0);
                t = this.SelfInstance(TYK_STRUCT, s, tps, count);
                Sym g = this.SymAt(s);
                g.NEnv = count;
                g.Flags = g.Flags | SF_GENERIC;
                this.PutSym(s, g);
            }
            this.SetSymType(s, t);
        }
        if (kind == SK_FN && tps != 0) {
            u32 count = this.DeclareTParams(tps, 0);
            Sym g = this.SymAt(s);
            g.NEnv = count;
            g.Flags = g.Flags | SF_GENERIC;
            this.PutSym(s, g);
        }
        if (!hidden) this.Global.Put(TextStr(key), s);
        if (prelude) {
            Text name = this.SymAt(s).Name;
            this.PreludeScope.Put(TextStr(name), s);
        }
        if (kind == SK_IFACE) this.DeclareIfaceItem(s);
    }

    // The type a type node denotes ([core.name.3], [core.type.1]).
    u32 ResolveType(ref this, u32 n, bool voidOk) => this.ResolveTypeEx(n, voidOk, false);

    // ifaceOk: an interface may be named (a bound or an `impl`); elsewhere it would be a
    // dynamic interface value, which Envo-S1 leaves out ([s1.type.3]).
    u32 ResolveTypeEx(ref this, u32 n, bool voidOk, bool ifaceOk) {
        Node node = this.NodeAt(n);
        u32 t = 0;
        if (node.Kind == NK_TOPT) {
            u32 inner = this.ResolveType(node.A, false);
            return this.OptionOf(inner, node.Tok);
        }
        if (node.Kind == NK_TFN) return this.ResolveFnType(n);
        if (node.Kind == NK_TPTR) {
            u32 elem = this.ResolveType(node.A, false);
            t = this.TypePtrTo(elem);
        } else if (node.Kind == NK_TSLICE) {
            u32 mutable = 0;
            if (node.Flags & NF_MUT != 0) mutable = 1;      // `mut T[]` ([view.1])
            u32 elem = this.ResolveType(node.A, false);
            t = this.TypeDerived(TYK_SLICE, elem, mutable);
        } else if (node.Kind == NK_TARRAY) {
            u32 elem = this.ResolveType(node.A, false);
            u32 countNode = node.B;
            u32 countTok = this.NTok(countNode);
            u64 count = 0;
            if (this.NKind(countNode) == NK_INT) {
                bool overflow = false;
                count = this.LiteralValue(countTok, ref overflow);
                if (overflow) this.DoesNotFit(countTok, T_USIZE);
                this.SetNType(countNode, T_USIZE);
            } else {
                u32 s = this.GFindAt(countTok);
                if (s == 0) this.FailName(countTok, E_UNKNOWN_NAME, "unknown name `", countTok, "`");
                if (this.SymKind(s) != SK_CONST) this.Error(E_NOT_CONSTANT, countTok);
                this.ConstResolve(s, countTok);
                Sym sym = this.SymAt(s);
                if (!this.IsIntType(sym.Type)) this.Error(E_NOT_CONSTANT, countTok);
                this.SetNType(countNode, sym.Type);
                count = sym.Value;
                if (this.TypeAt(sym.Type).Signed && (count as i64) < 0) this.Error(E_NOT_CONSTANT, countTok);
            }
            u32 saturated = 0x80000000;
            if (count < 0x80000000) saturated = count as u32;
            // an array's elements are zeroed, not constructed, so none may need a drop
            if (!this.Core && !this.IsCopy(elem) && this.NeedsDropAt(elem)) this.NotCore("arrays of values with a drop; use `List<T>`", node.Tok);
            t = this.TypeDerived(TYK_ARRAY, elem, saturated);
        } else {
            t = this.ResolveTypeName(node.Tok, node.E, node.F);
        }
        if (this.TyKind(t) == TYK_IFACE && !ifaceOk) this.NotCore("interface values; use a generic parameter with a `where` bound", node.Tok);
        if (t == T_VOID && !voidOk) this.Error(E_VOID_TYPE, node.Tok);
        return t;
    }

    // The type named by token tok with type arguments args (a list of type nodes): a type
    // parameter in scope, or a program-scope type ([type.gen.1]).
    u32 ResolveTypeName(ref this, u32 tok, u32 args, u32 quals) {
        u32 have = this.ListCount(args);
        u32 tp = 0;
        if (quals == 0) tp = this.FindTParam(tok);
        if (tp != 0) {
            if (have != 0) this.TypeArgCount(tok, 0, have);
            return this.SymAt(tp).Type;
        }
        u32 s = 0;
        if (quals != 0) s = this.QualifiedType(quals, tok);
        else s = this.GFindAt(tok);
        if (s == 0 && quals == 0 && !this.Core) {
            str name = this.TokText(tok);
            if (Same(name, "f32") || Same(name, "float")) {
                if (have != 0) this.TypeArgCount(tok, 0, have);
                return this.FloatType(4);
            }
            if (Same(name, "f64") || Same(name, "double")) {
                if (have != 0) this.TypeArgCount(tok, 0, have);
                return this.FloatType(8);
            }
        }
        if (s == 0) this.FailName(tok, E_UNKNOWN_TYPE, "unknown type `", tok, "`");
        Sym sym = this.SymAt(s);
        u8 k = sym.Kind;
        if (k != SK_TYPE && k != SK_STRUCT && k != SK_ENUM && k != SK_IFACE) this.FailName(tok, E_NOT_A_TYPE, "`", tok, "` is not a type");
        u32 want = 0;
        if (k == SK_STRUCT || k == SK_IFACE || k == SK_ENUM) want = sym.NEnv;
        if (have != want) this.TypeArgCount(tok, want, have);
        if (want == 0) return sym.Type;
        u32 env = this.EnvNew(want);
        u32 a = args;
        for (u32 i = 0; i < want; i++) {
            u32 at = this.ResolveType(a, false);
            this.EnvSet(env, i, at);
            a = this.NNext(a);
        }
        u8 kind = TYK_STRUCT;
        if (k == SK_IFACE) kind = TYK_IFACE;
        if (k == SK_ENUM) kind = TYK_UNION;
        return this.TypeInstance(kind, s, env, want);
    }

    // Size and alignment of a type, laying out structs on demand. blame is the token to
    // report a struct cycle or a size overflow at.
    u64 SizeOf(ref this, u32 t, u32 blame, ref u64 align) {
        Type ty = this.TypeAt(t);
        if (ty.Kind == TYK_PARAM) {
            // laid out per instance (an abstract layout only finds cycles)
            align = 1;
            return 0;
        }
        if (ty.Kind == TYK_UNION) return this.TaggedLayout(t, blame, ref align);
        if (ty.Kind == TYK_STRUCT && ty.NArgs > 0) {
            this.StructLayout(ty.Sym, blame);
            if (this.HasParams(t)) {
                align = 1;
                return 0;
            }
            return this.InstanceLayout(t, blame, ref align);
        }
        if (ty.Kind == TYK_STRUCT) {
            this.StructLayout(ty.Sym, blame);
            Sym s = this.SymAt(ty.Sym);
            align = s.Aux2 as u64;
            return s.Aux as u64;
        }
        if (ty.Kind == TYK_ENUM) {
            this.EnumDeclare(ty.Sym);
            Type repr = this.TypeAt(this.SymAt(ty.Sym).Aux);
            align = repr.Align as u64;
            return repr.Size as u64;
        }
        if (ty.Kind == TYK_ARRAY) {
            u64 elemSize = this.SizeOf(ty.Elem, blame, ref align);
            // both factors are below 2^31, so the product fits in 64 bits
            u64 size = elemSize * ty.Count as u64;
            if (size > MAX_TYPE_SIZE) this.Error(E_TOO_LARGE, blame);
            return size;
        }
        align = ty.Align as u64;
        return ty.Size as u64;
    }

    // SizeOf when only the checks matter.
    void Layout(ref this, u32 t, u32 blame) {
        u64 align = 0;
        this.SizeOf(t, blame, ref align);
    }

    // Lays out struct symbol s ([core.type.2]). blame: the token to report E0303 at.
    void StructLayout(ref this, u32 s, u32 blame) {
        Sym sym = this.SymAt(s);
        if (sym.LState == 2) return;
        if (sym.LState == 1) this.FailName(blame, E_RECURSIVE, "struct `", this.NTok(sym.Node), "` contains itself");
        sym.LState = 1;
        this.PutSym(s, sym);
        // a generic struct's fields name its parameters
        u32 s1 = this.Scope1;
        u32 s2 = this.Scope2;
        this.Scope1 = this.NodeAt(sym.Node).E;
        this.Scope2 = 0;
        u64 offset = 0;
        u64 maxAlign = 1;
        u32 first = this.NodeAt(sym.Node).A;
        u32 f = first;
        while (f != 0) {
            this.CheckDuplicateInList(first, f);
            u32 ft = this.ResolveType(this.NodeAt(f).A, false);
            u64 align = 0;
            u64 size = this.SizeOf(ft, this.NTok(f), ref align);
            offset = (offset + align - 1) & ~(align - 1);
            if (maxAlign < align) maxAlign = align;
            this.SetNValue(f, offset);
            this.SetNType(f, ft);
            offset += size;
            if (offset > MAX_TYPE_SIZE) this.Error(E_TOO_LARGE, this.NTok(sym.Node));
            f = this.NNext(f);
        }
        offset = (offset + maxAlign - 1) & ~(maxAlign - 1);
        if (offset > MAX_TYPE_SIZE) this.Error(E_TOO_LARGE, this.NTok(sym.Node));
        Sym p = this.SymAt(s);
        p.Aux = offset as u32;
        p.Aux2 = maxAlign as u32;
        p.LState = 2;
        this.PutSym(s, p);
        this.Scope1 = s1;
        this.Scope2 = s2;
    }

    // Size and alignment of generic struct instance t with concrete arguments.
    u64 InstanceLayout(ref this, u32 t, u32 blame, ref u64 align) {
        Type ty = this.TypeAt(t);
        if (ty.LState == 2) {
            align = ty.Align as u64;
            return ty.Size as u64;
        }
        if (ty.LState == 1) this.FailName(blame, E_RECURSIVE, "struct `", this.NTok(this.SymAt(ty.Sym).Node), "` contains itself");
        ty.LState = 1;
        this.PutType(t, ty);
        u64 offset = 0;
        u64 maxAlign = 1;
        u32 f = this.NodeAt(this.SymAt(ty.Sym).Node).A;
        while (f != 0) {
            u64 fa = 0;
            u32 ft = this.FieldType(t, f);
            u64 size = this.SizeOf(ft, blame, ref fa);
            offset = (offset + fa - 1) & ~(fa - 1);
            if (maxAlign < fa) maxAlign = fa;
            offset += size;
            if (offset > MAX_TYPE_SIZE) this.Error(E_TOO_LARGE, blame);
            f = this.NNext(f);
        }
        offset = (offset + maxAlign - 1) & ~(maxAlign - 1);
        if (offset > MAX_TYPE_SIZE) this.Error(E_TOO_LARGE, blame);
        Type p = this.TypeAt(t);
        p.Size = offset as u32;
        p.Align = maxAlign as u32;
        p.LState = 2;
        this.PutType(t, p);
        align = maxAlign;
        return offset;
    }

    // E0201 if node n's name matches an earlier node in the list starting at first.
    void CheckDuplicateInList(in this, u32 first, u32 n) {
        u32 tok = this.NTok(n);
        u32 m = first;
        while (m != n) {
            if (this.SameName(this.NTok(m), tok)) this.FailName(tok, E_DUPLICATE, "`", tok, "` is already defined");
            m = this.NNext(m);
        }
    }

    // Representation and variant values of enum symbol s ([core.type.4]). Re-entry while in
    // progress returns quietly: a value that names a later variant then reports E0206.
    void EnumDeclare(ref this, u32 s) {
        Sym sym = this.SymAt(s);
        if (this.TyKind(sym.Type) == TYK_UNION) {
            this.TaggedEnumDeclare(s);
            return;
        }
        if (sym.State != 0) return;
        this.SetSymState(s, 1);
        u32 repr = T_I32;
        Node en = this.NodeAt(sym.Node);
        if (en.A != 0) {
            repr = this.ResolveType(en.A, false);
            if (!this.IsIntType(repr)) this.Error(E_BAD_REPR, this.NTok(en.A));
        }
        Sym r = this.SymAt(s);
        r.Aux = repr;
        this.PutSym(s, r);
        u32 first = en.B;
        u32 v = first;
        u64 prev = 0;
        bool seen = false;
        while (v != 0) {
            this.CheckDuplicateInList(first, v);
            u32 valueNode = this.NodeAt(v).A;
            u64 value = 0;
            if (valueNode != 0) {
                this.ExpectType(valueNode, repr);
                value = this.ConstEval(valueNode);
                if (!this.ValueFits(value, repr)) this.DoesNotFit(this.NTok(valueNode), repr);
            } else if (seen) {
                if (prev == this.TypeMax(repr)) this.DoesNotFit(this.NTok(v), repr);
                value = prev +% 1;
            }
            // [core.type.4] values must be distinct
            u32 w = first;
            while (w != v) {
                if (this.NValue(w) == value) this.Error(E_DUPLICATE_VALUE, this.NTok(v));
                w = this.NNext(w);
            }
            this.SetNValue(v, value);
            this.SetNType(v, sym.Type);     // marks the variant as defined
            prev = value;
            seen = true;
            v = this.NNext(v);
        }
        this.SetSymState(s, 2);
    }

    // Type and value of const symbol s ([core.const.2]). blame: where to report E0309.
    void ConstResolve(ref this, u32 s, u32 blame) {
        Sym sym = this.SymAt(s);
        if (sym.State == 2) return;
        if (sym.State == 1) this.FailName(blame, E_CONST_CYCLE, "constant `", this.NTok(sym.Node), "` depends on itself");
        this.SetSymState(s, 1);
        Node n = this.NodeAt(sym.Node);
        u32 t = this.ResolveType(n.A, false);
        this.SetSymType(s, t);
        this.ExpectType(n.B, t);
        u64 value = this.ConstEval(n.B);
        Sym p = this.SymAt(s);
        p.Value = value;
        p.State = 2;
        this.PutSym(s, p);
    }

    // Type and initial value of static symbol s ([core.const.3]).
    void StaticDeclare(ref this, u32 s) {
        Sym sym = this.SymAt(s);
        Node n = this.NodeAt(sym.Node);
        u32 t = this.ResolveType(n.A, false);
        this.Layout(t, n.Tok);
        this.SetSymType(s, t);
        if (n.B == 0) return;
        this.ExpectType(n.B, t);
        u64 value = this.ConstEval(n.B);    // must be a constant
        if (this.IsScalarValue(t)) {
            Sym p = this.SymAt(s);
            p.Value = value;
            p.State = 2;        // the dump prints " = value"
            this.PutSym(s, p);
        }
    }

    // Is type t an integer, bool or enum (a printable constant)?
    bool IsScalarValue(in this, u32 t) {
        u8 k = this.TyKind(t);
        return k == TYK_INT || k == TYK_BOOL || k == TYK_ENUM;
    }

    // Return and parameter types of function symbol s (for a method, without the receiver),
    // and its `where` bounds.
    void FnSignature(ref this, u32 s) {
        Sym fs = this.SymAt(s);
        Node fn = this.NodeAt(fs.Node);
        u32 s1 = this.Scope1;
        u32 s2 = this.Scope2;
        this.Scope1 = fs.OwnerTP;
        this.Scope2 = fn.E;
        u32 ret = this.ResolveType(fn.A, true);
        u32 count = 0;
        u32 first = fn.B;
        if (first != 0 && this.IsReceiver(first)) {
            if (fs.Flags & SF_METHOD == 0) this.Error(E_BAD_THIS, this.NTok(first));
            first = this.NNext(first);
        }
        u32 p = first;
        while (p != 0) {
            if (this.IsReceiver(p)) this.Error(E_BAD_THIS, this.NTok(p));
            count++;
            p = this.NNext(p);
        }
        Sym sym = this.SymAt(s);
        sym.Type = ret;
        sym.Aux = count;
        sym.Params = this.ParamTypes.Len() as u32;
        this.PutSym(s, sym);
        for (u32 i = 0; i < count; i++) this.ParamTypes.Push(0);
        p = first;
        u32 i = 0;
        while (p != 0) {
            this.CheckDuplicateInList(first, p);
            u32 pt = this.ResolveType(this.NodeAt(p).A, false);
            this.Layout(pt, this.NTok(p));
            usize slot = (this.SymAt(s).Params + i) as usize;
            this.ParamTypes.Set(slot, pt);
            this.SetNType(p, pt);
            i++;
            p = this.NNext(p);
        }
        // bounds: an interface method's implementing type implements the interface; then the
        // `where` clauses ([type.gen.2])
        u32 nb = (this.Bounds.Len() / 2) as u32;
        if (fs.Iface != 0) {
            this.Bounds.Push(fs.OwnerType);
            u32 ifaceType = this.SymAt(fs.Iface).Type;
            this.Bounds.Push(ifaceType);
        }
        u32 w = fn.F;
        while (w != 0) {
            u32 tp = this.FindTParam(this.NTok(w));
            if (tp == 0) this.FailName(this.NTok(w), E_UNKNOWN_TYPE, "unknown type `", this.NTok(w), "`");
            u32 b = this.NodeAt(w).A;
            while (b != 0) {
                u32 it = this.ResolveIface(b);
                u32 paramType = this.SymAt(tp).Type;
                this.Bounds.Push(paramType);
                this.Bounds.Push(it);
                b = this.NNext(b);
            }
            w = this.NNext(w);
        }
        Sym done = this.SymAt(s);
        done.Bounds = nb;
        done.NBounds = (this.Bounds.Len() / 2) as u32 - nb;
        this.PutSym(s, done);
        this.Scope1 = s1;
        this.Scope2 = s2;
    }

    // Checks the body of function symbol s.
    void FnBody(ref this, u32 s) {
        Sym sym = this.SymAt(s);
        Node fn = this.NodeAt(sym.Node);
        usize saved = this.LSP;
        this.LBase = saved;     // main's locals are not visible here
        this.Ret = sym.Type;
        this.Top = false;
        this.Unsafe = 0;
        this.Loops = 0;
        this.Scope1 = sym.OwnerTP;
        this.Scope2 = fn.E;
        this.CurFn = s;
        this.CurBounds = sym.Bounds;
        this.NCurBounds = sym.NBounds;
        Sym calls = this.SymAt(s);
        calls.Calls = this.Calls.Len() as u32;
        this.PutSym(s, calls);
        // the receiver and the parameters are the first locals; `in` and `ref` ones are
        // reached through a pointer ([own.mode.1])
        u32 p = fn.B;
        if (sym.Flags & SF_METHOD != 0 && sym.Flags & SF_STATIC == 0) {
            u32 recv = 0;
            if (p != 0 && this.IsReceiver(p)) {
                recv = this.LocalPush(p, sym.OwnerType);
                this.SetNSym(p, recv);
                p = this.NNext(p);
            } else {
                recv = this.LocalPushNamed("this", sym.OwnerType);
            }
            if (sym.Flags & SF_RECV_IN != 0) this.SetSymFlags(recv, SF_BYREF | SF_READONLY);
            if (sym.Flags & SF_RECV_REF != 0) this.SetSymFlags(recv, SF_BYREF);
            Sym r = this.SymAt(s);
            r.Recv = recv;
            this.PutSym(s, r);
        }
        while (p != 0) {
            u32 local = this.LocalPush(p, this.NType(p));
            this.SetNSym(p, local);
            u32 mode = this.NodeAt(p).Flags;
            if (mode & NF_IN != 0) this.SetSymFlags(local, SF_BYREF | SF_READONLY);
            if (mode & NF_REF != 0) this.SetSymFlags(local, SF_BYREF);
            p = this.NNext(p);
        }
        bool terminates = false;
        if (this.NKind(fn.C) == NK_BLOCK) {
            terminates = this.CheckStmt(fn.C);
        } else if (sym.Type == T_VOID) {
            if (this.NKind(fn.C) != NK_CALL) this.Error(E_NO_EFFECT, this.NTok(fn.C));
            this.CheckExpr(fn.C, 0);
            terminates = this.IsNoreturnCall(fn.C);
        } else {
            this.ExpectType(fn.C, sym.Type);
            terminates = true;
        }
        if (sym.Type != T_VOID && !terminates) this.Error(E_MISSING_RETURN, fn.Tok);
        if (!this.Core) {
            this.MoveCheckFn(s);
            this.OriginCheckFn(s);
        }
        this.LSP = saved;
        this.LBase = 0;
        Sym done = this.SymAt(s);
        done.NCalls = this.Calls.Len() as u32 - done.Calls;
        this.PutSym(s, done);
        this.Scope1 = 0;
        this.Scope2 = 0;
        this.CurFn = 0;
        this.CurBounds = 0;
        this.NCurBounds = 0;
    }

    u32 ListCount(in this, u32 first) {
        u32 n = 0;
        while (first != 0) {
            n++;
            first = this.NNext(first);
        }
        return n;
    }
}
