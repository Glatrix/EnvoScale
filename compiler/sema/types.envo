// Types, symbols and checker error codes (compiler/sema/README.md). They mirror Stage 1's
// (bootstrap/stage1/check/types.envo): the same kinds, fixed type indices and messages, so
// `envoc check` reports what `envoc1 check` does (PLAN D17). Types are interned: two types
// are equal exactly when their indices are.
namespace envoc.sema;

use envoc.util;

public struct Type {
    u8 Kind;        // TYK_*
    bool Signed;
    u32 Size;       // fixed-size kinds only; see SizeOf
    u32 Align;
    u32 Elem;       // element type (ptr, slice, array); a fn type's result
    u32 Count;      // array length (saturated at 2^31); 1 for `mut T[]`; a fn type's kind
    u32 Sym;        // symbol (struct, enum, interface, type parameter); a fn type's modes
    Text Name;
    u32 Args;       // generic instance or fn type: first type argument in Checker.TypeArgs
    u32 NArgs;      // number of type arguments (0: not an instance)
    u8 LState;      // instance with concrete arguments: 2 once Size/Align are set
}

public const u8 TYK_VOID = 1;
public const u8 TYK_BOOL = 2;
public const u8 TYK_INT = 3;
public const u8 TYK_STR = 4;
public const u8 TYK_PTR = 5;
public const u8 TYK_SLICE = 6;
public const u8 TYK_ARRAY = 7;
public const u8 TYK_STRUCT = 8;
public const u8 TYK_ENUM = 9;
public const u8 TYK_PARAM = 10;     // a generic type parameter
public const u8 TYK_IFACE = 11;     // an interface, only as a bound or in `impl`
public const u8 TYK_FN = 12;        // a function type
public const u8 TYK_UNION = 13;     // a tagged enum: payloads or type parameters

// Fixed type indices. 0 means "no type".
public const u32 T_VOID = 1;
public const u32 T_BOOL = 2;
public const u32 T_STR = 3;
public const u32 T_I8 = 4;
public const u32 T_I16 = 5;
public const u32 T_I32 = 6;
public const u32 T_I64 = 7;
public const u32 T_ISIZE = 8;
public const u32 T_U8 = 9;
public const u32 T_U16 = 10;
public const u32 T_U32 = 11;
public const u32 T_U64 = 12;
public const u32 T_USIZE = 13;
public const u32 T_PTR_U8 = 14;
public const u32 T_INFER = 0xFFFFFFFE;      // Checker.Ret: a lambda whose result is inferred

public struct Sym {
    u8 Kind;        // SK_*
    u8 State;       // 0 new, 1 in progress, 2 done (const, enum, static value)
    u8 LState;      // struct layout state
    Text Name;
    u32 Node;       // declaring node
    u32 Type;       // the type it names / its value type / return type
    u64 Value;      // constant value; a local's stack index; a type parameter's index
    u32 Aux;        // struct size; enum representation type; parameter count
    u32 Aux2;       // struct alignment; built-in id
    u32 Params;     // index of the first parameter type in Checker.ParamTypes
    u32 Flags;      // SF_*
    u32 NEnv;       // generic environment size: the owner's parameters, then the item's own
    u32 NOwn;       // how many of them come from the owner (struct, impl or interface)
    u32 OwnerTP;    // the owner's type parameter list (first node), for name lookup
    u32 OwnerType;  // a method's receiver type, in the owner's generic form
    u32 Iface;      // an interface method's interface symbol
    u32 Recv;       // a method's `this` local
    u32 Bounds;     // first (parameter type, interface type) pair in Checker.Bounds
    u32 NBounds;
    u32 Calls;      // first call node of the body in Checker.Calls
    u32 NCalls;
    Text Ns;        // an item's namespace (empty for the root)
}

public const u8 SK_TYPE = 1;
public const u8 SK_STRUCT = 2;
public const u8 SK_ENUM = 3;
public const u8 SK_CONST = 4;
public const u8 SK_STATIC = 5;
public const u8 SK_FN = 6;
public const u8 SK_BUILTIN = 7;
public const u8 SK_LOCAL = 8;
public const u8 SK_TPARAM = 9;
public const u8 SK_IFACE = 10;

public const u32 SF_METHOD = 1;
public const u32 SF_STATIC = 2;         // a method without a receiver
public const u32 SF_RECV_IN = 4;        // `in this` (also the default)
public const u32 SF_RECV_REF = 8;       // `ref this`
public const u32 SF_GENERIC = 16;       // has a generic environment (NEnv > 0)
public const u32 SF_BYREF = 32;         // a local reached through a pointer (`in`/`ref`, receiver)
public const u32 SF_READONLY = 64;      // an `in` local
public const u32 SF_PRELUDE = 128;      // a prelude item: a program's own item of the same name hides it
public const u32 SF_PUBLIC = 256;       // `public` or `internal`

// Built-in ids (envo-core.md section 6), from 1.
public const u32 B_EXIT = 7;
public const u32 B_PANIC = 10;
public const u32 B_STR_FROM = 11;
public const u32 B_SYSCALL = 12;
public const u32 B_WINCALL = 13;
public const u32 B_FREE = 14;
public const u32 B_SLICE_FROM = 15;
public const u32 B_SLICE_FROM_MUT = 16;

public const u64 MAX_TYPE_SIZE = 0x7FFFFFFF;

// Function type kinds ([fn.type.2]); they nest: fn < mut fn < once fn.
public const u32 FK_FN = 0;
public const u32 FK_MUT = 1;
public const u32 FK_ONCE = 2;

// How a match holds its scrutinee.
public const u32 MS_OWNED_LOCAL = 1;
public const u32 MS_TEMP = 2;
public const u32 MS_BORROW = 3;

public const u32 MAX_INST_DEPTH = 64;

// Checker error codes (envo-core.md 5.2, 5.3; envo-s1.md).
public const u32 E_DUPLICATE = 201;
public const u32 E_UNKNOWN_TYPE = 202;
public const u32 E_UNKNOWN_NAME = 203;
public const u32 E_REDECLARED = 204;
public const u32 E_NOT_IN_LOOP = 205;
public const u32 E_NO_MEMBER = 206;
public const u32 E_FIELD_TWICE = 207;
public const u32 E_NOT_A_TYPE = 208;
public const u32 E_NOT_A_VALUE = 209;
public const u32 E_NAMESPACE_FIRST = 211;
public const u32 E_PRIVATE = 212;
public const u32 E_UNKNOWN_NAMESPACE = 213;
public const u32 E_MISMATCH = 301;
public const u32 E_BAD_OPERAND = 302;
public const u32 E_RECURSIVE = 303;
public const u32 E_DOES_NOT_FIT = 304;
public const u32 E_BAD_CAST = 305;
public const u32 E_NEEDS_UNSAFE = 306;
public const u32 E_ARG_COUNT = 307;
public const u32 E_NOT_EXHAUSTIVE = 308;
public const u32 E_CONST_CYCLE = 309;
public const u32 E_CONST_FAILED = 310;
public const u32 E_NOT_CONSTANT = 311;
public const u32 E_TOO_LARGE = 312;
public const u32 E_NOT_CALLABLE = 314;
public const u32 E_NOT_ASSIGNABLE = 315;
public const u32 E_NOT_ADDRESSABLE = 316;
public const u32 E_BAD_RETURN = 317;
public const u32 E_DUPLICATE_PATTERN = 319;
public const u32 E_MISSING_RETURN = 320;
public const u32 E_NO_EFFECT = 321;
public const u32 E_VOID_VALUE = 322;
public const u32 E_DUPLICATE_VALUE = 323;
public const u32 E_BAD_REPR = 324;
public const u32 E_VOID_TYPE = 327;
public const u32 E_CANNOT_SLICE = 328;
public const u32 E_SLICE_TEMP = 329;
public const u32 E_LAMBDA_INFER = 330;
public const u32 E_LAMBDA_KIND = 331;
public const u32 E_MUT_FN_SHARED = 332;
public const u32 E_NOT_IMPLEMENTED = 334;
public const u32 E_CANNOT_INFER = 335;
public const u32 E_NOT_AN_IFACE = 336;
public const u32 E_MISSING_METHOD = 337;
public const u32 E_TYPE_ARG_COUNT = 338;
public const u32 E_METHOD_MISMATCH = 339;
public const u32 E_NOT_IN_IFACE = 340;
public const u32 E_BAD_THIS = 341;
public const u32 E_ARG_MODE = 342;
public const u32 E_STATIC_CALL = 343;
public const u32 E_INST_TOO_DEEP = 350;
public const u32 E_MOVE_OUT_OF_BORROW = 502;

// The fixed message of an error that has no arguments.
public str CheckMessage(u32 code) {
    match code {
        E_NOT_IN_LOOP => { return "`break` or `continue` outside a loop"; }
        E_NEEDS_UNSAFE => { return "this needs an `unsafe` block"; }
        E_NOT_EXHAUSTIVE => { return "`match` is not exhaustive; add `_` or the missing values"; }
        E_CONST_FAILED => { return "constant evaluation failed (overflow, division by zero, or shift too large)"; }
        E_NOT_CONSTANT => { return "expected a constant expression"; }
        E_TOO_LARGE => { return "type is too large (Stage 1 limit: 2^31 - 1 bytes)"; }
        E_NOT_CALLABLE => { return "this cannot be called"; }
        E_NOT_ASSIGNABLE => { return "cannot assign to this"; }
        E_NOT_ADDRESSABLE => { return "cannot take the address of this"; }
        E_DUPLICATE_PATTERN => { return "this value is already matched"; }
        E_MISSING_RETURN => { return "not all code paths return a value"; }
        E_NO_EFFECT => { return "only calls can be used as statements"; }
        E_VOID_VALUE => { return "a `void` value cannot be used here"; }
        E_DUPLICATE_VALUE => { return "duplicate enum value"; }
        E_BAD_REPR => { return "enum representation must be an integer type"; }
        E_VOID_TYPE => { return "`void` is only allowed as a return type"; }
        E_BAD_THIS => { return "`this` is only allowed as the first parameter of a method"; }
        E_SLICE_TEMP => { return "cannot slice a temporary array; store it in a variable first"; }
        E_INST_TOO_DEEP => { return "generic instantiation too deep"; }
        _ => { return "?"; }
    }
}

// An interface implementation: `impl I for T`, or an interface listed on a struct.
public struct ImplRec {
    u32 Target;     // the implementing type, in the impl's generic form
    u32 Iface;      // the interface type, in the same form
    u32 Node;       // the impl (or struct) node, for errors
    u32 Methods;    // first method node
    u32 NParams;    // the impl's type parameters (the target's arguments, in order)
}

// A function body to compile with its type arguments (monomorphization, PLAN D13).
public struct Inst {
    u32 Sym;
    u32 Env;        // first type argument in Checker.TypeArgs
    u32 NEnv;
    u32 Depth;      // instantiation depth (E0350 past MAX_INST_DEPTH)
    u32 Func;       // its EIR function (set by lowering)
    bool Declared;  // Func is set
}
