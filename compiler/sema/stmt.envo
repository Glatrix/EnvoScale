// Statements. CheckStmt returns true if the statement terminates ([core.stmt.6]).
// Follows Stage 1's bootstrap/stage1/check/stmt.envo.
namespace envoc.sema;

use envoc.util;
use envoc.syntax;

impl Checker {
    bool CheckStmt(ref this, u32 n) {
        Node node = this.NodeAt(n);
        u16 k = node.Kind;
        if (k == NK_BLOCK) {
            usize saved = this.LSP;
            bool terminates = false;
            u32 s = node.A;
            while (s != 0) {
                if (this.CheckStmt(s)) terminates = true;
                s = this.NNext(s);
            }
            this.LSP = saved;       // leave the block's scope
            return terminates;
        }
        if (k == NK_UNSAFE) {
            this.Unsafe++;
            bool t = this.CheckStmt(node.A);
            this.Unsafe--;
            return t;
        }
        if (k == NK_IF) {
            this.ExpectType(node.A, T_BOOL);
            bool then = this.CheckStmt(node.B);
            if (node.C == 0) return false;
            bool other = this.CheckStmt(node.C);
            return then && other;
        }
        if (k == NK_WHILE) {
            this.ExpectType(node.A, T_BOOL);
            bool broke = this.CheckLoopBody(node.B);
            // terminates: the condition is the literal true and nothing breaks out
            if (broke) return false;
            if (this.NKind(node.A) != NK_BOOL) return false;
            return Same(this.TokText(this.NTok(node.A)), "true");
        }
        if (k == NK_FOR) {
            usize saved = this.LSP;     // the init's variables live in the loop's scope
            if (node.A != 0) this.CheckSimple(node.A);
            if (node.B != 0) this.ExpectType(node.B, T_BOOL);
            if (node.C != 0) this.CheckSimple(node.C);
            bool broke = this.CheckLoopBody(node.D);
            this.LSP = saved;
            // terminates: no condition and nothing breaks out
            return node.B == 0 && !broke;
        }
        if (k == NK_BREAK || k == NK_CONTINUE) {
            if (this.Loops == 0) this.Error(E_NOT_IN_LOOP, node.Tok);
            if (k == NK_BREAK) this.Brk = true;
            return false;
        }
        if (k == NK_RETURN) {
            u32 ret = this.Ret;
            if (this.Top) {
                // top level: an optional exit code
                if (node.A != 0) this.ExpectType(node.A, T_I32);
                return true;
            }
            if (ret == T_INFER) {
                // the first `return` of a lambda without a target result decides it ([fn.lam.2])
                if (node.A == 0) this.Ret = T_VOID;
                else this.Ret = this.CheckValue(node.A, 0);
                return true;
            }
            if (ret == T_VOID) {
                if (node.A != 0) this.Fail(node.Tok, E_BAD_RETURN, "this function returns nothing; remove the return value");
                return true;
            }
            if (node.A == 0) {
                string b = string.From("this function returns `");
                this.AppendType(ref b, ret);
                b.Append("`; `return` needs a value");
                this.Fail(node.Tok, E_BAD_RETURN, b);
            }
            this.ExpectType(node.A, ret);
            return true;
        }
        if (k == NK_MATCH) return this.CheckMatch(n);
        if (k == NK_FOREACH) return this.CheckForeach(n);
        return this.CheckSimple(n);
    }

    // A loop body with a fresh break flag; true if a break targets this loop.
    bool CheckLoopBody(ref this, u32 n) {
        bool outer = this.Brk;
        this.Brk = false;
        this.Loops++;
        this.CheckStmt(n);
        this.Loops--;
        bool broke = this.Brk;
        this.Brk = outer;
        return broke;
    }

    // Simple statements ([core.stmt.1]-[core.stmt.3]). Returns true if it terminates.
    bool CheckSimple(ref this, u32 n) {
        Node node = this.NodeAt(n);
        if (node.Kind == NK_VAR) {
            u32 t = 0;
            if (node.A != 0) {
                t = this.ResolveType(node.A, false);
                this.Layout(t, node.Tok);
                if (node.B != 0) this.ExpectType(node.B, t);
            } else {
                t = this.CheckValue(node.B, 0);
            }
            this.DeclareLocal(n, t);
            this.SetNType(n, t);
            // [own.borrow.4] `var x = place;` that would move out of a borrow borrows the
            // place instead (M3.10; Stage 1: E0502). An explicit type asks for ownership.
            if (node.A == 0 && !this.Core && !this.IsCopy(t) && this.BorrowsPlace(node.B)) {
                this.SetSymFlags(this.NSym(n), SF_BYREF | SF_READONLY);
            }
            return false;
        }
        if (node.Kind == NK_EXPR) {
            if (this.NKind(node.A) != NK_CALL) this.Error(E_NO_EFFECT, node.Tok);
            this.CheckExpr(node.A, 0);
            return this.IsNoreturnCall(node.A);
        }
        if (node.Kind == NK_ASSIGN) {
            u32 op = node.Tok;
            u32 target = this.CheckValue(node.A, 0);
            if (!this.IsMutable(node.A)) this.Error(E_NOT_ASSIGNABLE, op);
            this.MarkMutation(node.A);
            Text opText = this.TokName(op);
            if (opText.Len == 1) {
                this.ExpectType(node.B, target);    // '=' is the only one-byte assignment
                return false;
            }
            if (this.IsFloatType(target)) {
                // RFC 0006: += -= *= /= on floats
                str ot = TextStr(opText);
                if (!Same(ot, "+=") && !Same(ot, "-=") && !Same(ot, "*=") && !Same(ot, "/=")) this.BadOperand(target, op);
                this.ExpectType(node.B, target);
                return false;
            }
            if (!this.IsIntType(target)) this.BadOperand(target, op);
            u8 first = TextStr(opText)[0];
            if (first == '<' || first == '>') {
                // '<<=' and '>>=': any integer on the right
                u32 r = this.CheckValue(node.B, 0);
                if (!this.IsIntType(r)) this.BadOperand(r, op);
                return false;
            }
            this.ExpectType(node.B, target);
            return false;
        }
        // NK_INC, NK_DEC
        u32 t = this.CheckValue(node.A, 0);
        if (!this.IsMutable(node.A)) this.Error(E_NOT_ASSIGNABLE, node.Tok);
        this.MarkMutation(node.A);
        if (!this.IsIntType(t)) this.BadOperand(t, node.Tok);
        return false;
    }

    // Would taking the value of place e move out of a borrow: e is in an `in` or `ref`
    // local, or is an element of an array or of a shared view? (A `mut T[]` element could
    // change under the borrow, so it does not count.)
    bool BorrowsPlace(in this, u32 e) {
        bool through = false;
        u32 n = e;
        while (n != 0) {
            Node node = this.NodeAt(n);
            if (node.Kind == NK_NAME || node.Kind == NK_THIS) {
                u32 s = this.NSym(n);
                if (s == 0 || this.SymKind(s) != SK_LOCAL) return false;
                return through || this.SymAt(s).Flags & SF_BYREF != 0;
            }
            if (node.Kind == NK_MEMBER) {
                if (this.TyKind(this.NType(node.A)) != TYK_STRUCT) return false;
            } else if (node.Kind == NK_INDEX) {
                if (this.NKind(node.B) == NK_RANGE) return false;
                u32 at = this.NType(node.A);
                if (this.TyKind(at) == TYK_ARRAY) through = true;
                else if (this.TyKind(at) == TYK_SLICE && !this.IsMutView(at)) through = true;
                else return false;
            } else {
                return false;
            }
            n = node.A;
        }
        return false;
    }

    // Is call node n a call to exit or panic?
    bool IsNoreturnCall(ref this, u32 n) {
        u32 callee = this.NodeAt(n).A;
        if (this.NKind(callee) != NK_NAME) return false;
        u32 s = this.Lookup(this.NTok(callee));
        if (s == 0) return false;
        Sym sym = this.SymAt(s);
        if (sym.Kind != SK_BUILTIN) return false;
        return sym.Aux2 == B_EXIT || sym.Aux2 == B_PANIC;
    }

    // [core.stmt.7]. Returns true if the match terminates.
    bool CheckMatch(ref this, u32 n) {
        Node m = this.NodeAt(n);
        u32 t = this.CheckValue(m.A, 0);
        if (this.MatchIsS1(n, t)) return this.CheckMatchS1(n, t, 0, false) == 1;
        u8 tk = this.TyKind(t);
        if (tk == TYK_ENUM) {
            this.EnumDeclare(this.TypeAt(t).Sym);
        } else if (tk != TYK_INT) {
            string b = string.From("`match` needs an integer or enum value, found `");
            this.AppendType(ref b, t);
            b.AppendByte('`');
            this.Fail(this.NTok(m.A), E_BAD_OPERAND, b);
        }
        bool wild = false;
        bool open = false;      // an arm does not terminate
        u32 arm = m.B;
        while (arm != 0) {
            Node a = this.NodeAt(arm);
            u32 pat = a.A;
            while (pat != 0) {
                u16 pk = this.NKind(pat);
                if (pk == NK_WILD) {
                    wild = true;
                } else {
                    u64 value = 0;
                    u32 variant = 0;
                    // a bare variant name of the scrutinee's enum
                    if (pk == NK_NAME && tk == TYK_ENUM) variant = this.EnumVariantNamed(t, pat);
                    if (variant != 0) {
                        value = this.NValue(variant);
                        this.SetNType(pat, t);
                    } else {
                        this.ExpectType(pat, t);
                        value = this.ConstEval(pat);
                    }
                    // [core.stmt.7] each value once
                    if (this.MatchValueSeen(value, pat, n)) this.Error(E_DUPLICATE_PATTERN, this.NTok(pat));
                    this.SetNValue(pat, value);
                    this.SetNMatched(pat);
                }
                pat = this.NNext(pat);
            }
            bool terminates = false;
            if (this.NKind(a.B) == NK_BLOCK) terminates = this.CheckStmt(a.B);
            else terminates = this.CheckSimple(a.B);
            if (!terminates) open = true;
            arm = a.Next;
        }
        if (!wild) {
            if (tk != TYK_ENUM || !this.EnumAllMatched(t, n)) this.Error(E_NOT_EXHAUSTIVE, m.Tok);
        }
        return !open;
    }

    // Has a pattern of match m before `stop` (0: any) recorded value v?
    bool MatchValueSeen(in this, u64 v, u32 stop, u32 m) {
        u32 arm = this.NodeAt(m).B;
        while (arm != 0) {
            u32 pat = this.NodeAt(arm).A;
            while (pat != 0) {
                if (pat == stop) return false;
                if (this.NMatchedAt(pat) && this.NValue(pat) == v) return true;
                pat = this.NNext(pat);
            }
            arm = this.NNext(arm);
        }
        return false;
    }

    // Does match m name every variant of enum type t?
    bool EnumAllMatched(in this, u32 t, u32 m) {
        u32 v = this.NodeAt(this.SymAt(this.TypeAt(t).Sym).Node).B;
        while (v != 0) {
            if (!this.MatchValueSeen(this.NValue(v), 0, m)) return false;
            v = this.NNext(v);
        }
        return true;
    }

    // The variant of enum type t named by node n's token, or 0 (variants not yet defined
    // are not found).
    u32 EnumVariantNamed(in this, u32 t, u32 n) {
        u32 tok = this.NTok(n);
        u32 v = this.NodeAt(this.SymAt(this.TypeAt(t).Sym).Node).B;
        while (v != 0) {
            if (this.NType(v) != 0 && this.SameName(this.NTok(v), tok)) return v;
            v = this.NNext(v);
        }
        return 0;
    }

    // [core.stmt.3] may this checked expression be assigned to?
    bool IsMutable(in this, u32 n) => this.PlaceCheck(n, true);

    // [core.expr.5] may `&` be applied?
    bool IsAddressable(in this, u32 n) => this.PlaceCheck(n, false);

    // assign: slices and str are read-only; for `&` any element has an address.
    bool PlaceCheck(in this, u32 n, bool assign) {
        Node node = this.NodeAt(n);
        if (node.Kind == NK_NAME || node.Kind == NK_THIS) {
            u32 s = this.NSym(n);
            if (s == 0) return false;
            Sym sym = this.SymAt(s);
            // an `in` parameter or receiver is read-only ([own.mode.1])
            if (assign && sym.Flags & SF_READONLY != 0) return false;
            return sym.Kind == SK_LOCAL || sym.Kind == SK_STATIC;
        }
        if (node.Kind == NK_MEMBER) {
            u32 t = this.NType(node.A);
            if (t == 0) return false;       // Enum.Variant
            u8 k = this.TyKind(t);
            if (k == TYK_PTR) return true;
            if (k != TYK_STRUCT) return false;
            return this.PlaceCheck(node.A, assign);
        }
        if (node.Kind == NK_INDEX) {
            u32 ot = this.NType(node.A);
            u8 k = this.TyKind(ot);
            if (k == TYK_ARRAY) return this.PlaceCheck(node.A, assign);
            if (k == TYK_PTR) return true;
            if (k == TYK_SLICE && this.TypeAt(ot).Count == 1) return true;     // `mut T[]`
            return !assign;     // &s[i] of a slice or str is fine
        }
        return node.Kind == NK_UNARY && node.Op == TK_STAR;
    }
}
