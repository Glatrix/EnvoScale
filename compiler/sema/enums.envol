// Envo-S1 enums with payloads, Option and Result, and `match` with payload patterns
// ([item.enum.1]–[item.enum.3], [s1.expr.1]). Follows Stage 1's
// bootstrap/stage1/check/enums.envol. An enum with a payload on any variant, or with type
// parameters, is a tagged value (TYK_UNION); fieldless enums stay integers.
namespace envoc.sema;

use envoc.util;
use envoc.syntax;

impl Checker {
    // Is enum node n a tagged one (generic, or a variant has a payload)?
    bool IsTaggedEnumNode(in this, u32 n) {
        Node en = this.NodeAt(n);
        if (en.E != 0) return true;
        u32 v = en.B;
        while (v != 0) {
            if (this.NodeAt(v).E != 0) return true;
            v = this.NNext(v);
        }
        return false;
    }

    bool IsTagged(in this, u32 t) => this.TyKind(t) == TYK_UNION;

    // Pass 1 for a tagged enum: its type parameters and its type.
    void DefineTaggedEnum(ref this, u32 s, u32 n) {
        u32 tps = this.NodeAt(n).E;
        u32 count = this.DeclareTParams(tps, 0);
        u32 t = 0;
        if (count == 0) t = this.TypeNamed(TYK_UNION, s);
        else t = this.SelfInstance(TYK_UNION, s, tps, count);
        Sym sym = this.SymAt(s);
        sym.Type = t;
        sym.NEnv = count;
        if (count > 0) sym.Flags = sym.Flags | SF_GENERIC;
        this.PutSym(s, sym);
    }

    // The variants of a tagged enum: index values in order, payload field types resolved
    // with the enum's type parameters in scope ([item.enum.1]).
    void TaggedEnumDeclare(ref this, u32 s) {
        Sym sym = this.SymAt(s);
        if (sym.State != 0) return;
        this.SetSymState(s, 1);
        Node en = this.NodeAt(sym.Node);
        if (en.A != 0) this.Fail(this.NTok(en.A), E_BAD_REPR, "only an enum without payloads may declare a representation ([item.enum.2])");
        u32 s1 = this.Scope1;
        u32 s2 = this.Scope2;
        this.Scope1 = en.E;
        this.Scope2 = 0;
        u32 v = en.B;
        u64 i = 0;
        while (v != 0) {
            this.CheckDuplicateInList(en.B, v);
            Node vn = this.NodeAt(v);
            if (vn.A != 0) this.Fail(this.NTok(vn.A), E_BAD_REPR, "only an enum without payloads may give its variants values ([item.enum.2])");
            u32 f = vn.E;
            while (f != 0) {
                this.CheckDuplicateInList(vn.E, f);
                u32 ft = this.ResolveType(this.NodeAt(f).A, false);
                this.SetNType(f, ft);
                f = this.NNext(f);
            }
            this.SetNValue(v, i);
            this.SetNType(v, sym.Type);
            i++;
            v = vn.Next;
        }
        this.SetSymState(s, 2);
        this.Scope1 = s1;
        this.Scope2 = s2;
    }

    // The type of payload field f in tagged enum type t.
    u32 PayloadType(ref this, u32 t, u32 f) {
        Type ty = this.TypeAt(t);
        return this.Subst(this.NType(f), ty.Args, ty.NArgs);
    }

    // The variant of tagged enum type t named by token tok, or 0.
    u32 VariantNamed(in this, u32 t, u32 tok) {
        u32 v = this.NodeAt(this.SymAt(this.TypeAt(t).Sym).Node).B;
        while (v != 0) {
            if (this.SameName(this.NTok(v), tok)) return v;
            v = this.NNext(v);
        }
        return 0;
    }

    // Size and alignment of tagged enum type t: the tag (u32), then the largest payload, in
    // words of the largest payload alignment. Type.Count keeps that word size and Type.Elem
    // the word count, for lowering. Payloads that still name type parameters lay out per
    // instance.
    u64 TaggedLayout(ref this, u32 t, u32 blame, ref u64 align) {
        Type ty = this.TypeAt(t);
        this.TaggedEnumDeclare(ty.Sym);
        if (this.HasParams(t)) {
            align = 1;
            return 0;
        }
        if (ty.LState == 2) {
            align = ty.Align as u64;
            return ty.Size as u64;
        }
        if (ty.LState == 1) this.FailName(blame, E_RECURSIVE, "enum `", this.NTok(this.SymAt(ty.Sym).Node), "` contains itself");
        ty.LState = 1;
        this.PutType(t, ty);
        u64 word = 1;
        u64 biggest = 0;
        u32 v = this.NodeAt(this.SymAt(ty.Sym).Node).B;
        while (v != 0) {
            u64 off = 0;
            u64 pa = 1;
            u32 f = this.NodeAt(v).E;
            while (f != 0) {
                u64 fa = 0;
                u32 pt = this.PayloadType(t, f);
                u64 size = this.SizeOf(pt, blame, ref fa);
                off = (off + fa - 1) & ~(fa - 1);
                off += size;
                if (pa < fa) pa = fa;
                f = this.NNext(f);
            }
            off = (off + pa - 1) & ~(pa - 1);
            if (biggest < off) biggest = off;
            if (word < pa) word = pa;
            v = this.NNext(v);
        }
        u64 words = (biggest + word - 1) / word;
        if (words == 0) words = 1;
        u64 at = (4 + word - 1) & ~(word - 1);
        u64 a = word;
        if (a < 4) a = 4;
        u64 size = (at + words * word + a - 1) & ~(a - 1);
        if (size > MAX_TYPE_SIZE) this.Error(E_TOO_LARGE, blame);
        Type p = this.TypeAt(t);
        p.Size = size as u32;
        p.Align = a as u32;
        p.Count = word as u32;
        p.Elem = words as u32;
        p.LState = 2;
        this.PutType(t, p);
        align = a;
        return size;
    }

    // ------------------------------------------------------------------ values

    // A variant value ([item.enum.3]): node n (a call with arguments args, or a bare name or
    // member when hasCall is false) builds variant v of tagged enum symbol s. t is the enum
    // type when it is known (an instance, or the expected type), or 0 to infer the type
    // arguments from the payload. Records the enum (NSym) and the variant (NValue) on n.
    u32 CheckVariantValue(ref this, u32 n, u32 s, u32 v, u32 t, u32 args, bool hasCall, u32 tok) {
        Sym sym = this.SymAt(s);
        this.TaggedEnumDeclare(s);
        u32 count = this.ListCount(this.NodeAt(v).E);
        u32 have = this.ListCount(args);
        if (count != have || (count > 0 && !hasCall)) this.ArgCount(tok, count, have);
        u32 ne = sym.NEnv;
        u32 env = this.EnvNew(ne);
        if (t != 0 && this.TypeAt(t).Sym == s) {
            for (u32 i = 0; i < ne; i++) this.EnvSet(env, i, this.EnvGet(this.TypeAt(t).Args, i));
        }
        // the payload, like the arguments of a call (CheckCallTo)
        u32 a = args;
        u32 f = this.NodeAt(v).E;
        while (a != 0) {
            u32 pt = this.NType(f);
            if (this.Unbound(pt, env, ne) && !this.IsUntyped(a) && this.NKind(a) != NK_LAMBDA) {
                u32 at = this.CheckValue(a, 0);
                this.Unify(pt, at, env, ne);
            }
            a = this.NNext(a);
            f = this.NNext(f);
        }
        a = args;
        f = this.NodeAt(v).E;
        while (a != 0) {
            u32 pt = this.NType(f);
            if (this.NType(a) == 0 && this.Unbound(pt, env, ne)) {
                u32 at = this.CheckValue(a, 0);
                this.Unify(pt, at, env, ne);
            }
            u32 want = this.Subst(pt, env, ne);
            if (this.NType(a) != 0) {
                if (!this.Coerce(a, this.NType(a), want)) this.Mismatch(want, this.NTok(a), this.NType(a));
            } else {
                this.ExpectType(a, want);
            }
            this.CheckArgMode(a, false);
            a = this.NNext(a);
            f = this.NNext(f);
        }
        u32 tp = this.NodeAt(sym.Node).E;
        for (u32 i = 0; i < ne; i++) {
            if (this.EnvGet(env, i) == 0) this.FailName(tok, E_CANNOT_INFER, "cannot infer type argument `", this.NTok(tp), "`; write it explicitly");
            tp = this.NNext(tp);
        }
        this.SetNSym(n, s);
        this.SetNValue(n, v as u64);
        if (ne == 0) return sym.Type;
        return this.TypeInstance(TYK_UNION, s, env, ne);
    }

    // An unqualified variant ([item.enum.3]): the expected type is an enum with a variant
    // of that name. Returns the variant or 0.
    u32 ExpectedVariant(ref this, u32 expected, u32 tok) {
        if (expected == 0) return 0;
        u8 k = this.TyKind(expected);
        if (k == TYK_UNION) {
            this.TaggedEnumDeclare(this.TypeAt(expected).Sym);
            return this.VariantNamed(expected, tok);
        }
        if (k == TYK_ENUM) {
            this.EnumDeclare(this.TypeAt(expected).Sym);
            u32 v = this.NodeAt(this.SymAt(this.TypeAt(expected).Sym).Node).B;
            while (v != 0) {
                if (this.SameName(this.NTok(v), tok)) return v;
                v = this.NNext(v);
            }
        }
        return 0;
    }

    // ------------------------------------------------------------------ Option and Result

    // `T?`: the prelude's Option<T> ([type.opt.1]).
    u32 OptionOf(ref this, u32 inner, u32 tok) {
        u32 s = this.OptionSym;
        if (s == 0) panic("checker: `T?` without the prelude");
        u32 env = this.EnvNew(1);
        this.EnvSet(env, 0, inner);
        return this.TypeInstance(TYK_UNION, s, env, 1);
    }

    bool IsOptionType(in this, u32 t) {
        u32 s = this.OptionSym;
        return s != 0 && this.TyKind(t) == TYK_UNION && this.TypeAt(t).Sym == s;
    }

    bool IsResultType(in this, u32 t) {
        u32 s = this.ResultSym;
        return s != 0 && this.TyKind(t) == TYK_UNION && this.TypeAt(t).Sym == s;
    }

    // Type argument i of generic instance t.
    u32 TypeArg(in this, u32 t, u32 i) => this.EnvGet(this.TypeAt(t).Args, i);

    // The variant of enum symbol s named name.
    u32 VariantByName(in this, u32 s, str name) {
        u32 v = this.NodeAt(this.SymAt(s).Node).B;
        while (v != 0) {
            if (Same(this.TokText(this.NTok(v)), name)) return v;
            v = this.NNext(v);
        }
        return 0;
    }

    // `null`: `None` of the expected `T?` ([type.opt.1]).
    u32 CheckNull(ref this, u32 n, u32 expected) {
        if (!this.IsOptionType(expected)) this.Fail(this.NTok(n), E_CANNOT_INFER, "the type of `null` is not known here: it needs an expected `T?`");
        u32 s = this.OptionSym;
        u32 none = this.VariantByName(s, "None");
        return this.CheckVariantValue(n, s, none, expected, 0, false, this.NTok(n));
    }

    // `a ?? b`: a's value, or b when a is `None`.
    u32 CheckCoalesce(ref this, u32 n, u32 expected) {
        Node node = this.NodeAt(n);
        u32 want = 0;
        if (expected != 0 && this.TyKind(expected) != TYK_VOID) want = this.OptionOf(expected, node.Tok);
        u32 at = this.CheckValue(node.A, want);
        if (!this.IsOptionType(at)) {
            string b = string.From("`??` needs an optional value (`T?`) on its left, found `");
            this.AppendType(ref b, at);
            b.AppendByte('`');
            this.Fail(node.Tok, E_BAD_OPERAND, b);
        }
        u32 inner = this.TypeArg(at, 0);
        this.ExpectType(node.B, inner);
        return inner;
    }

    // `e?` ([expr.q.1]): e's value, or an early `return` of `None` or of e's error, in a
    // function whose result has the same kind.
    u32 CheckTry(ref this, u32 n) {
        Node node = this.NodeAt(n);
        u32 at = this.CheckValue(node.A, 0);
        u32 ret = this.Ret;
        bool top = this.Top;
        if (this.IsOptionType(at)) {
            if (top || !this.IsOptionType(ret)) this.Fail(node.Tok, E_BAD_RETURN, "`?` on an optional value needs a function that returns an optional value (`T?`)");
            return this.TypeArg(at, 0);
        }
        if (this.IsResultType(at)) {
            if (top || !this.IsResultType(ret) || this.TypeArg(ret, 1) != this.TypeArg(at, 1)) {
                string b = string.From("`?` on a `");
                this.AppendType(ref b, at);
                b.Append("` needs a function that returns a `Result` with the error type `");
                this.AppendType(ref b, this.TypeArg(at, 1));
                b.AppendByte('`');
                this.Fail(node.Tok, E_BAD_RETURN, b);
            }
            return this.TypeArg(at, 0);
        }
        string b = string.From("`?` needs an optional value or a `Result`, found `");
        this.AppendType(ref b, at);
        b.AppendByte('`');
        this.Fail(node.Tok, E_BAD_OPERAND, b);
        return 0;
    }

    // ------------------------------------------------------------------ match

    // How a match holds its scrutinee: bindings of non-`Copy` payloads take them from an
    // owned local or a temporary, and borrow them (`in`) from anything else.
    u32 ScrutineeKind(in this, u32 e) {
        u16 k = this.NKind(e);
        if (k == NK_NAME || k == NK_THIS) {
            u32 s = this.NSym(e);
            if (s == 0 || this.SymKind(s) != SK_LOCAL) return MS_BORROW;
            if (this.SymAt(s).Flags & SF_BYREF != 0) return MS_BORROW;
            // a lambda's capture belongs to the closure, not to this body
            if (this.LamStack.Len() >= 3) {
                u32 start = this.LamStack.Get(this.LamStack.Len() - 2);
                if (this.SymAt(s).Value < start as u64) return MS_BORROW;
            }
            return MS_OWNED_LOCAL;
        }
        if (k == NK_CALL || k == NK_NEW || k == NK_COND || k == NK_MATCH) return MS_TEMP;
        return MS_BORROW;
    }

    // A `match` in Envo-S1 form: a tagged enum scrutinee, guards, or a `match` expression
    // ([s1.expr.1]). t is the scrutinee's type (already checked). For an expression,
    // returns its type; for a statement, 1 if it terminates, else 0.
    u32 CheckMatchS1(ref this, u32 n, u32 t, u32 expected, bool isExpr) {
        Node m = this.NodeAt(n);
        u8 tk = this.TyKind(t);
        if (tk == TYK_UNION) this.TaggedEnumDeclare(this.TypeAt(t).Sym);
        else if (tk == TYK_ENUM) this.EnumDeclare(this.TypeAt(t).Sym);
        else if (tk != TYK_INT) {
            string b = string.From("`match` needs an integer or enum value, found `");
            this.AppendType(ref b, t);
            b.AppendByte('`');
            this.Fail(this.NTok(m.A), E_BAD_OPERAND, b);
        }
        u32 kind = this.ScrutineeKind(m.A);
        this.SetNValue(n, kind as u64);
        if (tk == TYK_UNION && kind == MS_TEMP) {
            // the temporary is held like a local for the match's duration (lowering drops it)
            u32 tmp = this.SymNew(SK_LOCAL, 0);
            Sym x = this.SymAt(tmp);
            x.Name = TextOf("match");
            x.Type = t;
            this.PutSym(tmp, x);
            this.SetNSym(n, tmp);
        }
        bool wild = false;
        bool open = false;
        u32 result = 0;
        if (isExpr) result = expected;
        u32 arm = m.B;
        while (arm != 0) {
            Node a = this.NodeAt(arm);
            usize saved = this.LSP;
            bool guarded = a.E != 0;
            u32 pat = a.A;
            bool several = pat != 0 && this.NNext(pat) != 0;
            bool moves = false;
            while (pat != 0) {
                u16 pk = this.NKind(pat);
                if (pk == NK_WILD) {
                    if (!guarded) wild = true;
                } else if (tk == TYK_UNION) {
                    if (this.CheckTaggedPattern(pat, t, kind, several)) moves = true;
                    if (!guarded) {
                        if (this.MatchValueSeen(this.NValue(pat), pat, n)) this.Error(E_DUPLICATE_PATTERN, this.NTok(pat));
                        this.SetNMatched(pat);
                    }
                } else {
                    u64 value = 0;
                    u32 variant = 0;
                    if (pk == NK_NAME && tk == TYK_ENUM) variant = this.EnumVariantNamed(t, pat);
                    if (variant != 0) {
                        value = this.NValue(variant);
                        this.SetNType(pat, t);
                    } else {
                        this.ExpectType(pat, t);
                        value = this.ConstEval(pat);
                    }
                    this.SetNValue(pat, value);
                    if (!guarded) {
                        if (this.MatchValueSeen(value, pat, n)) this.Error(E_DUPLICATE_PATTERN, this.NTok(pat));
                        this.SetNMatched(pat);
                    }
                }
                pat = this.NNext(pat);
            }
            this.SetNValue(arm, 0);
            if (moves) this.SetNValue(arm, 1);
            if (guarded) this.ExpectType(a.E, T_BOOL);
            bool terminates = false;
            if (this.NKind(a.B) == NK_BLOCK) {
                terminates = this.CheckStmt(a.B);
                if (isExpr && !terminates) this.Fail(a.Tok, E_MISSING_RETURN, "a block arm of a `match` expression gives no value; end it with `return`, `break` or a panic");
            } else if (isExpr) {
                if (result == 0) result = this.CheckValue(a.B, 0);
                else this.ExpectType(a.B, result);
                terminates = true;
            } else {
                terminates = this.CheckSimple(a.B);
            }
            if (!terminates) open = true;
            this.LSP = saved;
            arm = a.Next;
        }
        if (!wild) {
            bool all = false;
            if (tk == TYK_UNION) all = this.TaggedAllMatched(t, n);
            if (tk == TYK_ENUM) all = this.EnumAllMatched(t, n);
            if (!all) this.Error(E_NOT_EXHAUSTIVE, m.Tok);
        }
        if (isExpr) {
            if (result == 0) this.Fail(m.Tok, E_MISSING_RETURN, "no arm of this `match` expression gives a value");
            return result;
        }
        if (open) return 0;
        return 1;
    }

    // One pattern on tagged enum type t: `V`, `E.V`, `V(a, _)` or `E.V(a, _)`. Declares the
    // bindings; returns true if one takes a payload value that is not `Copy`.
    bool CheckTaggedPattern(ref this, u32 pat, u32 t, u32 kind, bool several) {
        Node p = this.NodeAt(pat);
        u32 head = pat;
        u32 args = 0;
        bool call = p.Kind == NK_CALL;
        if (call) {
            head = p.A;
            args = p.B;
        }
        u16 hk = this.NKind(head);
        u32 nameTok = this.NTok(head);
        if (hk == NK_MEMBER) {
            this.TryQualified(this.NodeAt(head).A);
            u32 owner = this.NodeAt(head).A;
            if (this.NKind(owner) != NK_NAME || this.TypeNameSym(this.NTok(owner)) != this.TypeAt(t).Sym) {
                this.Fail(this.NTok(owner), E_MISMATCH, "this pattern names another type than the one matched");
            }
        } else if (hk != NK_NAME) {
            this.Fail(this.NTok(head), E_NOT_CONSTANT, "expected a variant pattern");
        }
        u32 v = this.VariantNamed(t, nameTok);
        if (v == 0) this.NoMember(nameTok, t);
        u32 count = this.ListCount(this.NodeAt(v).E);
        u32 have = this.ListCount(args);
        if (count != have || (count > 0 && !call)) this.ArgCount(this.NTok(pat), count, have);
        this.SetNValue(pat, this.NValue(v));
        this.SetNType(pat, t);
        this.SetNSym(pat, v);
        bool moves = false;
        u32 a = args;
        u32 f = this.NodeAt(v).E;
        while (a != 0) {
            u32 pt = this.PayloadType(t, f);
            if (this.NKind(a) != NK_WILD) {
                if (this.NKind(a) != NK_NAME) this.Fail(this.NTok(a), E_NOT_CONSTANT, "expected a name to bind or `_`");
                if (several) this.NotCore("bindings in a pattern with `|`; write one arm for each variant", this.NTok(a));
                this.DeclareLocal(a, pt);
                this.SetNType(a, pt);
                u32 s = this.NSym(a);
                if (!this.IsCopy(pt)) {
                    if (kind == MS_BORROW) {
                        // an `in` borrow of the payload, which stays in the scrutinee
                        this.SetSymFlags(s, SF_BYREF | SF_READONLY);
                    } else {
                        moves = true;
                    }
                }
            }
            a = this.NNext(a);
            f = this.NNext(f);
        }
        if (moves && this.HasDropImpl(t)) this.Fail(this.NTok(pat), E_MOVE_OUT_OF_BORROW, "cannot move a payload out of a value whose type implements `IDrop`; match on it by borrowing");
        return moves;
    }

    // Does match m name every variant of tagged enum type t in an unguarded arm?
    bool TaggedAllMatched(in this, u32 t, u32 m) {
        u32 v = this.NodeAt(this.SymAt(this.TypeAt(t).Sym).Node).B;
        while (v != 0) {
            if (!this.MatchValueSeen(this.NValue(v), 0, m)) return false;
            v = this.NNext(v);
        }
        return true;
    }

    // Is match node n in the Envo-S1 form (CheckMatchS1)?
    bool MatchIsS1(in this, u32 n, u32 t) {
        if (this.Core) return false;
        if (this.IsTagged(t)) return true;
        u32 arm = this.NodeAt(n).B;
        while (arm != 0) {
            if (this.NodeAt(arm).E != 0) return true;
            arm = this.NNext(arm);
        }
        return false;
    }
}
