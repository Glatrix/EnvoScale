// Borrows within calls and the origins of borrowed closures ([own.borrow.*], [life.*]).
// Follows Stage 1's bootstrap/stage1/check/borrow.envo:
//
// - In one call, a local passed `ref` (or captured by a lambda argument that changes it)
//   may not be used any other way in that call (E0503); a local borrowed by the call may
//   not be moved by it (E0504). Arguments are evaluated before the call takes its borrows,
//   so plain reads in an argument whose value holds no borrow do not count. Uses of
//   different fields of a local are disjoint (`F(ref p.A, ref p.B)`); Stage 1 counts any
//   use of a field as a use of the whole local (M3.10).
// - A function-typed parameter may hold a lambda that borrows its caller's variables
//   ([fn.pos.1]); it may only be called or passed to another function-typed parameter.
//   Returning it, storing it, or giving it to anything else is E0507.
// - `from` clauses name borrowed parameters or `this` (E0508); a function with one may
//   return only borrows of what it names (E0507).
// - A view of a temporary ([own.temp.1]) may initialize a local, whose block then keeps
//   the temporary; returning it, or storing it anywhere else, is E0509.
namespace envoc.sema;

use envoc.util;
use envoc.syntax;

const u32 BK_READ = 0;      // a plain read (a copy): not a borrow
const u32 BK_IN = 1;        // a shared borrow for the call
const u32 BK_REF = 2;       // an exclusive borrow for the call
const u32 BK_MOVE = 3;      // the call takes it

// The origin of a value that views a temporary ([own.temp.1]); parameters use the other bits.
const u64 ORIGIN_TEMP = 0x8000000000000000;

struct OriginCx {
    List<u32> Params;       // the local symbol of each parameter, receiver first (a bit each)
    u64 NoEscape;           // parameters that may hold borrowed closures
    u64 From;               // the parameters a `from` clause names
    bool HasFrom;
    List<u32> Locals;       // triples: local symbol, origins (low and high 32 bits)
    bool Changed;
    bool Report;            // the final pass reports errors

    static OriginCx New() => new OriginCx {
        Params = List<u32>.New(), NoEscape = 0, From = 0, HasFrom = false,
        Locals = List<u32>.New(), Changed = false, Report = false
    };

    // Bit i for parameter local s, or 0.
    u64 ParamBit(in this, u32 s) {
        for (usize i = 0; i < this.Params.Len() && i < 64; i++) {
            if (this.Params.Get(i) == s) return (1 as u64) << i;
        }
        return 0;
    }

    u32 ParamOfBit(in this, u64 bits) {
        for (usize i = 0; i < this.Params.Len() && i < 64; i++) {
            if (bits & (1 as u64) << i != 0) return this.Params.Get(i);
        }
        return 0;
    }

    u64 LocalOrigins(in this, u32 s) {
        for (usize i = 0; i < this.Locals.Len(); i += 3) {
            if (this.Locals.Get(i) == s) return this.Locals.Get(i + 1) as u64 | (this.Locals.Get(i + 2) as u64) << 32;
        }
        return 0;
    }

    void AddLocalOrigins(ref this, u32 s, u64 o) {
        if (o == 0) return;
        for (usize i = 0; i < this.Locals.Len(); i += 3) {
            if (this.Locals.Get(i) != s) continue;
            u64 old = this.Locals.Get(i + 1) as u64 | (this.Locals.Get(i + 2) as u64) << 32;
            if (old | o == old) return;
            o = old | o;
            this.Locals.Set(i + 1, (o & 0xFFFFFFFF) as u32);
            this.Locals.Set(i + 2, (o >> 32) as u32);
            this.Changed = true;
            return;
        }
        this.Locals.Push(s);
        this.Locals.Push((o & 0xFFFFFFFF) as u32);
        this.Locals.Push((o >> 32) as u32);
        this.Changed = true;
    }
}

impl Checker {
    // ------------------------------------------------------------------ calls

    // Records every use of a local in expression n (not inside lambda bodies) as kind k, or
    // as a move where the move checker marked one. uses holds quadruples (local, kind,
    // token, path): path is the outermost of the field accesses directly over the local
    // (`p.A.B` for p), or 0 for the whole local.
    void CollectUses(in this, ref List<u32> uses, u32 n, u32 k, u32 path) {
        if (n == 0) return;
        Node node = this.NodeAt(n);
        if (node.Kind == NK_NAME || node.Kind == NK_THIS) {
            u32 s = this.NSym(n);
            if (s == 0 || this.SymKind(s) != SK_LOCAL) return;
            u32 kind = k;
            if (this.NMove.Get(n as usize) == 1) kind = BK_MOVE;
            uses.Push(s);
            uses.Push(kind);
            uses.Push(node.Tok);
            uses.Push(path);
            return;
        }
        if (node.Kind == NK_LAMBDA) {
            // a lambda inside an argument holds its captures as values or borrows, read here
            u64 cv = this.NValue(n);
            u32 first = (cv & 0xFFFFFFFF) as u32;
            u32 count = (cv >> 32) as u32;
            for (u32 i = 0; i < count; i++) {
                uses.Push(this.Captures.Get((first + i) as usize));
                uses.Push(BK_READ);
                uses.Push(node.Tok);
                uses.Push(0);
            }
            return;
        }
        if (node.Kind == NK_MEMBER) {
            u32 outer = path;
            if (outer == 0) outer = n;
            this.CollectUses(ref uses, node.A, k, outer);
            return;
        }
        if (node.Kind == NK_UNARY || node.Kind == NK_CAST || node.Kind == NK_TRY) {
            this.CollectUses(ref uses, node.A, k, 0);
            return;
        }
        if (node.Kind == NK_COND) {
            this.CollectUses(ref uses, node.A, BK_READ, 0);
            this.CollectUses(ref uses, node.B, k, 0);
            this.CollectUses(ref uses, node.C, k, 0);
            return;
        }
        if (node.Kind == NK_INDEX || node.Kind == NK_BINARY) {
            this.CollectUses(ref uses, node.A, k, 0);
            this.CollectUses(ref uses, node.B, BK_READ, 0);
            return;
        }
        if (node.Kind == NK_CALL) {
            // an inner call's borrows end before the outer call: its uses are reads here
            if (this.NKind(node.A) == NK_MEMBER) this.CollectUses(ref uses, this.NodeAt(node.A).A, BK_READ, 0);
            else if (this.TyKind(this.NType(node.A)) == TYK_FN) this.CollectUses(ref uses, node.A, BK_READ, 0);
            u32 a = node.B;
            while (a != 0) {
                this.CollectUses(ref uses, a, BK_READ, 0);
                a = this.NNext(a);
            }
            return;
        }
        if (node.Kind == NK_NEW) {
            u32 init = node.B;
            while (init != 0) {
                this.CollectUses(ref uses, this.NodeAt(init).A, BK_READ, 0);
                init = this.NNext(init);
            }
        }
    }

    // Are field paths p and q (CollectUses) disjoint: neither a prefix of the other?
    bool DisjointPaths(in this, u32 p, u32 q) {
        if (p == 0 || q == 0) return false;
        List<u32> a = List<u32>.New();
        List<u32> b = List<u32>.New();
        u32 n = p;
        while (this.NKind(n) == NK_MEMBER) {
            a.Push(this.NTok(n));
            n = this.NodeAt(n).A;
        }
        n = q;
        while (this.NKind(n) == NK_MEMBER) {
            b.Push(this.NTok(n));
            n = this.NodeAt(n).A;
        }
        // compare from the local outward: the lists hold the outermost access first
        usize i = a.Len();
        usize j = b.Len();
        while (i > 0 && j > 0) {
            i--;
            j--;
            if (!Same(TextStr(this.TokName(a.Get(i))), TextStr(this.TokName(b.Get(j))))) return true;
        }
        return false;
    }

    // A lambda argument for a function-typed parameter borrows its captures for the call:
    // exclusively if it changes one (a `mut fn`), shared otherwise.
    void CollectLambdaBorrows(in this, ref List<u32> uses, u32 a) {
        Node lam = this.NodeAt(a);
        if (this.NSym(a) != 1 || lam.Flags & NF_MOVE != 0) {
            this.CollectUses(ref uses, a, BK_READ, 0);
            return;
        }
        u32 k = BK_IN;
        if (this.TypeAt(this.NType(a)).Count != FK_FN) k = BK_REF;
        u64 cv = this.NValue(a);
        u32 first = (cv & 0xFFFFFFFF) as u32;
        u32 count = (cv >> 32) as u32;
        for (u32 i = 0; i < count; i++) {
            uses.Push(this.Captures.Get((first + i) as usize));
            uses.Push(k);
            uses.Push(lam.Tok);
            uses.Push(0);
        }
    }

    // One argument (or the receiver) passed with mode k. Plain reads inside an argument
    // whose value holds no borrow do not conflict with the call ([own.borrow.2]).
    void CollectArg(ref this, ref List<u32> uses, u32 a, u32 k) {
        if (this.NKind(a) == NK_LAMBDA) {
            this.CollectLambdaBorrows(ref uses, a);
            return;
        }
        usize start = uses.Len();
        this.CollectUses(ref uses, a, k, 0);
        if (this.HoldsBorrow(this.NType(a)) || this.IsConverted(a)) return;     // a view, or a `string` lent as `str`
        usize keep = start;
        for (usize i = start; i < uses.Len(); i += 4) {
            if (uses.Get(i + 1) == BK_READ) continue;
            for (usize j = 0; j < 4; j++) uses.Set(keep + j, uses.Get(i + j));
            keep += 4;
        }
        while (uses.Len() > keep) uses.Pop();
    }

    // [own.borrow.1], [own.borrow.3] within call n.
    void CheckCallBorrows(ref this, u32 n) {
        Node node = this.NodeAt(n);
        List<u32> uses = List<u32>.New();
        u32 cs = this.NSym(n);
        u32 a = node.B;
        if (cs != 0 && this.SymKind(cs) == SK_FN) {
            Sym fs = this.SymAt(cs);
            if (fs.Flags & SF_METHOD != 0 && fs.Flags & SF_STATIC == 0 && this.NKind(node.A) == NK_MEMBER) {
                u32 rk = BK_READ;
                if (fs.Flags & SF_RECV_IN != 0) rk = BK_IN;
                if (fs.Flags & SF_RECV_REF != 0) rk = BK_REF;
                this.CollectArg(ref uses, this.NodeAt(node.A).A, rk);
            }
            u32 p = this.FirstParam(cs);
            while (a != 0) {
                u32 k = BK_READ;
                if (this.NodeAt(p).Flags & NF_IN != 0) k = BK_IN;
                if (this.NodeAt(p).Flags & NF_REF != 0) k = BK_REF;
                this.CollectArg(ref uses, a, k);
                a = this.NNext(a);
                p = this.NNext(p);
            }
        } else if (this.TyKind(this.NType(node.A)) == TYK_FN) {
            Type f = this.TypeAt(this.NType(node.A));
            this.CollectUses(ref uses, node.A, BK_READ, 0);
            u32 i = 0;
            while (a != 0) {
                u32 k = BK_READ;
                u32 mode = this.EnvGet(f.Sym, i);
                if (mode == NF_IN) k = BK_IN;
                if (mode == NF_REF) k = BK_REF;
                this.CollectArg(ref uses, a, k);
                a = this.NNext(a);
                i++;
            }
        } else {
            return;
        }
        usize count = uses.Len() / 4;
        for (usize i = 0; i < count; i++) {
            for (usize j = i + 1; j < count; j++) {
                u32 si = uses.Get(i * 4);
                if (si != uses.Get(j * 4)) continue;
                if (this.DisjointPaths(uses.Get(i * 4 + 3), uses.Get(j * 4 + 3))) continue;
                u32 ki = uses.Get(i * 4 + 1);
                u32 kj = uses.Get(j * 4 + 1);
                u32 tok = uses.Get(j * 4 + 2);
                bool moved = ki == BK_MOVE || kj == BK_MOVE;
                bool borrowed = ki == BK_REF || kj == BK_REF || ki == BK_IN || kj == BK_IN;
                if (moved && borrowed) this.BorrowError(tok, si, E_MOVED_WHILE_BORROWED, "` is moved while this call borrows it");
                if (ki == BK_REF || kj == BK_REF) this.BorrowError(tok, si, E_BORROW_CONFLICT, "` is borrowed `ref` by this call, so the call cannot use it another way");
            }
        }
    }

    // ------------------------------------------------------------------ origins

    // May a value of type t hold a borrow ([life.origin.1])? `str`, views, function values,
    // type parameters, and anything containing them.
    bool HoldsBorrow(ref this, u32 t) {
        // cached: callers run once declarations are complete, and types never change
        if ((t as usize) < this.BorrowMemo.Len() && this.BorrowMemo.Get(t as usize) != 0) return this.BorrowMemo.Get(t as usize) == 2;
        bool holds = this.HoldsBorrowOf(t);
        while (this.BorrowMemo.Len() <= t as usize) this.BorrowMemo.Push(0);
        u8 v = 1;
        if (holds) v = 2;
        this.BorrowMemo.Set(t as usize, v);
        return holds;
    }

    bool HoldsBorrowOf(ref this, u32 t) {
        Type ty = this.TypeAt(t);
        u8 k = ty.Kind;
        if (k == TYK_STR || k == TYK_SLICE || k == TYK_FN || k == TYK_PARAM) return true;
        if (k == TYK_ARRAY) return this.HoldsBorrow(ty.Elem);
        if (k == TYK_UNION) {
            u32 v = this.NodeAt(this.SymAt(ty.Sym).Node).B;
            while (v != 0) {
                u32 f = this.NodeAt(v).E;
                while (f != 0) {
                    u32 pt = this.PayloadType(t, f);
                    if (this.HoldsBorrow(pt)) return true;
                    f = this.NNext(f);
                }
                v = this.NNext(v);
            }
            return false;
        }
        if (k != TYK_STRUCT) return false;
        u32 f = this.NodeAt(this.SymAt(ty.Sym).Node).A;
        while (f != 0) {
            u32 ft = this.FieldType(t, f);
            if (this.HoldsBorrow(ft)) return true;
            f = this.NNext(f);
        }
        return false;
    }

    // Is expression n a temporary that owns what it holds (a call's or `new`'s value that
    // needs a drop and is not moved anywhere: dropped at the end of its statement)?
    bool IsTempOwner(ref this, u32 n) {
        u16 k = this.NKind(n);
        if (k != NK_CALL && k != NK_NEW) return false;
        return this.NMove.Get(n as usize) == 2 && this.NeedsDrop(this.NType(n));
    }

    // E0509 if a value with origins o, which view a temporary, would outlive it at tok.
    void TempViewEscapes(in this, in OriginCx x, u32 tok, u64 o, str what) {
        if (!x.Report || o & ORIGIN_TEMP == 0) return;
        string b = string.From(what);
        b.Append(", which is dropped at the end of its statement; keep the value in a local of its own first");
        this.Fail(tok, E_TEMP_VIEW_ESCAPES, b);
    }

    // E0507 for a borrowed closure parameter that would escape at tok.
    void ClosureEscapes(in this, in OriginCx x, u32 tok, u64 o) {
        if (!x.Report || o & x.NoEscape == 0) return;
        u32 s = x.ParamOfBit(o & x.NoEscape);
        this.BorrowError(tok, s, E_BORROW_NOT_DECLARED, "` may borrow its caller's variables, so it can only be called or passed to a function-typed parameter");
    }

    // The parameters whose borrows the value of expression n may hold ([life.origin.1]).
    u64 OriginOf(ref this, ref OriginCx x, u32 n) {
        if (n == 0) return 0;
        Node node = this.NodeAt(n);
        u16 k = node.Kind;
        u64 o = 0;
        if (k == NK_LAMBDA) {
            // a lambda holds its captures (copies or borrows): its value carries their
            // origins, so where it may go is checked where it goes
            u64 cv = this.NValue(n);
            u32 first = (cv & 0xFFFFFFFF) as u32;
            u32 count = (cv >> 32) as u32;
            for (u32 i = 0; i < count; i++) {
                u32 s = this.Captures.Get((first + i) as usize);
                o = o | x.ParamBit(s) | x.LocalOrigins(s);
            }
            return o;
        }
        if (k == NK_CALL) {
            // a call's result may hold borrows of anything it was given; a borrowed closure
            // may go only to a function-typed parameter
            u32 cs = this.NSym(n);
            u32 a = node.B;
            u32 p = 0;
            Type ft = this.TypeAt(this.NType(node.A));
            if (cs != 0 && this.SymKind(cs) == SK_FN) {
                p = this.FirstParam(cs);
                if (this.NKind(node.A) == NK_MEMBER) {
                    u32 recv = this.NodeAt(node.A).A;
                    o = this.OriginOf(ref x, recv);
                    if (this.IsTempOwner(recv)) o = o | ORIGIN_TEMP;
                }
            }
            u32 i = 0;
            while (a != 0) {
                u64 ao = this.OriginOf(ref x, a);
                if (this.IsTempOwner(a)) ao = ao | ORIGIN_TEMP;
                bool fnParam = false;
                if (p != 0) fnParam = this.TyKind(this.NType(p)) == TYK_FN;
                else if (ft.Kind == TYK_FN) fnParam = this.TyKind(this.EnvGet(ft.Args, i)) == TYK_FN;
                if (!fnParam) this.ClosureEscapes(x, this.NTok(a), ao);
                o = o | ao;
                a = this.NNext(a);
                if (p != 0) p = this.NNext(p);
                i++;
            }
            if (!this.HoldsBorrow(this.NType(n))) return 0;
            return o;
        }
        if (k == NK_NEW) {
            u32 init = node.B;
            while (init != 0) {
                o = o | this.OriginOf(ref x, this.NodeAt(init).A);
                init = this.NNext(init);
            }
            return o;
        }
        if (k == NK_COND) {
            this.OriginOf(ref x, node.A);
            u64 b = this.OriginOf(ref x, node.B);
            return b | this.OriginOf(ref x, node.C);
        }
        if (k == NK_MATCH) return this.OriginMatch(ref x, n, true);
        if (k == NK_TRY) return this.OriginOf(ref x, node.A);
        if (k == NK_BINARY && node.Op == TK_QQ) {
            u64 l = this.OriginOf(ref x, node.A);
            return l | this.OriginOf(ref x, node.B);
        }
        if (!this.HoldsBorrow(this.NType(n))) return 0;
        if (k == NK_NAME || k == NK_THIS) {
            u32 s = this.NSym(n);
            if (s == 0 || this.SymKind(s) != SK_LOCAL) return 0;
            return x.ParamBit(s) | x.LocalOrigins(s);
        }
        if (k == NK_MEMBER || k == NK_INDEX) return this.OriginOf(ref x, node.A);
        return 0;
    }

    void OriginStmt(ref this, ref OriginCx x, u32 n) {
        if (n == 0) return;
        Node node = this.NodeAt(n);
        u16 k = node.Kind;
        if (k == NK_BLOCK) {
            u32 s = node.A;
            while (s != 0) {
                this.OriginStmt(ref x, s);
                s = this.NNext(s);
            }
            return;
        }
        if (k == NK_UNSAFE) {
            this.OriginStmt(ref x, node.A);
            return;
        }
        if (k == NK_IF || k == NK_WHILE) {
            this.OriginOf(ref x, node.A);
            this.OriginStmt(ref x, node.B);
            if (k == NK_IF) this.OriginStmt(ref x, node.C);
            return;
        }
        if (k == NK_FOR) {
            this.OriginStmt(ref x, node.A);
            this.OriginOf(ref x, node.B);
            this.OriginStmt(ref x, node.C);
            this.OriginStmt(ref x, node.D);
            return;
        }
        if (k == NK_MATCH) {
            this.OriginMatch(ref x, n, false);
            return;
        }
        if (k == NK_RETURN) {
            this.OriginReturn(ref x, node.A);
            return;
        }
        if (k == NK_VAR) {
            u64 o = this.OriginOf(ref x, node.B);
            x.AddLocalOrigins(this.NSym(n), o);
            return;
        }
        if (k == NK_ASSIGN) {
            u64 o = this.OriginOf(ref x, node.B);
            u32 t = node.A;
            u16 tk = this.NKind(t);
            if ((tk == NK_NAME || tk == NK_THIS) && this.NSym(t) != 0 && this.SymKind(this.NSym(t)) == SK_LOCAL) {
                this.TempViewEscapes(x, node.Tok, o, "this stores a view of a temporary in a variable that outlives it");
                x.AddLocalOrigins(this.NSym(t), o);
                return;
            }
            // stored somewhere that outlives this call
            this.ClosureEscapes(x, node.Tok, o);
            this.TempViewEscapes(x, node.Tok, o, "this stores a view of a temporary somewhere that outlives it");
            return;
        }
        if (k == NK_EXPR) this.OriginOf(ref x, node.A);
        if (k == NK_FOREACH) {
            u64 o = this.OriginOf(ref x, node.B);
            // an element copied out of the sequence views what the elements view, not the
            // sequence's container: a temporary container does not follow it
            u32 es = this.NSym(node.A);
            if (es != 0 && this.SymAt(es).Flags & SF_BYREF == 0) o = o & ~ORIGIN_TEMP;
            x.AddLocalOrigins(es, o);
            this.OriginStmt(ref x, node.C);
        }
    }

    // A match: its bindings carry the scrutinee's origins; an expression match's value,
    // those of its arms.
    u64 OriginMatch(ref this, ref OriginCx x, u32 n, bool isExpr) {
        Node m = this.NodeAt(n);
        u64 so = this.OriginOf(ref x, m.A);
        u64 o = 0;
        u32 arm = m.B;
        while (arm != 0) {
            Node a = this.NodeAt(arm);
            u32 pat = a.A;
            while (pat != 0) {
                if (this.NKind(pat) == NK_CALL) {
                    u32 b = this.NodeAt(pat).B;
                    while (b != 0) {
                        if (this.NKind(b) == NK_NAME && this.NSym(b) != 0) x.AddLocalOrigins(this.NSym(b), so);
                        b = this.NNext(b);
                    }
                }
                pat = this.NNext(pat);
            }
            this.OriginOf(ref x, a.E);
            if (isExpr && this.NKind(a.B) != NK_BLOCK) o = o | this.OriginOf(ref x, a.B);
            else this.OriginStmt(ref x, a.B);
            arm = a.Next;
        }
        return o;
    }

    // `return e`: no borrowed closure leaves; with a `from` clause, only borrows of what it
    // names ([life.from.3]).
    void OriginReturn(ref this, ref OriginCx x, u32 e) {
        u64 o = this.OriginOf(ref x, e);
        if (e == 0) return;
        this.ClosureEscapes(x, this.NTok(e), o);
        this.TempViewEscapes(x, this.NTok(e), o, "this returns a view of a temporary");
        if (!x.Report || !x.HasFrom) return;
        u64 extra = o & ~x.From & ~ORIGIN_TEMP;
        if (extra == 0) return;
        u32 s = x.ParamOfBit(extra);
        string b = string.From("this returns (or stores) a borrow of `");
        b.Append(this.SymName(s));
        b.Append("`, but the signature does not say `from ");
        b.Append(this.SymName(s));
        b.Append("`");
        this.Fail(this.NTok(e), E_BORROW_NOT_DECLARED, b);
    }

    // The `from` names in list first must be borrowed parameters or `this` ([life.from.2]);
    // returns their bits.
    u64 CheckFromList(ref this, in OriginCx x, u32 first, u32 fs) {
        u64 bits = 0;
        u32 o = first;
        while (o != 0) {
            Node on = this.NodeAt(o);
            u32 s = 0;
            if (on.Kind == NK_THIS) {
                s = this.SymAt(fs).Recv;
            } else {
                foreach (var ps in x.Params.AsSlice()) {
                    if (Same(this.SymName(ps), this.TokText(on.Tok))) s = ps;
                }
            }
            if (s == 0) this.Fail(on.Tok, E_BAD_FROM, "`from` can only name a borrowed parameter or `this`");
            Sym ps = this.SymAt(s);
            if (ps.Flags & SF_BYREF == 0 && !this.HoldsBorrow(ps.Type)) this.Fail(on.Tok, E_BAD_FROM, "`from` can only name a borrowed parameter or `this`");
            if (this.TyKind(ps.Type) == TYK_FN) this.NotCore("`from` naming a function-typed parameter (a function value cannot be returned from its parameter)", on.Tok);
            bits = bits | x.ParamBit(s);
            o = on.Next;
        }
        return bits;
    }

    // Checks function symbol s's borrows ([s1.own.3]), after its body is checked.
    void OriginCheckFn(ref this, u32 s) {
        Sym sym = this.SymAt(s);
        Node fn = this.NodeAt(sym.Node);
        OriginCx x = OriginCx.New();
        if (sym.Recv != 0) x.Params.Push(sym.Recv);
        u32 p = this.FirstParam(s);
        while (p != 0) {
            u32 ls = this.NSym(p);
            x.Params.Push(ls);
            if (this.TyKind(this.NType(p)) == TYK_FN) x.NoEscape = x.NoEscape | x.ParamBit(ls);
            // `from` on a parameter: only a `ref` one may receive borrows ([life.from.4])
            if (this.NodeAt(p).E != 0) {
                if (this.NodeAt(p).Flags & NF_REF == 0) this.Fail(this.NTok(this.NodeAt(p).E), E_BAD_FROM, "`from` on a parameter needs a `ref` parameter");
                this.CheckFromList(x, this.NodeAt(p).E, s);
            }
            p = this.NNext(p);
        }
        if (fn.G != 0) {
            x.HasFrom = true;
            x.From = this.CheckFromList(x, fn.G, s);
        }
        this.OriginBody(ref x, fn.C, sym.Type != T_VOID);
    }

    // The same for the program's top-level statements ([own.temp.1]: views of temporaries).
    void OriginCheckMain(ref this, u32 first) {
        OriginCx x = OriginCx.New();
        for (u32 round = 0; round < 8; round++) {
            x.Changed = false;
            u32 n = first;
            while (n != 0) {
                if (!NodeIsItem(this.NKind(n))) this.OriginStmt(ref x, n);
                n = this.NNext(n);
            }
            if (!x.Changed) break;
        }
        x.Report = true;
        u32 n = first;
        while (n != 0) {
            if (!NodeIsItem(this.NKind(n))) this.OriginStmt(ref x, n);
            n = this.NNext(n);
        }
    }

    // The same for a lambda's body: its function-typed parameters may hold borrowed
    // closures.
    void OriginCheckLambda(ref this, u32 n) {
        Node lam = this.NodeAt(n);
        OriginCx x = OriginCx.New();
        Type ft = this.TypeAt(this.NType(n));
        u32 p = lam.A;
        while (p != 0) {
            u32 ls = this.NSym(p);
            x.Params.Push(ls);
            if (this.TyKind(this.NType(p)) == TYK_FN) x.NoEscape = x.NoEscape | x.ParamBit(ls);
            p = this.NNext(p);
        }
        this.OriginBody(ref x, lam.B, ft.Elem != T_VOID);
    }

    // Origins of locals until stable, then a pass that reports. exprReturns: an expression
    // body is the result.
    void OriginBody(ref this, ref OriginCx x, u32 body, bool exprReturns) {
        for (u32 round = 0; round < 8; round++) {
            x.Changed = false;
            if (this.NKind(body) == NK_BLOCK) this.OriginStmt(ref x, body);
            if (!x.Changed) break;
        }
        x.Report = true;
        if (this.NKind(body) == NK_BLOCK) this.OriginStmt(ref x, body);
        else if (exprReturns) this.OriginReturn(ref x, body);
        else this.OriginOf(ref x, body);
    }
}
