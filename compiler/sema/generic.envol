// Envo-S1 generics, methods and interfaces: type parameters and instances, substitution
// and inference, method tables, interface implementations, and the instantiation pass.
// Follows Stage 1's bootstrap/stage1/check/generic.envol.
//
// A generic item has an environment: a list of type arguments, the owner's first (the
// struct, impl or interface a method belongs to), then the item's own. A type parameter's
// symbol holds its index in that list, so substitution is positional. An interface's
// methods have the implementing type at index 0 ("This"), then the interface's parameters.
namespace envoc.sema;

use envoc.util;
use envoc.syntax;

impl Checker {
    // ------------------------------------------------------------------ environments

    u32 EnvGet(in this, u32 first, u32 i) => this.TypeArgs.Get((first + i) as usize);

    void EnvSet(ref this, u32 first, u32 i, u32 t) => this.TypeArgs.Set((first + i) as usize, t);

    // n zeroed entries; the first one's index (0 if n is 0).
    u32 EnvNew(ref this, u32 n) {
        if (n == 0) return 0;
        u32 first = this.TypeArgs.Len() as u32;
        for (u32 i = 0; i < n; i++) this.TypeArgs.Push(0);
        return first;
    }

    // ------------------------------------------------------------------ types

    // The interned instance of generic struct or interface s with the n arguments at first.
    u32 TypeInstance(ref this, u8 kind, u32 s, u32 first, u32 n) {
        string key = Decimal(kind as u64);
        key.AppendByte(':');
        AppendDecimal(ref key, s as u64);
        for (u32 i = 0; i < n; i++) {
            key.AppendByte(',');
            AppendDecimal(ref key, this.EnvGet(first, i) as u64);
        }
        u32? found = this.Instances.Get(key);
        if (found.IsSome()) return found.Unwrap();
        u32 args = this.EnvNew(n);
        for (u32 i = 0; i < n; i++) this.EnvSet(args, i, this.EnvGet(first, i));
        u32 t = this.TypeNew(kind);
        Type ty = this.TypeAt(t);
        ty.Sym = s;
        ty.Name = this.SymAt(s).Name;
        ty.Args = args;
        ty.NArgs = n;
        this.PutType(t, ty);
        this.Instances.Put(key, t);
        return t;
    }

    // Does type t mention a type parameter?
    bool HasParams(in this, u32 t) {
        if (t == 0) return false;
        if ((t as usize) < this.ParamsIn.Len()) return this.ParamsIn.Get(t as usize);
        Type ty = this.TypeAt(t);
        if (ty.Kind == TYK_PARAM) return true;
        if (ty.Kind == TYK_PTR || ty.Kind == TYK_SLICE || ty.Kind == TYK_ARRAY) return this.HasParams(ty.Elem);
        if (ty.Kind == TYK_FN && this.HasParams(ty.Elem)) return true;
        for (u32 i = 0; i < ty.NArgs; i++) {
            if (this.HasParams(this.EnvGet(ty.Args, i))) return true;
        }
        return false;
    }

    // t with every type parameter replaced by its entry in the environment (env, n).
    u32 Subst(ref this, u32 t, u32 env, u32 n) {
        if (n == 0 || !this.HasParams(t)) return t;
        Type ty = this.TypeAt(t);
        if (ty.Kind == TYK_PARAM) {
            u32 i = this.SymAt(ty.Sym).Value as u32;
            if (i < n) {
                u32 r = this.EnvGet(env, i);
                if (r != 0) return r;
            }
            return t;
        }
        if (ty.Kind == TYK_PTR || ty.Kind == TYK_SLICE || ty.Kind == TYK_ARRAY) {
            u32 elem = this.Subst(ty.Elem, env, n);
            return this.TypeDerived(ty.Kind, elem, ty.Count);
        }
        if (ty.Kind == TYK_FN) return this.FnTypeSubst(t, env, n);
        u32 args = this.EnvNew(ty.NArgs);
        for (u32 i = 0; i < ty.NArgs; i++) {
            u32 a = this.Subst(this.EnvGet(ty.Args, i), env, n);
            this.EnvSet(args, i, a);
        }
        return this.TypeInstance(ty.Kind, ty.Sym, args, ty.NArgs);
    }

    // Binds the parameters in declared type pt that are still unknown in (env, n) by
    // matching it against the argument type at ([s1.expr.7] inference). Mismatches are
    // reported later.
    void Unify(ref this, u32 pt, u32 at, u32 env, u32 n) {
        if (pt == 0 || at == 0) return;
        Type p = this.TypeAt(pt);
        if (p.Kind == TYK_PARAM) {
            u32 i = this.SymAt(p.Sym).Value as u32;
            if (i < n && this.EnvGet(env, i) == 0) this.EnvSet(env, i, at);
            return;
        }
        Type a = this.TypeAt(at);
        if (p.Kind != a.Kind) return;
        if (p.Kind == TYK_PTR || p.Kind == TYK_SLICE || p.Kind == TYK_ARRAY) {
            this.Unify(p.Elem, a.Elem, env, n);
            return;
        }
        if (p.Kind == TYK_FN) {
            if (p.NArgs != a.NArgs) return;
            this.Unify(p.Elem, a.Elem, env, n);
        } else if (p.Sym != a.Sym || p.NArgs != a.NArgs) return;
        for (u32 i = 0; i < p.NArgs; i++) this.Unify(this.EnvGet(p.Args, i), this.EnvGet(a.Args, i), env, n);
    }

    // Does pt mention a parameter that (env, n) has not bound yet?
    bool Unbound(in this, u32 pt, u32 env, u32 n) {
        if (pt == 0) return false;
        Type p = this.TypeAt(pt);
        if (p.Kind == TYK_PARAM) {
            u32 i = this.SymAt(p.Sym).Value as u32;
            return i < n && this.EnvGet(env, i) == 0;
        }
        if (p.Kind == TYK_PTR || p.Kind == TYK_SLICE || p.Kind == TYK_ARRAY) return this.Unbound(p.Elem, env, n);
        if (p.Kind == TYK_FN && this.Unbound(p.Elem, env, n)) return true;
        for (u32 i = 0; i < p.NArgs; i++) {
            if (this.Unbound(this.EnvGet(p.Args, i), env, n)) return true;
        }
        return false;
    }

    // The type of field node f of struct type t (an instance's arguments substituted).
    u32 FieldType(ref this, u32 t, u32 f) {
        Type ty = this.TypeAt(t);
        return this.Subst(this.NType(f), ty.Args, ty.NArgs);
    }

    // Interface symbol s applied to the n arguments at first.
    u32 IfaceTypeOf(ref this, u32 s, u32 first, u32 n) {
        if (n == 0) return this.SymAt(s).Type;
        return this.TypeInstance(TYK_IFACE, s, first, n);
    }

    // ------------------------------------------------------------------ type parameters

    // Declares the type parameters in the list starting at first, with environment indexes
    // from start. Returns how many there are.
    u32 DeclareTParams(ref this, u32 first, u32 start) {
        u32 n = 0;
        u32 p = first;
        while (p != 0) {
            this.CheckDuplicateInList(first, p);
            u32 s = this.SymNew(SK_TPARAM, p);
            u32 t = this.TypeNew(TYK_PARAM);
            Type ty = this.TypeAt(t);
            ty.Sym = s;
            ty.Name = this.SymAt(s).Name;
            this.PutType(t, ty);
            Sym sym = this.SymAt(s);
            sym.Value = (start + n) as u64;
            sym.Type = t;
            this.PutSym(s, sym);
            this.SetNSym(p, s);
            n++;
            p = this.NNext(p);
        }
        return n;
    }

    // The type parameter visible under token tok's name, or 0.
    u32 FindTParam(in this, u32 tok) {
        u32 p = this.Scope2;
        while (p != 0) {
            if (this.SameName(this.NTok(p), tok)) return this.NSym(p);
            p = this.NNext(p);
        }
        p = this.Scope1;
        while (p != 0) {
            if (this.SameName(this.NTok(p), tok)) return this.NSym(p);
            p = this.NNext(p);
        }
        return 0;
    }

    // The type made of the n parameters of a generic item (its own generic form).
    u32 SelfInstance(ref this, u8 kind, u32 s, u32 first, u32 n) {
        u32 env = this.EnvNew(n);
        u32 p = first;
        for (u32 i = 0; i < n; i++) {
            this.EnvSet(env, i, this.SymAt(this.NSym(p)).Type);
            p = this.NNext(p);
        }
        return this.TypeInstance(kind, s, env, n);
    }

    // E0338 at tok.
    void TypeArgCount(in this, u32 tok, u32 want, u32 have) {
        string b = string.From("wrong number of type arguments: expected ");
        AppendDecimal(ref b, want as u64);
        b.Append(", found ");
        AppendDecimal(ref b, have as u64);
        this.Fail(tok, E_TYPE_ARG_COUNT, b);
    }

    // ------------------------------------------------------------------ methods

    // The method table key of type t's member named by token tok.
    string MethodKey(in this, u32 t, u32 tok) {
        Type ty = this.TypeAt(t);
        string key = string.New();
        if (ty.Kind == TYK_STRUCT || ty.Kind == TYK_ENUM || ty.Kind == TYK_UNION) {
            key.AppendByte('s');
            AppendDecimal(ref key, ty.Sym as u64);
        } else {
            key.AppendByte('t');
            AppendDecimal(ref key, t as u64);
        }
        key.AppendByte('.');
        key.Append(this.TokText(tok));
        return key;
    }

    // The method of type t named by token tok: its symbol | (impl index + 1) << 32, or 0.
    u64 MethodFind(in this, u32 t, u32 tok) {
        string key = this.MethodKey(t, tok);
        return this.Methods.Get(key) ?? 0;
    }

    // Adds a method to type t's table (E0201 if the name is taken).
    void MethodAdd(ref this, u32 t, u32 tok, u64 v) {
        if (this.MethodFind(t, tok) != 0) this.FailName(tok, E_DUPLICATE, "`", tok, "` is already defined");
        string key = this.MethodKey(t, tok);
        this.Methods.Put(key, v);
    }

    // The method of interface symbol s named by token tok, or 0.
    u32 IfaceMethodNamed(in this, u32 s, u32 tok) {
        u32 m = this.NodeAt(this.SymAt(s).Node).A;
        while (m != 0) {
            if (this.SameName(this.NTok(m), tok)) return this.NSym(m);
            m = this.NNext(m);
        }
        return 0;
    }

    // The method node named by token tok in the list starting at first, or 0.
    u32 MethodNodeNamed(in this, u32 first, u32 tok) {
        u32 m = first;
        while (m != 0) {
            if (this.SameName(this.NTok(m), tok)) return m;
            m = this.NNext(m);
        }
        return 0;
    }

    // Is node p a `this` receiver parameter?
    bool IsReceiver(in this, u32 p) => this.Tok(this.NTok(p)).Kind == TK_KW_THIS;

    // The first ordinary (non-receiver) parameter node of function symbol s.
    u32 FirstParam(in this, u32 s) {
        u32 p = this.NodeAt(this.SymAt(s).Node).B;
        if (p != 0 && this.IsReceiver(p)) p = this.NNext(p);
        return p;
    }

    // Declares method node m of an owner: its symbol, type parameters, receiver and
    // signature. ownerTP is the owner's type parameter list, nOwn its length (1 + the
    // interface's parameters for an interface).
    u32 DeclareMethod(ref this, u32 m, u32 ownerType, u32 ownerTP, u32 nOwn, u32 iface) {
        u32 s = this.SymNew(SK_FN, m);
        this.SetNSym(m, s);
        Node fn = this.NodeAt(m);
        u32 flags = SF_METHOD;
        if (fn.Flags & NF_STATIC != 0) flags = flags | SF_STATIC;
        if (iface != 0 && fn.E != 0) this.NotCore("generic methods in an interface", this.NTok(fn.E));
        u32 own = this.DeclareTParams(fn.E, nOwn);
        u32 p = fn.B;
        if (p != 0 && this.IsReceiver(p)) {
            if (flags & SF_STATIC != 0) this.Error(E_BAD_THIS, this.NTok(p));
            u32 mode = this.NodeAt(p).Flags;
            if (mode & NF_REF != 0) flags = flags | SF_RECV_REF;
            else if (mode & NF_IN != 0) flags = flags | SF_RECV_IN;
        } else if (flags & SF_STATIC == 0) {
            flags = flags | SF_RECV_IN;     // [item.method.1] no receiver: `in this`
        }
        if (nOwn + own > 0) flags = flags | SF_GENERIC;
        Sym sym = this.SymAt(s);
        sym.Flags = flags;
        sym.NEnv = nOwn + own;
        sym.NOwn = nOwn;
        sym.OwnerTP = ownerTP;
        sym.OwnerType = ownerType;
        sym.Iface = iface;
        this.PutSym(s, sym);
        this.FnSignature(s);
        return s;
    }

    // A struct's methods (in its body) and the interfaces it lists after `:`.
    void DeclareStructMethods(ref this, u32 s) {
        Sym sym = this.SymAt(s);
        Node st = this.NodeAt(sym.Node);
        u32 m = st.G;
        while (m != 0) {
            u32 ms = this.DeclareMethod(m, sym.Type, st.E, sym.NEnv, 0);
            this.MethodAdd(sym.Type, this.NTok(m), ms as u64);
            m = this.NNext(m);
        }
        u32 b = st.F;
        while (b != 0) {
            u32 it = this.ResolveIfaceIn(b, st.E);
            this.AddImpl(sym.Type, it, sym.Node, st.G, sym.NEnv);
            b = this.NNext(b);
        }
    }

    // An interface type node b, resolved with the type parameters in list tps visible.
    u32 ResolveIfaceIn(ref this, u32 b, u32 tps) {
        u32 s1 = this.Scope1;
        u32 s2 = this.Scope2;
        this.Scope1 = tps;
        this.Scope2 = 0;
        u32 it = this.ResolveIface(b);
        this.Scope1 = s1;
        this.Scope2 = s2;
        return it;
    }

    // A type node that must name an interface (E0336).
    u32 ResolveIface(ref this, u32 n) {
        u32 t = this.ResolveTypeEx(n, false, true);
        if (this.TyKind(t) != TYK_IFACE) {
            string b = string.From("`");
            this.AppendType(ref b, t);
            b.Append("` is not an interface");
            this.Fail(this.NTok(n), E_NOT_AN_IFACE, b);
        }
        return t;
    }

    void AddImpl(ref this, u32 target, u32 it, u32 node, u32 methods, u32 nparams) {
        u32 copy = this.CopySym;
        if (copy != 0 && this.TypeAt(it).Sym == copy) this.Fail(this.NTok(node), E_NOT_AN_IFACE, "`Copy` is implemented automatically; it cannot be implemented by hand");
        if (this.FindImpl(target, it) != 0) {
            string b = string.From("`");
            this.AppendType(ref b, it);
            b.Append("` is already implemented for `");
            this.AppendType(ref b, target);
            b.AppendByte('`');
            this.Fail(this.NTok(node), E_DUPLICATE, b);
        }
        this.Impls.Push(new ImplRec { Target = target, Iface = it, Node = node, Methods = methods, NParams = nparams });
    }

    // An interface: the parameter for the implementing type, its own parameters, its methods.
    void DeclareIfaceItem(ref this, u32 s) {
        Node it = this.NodeAt(this.SymAt(s).Node);
        // "This", the implementing type, is index 0 of every method's environment
        u32 self = this.SymNew(SK_TPARAM, 0);
        u32 st = this.TypeNew(TYK_PARAM);
        Type ty = this.TypeAt(st);
        ty.Sym = self;
        ty.Name = TextOf("This");
        this.PutType(st, ty);
        Sym p = this.SymAt(self);
        p.Name = TextOf("This");
        p.Type = st;
        this.PutSym(self, p);
        u32 n = this.DeclareTParams(it.E, 1);
        u32 t = 0;
        if (n == 0) t = this.TypeNamed(TYK_IFACE, s);
        else t = this.SelfInstance(TYK_IFACE, s, it.E, n);
        Sym sym = this.SymAt(s);
        sym.NEnv = n;
        sym.OwnerType = st;
        sym.Type = t;
        this.PutSym(s, sym);
    }

    void DeclareIfaceMethods(ref this, u32 s) {
        Sym sym = this.SymAt(s);
        Node it = this.NodeAt(sym.Node);
        u32 m = it.A;
        while (m != 0) {
            this.CheckDuplicateInList(it.A, m);
            this.DeclareMethod(m, sym.OwnerType, it.E, sym.NEnv + 1, s);
            m = this.NNext(m);
        }
    }

    // impl [<T…>] [I for] Type { methods }   ([item.impl.1], [s1.item.4], [s1.item.5])
    void DeclareImpl(ref this, u32 n) {
        Node im = this.NodeAt(n);
        u32 count = this.DeclareTParams(im.E, 0);
        u32 it = 0;
        this.Scope1 = im.E;
        this.Scope2 = 0;
        u32 target = this.ResolveType(im.A, false);
        if (im.B != 0) it = this.ResolveIface(im.B);
        this.Scope1 = 0;
        Type tt = this.TypeAt(target);
        if (count > 0) {
            // impl<T, U> applies to S<T, U> exactly
            bool exact = (tt.Kind == TYK_STRUCT || tt.Kind == TYK_UNION) && tt.NArgs == count;
            u32 p = im.E;
            for (u32 i = 0; exact && i < count; i++) {
                if (this.EnvGet(tt.Args, i) != this.SymAt(this.NSym(p)).Type) exact = false;
                p = this.NNext(p);
            }
            if (!exact) this.NotCore("an `impl` for some instances of a generic type; its type parameters must be exactly the type's", this.NTok(im.A));
        } else if (tt.NArgs > 0) {
            this.NotCore("an `impl` for one instance of a generic type", this.NTok(im.A));
        }
        if (it != 0) this.AddImpl(target, it, n, im.C, count);
        u32 m = im.C;
        while (m != 0) {
            u32 ms = this.DeclareMethod(m, target, im.E, count, 0);
            this.MethodAdd(target, this.NTok(m), ms as u64);
            m = this.NNext(m);
        }
    }

    // [item.iface.1] every implementation provides each method of its interface with the
    // same signature (or inherits a default body), and nothing else.
    void CheckImpls(ref this) {
        u32 count = this.Impls.Len() as u32;
        for (u32 i = 0; i < count; i++) this.CheckImpl(i);
    }

    void CheckImpl(ref this, u32 i) {
        ImplRec r = this.Impls.Get(i as usize);
        Type it = this.TypeAt(r.Iface);
        u32 isym = it.Sym;
        // the interface's environment for this implementation: [target, interface arguments…]
        u32 n = 1 + it.NArgs;
        u32 env = this.EnvNew(n);
        this.EnvSet(env, 0, r.Target);
        for (u32 k = 0; k < it.NArgs; k++) this.EnvSet(env, k + 1, this.EnvGet(it.Args, k));
        u32 im = this.NodeAt(this.SymAt(isym).Node).A;
        while (im != 0) {
            u32 ims = this.NSym(im);
            u32 f = this.MethodNodeNamed(r.Methods, this.NTok(im));
            if (f == 0) {
                if (this.NodeAt(im).C == 0) {
                    string b = string.From("`");
                    this.AppendType(ref b, r.Target);
                    b.Append("` does not implement `");
                    b.Append(this.TokText(this.NTok(im)));
                    b.Append("` from `");
                    this.AppendType(ref b, r.Iface);
                    b.AppendByte('`');
                    this.Fail(this.NTok(r.Node), E_MISSING_METHOD, b);
                }
                // the default body serves this type
                if (this.MethodFind(r.Target, this.NTok(im)) == 0) this.MethodAdd(r.Target, this.NTok(im), ims as u64 | ((i + 1) as u64) << 32);
            } else if (!this.SameSignature(ims, env, n, this.NSym(f))) {
                string b = string.From("method `");
                b.Append(this.TokText(this.NTok(f)));
                b.Append("` does not match its declaration in `");
                this.AppendType(ref b, r.Iface);
                b.AppendByte('`');
                this.Fail(this.NTok(f), E_METHOD_MISMATCH, b);
            }
            im = this.NNext(im);
        }
        // an interface implementation holds only the interface's methods (a struct body may
        // also have its own)
        if (this.NKind(r.Node) != NK_IMPL) return;
        u32 f = r.Methods;
        while (f != 0) {
            if (this.IfaceMethodNamed(isym, this.NTok(f)) == 0) {
                string b = string.From("`");
                b.Append(this.TokText(this.NTok(f)));
                b.Append("` is not a method of `");
                this.AppendType(ref b, r.Iface);
                b.AppendByte('`');
                this.Fail(this.NTok(f), E_NOT_IN_IFACE, b);
            }
            f = this.NNext(f);
        }
    }

    // Does method fs have interface method ims's signature, under the interface environment?
    bool SameSignature(ref this, u32 ims, u32 env, u32 n, u32 fs) {
        Sym a = this.SymAt(ims);
        Sym b = this.SymAt(fs);
        u32 kinds = SF_STATIC | SF_RECV_IN | SF_RECV_REF;
        if (a.Flags & kinds != b.Flags & kinds) return false;
        if (b.NEnv != b.NOwn || a.Aux != b.Aux) return false;
        if (this.Subst(a.Type, env, n) != b.Type) return false;
        u32 pa = this.FirstParam(ims);
        u32 pb = this.FirstParam(fs);
        for (u32 i = 0; i < a.Aux; i++) {
            if (this.Subst(this.ParamType(ims, i), env, n) != this.ParamType(fs, i)) return false;
            u32 modes = NF_IN | NF_REF;
            if (this.NodeAt(pa).Flags & modes != this.NodeAt(pb).Flags & modes) return false;
            pa = this.NNext(pa);
            pb = this.NNext(pb);
        }
        return true;
    }

    // ------------------------------------------------------------------ bounds

    // The impl index + 1 of interface type it for type t, or 0.
    u32 FindImpl(ref this, u32 t, u32 it) {
        Type ty = this.TypeAt(t);
        u32 isym = this.TypeAt(it).Sym;
        u32 count = this.Impls.Len() as u32;
        for (u32 i = 0; i < count; i++) {
            ImplRec r = this.Impls.Get(i as usize);
            if (this.TypeAt(r.Iface).Sym != isym) continue;
            u32 env = 0;
            u32 n = 0;
            if (r.NParams == 0) {
                if (r.Target != t) continue;
            } else {
                Type rt = this.TypeAt(r.Target);
                if ((ty.Kind != TYK_STRUCT && ty.Kind != TYK_UNION) || ty.Sym != rt.Sym || ty.NArgs != r.NParams) continue;
                env = ty.Args;
                n = ty.NArgs;
            }
            if (this.Subst(r.Iface, env, n) == it) return i + 1;
        }
        return 0;
    }

    // Does type t implement interface type it here? A type parameter does through the
    // current function's bounds ([type.gen.2]); other types through an implementation.
    bool Implements(ref this, u32 t, u32 it) {
        u32 copy = this.CopySym;
        if (this.TyKind(t) != TYK_PARAM && copy != 0 && this.TypeAt(it).Sym == copy) return this.IsCopy(t);
        if (this.TyKind(t) != TYK_PARAM) return this.FindImpl(t, it) != 0;
        u32 first = this.CurBounds;
        u32 n = this.NCurBounds;
        for (u32 i = 0; i < n; i++) {
            if (this.BoundAt(first + i, 0) == t && this.BoundAt(first + i, 1) == it) return true;
        }
        return false;
    }

    // Pair i of Checker.Bounds: k 0 is the parameter type, k 1 the interface type.
    u32 BoundAt(in this, u32 i, u32 k) => this.Bounds.Get((i * 2 + k) as usize);

    // The interface method named by tok that a bound of parameter type t provides, and in
    // bound the bound's interface type; 0 if there is none.
    u32 BoundMethod(in this, u32 t, u32 tok, ref u32 bound) {
        u32 first = this.CurBounds;
        u32 n = this.NCurBounds;
        for (u32 i = 0; i < n; i++) {
            if (this.BoundAt(first + i, 0) != t) continue;
            u32 it = this.BoundAt(first + i, 1);
            u32 m = this.IfaceMethodNamed(this.TypeAt(it).Sym, tok);
            if (m != 0) {
                bound = it;
                return m;
            }
        }
        return 0;
    }

    // E0334 "`T` does not implement `I`" at tok.
    void NotImplemented(in this, u32 tok, u32 t, u32 it) {
        string b = string.From("`");
        this.AppendType(ref b, t);
        b.Append("` does not implement `");
        this.AppendType(ref b, it);
        b.AppendByte('`');
        this.Fail(tok, E_NOT_IMPLEMENTED, b);
    }

    // ------------------------------------------------------------------ instantiation

    // Records a call that needs an instance (a generic function or a method).
    void RecordCall(ref this, u32 call) {
        if (this.CurFn == 0) this.MainCalls.Push(call);
        else this.Calls.Push(call);
    }

    // Does a call to function symbol s need an instance?
    bool NeedsInst(in this, u32 s) => this.SymAt(s).Flags & (SF_METHOD | SF_GENERIC) != 0;

    // The function and the concrete environment a checked call runs when the body holding
    // it is compiled with environment (env, n): the recorded arguments substituted, and an
    // interface method resolved to its implementation.
    void CallTarget(ref this, u32 call, u32 env, u32 n, ref u32 rs, ref u32 renv, ref u32 rn) {
        u32 s = this.NSym(call);
        u64 v = this.NValue(call);
        u32 cf = (v & 0xFFFFFFFF) as u32;
        u32 cn = (v >> 32) as u32;
        u32 e = this.EnvNew(cn);
        for (u32 i = 0; i < cn; i++) {
            u32 t = this.Subst(this.EnvGet(cf, i), env, n);
            this.EnvSet(e, i, t);
        }
        if (this.SymAt(s).Iface != 0) {
            this.ResolveIfaceCall(s, e, cn, ref rs, ref renv, ref rn);
            return;
        }
        rs = s;
        renv = e;
        rn = cn;
    }

    // The function an interface method runs for the concrete environment [This, interface
    // arguments…]: the implementation's method, or the interface's default body.
    void ResolveIfaceCall(ref this, u32 m, u32 env, u32 n, ref u32 rs, ref u32 renv, ref u32 rn) {
        Sym ms = this.SymAt(m);
        u32 self = this.EnvGet(env, 0);
        u32 it = this.IfaceTypeOf(ms.Iface, env + 1, n - 1);
        u32 r = this.FindImpl(self, it);
        if (r == 0) panic("checker: an interface call has no implementation");
        ImplRec rec = this.Impls.Get((r - 1) as usize);
        u32 f = this.MethodNodeNamed(rec.Methods, this.NTok(ms.Node));
        if (f != 0) {
            rs = this.NSym(f);
            renv = 0;
            rn = 0;
            if (rec.NParams > 0) {
                Type st = this.TypeAt(self);
                renv = st.Args;
                rn = st.NArgs;
            }
            return;
        }
        rs = m;
        renv = env;
        rn = n;
    }

    // The instance of function s for environment (env, n), created on first use. depth is
    // how many generic calls led here (E0350 at blame past MAX_INST_DEPTH).
    u32 InstGet(ref this, u32 s, u32 env, u32 n, u32 depth, u32 blame) {
        string key = Decimal(s as u64);
        key.AppendByte(':');
        for (u32 i = 0; i < n; i++) {
            AppendDecimal(ref key, this.EnvGet(env, i) as u64);
            key.AppendByte(',');
        }
        u32? found = this.InstMap.Get(key);
        if (found.IsSome()) return found.Unwrap();
        if (depth > MAX_INST_DEPTH) this.Error(E_INST_TOO_DEEP, blame);
        u32 idx = this.Insts.Len() as u32;
        this.Insts.Push(new Inst { Sym = s, Env = env, NEnv = n, Depth = depth, Func = 0, Declared = false });
        this.InstMap.Put(key, idx);
        return idx;
    }

    // Every function instance the program needs, from the top-level statements and the
    // non-generic functions outward ([type.gen.1]: each instantiation is compiled separately).
    void CollectInstances(ref this) {
        for (usize i = 0; i < this.MainCalls.Len(); i++) this.InstantiateCall(this.MainCalls.Get(i), 0, 0, 0);
        for (u32 s = 1; s < this.Syms.Len() as u32; s++) {
            Sym sym = this.SymAt(s);
            if (sym.Kind != SK_FN || this.NeedsInst(s)) continue;
            for (u32 k = 0; k < sym.NCalls; k++) this.InstantiateCall(this.Calls.Get((sym.Calls + k) as usize), 0, 0, 0);
        }
        usize i = 0;
        while (i < this.Insts.Len()) {
            Inst inst = this.Insts.Get(i);
            Sym sym = this.SymAt(inst.Sym);
            for (u32 k = 0; k < sym.NCalls; k++) this.InstantiateCall(this.Calls.Get((sym.Calls + k) as usize), inst.Env, inst.NEnv, inst.Depth);
            i++;
        }
    }

    void InstantiateCall(ref this, u32 call, u32 env, u32 n, u32 depth) {
        u32 s = 0;
        u32 e = 0;
        u32 k = 0;
        this.CallTarget(call, env, n, ref s, ref e, ref k);
        this.InstGet(s, e, k, depth + 1, this.NTok(call));
    }

    // ------------------------------------------------------------------ names

    // A type's part of an instance's name. Self-delimiting: `0.` pointer, `1.` slice,
    // `2.N.` array, then a name, and for a generic instance its argument count and
    // arguments.
    public void AppendMangle(in this, ref string b, u32 t) {
        Type ty = this.TypeAt(t);
        if (ty.Kind == TYK_PTR) {
            b.Append("0.");
            this.AppendMangle(ref b, ty.Elem);
            return;
        }
        if (ty.Kind == TYK_SLICE) {
            b.Append("1.");
            this.AppendMangle(ref b, ty.Elem);
            return;
        }
        if (ty.Kind == TYK_ARRAY) {
            b.Append("2.");
            AppendDecimal(ref b, ty.Count as u64);
            b.AppendByte('.');
            this.AppendMangle(ref b, ty.Elem);
            return;
        }
        if (ty.Kind == TYK_FN) {
            // 3.kind.count, then each parameter's mode and type, then the result
            b.Append("3.");
            AppendDecimal(ref b, ty.Count as u64);
            b.AppendByte('.');
            AppendDecimal(ref b, ty.NArgs as u64);
            for (u32 i = 0; i < ty.NArgs; i++) {
                b.AppendByte('.');
                AppendDecimal(ref b, this.EnvGet(ty.Sym, i) as u64);
                b.AppendByte('.');
                this.AppendMangle(ref b, this.EnvGet(ty.Args, i));
            }
            b.AppendByte('.');
            this.AppendMangle(ref b, ty.Elem);
            return;
        }
        this.AppendTypeName(ref b, t);
        if (ty.NArgs == 0) return;
        b.AppendByte('.');
        AppendDecimal(ref b, ty.NArgs as u64);
        for (u32 i = 0; i < ty.NArgs; i++) {
            b.AppendByte('.');
            this.AppendMangle(ref b, this.EnvGet(ty.Args, i));
        }
    }

    // The name of named type t (a struct or an enum), prefixed with its namespace as
    // items' EIR names are, so types of the same name in different namespaces stay apart.
    public void AppendTypeName(in this, ref string b, u32 t) {
        Type ty = this.TypeAt(t);
        if (ty.Sym != 0 && (ty.Kind == TYK_STRUCT || ty.Kind == TYK_ENUM || ty.Kind == TYK_UNION)) {
            Text ns = this.SymAt(ty.Sym).Ns;
            if (ns.Len > 0) {
                b.Append(TextStr(ns));
                b.AppendByte('.');
            }
        }
        b.Append(TextStr(ty.Name));
    }

    // The EIR name of instance i: [owner.]name, then each type argument.
    public string InstName(in this, u32 i) {
        Inst inst = this.Insts.Get(i as usize);
        Sym s = this.SymAt(inst.Sym);
        string b = string.New();
        if (s.Iface != 0) {
            b.Append(this.SymName(s.Iface));
            b.AppendByte('.');
        } else if (s.Flags & SF_METHOD != 0) {
            Type ot = this.TypeAt(s.OwnerType);
            if (ot.Kind == TYK_STRUCT || ot.Kind == TYK_ENUM || ot.Kind == TYK_UNION) this.AppendTypeName(ref b, s.OwnerType);
            else this.AppendMangle(ref b, s.OwnerType);
            b.AppendByte('.');
        }
        b.Append(TextStr(s.Name));
        for (u32 k = 0; k < inst.NEnv; k++) {
            b.AppendByte('.');
            this.AppendMangle(ref b, this.EnvGet(inst.Env, k));
        }
        return b;
    }
}
