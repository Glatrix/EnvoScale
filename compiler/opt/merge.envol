// -O2: a local that receives a result and is copied whole into a variable right after
// (`Node n = list.Get(i);` writes the result into a temporary, then copies it) becomes the
// variable itself: the copy goes, and the variable's reads read the temporary. Then the
// struct is copied once, and splitting and load forwarding see one local, not two.
namespace envoc.opt;

use envoc.util;
use envoc.eir;

const u16 MG_SLOTEND = 4;
const u16 MG_COPY = 47;
const u16 MG_ZERO = 48;
const u16 MG_CALL = 52;

// Merges such pairs in function fi; true if any.
bool MergeSlots(ref Module m, u32 fi) {
    EFunc f = m.Func(fi);
    u32 nv = f.NValues;
    u32 nb = f.NBlocks;
    if (nb == 0) return false;
    // per value: how many operands use it (slot.end aside), the first two instructions
    // using it, and whether a branch passes it
    List<u32> nuse = List<u32>.New();
    List<u32> use1 = List<u32>.New();
    List<u32> use2 = List<u32>.New();
    List<bool> passed = List<bool>.New();
    for (u32 k = 0; k < nv; k++) {
        nuse.Push(0);
        use1.Push(NONE);
        use2.Push(NONE);
        passed.Push(false);
    }
    bool any = false;
    for (u32 b = 0; b < nb; b++) {
        EBlock blk = m.Block(f.FirstBlock + b);
        for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) {
            EInst inst = m.Inst(i);
            if (inst.Op == MG_COPY) any = true;
            if (inst.Op == MG_SLOTEND) continue;
            for (u32 o = inst.FirstOp; o < inst.FirstOp + inst.NOps; o++) {
                EOp op = m.Op(o);
                if (op.Kind == OK_VALUE) {
                    u32 k = op.Ref - f.FirstValue;
                    if (k >= nv) continue;
                    nuse.Set(k as usize, nuse.Get(k as usize) + 1);
                    if (use1.Get(k as usize) == NONE) use1.Set(k as usize, i);
                    else if (use2.Get(k as usize) == NONE) use2.Set(k as usize, i);
                } else if (op.Kind == OK_TARGET) {
                    for (u32 a = 0; a < op.NArgs; a++) {
                        u32 k = m.Arg(op.Args + a) - f.FirstValue;
                        if (k < nv) passed.Set(k as usize, true);
                    }
                }
            }
        }
    }
    if (!any) return false;
    Cfg g = BuildCfg(m, f);
    bool changed = false;
    for (u32 b = 0; b < nb; b++) {
        EBlock blk = m.Block(f.FirstBlock + b);
        for (u32 c = blk.FirstInst; c < blk.FirstInst + blk.NInsts; c++) {
            EInst copy = m.Inst(c);
            if (copy.Op != MG_COPY || copy.NOps != 3) continue;
            EOp dop = m.Op(copy.FirstOp);
            EOp sop = m.Op(copy.FirstOp + 1);
            if (dop.Kind != OK_VALUE || sop.Kind != OK_VALUE) continue;
            u32 d = dop.Ref - f.FirstValue;
            u32 s = sop.Ref - f.FirstValue;
            if (d >= nv || s >= nv || d == s || passed.Get(d as usize) || passed.Get(s as usize)) continue;
            u32 di = m.Val(dop.Ref).Inst;
            u32 si = m.Val(sop.Ref).Inst;
            if (di == 0 || si == 0 || m.Inst(di).Op != OP_SLOT || m.Inst(si).Op != OP_SLOT) continue;
            if (m.Inst(di).Ty != m.Inst(si).Ty) continue;
            u64 size = m.Ty(m.Inst(si).Ty).Size as u64;
            if (size == 0 || !WholeSize(m, copy.FirstOp + 2, size)) continue;
            // the temporary: written whole by one instruction just before, read by the copy
            if (nuse.Get(s as usize) != 2) continue;
            u32 w = use1.Get(s as usize);
            if (w == c) w = use2.Get(s as usize);
            if (w == NONE || w >= c || w < blk.FirstInst) continue;
            if (!WritesWhole(m, w, sop.Ref, size)) continue;
            // nothing between them uses the variable
            bool clear = true;
            for (u32 i = w + 1; i < c && clear; i++) {
                if (UsesValue(m, i, dop.Ref)) clear = false;
            }
            if (!clear) continue;
            // every other use of the variable comes after the copy
            for (u32 ub = 0; ub < nb && clear; ub++) {
                EBlock u = m.Block(f.FirstBlock + ub);
                bool after = ub != b && g.Dom.Has(ub, b);
                for (u32 i = u.FirstInst; i < u.FirstInst + u.NInsts && clear; i++) {
                    if (i == c) continue;
                    if (!UsesValue(m, i, dop.Ref)) continue;
                    if (ub == b && i > c) continue;
                    if (!after) clear = false;
                }
            }
            if (!clear) continue;
            // the variable's uses take the temporary; the temporary's own slot.end goes
            for (u32 ub = 0; ub < nb; ub++) {
                EBlock u = m.Block(f.FirstBlock + ub);
                for (u32 i = u.FirstInst; i < u.FirstInst + u.NInsts; i++) {
                    if (i == c) continue;
                    EInst inst = m.Inst(i);
                    if (inst.Op == MG_SLOTEND && inst.NOps >= 1 && m.Op(inst.FirstOp).Kind == OK_VALUE && m.Op(inst.FirstOp).Ref == sop.Ref) {
                        inst.Op = 0;
                        inst.NOps = 0;
                        m.Insts.Set(i as usize, inst);
                        continue;
                    }
                    for (u32 o = inst.FirstOp; o < inst.FirstOp + inst.NOps; o++) {
                        EOp op = m.Op(o);
                        if (op.Kind == OK_VALUE && op.Ref == dop.Ref) {
                            op.Ref = sop.Ref;
                            m.Ops.Set(o as usize, op);
                        }
                    }
                }
            }
            copy.Op = 0;
            copy.NOps = 0;
            m.Insts.Set(c as usize, copy);
            // both are spent: the temporary now has other uses, the variable none
            nuse.Set(s as usize, 0);
            nuse.Set(d as usize, 0);
            changed = true;
        }
    }
    return changed;
}

// Does instruction w write all size bytes of local v: a call returning an aggregate there,
// or a whole copy or zero into it?
bool WritesWhole(in Module m, u32 w, u32 v, u64 size) {
    EInst inst = m.Inst(w);
    if (inst.Op == MG_CALL) {
        // the hidden first argument (after the callee) receives the result
        return inst.Imm == 1 && inst.NOps >= 2 && m.Op(inst.FirstOp + 1).Kind == OK_VALUE && m.Op(inst.FirstOp + 1).Ref == v && !UsedAfterFirst(m, w, v);
    }
    if (inst.Op == MG_COPY && inst.NOps == 3) {
        return m.Op(inst.FirstOp).Kind == OK_VALUE && m.Op(inst.FirstOp).Ref == v && WholeSize(m, inst.FirstOp + 2, size);
    }
    if (inst.Op == MG_ZERO && inst.NOps == 2) {
        return m.Op(inst.FirstOp).Kind == OK_VALUE && m.Op(inst.FirstOp).Ref == v && WholeSize(m, inst.FirstOp + 1, size);
    }
    return false;
}

// Does call w pass v again, after its result argument?
bool UsedAfterFirst(in Module m, u32 w, u32 v) {
    EInst inst = m.Inst(w);
    for (u32 o = inst.FirstOp + 2; o < inst.FirstOp + inst.NOps; o++) {
        EOp op = m.Op(o);
        if (op.Kind == OK_VALUE && op.Ref == v) return true;
    }
    return false;
}

// Does instruction i use value v (an operand or a branch argument)?
bool UsesValue(in Module m, u32 i, u32 v) {
    EInst inst = m.Inst(i);
    for (u32 o = inst.FirstOp; o < inst.FirstOp + inst.NOps; o++) {
        EOp op = m.Op(o);
        if (op.Kind == OK_VALUE && op.Ref == v) return true;
        if (op.Kind == OK_TARGET) {
            for (u32 a = 0; a < op.NArgs; a++) {
                if (m.Arg(op.Args + a) == v) return true;
            }
        }
    }
    return false;
}

// A `zero` of a local (an inlined callee's, zeroed as a call would get it) that is written
// whole before anything can read it, within its block, goes: by a whole copy or zero, by
// a call returning an aggregate there, or by stores to its fields. Unless its address is
// stored somewhere or passed on as a value, only its own uses can read it (a call it is
// passed to reads it during that call only).
bool DropDeadZeros(ref Module m, u32 fi) {
    EFunc f = m.Func(fi);
    u32 nv = f.NValues;
    // per value: does a use let its address out (anything but the accesses below)?
    List<bool> escapes = List<bool>.New();
    List<u32> nuse = List<u32>.New();
    for (u32 k = 0; k < nv; k++) {
        escapes.Push(false);
        nuse.Push(0);
    }
    bool zeros = false;
    for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
        EBlock blk = m.Block(b);
        for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) {
            EInst inst = m.Inst(i);
            if (inst.Op == MG_ZERO) zeros = true;
            for (u32 o = inst.FirstOp; o < inst.FirstOp + inst.NOps; o++) {
                EOp op = m.Op(o);
                if (op.Kind == OK_TARGET) {
                    for (u32 a = 0; a < op.NArgs; a++) {
                        u32 k = m.Arg(op.Args + a) - f.FirstValue;
                        if (k < nv) escapes.Set(k as usize, true);
                    }
                    continue;
                }
                if (op.Kind != OK_VALUE) continue;
                u32 k = op.Ref - f.FirstValue;
                if (k >= nv) continue;
                nuse.Set(k as usize, nuse.Get(k as usize) + 1);
                u32 at = o - inst.FirstOp;
                bool fine = (inst.Op == MG_ZERO && at == 0) || (inst.Op == MG_COPY && at <= 1) || inst.Op == MG_SLOTEND ||
                    (inst.Op == 42 && at == 0) || (inst.Op == 43 && at == 1) || inst.Op == 44 ||
                    ((inst.Op == MG_CALL || inst.Op == 53) && at >= 1);
                if (!fine) escapes.Set(k as usize, true);
            }
        }
    }
    if (!zeros) return false;
    bool changed = false;
    for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
        EBlock blk = m.Block(b);
        for (u32 z = blk.FirstInst; z < blk.FirstInst + blk.NInsts; z++) {
            EInst zi = m.Inst(z);
            if (zi.Op != MG_ZERO || zi.NOps != 2) continue;
            EOp sop = m.Op(zi.FirstOp);
            if (sop.Kind != OK_VALUE) continue;
            u32 s = sop.Ref;
            u32 si = m.Val(s).Inst;
            if (si == 0 || m.Inst(si).Op != OP_SLOT) continue;
            u32 sty = m.Inst(si).Ty;
            u64 size = m.Ty(sty).Size as u64;
            if (size == 0 || size > 64 || !WholeSize(m, zi.FirstOp + 1, size)) continue;
            bool esc = escapes.Get((s - f.FirstValue) as usize);
            u64 full = 0xFFFFFFFFFFFFFFFF;
            if (size < 64) full = ((1 as u64) << size) - 1;
            u64 covered = 0;
            bool stop = false;
            u32 j = z + 1;
            while (j < blk.FirstInst + blk.NInsts && !stop && covered != full) {
                EInst x = m.Inst(j);
                bool uses = false;
                for (u32 o = x.FirstOp; o < x.FirstOp + x.NOps; o++) {
                    EOp op = m.Op(o);
                    if (op.Kind == OK_VALUE && op.Ref == s) uses = true;
                }
                if (!uses) {
                    // once the address is out, a call, a load or a copy may read it
                    if (esc && (x.Op == MG_CALL || x.Op == 53 || x.Op == 54 || x.Op == 42 || x.Op == MG_COPY)) stop = true;
                    j++;
                    continue;
                }
                if ((x.Op == MG_COPY && x.NOps == 3 && m.Op(x.FirstOp).Ref == s && m.Op(x.FirstOp + 1).Ref != s && WholeSize(m, x.FirstOp + 2, size)) ||
                    (x.Op == MG_ZERO && WholeSize(m, x.FirstOp + 1, size)) ||
                    (x.Op == MG_CALL && x.Imm == 1 && WritesWhole(m, j, s, size))) {
                    covered = full;
                } else if (x.Op == 44 && x.NOps == 1 && nuse.Get((x.Result - f.FirstValue) as usize) == 1 && j + 1 < blk.FirstInst + blk.NInsts) {
                    // a field, stored to right after
                    EInst st = m.Inst(j + 1);
                    if (st.Op == 43 && st.NOps == 2 && m.Op(st.FirstOp + 1).Kind == OK_VALUE && m.Op(st.FirstOp + 1).Ref == x.Result && (m.Op(st.FirstOp).Kind != OK_VALUE || m.Op(st.FirstOp).Ref != s)) {
                        u64 off = m.FieldOffset(x.Ty, x.Imm as u32);
                        u64 n = m.Ty(st.Ty).Size as u64;
                        if (off + n <= size && n < 64) covered = covered | ((((1 as u64) << n) - 1) << off);
                        else stop = true;
                        j++;
                    } else {
                        stop = true;
                    }
                } else {
                    stop = true;
                }
                j++;
            }
            if (covered == full) {
                zi.Op = 0;
                zi.NOps = 0;
                m.Insts.Set(z as usize, zi);
                changed = true;
            }
        }
    }
    return changed;
}

// Per function: is its first parameter the storage its aggregate result goes to? So when
// every direct call passes one (`Imm` 1) and nothing takes its address.
List<bool> ResultFuncs(in Module m) {
    u32 nf = m.Funcs.Len() as u32;
    List<u32> withResult = List<u32>.New();
    List<bool> other = List<bool>.New();
    for (u32 fi = 0; fi < nf; fi++) {
        withResult.Push(0);
        other.Push(false);
    }
    for (u32 fi = 1; fi < nf; fi++) {
        EFunc f = m.Func(fi);
        if (f.Extern) continue;
        for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
            EBlock blk = m.Block(b);
            for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) {
                EInst inst = m.Inst(i);
                if (inst.Op == MG_CALL) {
                    u32 c = m.Op(inst.FirstOp).Ref;
                    if (c >= nf) continue;
                    if (inst.Imm == 1) withResult.Set(c as usize, withResult.Get(c as usize) + 1);
                    else other.Set(c as usize, true);
                } else if (inst.Op == 2) {
                    EOp rf = m.Op(inst.FirstOp);
                    if (rf.Int == NAME_FUNC && rf.Ref < nf) other.Set(rf.Ref as usize, true);
                }
            }
        }
    }
    List<bool> res = List<bool>.New();
    for (u32 fi = 0; fi < nf; fi++) res.Push(withResult.Get(fi as usize) > 0 && !other.Get(fi as usize) && m.Func(fi).NParams > 0);
    return res;
}

// `return g(...)` of an aggregate: the call writes the result's storage itself, instead of
// a temporary copied there right after.
bool ForwardResult(ref Module m, u32 fi, in List<bool> resultFunc) {
    if (!resultFunc.Get(fi as usize)) return false;
    EFunc f = m.Func(fi);
    u32 p0 = f.FirstValue;
    bool changed = false;
    for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
        EBlock blk = m.Block(b);
        if (blk.NInsts < 3) continue;
        u32 ri = blk.FirstInst + blk.NInsts - 1;
        if (m.Inst(ri).Op != 58 || m.Inst(ri).NOps != 0) continue;
        EInst cp = m.Inst(ri - 1);
        EInst call = m.Inst(ri - 2);
        if (cp.Op != MG_COPY || cp.NOps != 3 || m.Op(cp.FirstOp).Kind != OK_VALUE || m.Op(cp.FirstOp).Ref != p0) continue;
        EOp t = m.Op(cp.FirstOp + 1);
        if (t.Kind != OK_VALUE || call.Op != MG_CALL || call.Imm != 1 || call.NOps < 2) continue;
        if (m.Op(call.FirstOp + 1).Kind != OK_VALUE || m.Op(call.FirstOp + 1).Ref != t.Ref) continue;
        u32 ti = m.Val(t.Ref).Inst;
        if (ti == 0 || m.Inst(ti).Op != OP_SLOT) continue;
        if (!WholeSize(m, cp.FirstOp + 2, m.Ty(m.Inst(ti).Ty).Size as u64)) continue;
        // the temporary is used by these two only, and the call does not take the storage
        bool alone = true;
        for (u32 x = f.FirstBlock; x < f.FirstBlock + f.NBlocks && alone; x++) {
            EBlock xb = m.Block(x);
            for (u32 i = xb.FirstInst; i < xb.FirstInst + xb.NInsts && alone; i++) {
                if (i == ri - 1 || i == ri - 2 || m.Inst(i).Op == MG_SLOTEND) continue;
                if (UsesValue(m, i, t.Ref)) alone = false;
            }
        }
        for (u32 o = call.FirstOp + 2; o < call.FirstOp + call.NOps && alone; o++) {
            EOp op = m.Op(o);
            if (op.Kind == OK_VALUE && (op.Ref == p0 || op.Ref == t.Ref)) alone = false;
        }
        if (!alone) continue;
        EOp first = m.Op(call.FirstOp + 1);
        first.Ref = p0;
        m.Ops.Set((call.FirstOp + 1) as usize, first);
        cp.Op = 0;
        cp.NOps = 0;
        m.Insts.Set((ri - 1) as usize, cp);
        changed = true;
    }
    return changed;
}
