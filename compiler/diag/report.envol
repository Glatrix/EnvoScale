// Source files and diagnostics (compiler/diag/README.md). Messages use the format every
// stage shares: "path:line:col: error[E####]: message" on stderr, then exit code 1;
// problems with the command line are "envoc: error: message" with exit code 2. With rich
// diagnostics on (the `envo` tool turns them on; envoc keeps the shared format, which the
// stages are compared on), the first line is followed by the source line with a caret
// under the column, a `help:` line where there is advice, and a pointer to
// `envo explain`.
namespace envoc.diag;

use envoc.util;

public const i32 EXIT_OK = 0;
public const i32 EXIT_ERRORS = 1;
public const i32 EXIT_USAGE = 2;
public const i32 EXIT_INTERNAL = 70;

public struct SourceFile {
    string Path;
    string Text;
}

// Every source file the compiler has read, in the order read; a token refers to its file
// by index.
public struct Sources {
    List<SourceFile> Files;

    public static Sources New() => new Sources { Files = List<SourceFile>.New() };

    public usize Add(ref this, str path, string text) {
        this.Files.Push(new SourceFile { Path = string.From(path), Text = text });
        return this.Files.Len() - 1;
    }

    public usize Count() => this.Files.Len();

    public str Path(usize file) => this.Files.AsSlice()[file].Path.AsStr();
    public str Text(usize file) => this.Files.AsSlice()[file].Text.AsStr();
}

// Line and column (both from 1; columns count characters, not bytes) of byte offset off.
public void Position(str text, usize off, ref u32 line, ref u32 col) {
    line = 1;
    col = 1;
    for (usize i = 0; i < off && i < text.Len; i++) {
        u8 b = text[i];
        if (b == 10) {
            line++;
            col = 1;
        } else if (b & 0xC0 != 0x80) {
            col++;
        }
    }
}

// The column of byte offset off: characters from the start of its line, from 1.
public u32 Column(str text, usize off) {
    usize lineStart = off;
    while (lineStart > 0 && text[lineStart - 1] != 10) lineStart--;
    u32 col = 1;
    for (usize i = lineStart; i < off; i++) {
        if (text[i] & 0xC0 != 0x80) col++;
    }
    return col;
}

// Reports an error at byte offset off of a source file and exits.
public void Fail(in Sources src, usize file, usize off, u32 code, str msg) {
    FailAt(src.Path(file), src.Text(file), off, code, msg);
}

static bool RichOn = false;
static usize HelpData = 0;      // *u8 of the help set for the next error, or 0
static usize HelpLen = 0;

// Turns on the source line, caret and help after each error's first line.
public void EnableRichDiagnostics() {
    unsafe { RichOn = true; }
}

// Advice for the next error reported, shown as its `help:` line in rich mode.
public void SetHelp(str help) {
    unsafe {
        *u8 p = alloc(help.Len + 1);        // kept for the process's life
        for (usize i = 0; i < help.Len; i++) p[i] = help[i];
        HelpData = p as usize;
        HelpLen = help.Len;
    }
}

// General advice for an error code, where there is some.
str CodeHelp(u32 code) {
    if (code == 4) return "a string ends on its line; write a line break inside it as `\\n`";
    if (code == 203) return "check the spelling, or add a `use` for the namespace that declares it";
    if (code == 214) return "`use a.b` reads `lib/a/b/b.envol` under the library folder; check the name";
    if (code == 215) return "reach the outside world through a port and `platform`, not an adapter";
    if (code == 306) return "put the operation inside an `unsafe { ... }` block";
    if (code == 501) return "lend the value with `in` or `ref` instead of moving it, or use it before the move";
    if (code == 502) return "borrow it (`var x = place;` binds a borrow) instead of moving it out";
    return "";
}

// The source line holding byte offset off, then a caret under its column.
void AppendSnippet(ref string e, str text, usize off, u32 line) {
    usize start = off;
    if (start > text.Len) start = text.Len;
    while (start > 0 && text[start - 1] != 10) start--;
    usize end = start;
    while (end < text.Len && text[end] != 10 && text[end] != 13) end++;
    string num = string.New();
    AppendDecimal(ref num, line as u64);
    string pad = string.New();
    for (usize i = 0; i < num.Len(); i++) pad.AppendByte(' ');
    e.Append(pad.AsStr());
    e.Append(" |\n");
    e.Append(num.AsStr());
    e.Append(" | ");
    e.Append(text[start..end]);
    e.AppendByte(10);
    e.Append(pad.AsStr());
    e.Append(" | ");
    // the caret's column: tabs stay tabs so it lines up
    for (usize i = start; i < off && i < end; i++) {
        u8 b = text[i];
        if (b == 9) e.AppendByte(9);
        else if (b & 0xC0 != 0x80) e.AppendByte(' ');
    }
    e.Append("^\n");
}

// Reports an error at byte offset off of text, read from path, and exits.
public void FailAt(str path, str text, usize off, u32 code, str msg) {
    u32 line = 0;
    u32 col = 0;
    Position(text, off, ref line, ref col);
    string e = string.From(path);
    e.AppendByte(':');
    AppendDecimal(ref e, line as u64);
    e.AppendByte(':');
    AppendDecimal(ref e, col as u64);
    e.Append(": error[E");
    if (code < 1000) e.AppendByte('0');
    if (code < 100) e.AppendByte('0');
    if (code < 10) e.AppendByte('0');
    AppendDecimal(ref e, code as u64);
    e.Append("]: ");
    e.Append(msg);
    e.AppendByte(10);
    bool rich = false;
    str help = "";
    unsafe {
        rich = RichOn;
        if (HelpData != 0) help = str_from(HelpData as *u8, HelpLen);
    }
    if (rich) {
        if (off <= text.Len) AppendSnippet(ref e, text, off, line);
        if (help.Len == 0) help = CodeHelp(code);
        if (help.Len > 0) {
            e.Append("help: ");
            e.Append(help);
            e.AppendByte(10);
        }
        e.Append("  = run `envo explain E");
        if (code < 1000) e.AppendByte('0');
        if (code < 100) e.AppendByte('0');
        if (code < 10) e.AppendByte('0');
        AppendDecimal(ref e, code as u64);
        e.Append("` for more\n");
    }
    write(2, e);
    exit(EXIT_ERRORS);
}

// A problem with the command line or the environment: "envoc: error: msg", then exit.
public void ToolFail(str msg, i32 code) {
    string e = string.From("envoc: error: ");
    e.Append(msg);
    e.AppendByte(10);
    write(2, e);
    exit(code);
}
