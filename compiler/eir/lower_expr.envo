// Lowering expressions ([core.expr.*]). Follows Stage 1's bootstrap/stage1/lower/expr.envo.
// LowerExpr returns a scalar value, or for an aggregate type the address of memory holding
// the value. LowerPlace returns the address of a place.
namespace envoc.lower;

use envoc.util;
use envoc.syntax;
use envoc.sema;
use envoc.eir;

impl Lower {
    u32 LowerExpr(ref this, u32 n) {
        u32 v = this.LowerExprValue(n);
        if (!this.C.IsConverted(n)) return v;
        // a `string` used as a `str`: { its bytes, its length }
        u32 nt = this.LNType(n);
        u32 sv = this.LType(nt);
        u32 st = this.StrType;
        u32 tmp = this.Slot(st);
        u32 data = this.Load(ET_PTR, this.Field(sv, v, 0));
        this.Store(ET_PTR, data, this.Field(st, tmp, 0));
        u32 count = this.Load(ET_U64, this.Field(sv, v, 1));
        this.Store(ET_U64, count, this.Field(st, tmp, 1));
        return tmp;
    }

    u32 LowerExprValue(ref this, u32 n) {
        Node node = this.C.NodeAt(n);
        u32 t = this.LNType(n);
        u16 k = node.Kind;
        // constant expressions the checker already evaluated
        if (k != NK_CALL && t != 0 && this.C.IsUntyped(n)) {
            u32 et = this.LType(t);
            u64 v = this.C.WrapValue(this.C.NValue(n), this.IntReprType(t));
            return this.Const(et, v);
        }
        if (k == NK_INT) {
            bool overflow = false;
            u64 v = this.C.LiteralValue(node.Tok, ref overflow);
            return this.Const(this.LType(t), v);
        }
        if (k == NK_CHAR) return this.Const(ET_U8, this.C.CharValue(node.Tok));
        if (k == NK_BOOL) {
            if (Same(this.C.TokText(node.Tok), "true")) return this.Const(ET_BOOL, 1);
            return this.Const(ET_BOOL, 0);
        }
        if (k == NK_STRING) {
            Text bytes = this.StringValue(n);
            return this.StrTemp(bytes);
        }
        if (k == NK_SIZEOF || k == NK_ALIGNOF) {
            // a generic operand is measured per instance
            u32 ot = this.C.NSym(n);
            if (!this.C.HasParams(ot)) return this.Const(ET_U64, this.C.NValue(n));
            u64 align = 0;
            u32 st = this.LSubst(ot);
            u64 size = this.C.SizeOf(st, node.Tok, ref align);
            if (k == NK_ALIGNOF) size = align;
            return this.Const(ET_U64, size);
        }
        if (k == NK_THIS) return this.LowerLocalUse(n, t);
        if (k == NK_LAMBDA) return this.LowerLambda(n);
        if (k == NK_MATCH) return this.LowerMatchS1(n, true);
        if (k == NK_NULL) return this.LowerVariantValue(t, this.C.NValue(n) as u32, 0);
        if (k == NK_TRY) return this.LowerTry(n, t);
        if (k == NK_BINARY && node.Op == TK_QQ) return this.LowerCoalesce(n, t);
        if (k == NK_COND) {
            // c ? a : b through a slot of the result type
            u32 et = this.LType(t);
            u32 slot = this.Slot(et);
            u32 yes = this.NewBlock();
            u32 no = this.NewBlock();
            u32 join = this.NewBlock();
            u32 cv = this.LowerExpr(node.A);
            this.CondBr(cv, yes, no);
            this.Start(yes);
            u32 a = this.LowerExpr(node.B);
            this.StoreTo(t, a, slot);
            this.Br(join);
            this.Start(no);
            u32 b = this.LowerExpr(node.C);
            this.StoreTo(t, b, slot);
            this.Br(join);
            this.Start(join);
            return this.LoadPlace(t, slot);
        }
        if (k == NK_NAME) {
            u32 ns = this.C.NSym(n);
            Sym sym = this.C.SymAt(ns);
            if (sym.Kind == SK_FN) return this.FnItemValue(ns);
            if (sym.Kind == SK_ENUM) return this.LowerVariantValue(t, this.C.NValue(n) as u32, 0);
            if (sym.Kind == SK_CONST) {
                if (this.C.TyKind(sym.Type) == TYK_STR) {
                    Text bytes = this.StringValue(this.C.NodeAt(sym.Node).B);
                    return this.StrTemp(bytes);
                }
                u32 et = this.LType(sym.Type);
                u64 v = this.C.WrapValue(sym.Value, this.IntReprType(sym.Type));
                return this.Const(et, v);
            }
            return this.LowerLocalUse(n, t);
        }
        if (k == NK_MEMBER) {
            // Enum.Variant
            if (this.C.NType(node.A) == 0 && this.C.IsTagged(t)) return this.LowerVariantValue(t, this.C.NValue(n) as u32, 0);
            if (this.C.NType(node.A) == 0) {
                u32 v = this.C.EnumVariantNamed(t, n);
                u32 et = this.LType(t);
                return this.Const(et, this.C.NValue(v));
            }
            u32 objType = this.LNType(node.A);
            u8 ok = this.C.TyKind(objType);
            if (ok == TYK_STR || ok == TYK_SLICE) {
                u32 obj = this.LowerExpr(node.A);
                if (Same(this.C.TokText(node.Tok), "Len")) return this.Load(ET_U64, this.Field(this.StrType, obj, 1));
                return this.Load(ET_PTR, this.Field(this.StrType, obj, 0));
            }
            u32 p = this.LowerPlace(n);
            u32 v = this.LoadPlace(t, p);
            if (this.C.NMove.Get(n as usize) == 3) this.ClearFieldFlag(n);
            return v;
        }
        if (k == NK_INDEX && this.C.NKind(node.B) == NK_RANGE) return this.LowerSlice(n, t);
        if (k == NK_INDEX) {
            u32 p = this.LowerPlace(n);
            return this.LoadPlace(t, p);
        }
        if (k == NK_UNARY) {
            u16 op = node.Op;
            if (op == TK_STAR) {
                u32 p = this.LowerExpr(node.A);
                return this.LoadPlace(t, p);
            }
            if (op == TK_AMP) return this.LowerPlace(node.A);
            u32 v = this.LowerExpr(node.A);
            u32 et = this.LType(t);
            if (op == TK_MINUS) return this.Emit(11, et, 0, 0, et, 1, OpV(v), OpNone(), OpNone());
            return this.Emit(17, et, 0, 0, et, 1, OpV(v), OpNone(), OpNone());     // ~ and !
        }
        if (k == NK_BINARY) return this.LowerBinary(n, node, t);
        if (k == NK_CAST) {
            u32 from = this.LNType(node.A);
            u32 v = this.LowerExpr(node.A);
            return this.LowerCast(from, t, v);
        }
        if (k == NK_CALL) {
            u32 r = this.LowerCall(n, node, t);
            this.TrackTemp(n, t, r);
            return r;
        }
        // NK_NEW: a zeroed temporary with the given fields
        u32 et = this.LType(t);
        u32 tmp = this.Slot(et);
        this.ZeroBytes(tmp, this.ESizeOf(et) as u64);
        u32 init = node.B;
        while (init != 0) {
            u32 field = this.C.StructFieldNamed(t, init);
            u32 v = this.LowerExpr(this.C.NodeAt(init).A);
            u32 ft = this.C.FieldType(t, field);
            u32 at = this.Field(et, tmp, this.FieldIndex(t, field));
            this.StoreTo(ft, v, at);
            init = this.C.NNext(init);
        }
        this.TrackTemp(n, t, tmp);
        return tmp;
    }

    // The value of a local or `this`; a use that moves it clears its drop flag.
    u32 LowerLocalUse(ref this, u32 n, u32 t) {
        u32 p = this.LowerPlace(n);
        u32 v = this.LoadPlace(t, p);
        if (this.C.NMove.Get(n as usize) == 1) this.SetDropFlag(this.C.NSym(n), false);
        return v;
    }

    // The value at address p of checker type t: loaded if scalar, the address itself if not.
    u32 LoadPlace(ref this, u32 t, u32 p) {
        if (this.IsAggregate(t)) return p;
        u32 et = this.LType(t);
        return this.Load(et, p);
    }

    // The address of a global or function by name.
    u32 AddrOf(ref this, Text name, u32 index, u64 kind) {
        EOp ga = OpNone();
        ga.Kind = OK_GLOBAL;
        ga.Str = name;
        ga.Ref = index;
        ga.Int = kind;
        return this.Emit(2, 0, 0, 0, ET_PTR, 1, ga, OpNone(), OpNone());
    }

    // A temporary str { address of bytes, length }.
    u32 StrTemp(ref this, Text bytes) {
        u32 st = this.StrType;
        u32 tmp = this.Slot(st);
        u32 g = this.StringGlobal(bytes);
        u32 addr = this.AddrOf(this.M.Global(g).Name, g, NAME_GLOBAL);
        this.Store(ET_PTR, addr, this.Field(st, tmp, 0));
        u32 len = this.Const(ET_U64, bytes.Len as u64);
        this.Store(ET_U64, len, this.Field(st, tmp, 1));
        return tmp;
    }

    u32 FieldIndex(in this, u32 t, u32 field) {
        u32 f = this.C.NodeAt(this.C.SymAt(this.C.TypeAt(t).Sym).Node).A;
        u32 i = 0;
        while (f != field) {
            i++;
            f = this.C.NNext(f);
        }
        return i;
    }

    // The address of a place: a local or static, a field, an element, or *p.
    u32 LowerPlace(ref this, u32 n) {
        Node node = this.C.NodeAt(n);
        if (node.Kind == NK_THIS) return this.SymSlot(this.C.NSym(n));
        if (node.Kind == NK_NAME) {
            u32 s = this.C.NSym(n);
            if (this.C.SymKind(s) == SK_STATIC) {
                u32 g = this.GlobalIds.Get(s as usize);
                return this.AddrOf(this.M.Global(g).Name, g, NAME_GLOBAL);
            }
            return this.SymSlot(s);
        }
        if (node.Kind == NK_MEMBER) {
            u32 objType = this.LNType(node.A);
            u32 st = objType;
            if (this.C.TyKind(objType) == TYK_PTR) st = this.C.TypeAt(objType).Elem;
            u32 addrBase = this.LowerExpr(node.A);     // a pointer, or a struct value's address
            u32 field = this.C.StructFieldNamed(st, n);
            u32 et = this.LType(st);
            return this.Field(et, addrBase, this.FieldIndex(st, field));
        }
        if (node.Kind == NK_INDEX) {
            u32 objType = this.LNType(node.A);
            Type obj = this.C.TypeAt(objType);
            u32 et = this.LType(this.LNType(n));
            u32 bt = this.LNType(node.B);
            u32 iv = this.LowerExpr(node.B);
            u32 idx = this.Index64(bt, iv);
            if (obj.Kind == TYK_PTR) {
                u32 p = this.LowerExpr(node.A);
                return this.Elem(et, p, idx);
            }
            if (obj.Kind == TYK_ARRAY) {
                u32 addrBase = this.LowerExpr(node.A);
                u32 count = this.Const(ET_U64, obj.Count as u64);
                this.BoundsCheck(bt, idx, count);
                return this.Elem(et, addrBase, idx);
            }
            // str or slice: { ptr, len }
            u32 view = this.LowerExpr(node.A);
            u32 st = this.StrType;
            u32 len = this.Load(ET_U64, this.Field(st, view, 1));
            this.BoundsCheck(bt, idx, len);
            u32 data = this.Load(ET_PTR, this.Field(st, view, 0));
            return this.Elem(et, data, idx);
        }
        // *p
        return this.LowerExpr(node.A);
    }

    // An index of checker type t as a 64-bit value: signed indexes sign-extend (so a
    // negative index is caught as out of bounds), unsigned ones zero-extend.
    u32 Index64(ref this, u32 t, u32 v) {
        u32 et = this.LType(t);
        u32 size = this.M.Ty(et).Size;
        bool signed = this.IsSignedType(t);
        if (size == 8) {
            if (signed) return this.Conv(41, et, ET_U64, v);
            return v;
        }
        if (signed) return this.Conv(34, et, ET_U64, v);
        return this.Conv(33, et, ET_U64, v);
    }

    // Panics with "index out of bounds" unless 0 <= idx < len (idx was widened by Index64;
    // a negative signed index is a huge unsigned one).
    void BoundsCheck(ref this, u32 indexType, u32 idx, u32 len) {
        if (this.IsSignedType(indexType)) {
            u32 si = this.Conv(41, ET_U64, ET_I64, idx);
            u32 sl = this.Conv(41, ET_U64, ET_I64, len);
            this.Emit(49, ET_I64, 0, 0, 0, 2, OpV(si), OpV(sl), OpNone());
            return;
        }
        this.Emit(49, ET_U64, 0, 0, 0, 2, OpV(idx), OpV(len), OpNone());
    }

    u32 LowerBinary(ref this, u32 n, Node node, u32 t) {
        u16 op = node.Op;
        if (op == TK_AND_AND || op == TK_OR_OR) {
            // short-circuit through a bool slot
            u32 tmp = this.Slot(ET_BOOL);
            u32 rhs = this.NewBlock();
            u32 join = this.NewBlock();
            u32 a = this.LowerExpr(node.A);
            this.Store(ET_BOOL, a, tmp);
            if (op == TK_AND_AND) this.CondBr(a, rhs, join);
            else this.CondBr(a, join, rhs);
            this.Start(rhs);
            u32 b = this.LowerExpr(node.B);
            this.Store(ET_BOOL, b, tmp);
            this.Br(join);
            this.Start(join);
            return this.Load(ET_BOOL, tmp);
        }
        u32 lt = this.LNType(node.A);
        u32 et = this.LType(lt);
        u32 a = this.LowerExpr(node.A);
        u32 b = this.LowerExpr(node.B);
        if (op == TK_SHL || op == TK_SHR) {
            u32 rt = this.LNType(node.B);
            return this.LowerShift(op == TK_SHL, lt, a, b, rt);
        }
        if (TokClass(op) & TC_PREC == PREC_COMPARE) {
            u16 cmp = 20;
            if (op == TK_NOT_EQ) cmp = 21;
            if (op == TK_LT) cmp = 22;
            if (op == TK_LT_EQ) cmp = 23;
            if (op == TK_GT) cmp = 24;
            if (op == TK_GT_EQ) cmp = 25;
            return this.Bin(cmp, et, a, b);
        }
        return this.Bin(ArithOp(this.C.TokText(node.Tok)), et, a, b);
    }

    // a << n, a >> n: the amount may have any integer type; it is checked against the bit
    // width in 64 bits first (so truncating it cannot hide a bad amount), then converted.
    u32 LowerShift(ref this, bool left, u32 t, u32 a, u32 n, u32 nt) {
        u32 et = this.LType(t);
        u32 bits = this.M.Ty(et).Size * 8;
        u32 n64 = this.Index64(nt, n);
        if (this.IsSignedType(nt)) {
            u32 sn = this.Conv(41, ET_U64, ET_I64, n64);
            u32 zero = this.Const(ET_I64, 0);
            u32 neg = this.Bin(22, ET_I64, sn, zero);
            this.Trap(neg, 4);
        }
        u32 limit = this.Const(ET_U64, bits as u64);
        u32 big = this.Bin(25, ET_U64, n64, limit);
        this.Trap(big, 4);
        u32 nn = n64;
        u32 size = this.M.Ty(et).Size;
        if (size < 8) nn = this.Conv(32, ET_U64, et, n64);
        else if (et != ET_U64) nn = this.Conv(41, ET_U64, et, n64);
        u16 op = 19;
        if (left) op = 18;
        return this.Bin(op, et, a, nn);
    }

    // Panics with reason if c is true.
    void Trap(ref this, u32 c, u64 reason) {
        u32 bad = this.NewBlock();
        u32 ok = this.NewBlock();
        this.CondBr(c, bad, ok);
        this.Start(bad);
        this.Panic(reason);
        this.Start(ok);
    }

    // e as T ([core.expr.9]): integers truncate or extend, bool and enums are integers,
    // pointers convert to and from usize/isize and to other pointers unchanged.
    u32 LowerCast(ref this, u32 from, u32 to, u32 v) {
        u32 ef = this.LType(from);
        u32 et = this.LType(to);
        u8 fk = this.C.TyKind(from);
        u8 tk = this.C.TyKind(to);
        if (tk == TYK_PTR) {
            if (fk == TYK_PTR) return v;
            u32 w = this.ConvTo(ef, ET_U64, false, v);
            return this.Conv(40, ET_U64, ET_PTR, w);
        }
        if (fk == TYK_PTR) {
            u32 w = this.Conv(39, ET_PTR, ET_U64, v);
            return this.ConvTo(ET_U64, et, false, w);
        }
        if (fk == TYK_BOOL) {
            u32 w = this.Conv(41, ET_BOOL, ET_U8, v);
            return this.ConvTo(ET_U8, et, false, w);
        }
        return this.ConvTo(ef, et, this.IsSignedType(from), v);
    }

    // Converts integer v from EIR type a to EIR type b (truncate, extend by the source's
    // signedness, or reinterpret).
    u32 ConvTo(ref this, u32 a, u32 b, bool signed, u32 v) {
        if (a == b) return v;
        u32 sa = this.M.Ty(a).Size;
        u32 sb = this.M.Ty(b).Size;
        if (sb < sa) return this.Conv(32, a, b, v);
        if (sb > sa) {
            if (signed) return this.Conv(34, a, b, v);
            return this.Conv(33, a, b, v);
        }
        return this.Conv(41, a, b, v);
    }

    // Calls: functions take scalars by value and aggregates by a pointer to a copy; an
    // aggregate result comes back through a hidden first argument. Built-ins call the
    // runtime; str_from builds its str in place; __syscall and __wincall are intrinsics.
    u32 LowerCall(ref this, u32 n, Node node, u32 t) {
        u32 cs = this.C.NSym(n);
        if (cs != 0 && this.C.SymKind(cs) == SK_ENUM) return this.LowerVariantValue(t, this.C.NValue(n) as u32, node.B);
        if (cs != 0 && this.C.NeedsInst(cs)) return this.LowerInstCall(n, node, t);
        if (cs == 0 && this.C.TyKind(this.LNType(node.A)) == TYK_FN) return this.LowerIndirectCall(n, node, t);
        u32 s = this.C.NSym(node.A);
        if (s == 0) s = this.C.Lookup(this.C.NTok(node.A));
        Sym sym = this.C.SymAt(s);
        List<u32> args = List<u32>.New();
        u32 retTmp = 0;
        bool fromParts = sym.Kind == SK_BUILTIN && (sym.Aux2 == B_STR_FROM || sym.Aux2 == B_SLICE_FROM || sym.Aux2 == B_SLICE_FROM_MUT);
        bool direct = fromParts || (sym.Kind == SK_BUILTIN && (sym.Aux2 == B_SYSCALL || sym.Aux2 == B_WINCALL || sym.Aux2 == B_WINCALLP || sym.Aux2 == B_HOSTCALL));
        if (this.IsAggregate(t) && !direct) {
            u32 et = this.LType(t);
            retTmp = this.Slot(et);
            args.Push(retTmp);
        }
        u32 a = node.B;
        u32 i = 0;
        u32 p = 0;
        if (sym.Kind == SK_FN) p = this.C.FirstParam(s);
        while (a != 0) {
            u32 at = this.C.ParamType(s, i);
            bool byref = p != 0 && this.C.NodeAt(p).Flags & (NF_IN | NF_REF) != 0;
            u32 v = this.LowerArg(a, at, byref);
            args.Push(v);
            i++;
            a = this.C.NNext(a);
            if (p != 0) p = this.C.NNext(p);
        }
        u32 f = 0;
        if (sym.Kind == SK_BUILTIN) {
            if (fromParts) {
                u32 st = this.StrType;
                u32 tmp = this.Slot(st);
                this.Store(ET_PTR, args.Get(0), this.Field(st, tmp, 0));
                this.Store(ET_U64, args.Get(1), this.Field(st, tmp, 1));
                return tmp;
            }
            if (sym.Aux2 == B_SYSCALL || sym.Aux2 == B_WINCALL || sym.Aux2 == B_WINCALLP || sym.Aux2 == B_HOSTCALL) {
                EInst inst = NoInst(54);
                inst.Block = this.Block;
                inst.Str = TextOf("syscall");
                if (sym.Aux2 == B_WINCALL) inst.Str = TextOf("wincall");
                if (sym.Aux2 == B_WINCALLP) inst.Str = TextOf("wincallp");
                if (sym.Aux2 == B_HOSTCALL) inst.Str = TextOf("hostcall");
                inst.FirstOp = this.M.Ops.Len() as u32;
                foreach (var v in args.AsSlice()) this.M.Ops.Push(OpV(v));
                inst.NOps = args.Len() as u32;
                u32 id = this.M.Insts.Len() as u32;
                inst.Result = NewValue(ref this.M, ET_I64, this.Block, id);
                this.M.Insts.Push(inst);
                return inst.Result;
            }
            f = this.RuntimeFunc(TextStr(sym.Name));
        } else {
            f = this.FuncIds.Get(s as usize);
        }
        return this.EmitCall(f, args, retTmp);
    }

    // An argument of parameter type at: a borrowed (`in`, `ref`) one is passed by address;
    // an aggregate by a pointer to a copy the callee owns; a scalar by value.
    u32 LowerArg(ref this, u32 a, u32 at, bool byref) {
        if (byref) return this.LowerAddress(a, at);
        u32 v = this.LowerExpr(a);
        if (this.IsAggregate(at)) {
            // the callee owns a copy
            u32 et = this.LType(at);
            u32 copy = this.Slot(et);
            this.CopyBytes(copy, v, this.ESizeOf(et) as u64);
            v = copy;
        }
        return v;
    }

    // The address of expression a of type t: a place's own, or a temporary's.
    u32 LowerAddress(ref this, u32 a, u32 t) {
        if (this.IsAggregate(t)) return this.LowerExpr(a);     // already an address
        if (this.C.IsAddressable(a)) return this.LowerPlace(a);
        u32 et = this.LType(t);
        u32 tmp = this.Slot(et);
        u32 v = this.LowerExpr(a);
        this.Store(et, v, tmp);
        return tmp;
    }

    // A call to a generic function or a method: the instance for this environment, the
    // receiver first, then the arguments.
    u32 LowerInstCall(ref this, u32 n, Node node, u32 t) {
        u32 s = 0;
        u32 env = 0;
        u32 ne = 0;
        this.C.CallTarget(n, this.Env, this.NEnv, ref s, ref env, ref ne);
        u32 inst = this.C.InstGet(s, env, ne, 0, 0);
        u32 f = this.InstFunc(inst);
        Sym sym = this.C.SymAt(s);
        List<u32> args = List<u32>.New();
        u32 retTmp = 0;
        if (this.IsAggregate(t)) {
            u32 et = this.LType(t);
            retTmp = this.Slot(et);
            args.Push(retTmp);
        }
        if (sym.Flags & SF_METHOD != 0 && sym.Flags & SF_STATIC == 0) {
            u32 obj = this.C.NodeAt(node.A).A;
            u32 ot = this.LNType(obj);
            u32 rt = this.C.Subst(sym.OwnerType, env, ne);
            bool byref = sym.Flags & (SF_RECV_IN | SF_RECV_REF) != 0;
            u32 v = 0;
            if (this.C.TyKind(ot) == TYK_PTR) {
                // through a pointer: the pointer is the receiver's address
                u32 addr = this.LowerExpr(obj);
                if (byref) v = addr;
                else v = this.LowerArgAt(addr, rt);
            } else {
                v = this.LowerArg(obj, rt, byref);
            }
            args.Push(v);
        }
        u32 a = node.B;
        u32 i = 0;
        u32 p = this.C.FirstParam(s);
        while (a != 0) {
            u32 at = this.C.Subst(this.C.ParamType(s, i), env, ne);
            bool byref = this.C.NodeAt(p).Flags & (NF_IN | NF_REF) != 0;
            u32 v = this.LowerArg(a, at, byref);
            args.Push(v);
            i++;
            a = this.C.NNext(a);
            p = this.C.NNext(p);
        }
        return this.EmitCall(f, args, retTmp);
    }

    // A by-value argument of type t read from address p.
    u32 LowerArgAt(ref this, u32 p, u32 t) {
        if (!this.IsAggregate(t)) {
            u32 et = this.LType(t);
            return this.Load(et, p);
        }
        u32 et = this.LType(t);
        u32 copy = this.Slot(et);
        this.CopyBytes(copy, p, this.ESizeOf(et) as u64);
        return copy;
    }

    // Calls EIR function f with args; returns the result value, or retTmp for an aggregate
    // result.
    u32 EmitCall(ref this, u32 f, in List<u32> args, u32 retTmp) {
        EFunc callee = this.M.Func(f);
        u32 result = 0;
        EInst inst = NoInst(OP_CALL);
        inst.Block = this.Block;
        inst.FirstOp = this.M.Ops.Len() as u32;
        EOp g = OpNone();
        g.Kind = OK_GLOBAL;
        g.Str = callee.Name;
        g.Ref = f;
        g.Int = NAME_FUNC;
        this.M.Ops.Push(g);
        foreach (var v in args.AsSlice()) this.M.Ops.Push(OpV(v));
        inst.NOps = this.M.Ops.Len() as u32 - inst.FirstOp;
        u32 id = this.M.Insts.Len() as u32;
        if (callee.Ret != ET_VOID) {
            inst.Result = NewValue(ref this.M, callee.Ret, this.Block, id);
            result = inst.Result;
        }
        this.M.Insts.Push(inst);
        if (retTmp != 0) return retTmp;
        return result;
    }

    // The EIR function of the runtime's implementation of built-in `name` (__rt_<name>).
    u32 RuntimeFunc(in this, str name) {
        string b = string.From("__rt_");
        b.Append(name);
        u64? named = this.M.Names.Get(b);
        if (named.IsNone()) panic("lower: the runtime lacks a built-in");
        return (named.Unwrap() & 0xFFFFFFFF) as u32;
    }
}
