// Lowering function types and lambdas (RFC 0003). Follows Stage 1's
// bootstrap/stage1/lower/closure.envo. A function value is $fnv = { code: ptr, env: ptr }
// ([fn.abi.2]). Code takes the hidden result pointer (for an aggregate result), then env,
// then the parameters. A lambda becomes a function of its own; its environment is a struct
// of its captures: pointers to them when it borrows ([fn.pos.1]), or copies on the heap
// otherwise (null without captures). A named function used as a value goes through a
// thunk that skips env.
namespace envoc.lower;

use envoc.util;
use envoc.syntax;
use envoc.sema;
use envoc.eir;

impl Lower {
    // A pointer to function f.
    u32 FuncAddr(ref this, u32 f) => this.AddrOf(this.M.Func(f).Name, f, NAME_FUNC);

    u32 NullPtr(ref this) {
        u32 zero = this.Const(ET_U64, 0);
        return this.Conv(40, ET_U64, ET_PTR, zero);
    }

    // A function value { code, env } in a fresh slot.
    u32 FnValue(ref this, u32 code, u32 envp) {
        u32 ft = this.FnvType;
        u32 fv = this.Slot(ft);
        this.Store(ET_PTR, code, this.Field(ft, fv, 0));
        this.Store(ET_PTR, envp, this.Field(ft, fv, 1));
        return fv;
    }

    // The EIR parameter count of code for function type fty.
    u32 FnCodeParams(in this, Type fty) {
        u32 n = fty.NArgs + 1;
        if (this.IsAggregate(fty.Elem)) n++;
        return n;
    }

    u32 FnCodeRet(ref this, Type fty) {
        if (this.IsAggregate(fty.Elem)) return ET_VOID;
        return this.LType(fty.Elem);
    }

    // A lambda expression: its function (lowered later, by DrainLambdas) and its value.
    u32 LowerLambda(ref this, u32 n) {
        Node lam = this.C.NodeAt(n);
        u64 cv = this.C.NValue(n);
        u32 first = (cv & 0xFFFFFFFF) as u32;
        u32 count = (cv >> 32) as u32;
        bool borrow = this.C.NSym(n) == 1 && lam.Flags & NF_MOVE == 0;
        Type fty = this.C.TypeAt(this.LNType(n));
        string name = string.From(TextStr(this.M.Func(this.Func).Name));
        name.Append(".lambda");
        AppendDecimal(ref name, this.LamCount as u64);
        this.LamCount++;
        string envName = string.From(name.AsStr());
        envName.Append(".env");
        Text fname = this.M.Keep(name);
        u32 np = this.FnCodeParams(fty);
        u32 nr = this.FnCodeRet(fty);
        u32 f = this.AddFunc(fname, np, nr);
        u32 envT = 0;
        if (count > 0) {
            List<u32> fields = List<u32>.New();
            for (u32 i = 0; i < count; i++) {
                u32 ft = ET_PTR;
                if (!borrow) {
                    u32 ct = this.LSubst(this.C.SymAt(this.C.Captures.Get((first + i) as usize)).Type);
                    ft = this.LType(ct);
                }
                fields.Push(ft);
            }
            Text en = this.M.Keep(envName);
            envT = this.StructOf(en, fields);
        }
        this.PendingLams.Push(n);
        this.PendingLams.Push(f);
        this.PendingLams.Push(envT);
        this.PendingLams.Push(this.Env);
        this.PendingLams.Push(this.NEnv);
        u32 envp = 0;
        if (count == 0) {
            envp = this.NullPtr();
        } else if (borrow) {
            // the captures' addresses, in a slot: the lambda does not outlive this call
            envp = this.Slot(envT);
            for (u32 i = 0; i < count; i++) {
                u32 s = this.C.Captures.Get((first + i) as usize);
                u32 at = this.Field(envT, envp, i);
                this.Store(ET_PTR, this.SymSlot(s), at);
            }
        } else {
            // copies, on the heap
            List<u32> args = List<u32>.New();
            u32 size = this.Const(ET_U64, this.ESizeOf(envT) as u64);
            args.Push(size);
            envp = this.EmitCall(this.RuntimeFunc("alloc"), args, 0);
            for (u32 i = 0; i < count; i++) {
                u32 s = this.C.Captures.Get((first + i) as usize);
                u32 ct = this.LSubst(this.C.SymAt(s).Type);
                u32 v = this.LoadPlace(ct, this.SymSlot(s));
                u32 at = this.Field(envT, envp, i);
                this.StoreTo(ct, v, at);
            }
        }
        u32 code = this.FuncAddr(f);
        return this.FnValue(code, envp);
    }

    // Lowers the functions of the lambdas met so far (and of lambdas inside them).
    void DrainLambdas(ref this) {
        usize i = 0;
        while (i < this.PendingLams.Len()) {
            u32 n = this.PendingLams.Get(i);
            u32 f = this.PendingLams.Get(i + 1);
            u32 envT = this.PendingLams.Get(i + 2);
            u32 env = this.PendingLams.Get(i + 3);
            u32 ne = this.PendingLams.Get(i + 4);
            this.LowerLambdaFunc(n, f, envT, env, ne);
            i += 5;
        }
        while (this.PendingLams.Len() > 0) this.PendingLams.Pop();
    }

    void LowerLambdaFunc(ref this, u32 n, u32 f, u32 envT, u32 env, u32 ne) {
        Node lam = this.C.NodeAt(n);
        this.Env = env;
        this.NEnv = ne;
        EFunc ef = this.M.Func(f);
        this.BeginFunc(f, ef.NParams);
        List<u32> stores = List<u32>.New();
        u32 first = this.M.Func(f).FirstValue;
        Type fty = this.C.TypeAt(this.LNType(n));
        u32 k = 0;
        this.ResetDropFlags();
        this.Top = false;
        this.RetType = fty.Elem;
        this.RetSlot = 0;
        if (this.IsAggregate(fty.Elem)) {
            this.SetValType(first, ET_PTR);
            this.RetSlot = first;
            k = 1;
        }
        this.SetValType(first + k, ET_PTR);
        // the captures live in the environment
        u32 envv = first + k;
        k++;
        u64 cv = this.C.NValue(n);
        u32 cf = (cv & 0xFFFFFFFF) as u32;
        u32 count = (cv >> 32) as u32;
        bool borrow = this.C.NSym(n) == 1 && lam.Flags & NF_MOVE == 0;
        for (u32 i = 0; i < count; i++) {
            u32 addr = this.Field(envT, envv, i);
            if (borrow) addr = this.Load(ET_PTR, addr);
            this.SetSymSlot(this.C.Captures.Get((cf + i) as usize), addr);
        }
        u32 p = lam.A;
        for (u32 i = 0; i < fty.NArgs; i++) {
            bool byref = this.C.EnvGet(fty.Sym, i) != 0;
            u32 pt = this.C.EnvGet(fty.Args, i);
            u32 ps = this.ParamSym(p);
            this.LowerParam(ps, pt, byref, first + k, ref stores);
            if (!byref) this.TrackDrop(ps, pt, true, this.C.NTok(p));
            k++;
            p = this.C.NNext(p);
        }
        if (this.C.NKind(lam.B) == NK_BLOCK) {
            this.LowerStmt(lam.B);
        } else if (fty.Elem == T_VOID) {
            this.LowerExpr(lam.B);
            this.DropTemps();
        } else {
            this.LowerReturnValue(lam.B);
        }
        this.DropDownTo(0, false);
        this.EndFunc(stores);
        this.Env = 0;
        this.NEnv = 0;
    }

    // A named function as a value: { its thunk, null }.
    u32 FnItemValue(ref this, u32 s) {
        string key = Decimal(s as u64);
        u32? found = this.Thunks.Get(key);
        u32 t = 0;
        if (found.IsSome()) {
            t = found.Unwrap();
        } else {
            Sym sym = this.C.SymAt(s);
            string name = string.From(TextStr(sym.Name));
            name.Append(".fv");
            u32 n = sym.Aux + 1;
            u32 ret = this.LType(sym.Type);
            if (this.IsAggregate(sym.Type)) {
                n++;
                ret = ET_VOID;
            }
            Text kept = this.M.Keep(name);
            t = this.AddFunc(kept, n, ret);
            this.Thunks.Put(key, t);
            this.PendingThunks.Push(s);
            this.PendingThunks.Push(t);
        }
        u32 code = this.FuncAddr(t);
        u32 envp = this.NullPtr();
        return this.FnValue(code, envp);
    }

    // The thunks' bodies: call the function with every argument but env. Lowered last,
    // when every function's parameter types are known.
    void DrainThunks(ref this) {
        usize count = this.PendingThunks.Len();
        for (usize i = 0; i < count; i += 2) {
            u32 s = this.PendingThunks.Get(i);
            u32 t = this.PendingThunks.Get(i + 1);
            u32 callee = this.FuncIds.Get(s as usize);
            EFunc ce = this.M.Func(callee);
            this.BeginFunc(t, ce.NParams + 1);
            u32 tf = this.M.Func(t).FirstValue;
            // env sits after the hidden result pointer, if there is one
            u32 envAt = 0;
            if (this.IsAggregate(this.C.SymAt(s).Type)) envAt = 1;
            List<u32> args = List<u32>.New();
            u32 j = 0;
            for (u32 k = 0; k < ce.NParams + 1; k++) {
                if (k == envAt) {
                    this.SetValType(tf + k, ET_PTR);
                    continue;
                }
                this.SetValType(tf + k, this.M.Val(ce.FirstValue + j).Type);
                args.Push(tf + k);
                j++;
            }
            this.Top = false;
            u32 r = this.EmitCall(callee, args, 0);
            if (ce.Ret == ET_VOID) this.Ret();
            else this.RetValue(r);
            List<u32> none = List<u32>.New();
            this.EndFunc(none);
        }
    }

    // A call through a function value: code(ret?, env, args…) with `call.ind`.
    u32 LowerIndirectCall(ref this, u32 n, Node node, u32 t) {
        u32 ft = this.FnvType;
        u32 fv = this.LowerExpr(node.A);
        Type fty = this.C.TypeAt(this.LNType(node.A));
        u32 code = this.Load(ET_PTR, this.Field(ft, fv, 0));
        u32 envp = this.Load(ET_PTR, this.Field(ft, fv, 1));
        List<u32> args = List<u32>.New();
        u32 retTmp = 0;
        u32 rt = this.LType(t);
        if (this.IsAggregate(t)) {
            retTmp = this.Slot(rt);
            args.Push(retTmp);
            rt = ET_VOID;
        }
        args.Push(envp);
        u32 a = node.B;
        for (u32 i = 0; i < fty.NArgs; i++) {
            u32 at = this.C.EnvGet(fty.Args, i);
            bool byref = this.C.EnvGet(fty.Sym, i) != 0;
            u32 v = this.LowerArg(a, at, byref);
            args.Push(v);
            a = this.C.NNext(a);
        }
        u32 result = 0;
        EInst inst = NoInst(53);
        inst.Ty = rt;
        inst.Block = this.Block;
        inst.FirstOp = this.M.Ops.Len() as u32;
        foreach (var v in args.AsSlice()) this.M.Ops.Push(OpV(v));
        this.M.Ops.Push(OpV(code));
        inst.NOps = this.M.Ops.Len() as u32 - inst.FirstOp;
        u32 id = this.M.Insts.Len() as u32;
        if (rt != ET_VOID) {
            inst.Result = NewValue(ref this.M, rt, this.Block, id);
            result = inst.Result;
        }
        this.M.Insts.Push(inst);
        if (retTmp != 0) return retTmp;
        return result;
    }
}
