// The EIR text reader (eir.md section 3). Follows Stage 1's bootstrap/stage1/eir/read.envol.
// Newlines are whitespace: every instruction's shape fixes its operands, so lines need
// not be tracked. `;` starts a comment.
namespace envoc.eir;

use envoc.util;
use envoc.diag;

const u8 XT_EOF = 0;
const u8 XT_WORD = 1;       // keywords, opcodes, primitive types: [A-Za-z_][A-Za-z0-9_.]*
const u8 XT_VALUE = 2;      // %name
const u8 XT_GLOBAL = 3;     // @name
const u8 XT_BLOCK = 4;      // ^name
const u8 XT_TYPE = 5;       // $Name
const u8 XT_INT = 6;        // -?digits, 0x…, 0f… (float bits)
const u8 XT_STRING = 7;     // "…"
const u8 XT_PUNCT = 8;      // : , ( ) [ ] { } = ->

struct XTok {
    u8 Kind;
    u32 Start;
    u32 Len;
}

bool XIsLetter(u8 c) => (c | 0x20) >= 'a' && (c | 0x20) <= 'z';
bool XIsIdentCont(u8 c) => c == '_' || (c >= '0' && c <= '9') || XIsLetter(c);
bool XIsNameChar(u8 c) => XIsIdentCont(c) || c == '.';

u64 XDigit(u8 c) {
    if (c >= '0' && c <= '9') return (c - '0') as u64;
    if (XIsLetter(c)) return ((c | 0x20) - 'a') as u64 + 10;
    return 99;
}

EOp NoOp(u8 kind, u32 pos) => new EOp { Kind = kind, Ref = 0, Int = 0, Str = TextOf(""), Args = 0, NArgs = 0, Pos = pos };

struct Reader {
    Text Path;
    Text Src;
    List<XTok> Toks;
    usize Pos;
    StrMap<u32> Values;     // per function: value name -> id
    StrMap<u32> Blocks;     // per function: block name -> id
    u32 Func;
    u32 Block;

    // ------------------------------------------------------------------ tokens

    void Fail(in this, usize off, u32 code, str msg) {
        FailAt(TextStr(this.Path), TextStr(this.Src), off, code, msg);
    }

    void Tokenize(ref this) {
        str s = TextStr(this.Src);
        usize i = 0;
        while (true) {
            while (i < s.Len) {
                u8 c = s[i];
                if (c == ' ' || c == 9 || c == 10 || c == 13) {
                    i++;
                } else if (c == ';') {
                    while (i < s.Len && s[i] != 10) i++;
                } else {
                    break;
                }
            }
            XTok t = new XTok { Kind = XT_EOF, Start = i as u32, Len = 0 };
            if (i >= s.Len) {
                this.Toks.Push(t);
                return;
            }
            u8 c = s[i];
            usize j = i + 1;
            if (XIsLetter(c) || c == '_') {
                t.Kind = XT_WORD;
                while (j < s.Len && XIsNameChar(s[j])) j++;
            } else if (c == '%' || c == '@' || c == '^' || c == '$') {
                if (c == '%') t.Kind = XT_VALUE;
                if (c == '@') t.Kind = XT_GLOBAL;
                if (c == '^') t.Kind = XT_BLOCK;
                if (c == '$') t.Kind = XT_TYPE;
                while (j < s.Len && XIsNameChar(s[j])) j++;
                if (j == i + 1) this.Fail(i, 601, "EIR syntax: expected a name after the sigil");
            } else if ((c >= '0' && c <= '9') || (c == '-' && i + 1 < s.Len && s[i + 1] >= '0' && s[i + 1] <= '9')) {
                t.Kind = XT_INT;
                while (j < s.Len && XIsIdentCont(s[j])) j++;
            } else if (c == '"') {
                t.Kind = XT_STRING;
                while (j < s.Len && s[j] != '"') {
                    if (s[j] == 0x5C) j++;
                    if (s[j] == 10) this.Fail(i, 601, "EIR syntax: unterminated string");
                    j++;
                }
                if (j >= s.Len) this.Fail(i, 601, "EIR syntax: unterminated string");
                j++;
            } else if (c == '-' && i + 1 < s.Len && s[i + 1] == '>') {
                t.Kind = XT_PUNCT;
                j = i + 2;
            } else if (c == ':' || c == ',' || c == '(' || c == ')' || c == '[' || c == ']' || c == '{' ||
                c == '}' || c == '=') {
                t.Kind = XT_PUNCT;
            } else {
                this.Fail(i, 601, "EIR syntax: unexpected character");
            }
            t.Len = (j - i) as u32;
            this.Toks.Push(t);
            i = j;
        }
    }

    XTok Cur(in this) => this.Toks.Get(this.Pos);

    XTok At(in this, usize k) {
        usize i = this.Pos + k;
        if (i >= this.Toks.Len()) i = this.Toks.Len() - 1;
        return this.Toks.Get(i);
    }

    Text TokText(in this, XTok t) {
        unsafe { return new Text { Ptr = &this.Src.Ptr[t.Start as usize], Len = t.Len as usize }; }
    }

    str Word(in this, XTok t) => TextStr(this.TokText(t));

    // The name after a sigil.
    Text Name(in this, XTok t) {
        unsafe { return new Text { Ptr = &this.Src.Ptr[(t.Start + 1) as usize], Len = (t.Len - 1) as usize }; }
    }

    XTok Next(ref this) {
        XTok t = this.Cur();
        if (t.Kind != XT_EOF) this.Pos++;
        return t;
    }

    usize Off(in this) => this.Cur().Start as usize;

    void Expected(in this, str what) {
        XTok t = this.Cur();
        string b = string.From("EIR syntax: expected ");
        b.Append(what);
        b.Append(", found ");
        if (t.Kind == XT_EOF) b.Append("end of file");
        else {
            b.AppendByte('`');
            b.Append(this.Word(t));
            b.AppendByte('`');
        }
        this.Fail(t.Start as usize, 601, b);
    }

    bool IsPunct(in this, str p) {
        XTok t = this.Cur();
        return t.Kind == XT_PUNCT && Same(this.Word(t), p);
    }

    bool IsWord(in this, str w) {
        XTok t = this.Cur();
        return t.Kind == XT_WORD && Same(this.Word(t), w);
    }

    void Punct(ref this, str p) {
        if (!this.IsPunct(p)) {
            string b = string.From("`");
            b.Append(p);
            b.AppendByte('`');
            this.Expected(b);
        }
        this.Next();
    }

    bool AcceptPunct(ref this, str p) {
        if (!this.IsPunct(p)) return false;
        this.Next();
        return true;
    }

    void ExpectWord(ref this, str w) {
        if (!this.IsWord(w)) {
            string b = string.From("`");
            b.Append(w);
            b.AppendByte('`');
            this.Expected(b);
        }
        this.Next();
    }

    // An integer token: decimal (optionally negative) or 0x hex, as a 64-bit pattern;
    // 0f… is a float bit pattern in hex.
    u64 Int(ref this) {
        XTok t = this.Cur();
        if (t.Kind != XT_INT) this.Expected("an integer");
        this.Next();
        str s = this.Word(t);
        bool negative = false;
        usize i = 0;
        if (s[0] == '-') {
            negative = true;
            i = 1;
        }
        u64 radix = 10;
        if (s.Len >= i + 2 && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'f')) {
            radix = 16;
            i += 2;
        }
        u64 v = 0;
        if (i >= s.Len) this.Fail(t.Start as usize, 601, "EIR syntax: malformed integer");
        while (i < s.Len) {
            u64 d = XDigit(s[i]);
            if (d >= radix || v > (18446744073709551615 - d) / radix) this.Fail(t.Start as usize, 601, "EIR syntax: malformed integer");
            v = v * radix + d;
            i++;
        }
        if (negative) v = 0 -% v;
        return v;
    }

    // A string token's bytes, with the escapes of chapter 1 (\n \r \t \0 \\ \" \' \xHH).
    string Str(ref this) {
        XTok t = this.Cur();
        if (t.Kind != XT_STRING) this.Expected("a string");
        this.Next();
        str s = this.Word(t);
        string b = string.New();
        usize i = 1;
        while (i + 1 < s.Len) {
            u8 c = s[i];
            if (c == 0x5C) {
                u8 e = s[i + 1];
                i += 2;
                if (e == 'n') b.AppendByte(10);
                else if (e == 'r') b.AppendByte(13);
                else if (e == 't') b.AppendByte(9);
                else if (e == '0') b.AppendByte(0);
                else if (e == 'x') {
                    if (i + 1 >= s.Len) this.Fail(t.Start as usize, 601, "EIR syntax: malformed escape");
                    b.AppendByte((XDigit(s[i]) * 16 + XDigit(s[i + 1])) as u8);
                    i += 2;
                } else b.AppendByte(e);
            } else {
                b.AppendByte(c);
                i++;
            }
        }
        return b;
    }

    // ------------------------------------------------------------------ types

    u32 Type(ref this, ref Module m) {
        XTok t = this.Cur();
        if (t.Kind == XT_TYPE) {
            this.Next();
            return m.StructType(this.Name(t));
        }
        if (this.AcceptPunct("[")) {
            u64 n = this.Int();
            this.ExpectWord("x");
            u32 elem = this.Type(ref m);
            this.Punct("]");
            return m.ArrayType(elem, n as u32);
        }
        if (t.Kind == XT_WORD) {
            str w = this.Word(t);
            for (u32 k = ET_VOID; k <= ET_PTR; k++) {
                if (TextIs(m.Ty(k).Name, w)) {
                    this.Next();
                    return k;
                }
            }
        }
        this.Expected("a type");
        return 0;
    }

    // ------------------------------------------------------------------ module

    void ReadModule(ref this, ref Module m) {
        this.ExpectWord("eir");
        usize vpos = this.Off();
        u64 version = this.Int();
        if (version != 1) {
            string b = string.From("unsupported EIR version ");
            AppendDecimal(ref b, version);
            b.Append(" (this reader knows version 1)");
            this.Fail(vpos, 602, b);
        }
        this.ExpectWord("target");
        string target = this.Str();
        m.Target = m.Keep(target);
        while (this.Cur().Kind != XT_EOF) {
            if (this.IsWord("type")) this.ReadTypeDecl(ref m);
            else if (this.IsWord("global")) this.ReadGlobal(ref m);
            else if (this.IsWord("func") || this.IsWord("extern")) this.ReadFunc(ref m);
            else this.Expected("`type`, `global`, `func` or `extern`");
        }
    }

    void ReadTypeDecl(ref this, ref Module m) {
        this.Next();
        XTok nameTok = this.Cur();
        if (nameTok.Kind != XT_TYPE) this.Expected("a struct name");
        this.Next();
        u32 t = m.StructType(this.Name(nameTok));
        if (m.Ty(t).Defined) this.Fail(nameTok.Start as usize, 604, "type defined twice");
        this.Punct("=");
        bool packed = false;
        if (this.IsWord("packed")) {
            this.Next();
            packed = true;
        }
        this.Punct("{");
        List<u32> fields = List<u32>.New();
        while (!this.IsPunct("}")) {
            u32 ft = this.Type(ref m);
            fields.Push(ft);
            if (!this.AcceptPunct(",")) break;
        }
        this.Punct("}");
        u32 first = m.Fields.Len() as u32;
        foreach (var f in fields.AsSlice()) m.Fields.Push(f);
        ETy ty = m.Ty(t);
        ty.Fields = first;
        ty.NFields = fields.Len() as u32;
        ty.Packed = packed;
        ty.Defined = true;
        m.Types.Set(t as usize, ty);
    }

    void DefineName(in this, ref Module m, Text name, u64 kind, u32 index, usize pos) {
        if (m.Names.Has(TextStr(name))) this.Fail(pos, 604, "name defined twice");
        m.Names.Put(TextStr(name), (kind << 32) | index as u64);
    }

    void ReadGlobal(ref this, ref Module m) {
        this.Next();
        XTok nameTok = this.Cur();
        if (nameTok.Kind != XT_GLOBAL) this.Expected("a global name");
        this.Next();
        this.Punct(":");
        u32 t = this.Type(ref m);
        bool ro = false;
        if (this.IsWord("readonly")) {
            this.Next();
            ro = true;
        }
        this.Punct("=");
        u32 init = this.ReadInit(ref m);
        u32 g = m.Globals.Len() as u32;
        Text name = this.Name(nameTok);
        m.Globals.Push(new EGlobal { Name = name, Type = t, ReadOnly = ro, Init = init, Pos = nameTok.Start });
        this.DefineName(ref m, name, NAME_GLOBAL, g, nameTok.Start as usize);
    }

    u32 ReadInit(ref this, ref Module m) {
        EInit init = new EInit { Kind = 0, Int = 0, Bytes = TextOf(""), First = 0, Next = 0 };
        if (this.IsWord("zero")) {
            this.Next();
            init.Kind = EI_ZERO;
        } else if (this.IsWord("bytes")) {
            this.Next();
            init.Kind = EI_BYTES;
            string bytes = this.Str();
            init.Bytes = m.Keep(bytes);
        } else if (this.Cur().Kind == XT_INT) {
            init.Kind = EI_INT;
            init.Int = this.Int();
        } else if (this.Cur().Kind == XT_GLOBAL) {
            init.Kind = EI_ADDR;
            XTok g = this.Next();
            init.Bytes = this.Name(g);
        } else if (this.AcceptPunct("{")) {
            init.Kind = EI_LIST;
            u32 prev = 0;
            while (!this.IsPunct("}")) {
                u32 e = this.ReadInit(ref m);
                if (prev == 0) {
                    init.First = e;
                } else {
                    EInit pi = m.Init(prev);
                    pi.Next = e;
                    m.Inits.Set(prev as usize, pi);
                }
                prev = e;
                if (!this.AcceptPunct(",")) break;
            }
            this.Punct("}");
        } else {
            this.Expected("an initializer");
        }
        u32 i = m.Inits.Len() as u32;
        m.Inits.Push(init);
        return i;
    }

    // ------------------------------------------------------------------ functions

    // The value named by the current %token, created on first use (a forward reference).
    u32 ValueRef(ref this, ref Module m) {
        XTok t = this.Cur();
        if (t.Kind != XT_VALUE) this.Expected("a value");
        this.Next();
        str name = TextStr(this.Name(t));
        u32? found = this.Values.Get(name);
        if (found.IsSome()) return found.Unwrap();
        u32 id = NewValue(ref m, 0, 0, 0);
        EVal fresh = m.Val(id);
        fresh.Pos = t.Start;        // in case it is never defined
        m.Vals.Set(id as usize, fresh);
        this.Values.Put(name, id);
        return id;
    }

    // Defines value %name (a parameter or a result) with type t in block b.
    u32 DefineValue(ref this, ref Module m, XTok t, u32 type, u32 b, u32 inst) {
        str name = TextStr(this.Name(t));
        u32? found = this.Values.Get(name);
        if (found.IsSome()) {
            u32 v = found.Unwrap();
            EVal old = m.Val(v);
            if (old.Block != 0) this.Fail(t.Start as usize, 604, "value defined twice");
            old.Type = type;
            old.Block = b;
            old.Inst = inst;
            m.Vals.Set(v as usize, old);
            return v;
        }
        u32 v = NewValue(ref m, type, b, inst);
        EVal val = m.Val(v);
        val.Pos = t.Start;
        m.Vals.Set(v as usize, val);
        this.Values.Put(name, v);
        return v;
    }

    // The block named by the current ^token (blocks are known from the pre-scan).
    u32 BlockRef(ref this) {
        XTok t = this.Cur();
        if (t.Kind != XT_BLOCK) this.Expected("a block");
        this.Next();
        u32? b = this.Blocks.Get(TextStr(this.Name(t)));
        if (b.IsNone()) this.Fail(t.Start as usize, 603, "unknown block");
        return b.Unwrap();
    }

    void ReadFunc(ref this, ref Module m) {
        bool ext = this.IsWord("extern");
        this.Next();
        XTok nameTok = this.Cur();
        if (nameTok.Kind != XT_GLOBAL) this.Expected("a function name");
        this.Next();
        u32 f = m.Funcs.Len() as u32;
        Text none = TextOf("");
        m.Funcs.Push(new EFunc { Name = none, Extern = false, Abi = none, Ret = 0, NParams = 0, FirstBlock = 0, NBlocks = 0, FirstValue = 0, NValues = 0, Pos = 0, Deref = 0 });
        this.Func = f;
        this.Values = StrMap<u32>.New();
        this.Blocks = StrMap<u32>.New();
        this.DefineName(ref m, this.Name(nameTok), NAME_FUNC, f, nameTok.Start as usize);
        u32 firstValue = m.Vals.Len() as u32;
        u32 firstBlock = m.Blocks.Len() as u32;
        // The entry block exists for definitions (its parameters are the function's).
        if (!ext) m.Blocks.Push(new EBlock { Func = f, FirstParam = 0, NParams = 0, FirstInst = 0, NInsts = 0, Pos = 0 });
        u32 entry = 0;
        if (!ext) entry = firstBlock;
        this.Punct("(");
        u32 nparams = 0;
        while (!this.IsPunct(")")) {
            XTok pt = this.Cur();
            if (pt.Kind != XT_VALUE) this.Expected("a parameter");
            this.Next();
            this.Punct(":");
            u32 type = this.Type(ref m);
            this.DefineValue(ref m, pt, type, entry, 0);
            nparams++;
            if (!this.AcceptPunct(",")) break;
        }
        this.Punct(")");
        this.Punct("->");
        u32 ret = this.Type(ref m);
        Text abi = TextOf("");
        if (this.IsWord("abi")) {
            this.Next();
            string a = this.Str();
            abi = m.Keep(a);
        }
        EFunc fn = m.Func(f);
        fn.Name = this.Name(nameTok);
        fn.Extern = ext;
        fn.Abi = abi;
        fn.Ret = ret;
        fn.NParams = nparams;
        fn.FirstValue = firstValue;
        fn.FirstBlock = firstBlock;
        fn.Pos = nameTok.Start;
        m.Funcs.Set(f as usize, fn);
        if (!ext) {
            if (!this.IsPunct("{")) this.Expected("`{`");
            this.PrescanBlocks(ref m, firstBlock, f);
            this.Punct("{");
            bool first = true;
            while (!this.IsPunct("}")) {
                if (this.Cur().Kind == XT_EOF) this.Expected("`}`");
                this.ReadBlock(ref m, first);
                first = false;
            }
            this.Punct("}");
            if (first) this.Fail(nameTok.Start as usize, 606, "a function needs at least one block");
        }
        EFunc done = m.Func(f);
        done.NBlocks = m.Blocks.Len() as u32 - firstBlock;
        done.NValues = m.Vals.Len() as u32 - firstValue;
        m.Funcs.Set(f as usize, done);
        // every value used must be defined
        if (!ext) {
            for (u32 v = firstValue; v < firstValue + done.NValues; v++) {
                EVal val = m.Val(v);
                if (val.Block == 0) this.Fail(val.Pos as usize, 603, "unknown value");
            }
        }
    }

    bool IsPunctTok(in this, XTok t, str p) => t.Kind == XT_PUNCT && Same(this.Word(t), p);

    // Finds the function body's block labels, `^name:` or `^name(…):`, so blocks get ids in
    // the order they are written and branches can refer forward.
    void PrescanBlocks(ref this, ref Module m, u32 firstBlock, u32 f) {
        usize save = this.Pos;
        this.Next();        // {
        usize depth = 1;
        bool first = true;
        while (depth > 0) {
            XTok t = this.Cur();
            if (t.Kind == XT_EOF) break;
            if (this.IsPunctTok(t, "{") || this.IsPunctTok(t, "[")) depth++;
            if (this.IsPunctTok(t, "}") || this.IsPunctTok(t, "]")) depth--;
            if (t.Kind == XT_BLOCK) {
                usize k = 1;
                XTok after = this.At(1);
                if (this.IsPunctTok(after, "(")) {
                    while (true) {
                        XTok a = this.At(k);
                        if (a.Kind == XT_EOF) break;
                        if (this.IsPunctTok(a, ")")) break;
                        k++;
                    }
                    k++;
                }
                XTok colon = this.At(k);
                if (this.IsPunctTok(colon, ":")) {
                    str name = TextStr(this.Name(t));
                    if (this.Blocks.Has(name)) this.Fail(t.Start as usize, 604, "block defined twice");
                    u32 b = firstBlock;
                    if (!first) {
                        b = m.Blocks.Len() as u32;
                        m.Blocks.Push(new EBlock { Func = f, FirstParam = 0, NParams = 0, FirstInst = 0, NInsts = 0, Pos = 0 });
                    }
                    first = false;
                    this.Blocks.Put(name, b);
                }
            }
            this.Next();
        }
        this.Pos = save;
    }

    // One block: label, optional parameters, instructions. Returns its id.
    u32 ReadBlock(ref this, ref Module m, bool entry) {
        XTok label = this.Cur();
        u32 b = this.BlockRef();
        this.Block = b;
        EBlock start = m.Block(b);
        start.Pos = label.Start;
        start.FirstParam = m.Vals.Len() as u32;
        m.Blocks.Set(b as usize, start);
        u32 nparams = 0;
        if (this.AcceptPunct("(")) {
            if (entry) this.Fail(label.Start as usize, 601, "EIR syntax: the entry block's parameters are the function's");
            while (!this.IsPunct(")")) {
                XTok pt = this.Cur();
                if (pt.Kind != XT_VALUE) this.Expected("a parameter");
                this.Next();
                this.Punct(":");
                u32 type = this.Type(ref m);
                u32 v = this.DefineValue(ref m, pt, type, b, 0);
                // block parameters must be the block's consecutive values
                if (v != m.Block(b).FirstParam + nparams) this.Fail(pt.Start as usize, 604, "block parameter already used as a value elsewhere");
                nparams++;
                if (!this.AcceptPunct(",")) break;
            }
            this.Punct(")");
        }
        this.Punct(":");
        EBlock blk = m.Block(b);
        blk.NParams = nparams;
        // the entry block has no parameters of its own: the function's come first among
        // its values, as lowering and the binary form have them
        if (entry) {
            blk.FirstParam = 0;
            blk.NParams = 0;
        }
        blk.FirstInst = m.Insts.Len() as u32;
        m.Blocks.Set(b as usize, blk);
        while (true) {
            XTok t = this.Cur();
            if (t.Kind == XT_EOF) break;
            if (this.IsPunctTok(t, "}")) break;
            if (t.Kind == XT_BLOCK) break;
            this.ReadInst(ref m);
        }
        EBlock done = m.Block(b);
        done.NInsts = m.Insts.Len() as u32 - done.FirstInst;
        m.Blocks.Set(b as usize, done);
        return b;
    }

    void OpValue(ref this, ref Module m) {
        EOp op = NoOp(OK_VALUE, this.Cur().Start);
        op.Ref = this.ValueRef(ref m);
        m.Ops.Push(op);
    }

    // A value or an integer constant (the size operand of copy and zero).
    void OpValueOrInt(ref this, ref Module m) {
        if (this.Cur().Kind == XT_INT) {
            EOp op = NoOp(OK_INT, this.Cur().Start);
            op.Int = this.Int();
            m.Ops.Push(op);
            return;
        }
        this.OpValue(ref m);
    }

    // ^block or ^block(args)
    void OpTarget(ref this, ref Module m) {
        EOp op = NoOp(OK_TARGET, this.Cur().Start);
        op.Ref = this.BlockRef();
        List<u32> args = List<u32>.New();
        if (this.AcceptPunct("(")) {
            while (!this.IsPunct(")")) {
                u32 v = this.ValueRef(ref m);
                args.Push(v);
                if (!this.AcceptPunct(",")) break;
            }
            this.Punct(")");
        }
        op.Args = m.Args.Len() as u32;
        op.NArgs = args.Len() as u32;
        foreach (var a in args.AsSlice()) m.Args.Push(a);
        m.Ops.Push(op);
    }

    // '(' value ( ',' value )* ')'
    void OpArgList(ref this, ref Module m) {
        this.Punct("(");
        while (!this.IsPunct(")")) {
            this.OpValue(ref m);
            if (!this.AcceptPunct(",")) break;
        }
        this.Punct(")");
    }

    void OpGlobal(ref this, ref Module m, str what) {
        EOp g = NoOp(OK_GLOBAL, this.Cur().Start);
        if (this.Cur().Kind != XT_GLOBAL) this.Expected(what);
        XTok t = this.Next();
        g.Str = this.Name(t);
        m.Ops.Push(g);
    }

    void ReadInst(ref this, ref Module m) {
        XTok resultTok = new XTok { Kind = XT_EOF, Start = 0, Len = 0 };
        bool hasResult = false;
        if (this.Cur().Kind == XT_VALUE) {
            resultTok = this.Next();
            hasResult = true;
            this.Punct("=");
        }
        XTok opTok = this.Cur();
        if (opTok.Kind != XT_WORD) this.Expected("an instruction");
        this.Next();
        u16 op = OpByName(this.Word(opTok));
        if (op == 0) this.Fail(opTok.Start as usize, 614, "unknown instruction");
        OpInfo info = OpTable(op);
        EInst inst = new EInst {
            Op = op, Ty = 0, Ty2 = 0, Result = 0, FirstOp = m.Ops.Len() as u32, NOps = 0,
            Block = this.Block, Imm = 0, Str = TextOf(""), Pos = opTok.Start, Src = 0
        };
        u32 resultType = 0;
        u8 sh = info.Shape;
        if (sh == SH_CONST) {
            inst.Ty = this.Type(ref m);
            inst.Imm = this.Int();
            resultType = inst.Ty;
        } else if (sh == SH_ADDR) {
            this.OpGlobal(ref m, "a global");
            resultType = ET_PTR;
        } else if (sh == SH_SLOT) {
            inst.Ty = this.Type(ref m);
            resultType = ET_PTR;
        } else if (sh == SH_UNARY_V) {
            this.OpValue(ref m);
        } else if (sh == SH_BIN || sh == SH_CMP) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            this.Punct(",");
            this.OpValue(ref m);
            resultType = inst.Ty;
            if (sh == SH_CMP) resultType = ET_BOOL;
        } else if (sh == SH_UN) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            resultType = inst.Ty;
        } else if (sh == SH_SELECT) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            this.Punct(",");
            this.OpValue(ref m);
            this.Punct(",");
            this.OpValue(ref m);
            resultType = inst.Ty;
        } else if (sh == SH_CONV) {
            inst.Ty = this.Type(ref m);
            this.Punct("->");
            inst.Ty2 = this.Type(ref m);
            this.OpValue(ref m);
            resultType = inst.Ty2;
        } else if (sh == SH_LOAD) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            resultType = inst.Ty;
        } else if (sh == SH_STORE) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            this.Punct(",");
            this.OpValue(ref m);
        } else if (sh == SH_FIELD) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            this.Punct(",");
            inst.Imm = this.Int();
            resultType = ET_PTR;
        } else if (sh == SH_ELEM) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            this.Punct(",");
            this.OpValue(ref m);
            resultType = ET_PTR;
        } else if (sh == SH_PTRADD) {
            this.OpValue(ref m);
            this.Punct(",");
            this.OpValue(ref m);
            resultType = ET_PTR;
        } else if (sh == SH_VALUES) {
            for (u8 i = 0; i < info.Operands; i++) {
                if (i > 0) this.Punct(",");
                if (i == info.Operands - 1 && (op == 47 || op == 48)) this.OpValueOrInt(ref m);
                else this.OpValue(ref m);
            }
        } else if (sh == SH_BOUNDS) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            this.Punct(",");
            this.OpValue(ref m);
        } else if (sh == SH_CALL) {
            this.OpGlobal(ref m, "a function");
            this.OpArgList(ref m);
            // the result type comes from the callee, resolved after the whole module is read
        } else if (sh == SH_CALLIND) {
            if (this.IsWord("abi")) {
                this.Next();
                string a = this.Str();
                inst.Str = m.Keep(a);
            }
            inst.Ty = this.Type(ref m);
            this.OpArgList(ref m);
            this.OpValue(ref m);
            resultType = inst.Ty;
        } else if (sh == SH_INTRINSIC) {
            XTok nameTok = this.Cur();
            if (nameTok.Kind != XT_WORD) this.Expected("an intrinsic name");
            this.Next();
            inst.Str = this.TokText(nameTok);
            Intrinsic x = IntrinsicNamed(TextStr(inst.Str));
            if (x.Name.Len == 0) this.Fail(nameTok.Start as usize, 614, "unknown intrinsic");
            this.OpArgList(ref m);
            resultType = x.Ret;
        } else if (sh == SH_BR) {
            this.OpTarget(ref m);
        } else if (sh == SH_CONDBR) {
            this.OpValue(ref m);
            this.Punct(",");
            this.OpTarget(ref m);
            this.Punct(",");
            this.OpTarget(ref m);
        } else if (sh == SH_SWITCH) {
            inst.Ty = this.Type(ref m);
            this.OpValue(ref m);
            this.Punct(",");
            this.Punct("[");
            while (!this.IsPunct("]")) {
                EOp k = NoOp(OK_CASE, this.Cur().Start);
                k.Int = this.Int();
                m.Ops.Push(k);
                this.Punct(":");
                this.OpTarget(ref m);
                if (!this.AcceptPunct(",")) break;
            }
            this.Punct("]");
            this.Punct(",");
            this.OpTarget(ref m);
        } else if (sh == SH_RET) {
            if (this.Cur().Kind == XT_VALUE) this.OpValue(ref m);
        } else if (sh == SH_PANIC) {
            usize pos = this.Off();
            string reason = this.Str();
            u64 i = 0;
            while (i < PANIC_COUNT && !Same(PanicReason(i), reason)) i++;
            if (i == PANIC_COUNT) this.Fail(pos, 611, "unknown panic reason");
            inst.Imm = i;
        }
        inst.NOps = m.Ops.Len() as u32 - inst.FirstOp;
        u32 id = m.Insts.Len() as u32;
        if (hasResult) {
            if (resultType == ET_VOID || (resultType == 0 && sh != SH_CALL)) this.Fail(resultTok.Start as usize, 605, "this instruction has no result");
            inst.Result = this.DefineValue(ref m, resultTok, resultType, this.Block, id);
        }
        m.Insts.Push(inst);
    }
}

// A new value of type t defined in block b (inst 0 for a parameter).
public u32 NewValue(ref Module m, u32 t, u32 b, u32 inst) {
    u32 v = m.Vals.Len() as u32;
    m.Vals.Push(new EVal { Type = t, Block = b, Inst = inst, Pos = 0 });
    return v;
}

impl Module {
    // After the whole module is read: callees and globals by name, and call result types.
    void ResolveNames(ref this) {
        str path = TextStr(this.SrcPath);
        str text = TextStr(this.SrcText);
        for (u32 i = 1; i < this.Insts.Len() as u32; i++) {
            EInst inst = this.Inst(i);
            if (inst.Op != OP_CALL && inst.Op != 2) continue;
            EOp g = this.Op(inst.FirstOp);
            u64? named = this.Names.Get(TextStr(g.Str));
            if (named.IsNone()) FailAt(path, text, g.Pos as usize, 603, "unknown global or function");
            u64 v = named.Unwrap();
            if (inst.Op == OP_CALL) {
                if (v >> 32 != NAME_FUNC) FailAt(path, text, g.Pos as usize, 610, "only a function can be called");
                u32 f = (v & 0xFFFFFFFF) as u32;
                g.Ref = f;
                this.Ops.Set(inst.FirstOp as usize, g);
                u32 ret = this.Func(f).Ret;
                if (inst.Result != 0) {
                    if (ret == ET_VOID) FailAt(path, text, inst.Pos as usize, 610, "this function returns nothing");
                    EVal rv = this.Val(inst.Result);
                    rv.Type = ret;
                    this.Vals.Set(inst.Result as usize, rv);
                }
            } else {
                g.Ref = (v & 0xFFFFFFFF) as u32;
                g.Int = v >> 32;
                this.Ops.Set(inst.FirstOp as usize, g);
            }
        }
    }
}

// Reads EIR text (from path) into m. Stops at the first error.
public void ReadEir(ref Module m, str path, str text) {
    Reader r = new Reader {
        Path = TextOf(path), Src = TextOf(text), Toks = List<XTok>.New(), Pos = 0,
        Values = StrMap<u32>.New(), Blocks = StrMap<u32>.New(), Func = 0, Block = 0
    };
    m.SrcPath = TextOf(path);
    m.SrcText = TextOf(text);
    m.FromText = true;
    r.Tokenize();
    r.ReadModule(ref m);
    m.ResolveNames();
}
