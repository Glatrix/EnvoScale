// Lowering: the checked tree to EIR. Follows Stage 1's bootstrap/stage1/lower/lower.envol, so
// `envoc eir` prints what `envoc1 eir` does. Every local lives in a slot; scalar
// expressions become values; aggregates (str, slices, arrays, structs, tagged enums,
// function values) are handled by address. Checks are EIR's checked instructions, so
// programs panic where Stage 1's do, with the same reasons.
namespace envoc.lower;

use envoc.util;
use envoc.syntax;
use envoc.sema;
use envoc.eir;

public const u32 TARGET_LINUX = 1;
public const u32 TARGET_WINDOWS = 2;
public const u32 TARGET_WASM = 3;     // wasm32-web (D48); Stage 2 only
public const u32 TARGET_A64 = 4;      // aarch64-linux (M10, D69); Stage 2 only
public const u32 TARGET_MACOS = 5;    // aarch64-macos (M10, D70); Stage 2 only

EOp OpNone() => new EOp { Kind = 0, Ref = 0, Int = 0, Str = TextOf(""), Args = 0, NArgs = 0, Pos = 0 };

EOp OpV(u32 v) {
    EOp o = OpNone();
    o.Kind = OK_VALUE;
    o.Ref = v;
    return o;
}

EOp OpTargetOf(u32 b) {
    EOp o = OpNone();
    o.Kind = OK_TARGET;
    o.Ref = b;
    return o;
}

EOp OpInt(u64 n) {
    EOp o = OpNone();
    o.Kind = OK_INT;
    o.Int = n;
    return o;
}

EInst NoInst(u16 op) => new EInst {
    Op = op, Ty = 0, Ty2 = 0, Result = 0, FirstOp = 0, NOps = 0, Block = 0, Imm = 0,
    Str = TextOf(""), Pos = 0, Src = 0
};

// The EIR float type of size bytes: f32 (EK_F32) or f64 (EK_F64) (RFC 0006).
public u32 EFloatType(u32 size) {
    if (size == 4) return EK_F32 as u32;
    return EK_F64 as u32;
}

public u32 EIntType(u32 size, bool signed) {
    if (signed) {
        if (size == 1) return 3;
        if (size == 2) return 4;
        if (size == 4) return 5;
        return 6;
    }
    if (size == 1) return 7;
    if (size == 2) return 8;
    if (size == 4) return 9;
    return 10;
}

public struct Lower {
    Checker C;
    Module M;
    u32 Func;               // EIR function being built
    u32 Block;              // current block, 0 after a terminator
    u32 Entry;              // the function's entry block (filled in last)
    u32 Body;               // the first body block
    List<u32> PendingSlots; // pairs (value, type) for the entry block
    List<u32> SymSlots;     // per checker symbol: the slot value of a local
    List<u32> NodeLocals;   // per node: the local symbol declared by a var or parameter node
    List<u32> FuncIds;      // per checker symbol: the EIR function of a fn or built-in
    List<u32> GlobalIds;    // per checker symbol: the EIR global of a static
    List<u32> TypeIds;      // per checker type: the EIR type (0 = not yet)
    StrMap<u32> Strings;    // string literal bytes -> EIR global
    List<u32> Loops;        // triples (drop mark, continue block, break block)
    u32 StrType;            // $str = { ptr, u64 }, also every slice
    u32 RetSlot;            // the hidden result pointer of a function returning an aggregate
    u32 RetType;            // the checker type the function returns
    bool Top;               // lowering __main
    u32 Target;
    u32 Env;                // the generic environment of the function being lowered
    u32 NEnv;
    // function values (lower_closure.envol)
    u32 FnvType;            // $fnv = { ptr, ptr }
    u32 LamCount;
    List<u32> PendingLams;  // quintuples: lambda node, EIR function, env struct, Env, NEnv
    List<u32> PendingThunks; // pairs: function symbol, thunk
    StrMap<u32> Thunks;     // function symbol -> thunk
    // drops (lower_drop.envol)
    List<u32> DropFlags;    // per checker symbol: a local's drop flag slot
    List<u32> Drops;        // the locals with a drop flag, in scope order
    List<u32> Temps;        // pairs (type, address): the statement's temporaries to drop
    List<u32> KeptTemps;    // pairs (type, address): temporaries a view local borrows, dropped with its block
    List<u32> FlagSyms;     // the locals given a drop flag in the current function
    List<u32> FieldFlags;   // per checker symbol: 1 + where a partly moved local's field flags start
    List<u32> FieldFlagSlots; // per field of such a local: its drop flag slot, 0 if it needs none
    u32 Src;                // the statement being lowered: (file + 1) << 20 | line (EInst.Src)

    public static Lower New(Checker c, u32 target) => new Lower {
        C = c, M = Module.New(), Func = 0, Block = 0, Entry = 0, Body = 0,
        PendingSlots = List<u32>.New(), SymSlots = List<u32>.New(), NodeLocals = List<u32>.New(),
        FuncIds = List<u32>.New(), GlobalIds = List<u32>.New(), TypeIds = List<u32>.New(),
        Strings = StrMap<u32>.New(), Loops = List<u32>.New(), StrType = 0, RetSlot = 0, RetType = 0,
        Top = false, Target = target, Env = 0, NEnv = 0, FnvType = 0, LamCount = 0,
        PendingLams = List<u32>.New(), PendingThunks = List<u32>.New(), Thunks = StrMap<u32>.New(),
        DropFlags = List<u32>.New(), Drops = List<u32>.New(), Temps = List<u32>.New(), KeptTemps = List<u32>.New(), FlagSyms = List<u32>.New(),
        FieldFlags = List<u32>.New(), FieldFlagSlots = List<u32>.New(), Src = 0
    };

    // The module, handed out once lowering is done.
    public Module TakeModule(ref this) {
        Module fresh = Module.New();
        return Replace(ref this.M, fresh);
    }

    // The type of checked node n in the function being lowered (its type arguments
    // substituted).
    u32 LNType(ref this, u32 n) {
        u32 t = this.C.NType(n);
        return this.LSubst(t);
    }

    u32 LSubst(ref this, u32 t) {
        if (this.NEnv == 0) return t;
        return this.C.Subst(t, this.Env, this.NEnv);
    }

    // ------------------------------------------------------------------ builder

    u32 NewBlock(ref this) {
        u32 b = this.M.Blocks.Len() as u32;
        u32 first = this.M.Vals.Len() as u32;
        this.M.Blocks.Push(new EBlock { Func = this.Func, FirstParam = first, NParams = 0, FirstInst = 0, NInsts = 0, Pos = 0 });
        return b;
    }

    // Starts writing block b (blocks are written one at a time, so their instructions are
    // contiguous).
    void Start(ref this, u32 b) {
        EBlock blk = this.M.Block(b);
        blk.FirstInst = this.M.Insts.Len() as u32;
        blk.FirstParam = this.M.Vals.Len() as u32;
        this.M.Blocks.Set(b as usize, blk);
        this.Block = b;
    }

    // Appends an instruction with up to three operands; returns its result (0 if
    // resultType is 0 or void).
    u32 Emit(ref this, u16 op, u32 ty, u32 ty2, u64 imm, u32 resultType, u32 nops, EOp a, EOp b, EOp c) {
        if (this.Block == 0) {
            // unreachable code after a terminator: give it a block of its own
            u32 fresh = this.NewBlock();
            this.Start(fresh);
        }
        EInst inst = NoInst(op);
        inst.Ty = ty;
        inst.Ty2 = ty2;
        inst.Imm = imm;
        inst.Block = this.Block;
        inst.Src = this.Src;
        inst.FirstOp = this.M.Ops.Len() as u32;
        inst.NOps = nops;
        if (nops > 0) this.M.Ops.Push(a);
        if (nops > 1) this.M.Ops.Push(b);
        if (nops > 2) this.M.Ops.Push(c);
        u32 id = this.M.Insts.Len() as u32;
        if (resultType != 0 && resultType != ET_VOID) inst.Result = NewValue(ref this.M, resultType, this.Block, id);
        this.M.Insts.Push(inst);
        if (OpTable(op).Term) this.Close();
        return inst.Result;
    }

    // Ends the current block after its terminator.
    void Close(ref this) {
        EBlock blk = this.M.Block(this.Block);
        blk.NInsts = this.M.Insts.Len() as u32 - blk.FirstInst;
        this.M.Blocks.Set(this.Block as usize, blk);
        this.Block = 0;
    }

    u32 Const(ref this, u32 t, u64 v) => this.Emit(OP_CONST, t, 0, v, t, 0, OpNone(), OpNone(), OpNone());

    u32 Bin(ref this, u16 op, u32 t, u32 a, u32 b) {
        u32 rt = t;
        if (op >= 20 && op <= 25) rt = ET_BOOL;
        return this.Emit(op, t, 0, 0, rt, 2, OpV(a), OpV(b), OpNone());
    }

    u32 Conv(ref this, u16 op, u32 from, u32 to, u32 v) => this.Emit(op, from, to, 0, to, 1, OpV(v), OpNone(), OpNone());

    u32 Load(ref this, u32 t, u32 p) => this.Emit(42, t, 0, 0, t, 1, OpV(p), OpNone(), OpNone());

    void Store(ref this, u32 t, u32 v, u32 p) {
        this.Emit(43, t, 0, 0, 0, 2, OpV(v), OpV(p), OpNone());
    }

    u32 Field(ref this, u32 st, u32 p, u32 k) => this.Emit(44, st, 0, k as u64, ET_PTR, 1, OpV(p), OpNone(), OpNone());

    u32 Elem(ref this, u32 et, u32 p, u32 i) => this.Emit(45, et, 0, 0, ET_PTR, 2, OpV(p), OpV(i), OpNone());

    void CopyBytes(ref this, u32 dst, u32 src, u64 n) {
        this.Emit(47, 0, 0, 0, 0, 3, OpV(dst), OpV(src), OpInt(n));
    }

    void ZeroBytes(ref this, u32 p, u64 n) {
        this.Emit(48, 0, 0, 0, 0, 2, OpV(p), OpInt(n), OpNone());
    }

    void Br(ref this, u32 b) {
        this.Emit(55, 0, 0, 0, 0, 1, OpTargetOf(b), OpNone(), OpNone());
    }

    void CondBr(ref this, u32 c, u32 t, u32 f) {
        this.Emit(56, 0, 0, 0, 0, 3, OpV(c), OpTargetOf(t), OpTargetOf(f));
    }

    void Panic(ref this, u64 reason) {
        this.Emit(59, 0, 0, reason, 0, 0, OpNone(), OpNone(), OpNone());
    }

    void Ret(ref this) {
        this.Emit(58, 0, 0, 0, 0, 0, OpNone(), OpNone(), OpNone());
    }

    void RetValue(ref this, u32 v) {
        this.Emit(58, 0, 0, 0, 0, 1, OpV(v), OpNone(), OpNone());
    }

    void Unreachable(ref this) {
        this.Emit(60, 0, 0, 0, 0, 0, OpNone(), OpNone(), OpNone());
    }

    // A slot of EIR type t, created in the entry block when the function is finished.
    u32 Slot(ref this, u32 t) {
        u32 v = NewValue(ref this.M, ET_PTR, this.Entry, 0);
        this.PendingSlots.Push(v);
        this.PendingSlots.Push(t);
        return v;
    }

    // ------------------------------------------------------------------ types

    u32 ESizeOf(ref this, u32 t) {
        this.M.Layout(t);
        return this.M.Ty(t).Size;
    }

    // The EIR type of checker type t.
    u32 LType(ref this, u32 t) {
        // substitution makes types after the table was sized
        while (this.TypeIds.Len() <= t as usize) this.TypeIds.Push(0);
        u32 known = this.TypeIds.Get(t as usize);
        if (known != 0) return known;
        Type ty = this.C.TypeAt(t);
        u32 r = 0;
        if (ty.Kind == TYK_VOID) r = ET_VOID;
        else if (ty.Kind == TYK_BOOL) r = ET_BOOL;
        else if (ty.Kind == TYK_PTR) r = ET_PTR;
        else if (ty.Kind == TYK_FN) r = this.FnvType;
        else if (ty.Kind == TYK_UNION) r = this.TaggedEType(t);
        else if (ty.Kind == TYK_STR || ty.Kind == TYK_SLICE) r = this.StrType;
        else if (ty.Kind == TYK_INT) r = EIntType(ty.Size, ty.Signed);
        else if (ty.Kind == TYK_FLOAT) r = EFloatType(ty.Size);
        else if (ty.Kind == TYK_ENUM) {
            this.C.EnumDeclare(ty.Sym);
            r = this.LType(this.C.SymAt(ty.Sym).Aux);
        } else if (ty.Kind == TYK_ARRAY) {
            u32 elem = this.LType(ty.Elem);
            r = this.M.ArrayType(elem, ty.Count);
        } else {
            // a struct: its fields in order, with C layout; named with its namespace, and a
            // generic instance after its arguments
            string b = string.New();
            this.C.AppendMangle(ref b, t);
            Text name = this.M.Keep(b);
            r = this.M.StructType(name);
            this.TypeIds.Set(t as usize, r);
            u32 f = this.C.NodeAt(this.C.SymAt(ty.Sym).Node).A;
            List<u32> fields = List<u32>.New();
            while (f != 0) {
                u32 ft = this.C.FieldType(t, f);
                fields.Push(this.LType(ft));
                f = this.C.NNext(f);
            }
            this.DefineStruct(r, fields);
        }
        this.TypeIds.Set(t as usize, r);
        return r;
    }

    // Gives struct type r the fields in list fields.
    void DefineStruct(ref this, u32 r, in List<u32> fields) {
        u32 first = this.M.Fields.Len() as u32;
        foreach (var f in fields.AsSlice()) this.M.Fields.Push(f);
        ETy et = this.M.Ty(r);
        et.Fields = first;
        et.NFields = fields.Len() as u32;
        et.Defined = true;
        this.M.Types.Set(r as usize, et);
    }

    // A defined EIR struct named name with the field types in fields.
    u32 StructOf(ref this, Text name, in List<u32> fields) {
        u32 t = this.M.StructType(name);
        this.DefineStruct(t, fields);
        return t;
    }

    // Is checker type t passed and stored by address (str, slice, array, struct, …)?
    bool IsAggregate(in this, u32 t) {
        u8 k = this.C.TyKind(t);
        return k == TYK_STR || k == TYK_SLICE || k == TYK_ARRAY || k == TYK_STRUCT || k == TYK_FN || k == TYK_UNION;
    }

    // ------------------------------------------------------------------ module

    public void LowerProgram(ref this) {
        u32 program = this.C.T.Root;
        for (usize s = 0; s < this.C.Syms.Len(); s++) {
            this.SymSlots.Push(0);
            this.FuncIds.Push(0);
            this.GlobalIds.Push(0);
        }
        for (usize n = 0; n < this.C.T.Nodes.Len(); n++) this.NodeLocals.Push(0);
        for (u32 s = 1; s < this.C.Syms.Len() as u32; s++) {
            Sym sym = this.C.SymAt(s);
            if (sym.Kind == SK_LOCAL && sym.Node != 0) this.NodeLocals.Set(sym.Node as usize, s);
        }
        for (usize t = 0; t < this.C.Types.Len() + 64; t++) this.TypeIds.Push(0);
        this.M.Target = TextOf("x86_64-linux");
        if (this.Target == TARGET_WINDOWS) this.M.Target = TextOf("x86_64-windows");
        if (this.Target == TARGET_WASM) this.M.Target = TextOf("wasm32-web");
        if (this.Target == TARGET_A64) this.M.Target = TextOf("aarch64-linux");
        if (this.Target == TARGET_MACOS) this.M.Target = TextOf("aarch64-macos");
        // $str = { ptr, u64 }
        List<u32> sf = List<u32>.New();
        sf.Push(ET_PTR);
        sf.Push(ET_U64);
        this.StrType = this.StructOf(TextOf("str"), sf);
        // $fnv = { ptr, ptr }
        List<u32> fv = List<u32>.New();
        fv.Push(ET_PTR);
        fv.Push(ET_PTR);
        this.FnvType = this.StructOf(TextOf("fnv"), fv);
        // declare every function and static first, so calls can refer forward; generic
        // functions and methods are declared once per instance
        u32 n = this.C.NodeAt(program).A;
        while (n != 0) {
            u16 k = this.C.NKind(n);
            if (k == NK_FN && !this.C.NeedsInst(this.C.NSym(n))) this.DeclareFunc(this.C.NSym(n), this.QualifiedName(this.C.NSym(n), this.C.TokName(this.C.NTok(n))));
            if (k == NK_STATIC) this.DeclareStatic(this.C.NSym(n));
            n = this.C.NNext(n);
        }
        u32 ninst = this.C.Insts.Len() as u32;
        for (u32 i = 0; i < ninst; i++) this.DeclareInst(i);
        // __main: the top-level statements
        u32 mainFn = this.AddFunc(TextOf("__main"), 0, ET_I32);
        n = this.C.NodeAt(program).A;
        while (n != 0) {
            if (this.C.NKind(n) == NK_FN && !this.C.NeedsInst(this.C.NSym(n))) this.LowerFunc(this.C.NSym(n));
            n = this.C.NNext(n);
        }
        this.LowerMain(mainFn, this.C.NodeAt(program).A);
        // instances, including those lowering itself needed (drops)
        u32 i = 0;
        while (i < this.C.Insts.Len() as u32) {
            u32 f = this.InstFunc(i);
            Inst inst = this.C.Insts.Get(i as usize);
            this.LowerFuncEnv(inst.Sym, f, inst.Env, inst.NEnv);
            i++;
        }
        this.DrainThunks();
    }

    // Keeps only one unit's code, for an object (D19): the functions declared in files
    // not in `owned` become declarations, and so does __main unless main. Instances,
    // closures and thunks stay defined in every object; the linker takes one copy.
    public void KeepUnit(ref this, in List<bool> owned, bool main) {
        u32 n = this.C.NodeAt(this.C.T.Root).A;
        while (n != 0) {
            if (this.C.NKind(n) == NK_FN && !this.C.NeedsInst(this.C.NSym(n))) {
                u32 file = this.C.TokFile(this.C.NTok(n));
                u32 f = this.FuncIds.Get(this.C.NSym(n) as usize);
                if (f != 0 && !owned.Get(file as usize)) this.Declare(f);
            }
            n = this.C.NNext(n);
        }
        if (!main) {
            u64? named = this.M.Names.Get("__main");
            if (named.IsSome()) this.Declare((named.Unwrap() & 0xFFFFFFFF) as u32);
        }
    }

    // Function f becomes a declaration: `extern` with the Envol convention.
    void Declare(ref this, u32 f) {
        EFunc e = this.M.Func(f);
        e.Extern = true;
        e.NBlocks = 0;
        e.NValues = e.NParams;
        this.M.Funcs.Set(f as usize, e);
    }

    // The EIR function of instance i, named after its type arguments.
    void DeclareInst(ref this, u32 i) {
        Inst inst = this.C.Insts.Get(i as usize);
        string name = this.C.InstName(i);
        if (this.M.Names.Has(name)) {
            // mangled names are unique by construction; this keeps them so regardless
            name.Append(".i");
            AppendDecimal(ref name, i as u64);
        }
        Sym sym = this.C.SymAt(inst.Sym);
        u32 count = sym.Aux;
        if (sym.Flags & SF_METHOD != 0 && sym.Flags & SF_STATIC == 0) count++;
        u32 rt = this.C.Subst(sym.Type, inst.Env, inst.NEnv);
        u32 ret = this.LType(rt);
        if (this.IsAggregate(rt)) {
            count++;
            ret = ET_VOID;
        }
        Text kept = this.M.Keep(name);
        u32 f = this.AddFunc(kept, count, ret);
        Inst done = this.C.Insts.Get(i as usize);
        done.Func = f;
        done.Declared = true;
        this.C.Insts.Set(i as usize, done);
    }

    // A new EIR function with nparams parameters (their values are added by the caller).
    u32 AddFunc(ref this, Text given, u32 nparams, u32 ret) {
        u32 f = this.M.Funcs.Len() as u32;
        Text name = this.M.Own(given);         // given may be the checker's, which goes first
        this.M.Funcs.Push(new EFunc {
            Name = name, Extern = false, Abi = TextOf(""), Ret = ret, NParams = nparams,
            FirstBlock = 0, NBlocks = 0, FirstValue = 0, NValues = 0, Pos = 0
        });
        this.M.Names.Put(TextStr(name), (NAME_FUNC << 32) | f as u64);
        return f;
    }

    // The EIR signature of function symbol s: scalars by value, aggregates by pointer, and
    // an aggregate result through a hidden first pointer parameter.
    // The EIR name of item s, written name: prefixed with its namespace, so items of the
    // same name in different namespaces stay apart (found in the M3 sweep).
    Text QualifiedName(ref this, u32 s, Text name) {
        Text ns = this.C.SymAt(s).Ns;
        if (ns.Len == 0) return name;
        return this.C.JoinName(ns, name);
    }

    void DeclareFunc(ref this, u32 s, Text name) {
        Sym sym = this.C.SymAt(s);
        u32 n = sym.Aux;
        u32 ret = this.LType(sym.Type);
        if (this.IsAggregate(sym.Type)) {
            n++;
            ret = ET_VOID;
        }
        u32 f = this.AddFunc(name, n, ret);
        this.FuncIds.Set(s as usize, f);
    }

    u32 PushInit(ref this, EInit init) {
        u32 i = this.M.Inits.Len() as u32;
        this.M.Inits.Push(init);
        return i;
    }

    void DeclareStatic(ref this, u32 s) {
        Sym sym = this.C.SymAt(s);
        u32 t = this.LType(sym.Type);
        EInit init = new EInit { Kind = EI_ZERO, Int = 0, Bytes = TextOf(""), First = 0, Next = 0 };
        u32 valueNode = this.C.NodeAt(sym.Node).B;
        if (valueNode != 0) {
            if (this.C.TyKind(sym.Type) == TYK_STR) {
                // a string constant: { address of its bytes, length }
                Text bytes = this.StringValue(valueNode);
                u32 g = this.StringGlobal(bytes);
                EInit addr = new EInit { Kind = EI_ADDR, Int = 0, Bytes = this.M.Global(g).Name, First = 0, Next = 0 };
                EInit len = new EInit { Kind = EI_INT, Int = bytes.Len as u64, Bytes = TextOf(""), First = 0, Next = 0 };
                u32 a = this.PushInit(addr);
                u32 b = this.PushInit(len);
                EInit ai = this.M.Init(a);
                ai.Next = b;
                this.M.Inits.Set(a as usize, ai);
                init.Kind = EI_LIST;
                init.First = a;
            } else if (this.C.IsScalarValue(sym.Type)) {
                init.Kind = EI_INT;
                init.Int = this.C.WrapValue(sym.Value, sym.Type);
                if (this.C.TyKind(sym.Type) == TYK_ENUM) init.Int = sym.Value;
            }
        }
        u32 g = this.M.Globals.Len() as u32;
        string name = string.From("static.");
        name.Append(TextStr(this.QualifiedName(s, sym.Name)));
        Text kept = this.M.Keep(name);
        u32 ii = this.PushInit(init);
        this.M.Globals.Push(new EGlobal { Name = kept, Type = t, ReadOnly = false, Init = ii, Pos = 0 });
        this.M.Names.Put(TextStr(kept), (NAME_GLOBAL << 32) | g as u64);
        this.GlobalIds.Set(s as usize, g);
    }

    // The bytes of a string literal token (escapes decoded).
    Text StringValue(ref this, u32 n) {
        str text = this.C.TokText(this.C.NTok(n));
        string b = string.New();
        usize i = 1;
        while (i + 1 < text.Len) {
            u8 ch = text[i];
            if (ch != 0x5C) {
                b.AppendByte(ch);
                i++;
                continue;
            }
            u8 e = text[i + 1];
            i += 2;
            if (e == 'n') b.AppendByte(10);
            else if (e == 'r') b.AppendByte(13);
            else if (e == 't') b.AppendByte(9);
            else if (e == '0') b.AppendByte(0);
            else if (e == 'x') {
                b.AppendByte((HexDigit(text[i]) * 16 + HexDigit(text[i + 1])) as u8);
                i += 2;
            } else if (e == 'u') {
                // \u{H…}: UTF-8 encode the scalar value
                u32 v = 0;
                i++;
                while (text[i] != '}') {
                    v = v * 16 + HexDigit(text[i]);
                    i++;
                }
                i++;
                if (v < 0x80) b.AppendByte(v as u8);
                else if (v < 0x800) {
                    b.AppendByte((0xC0 | v >> 6) as u8);
                    b.AppendByte((0x80 | v & 0x3F) as u8);
                } else if (v < 0x10000) {
                    b.AppendByte((0xE0 | v >> 12) as u8);
                    b.AppendByte((0x80 | v >> 6 & 0x3F) as u8);
                    b.AppendByte((0x80 | v & 0x3F) as u8);
                } else {
                    b.AppendByte((0xF0 | v >> 18) as u8);
                    b.AppendByte((0x80 | v >> 12 & 0x3F) as u8);
                    b.AppendByte((0x80 | v >> 6 & 0x3F) as u8);
                    b.AppendByte((0x80 | v & 0x3F) as u8);
                }
            } else b.AppendByte(e);
        }
        return this.M.Keep(b);
    }

    // A read-only global holding bytes (shared between equal literals).
    u32 StringGlobal(ref this, Text bytes) {
        u32? found = this.Strings.Get(TextStr(bytes));
        if (found.IsSome()) return found.Unwrap();
        u32 g = this.M.Globals.Len() as u32;
        string name = string.From("str.");
        AppendDecimal(ref name, g as u64);
        Text kept = this.M.Keep(name);
        u32 n = bytes.Len as u32;
        if (n == 0) n = 1;      // a zero-length array still needs an address
        u32 at = this.M.ArrayType(ET_U8, n);
        EInit init = new EInit { Kind = EI_BYTES, Int = 0, Bytes = bytes, First = 0, Next = 0 };
        if (bytes.Len == 0) init.Bytes = TextOf("\0");
        u32 ii = this.PushInit(init);
        this.M.Globals.Push(new EGlobal { Name = kept, Type = at, ReadOnly = true, Init = ii, Pos = 0 });
        this.M.Names.Put(TextStr(kept), (NAME_GLOBAL << 32) | g as u64);
        this.Strings.Put(TextStr(bytes), g);
        return g;
    }

    // ------------------------------------------------------------------ functions

    // Begins EIR function f: parameter values, the (empty) entry block and the first body
    // block.
    void BeginFunc(ref this, u32 f, u32 nparams) {
        this.Func = f;
        while (this.PendingSlots.Len() > 0) this.PendingSlots.Pop();
        EFunc fn = this.M.Func(f);
        fn.FirstBlock = this.M.Blocks.Len() as u32;
        fn.FirstValue = this.M.Vals.Len() as u32;
        this.M.Funcs.Set(f as usize, fn);
        this.Entry = this.NewBlock();
        for (u32 i = 0; i < nparams; i++) NewValue(ref this.M, 0, this.Entry, 0);
        this.Body = this.NewBlock();
        this.Start(this.Body);
    }

    // Finishes the function: the entry block gets the slots, the parameter stores, and a
    // branch to the body.
    void EndFunc(ref this, in List<u32> stores) {
        if (this.Block != 0) {
            // falling off the end: void functions return; __main returns 0
            if (this.Top) {
                u32 zero = this.Const(ET_I32, 0);
                this.RetValue(zero);
            } else if (this.M.Func(this.Func).Ret == ET_VOID) this.Ret();
            else this.Unreachable();
        }
        this.Start(this.Entry);
        for (usize i = 0; i < this.PendingSlots.Len(); i += 2) {
            u32 v = this.PendingSlots.Get(i);
            u32 t = this.PendingSlots.Get(i + 1);
            EInst inst = NoInst(OP_SLOT);
            inst.Ty = t;
            inst.Block = this.Entry;
            inst.Result = v;
            inst.FirstOp = this.M.Ops.Len() as u32;
            u32 id = this.M.Insts.Len() as u32;
            this.M.Insts.Push(inst);
            EVal val = this.M.Val(v);
            val.Inst = id;
            val.Block = this.Entry;
            this.M.Vals.Set(v as usize, val);
        }
        // parameter stores: (value, slot, type) triples
        for (usize i = 0; i < stores.Len(); i += 3) this.Store(stores.Get(i + 2), stores.Get(i), stores.Get(i + 1));
        this.Br(this.Body);
        EFunc fn = this.M.Func(this.Func);
        fn.NBlocks = this.M.Blocks.Len() as u32 - fn.FirstBlock;
        fn.NValues = this.M.Vals.Len() as u32 - fn.FirstValue;
        this.M.Funcs.Set(this.Func as usize, fn);
    }

    // Lists local s (its storage's address in value v, holding EIR type et) for debuggers.
    void DebugLocal(ref this, u32 s, u32 v, u32 et) {
        Sym sym = this.C.SymAt(s);
        Text local = this.M.Own(sym.Name);
        this.M.Locals.Push(new EDebugVar { Func = this.Func, Value = v, Type = et, Name = local });
    }

    // The Src of node n: its first token's file and line.
    u32 SrcOf(in this, u32 n) {
        Node node = this.C.NodeAt(n);
        Token t = this.C.Tok(node.Tok);
        u32 line = t.Line;
        if (line > 0xFFFFF) line = 0xFFFFF;
        if (t.File >= 0xFFF) return 0;
        return ((t.File + 1) << 20) | line;
    }

    void SetSymSlot(ref this, u32 s, u32 v) {
        while (this.SymSlots.Len() <= s as usize) this.SymSlots.Push(0);
        this.SymSlots.Set(s as usize, v);
    }

    u32 SymSlot(in this, u32 s) {
        if (s as usize >= this.SymSlots.Len()) return 0;
        return this.SymSlots.Get(s as usize);
    }

    void LowerFunc(ref this, u32 s) {
        u32 f = this.FuncIds.Get(s as usize);
        this.LowerFuncEnv(s, f, 0, 0);
    }

    // Lowers function symbol s into EIR function f, with type arguments (env, n).
    void LowerFuncEnv(ref this, u32 s, u32 f, u32 env, u32 n) {
        Sym sym = this.C.SymAt(s);
        Node fn = this.C.NodeAt(sym.Node);
        EFunc ef = this.M.Func(f);
        this.Env = env;
        this.NEnv = n;
        this.BeginFunc(f, ef.NParams);
        List<u32> stores = List<u32>.New();
        u32 first = this.M.Func(f).FirstValue;
        u32 k = 0;
        u32 ret = this.LSubst(sym.Type);
        this.ResetDropFlags();
        this.Top = false;
        this.RetType = ret;
        this.RetSlot = 0;
        if (this.IsAggregate(ret)) {
            this.SetValType(first, ET_PTR);
            this.RetSlot = first;
            k = 1;
        }
        // the receiver: a pointer for `in this` and `ref this`, else a value like a parameter
        u32 p = fn.B;
        if (sym.Flags & SF_METHOD != 0 && sym.Flags & SF_STATIC == 0) {
            bool byref = sym.Flags & (SF_RECV_IN | SF_RECV_REF) != 0;
            u32 ot = this.LSubst(sym.OwnerType);
            this.LowerParam(sym.Recv, ot, byref, first + k, ref stores);
            if (!byref) this.TrackDrop(sym.Recv, ot, true, fn.Tok);
            k++;
            if (p != 0 && this.C.IsReceiver(p)) p = this.C.NNext(p);
        }
        // each parameter gets a slot (Core parameters are mutable locals)
        while (p != 0) {
            bool byref = this.C.NodeAt(p).Flags & (NF_IN | NF_REF) != 0;
            u32 pt = this.LNType(p);
            u32 ps = this.ParamSym(p);
            this.LowerParam(ps, pt, byref, first + k, ref stores);
            // a parameter taken by value is the callee's to drop
            if (!byref) this.TrackDrop(ps, pt, true, this.C.NTok(p));
            k++;
            p = this.C.NNext(p);
        }
        if (this.C.NKind(fn.C) == NK_BLOCK) {
            this.LowerStmt(fn.C);
        } else if (ret == T_VOID) {
            this.LowerExpr(fn.C);
            this.DropTemps();
        } else {
            this.LowerReturnValue(fn.C);
        }
        this.DropDownTo(0, false);
        this.EndFunc(stores);
        this.Env = 0;
        this.NEnv = 0;
        this.DrainLambdas();
    }

    void SetValType(ref this, u32 v, u32 t) {
        EVal val = this.M.Val(v);
        val.Type = t;
        this.M.Vals.Set(v as usize, val);
    }

    // Parameter value v for local s of type pt: an aggregate or a borrowed (`in`, `ref`)
    // parameter arrives as a pointer, which is the local's address; a scalar is stored in
    // a slot of its own.
    void LowerParam(ref this, u32 s, u32 pt, bool byref, u32 v, ref List<u32> stores) {
        u32 et = this.LType(pt);
        if (byref || this.IsAggregate(pt)) {
            // the caller passes a pointer to a copy this function owns, or to the borrowed place
            this.SetValType(v, ET_PTR);
            this.SetSymSlot(s, v);
            this.DebugLocal(s, v, et);
        } else {
            this.SetValType(v, et);
            u32 slot = this.Slot(et);
            stores.Push(v);
            stores.Push(slot);
            stores.Push(et);
            this.SetSymSlot(s, slot);
            this.DebugLocal(s, slot, et);
        }
    }

    // The local symbol the checker made for parameter node p.
    u32 ParamSym(in this, u32 p) => this.NodeLocals.Get(p as usize);

    void LowerMain(ref this, u32 f, u32 items) {
        this.BeginFunc(f, 0);
        this.Top = true;
        this.RetType = T_I32;
        this.RetSlot = 0;
        this.ResetDropFlags();
        u32 n = items;
        while (n != 0) {
            if (!NodeIsItem(this.C.NKind(n))) this.LowerStmt(n);
            n = this.C.NNext(n);
        }
        this.DropDownTo(0, false);
        List<u32> none = List<u32>.New();
        this.EndFunc(none);
        this.DrainLambdas();
    }
}

// The value of a hex digit.
u32 HexDigit(u8 c) {
    if (c >= '0' && c <= '9') return (c - '0') as u32;
    return ((c | 0x20) - 'a') as u32 + 10;
}
