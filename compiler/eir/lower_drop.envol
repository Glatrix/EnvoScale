// Lowering drops ([own.drop.1], [s1.own.2]). Follows Stage 1's bootstrap/stage1/lower/drop.envol.
// A local whose type needs a drop gets a drop flag, set when it is initialized and cleared
// where the move checker marked a move (NMove 1). At each scope exit the live flagged
// locals of the scopes being left are dropped, newest first. A value that needs a drop
// but is not moved anywhere (a temporary, NMove 2) is dropped at the end of its statement.
// Dropping calls the type's `Drop`, then drops the fields that need it, in order.
//
// A local a field of which is moved out (SF_PARTLY, M3.10) also gets a flag per field that
// needs a drop. Moving the field clears its flag (NMove 3 on the member), and the local
// is dropped field by field. Its type has no `Drop` of its own (the checker makes sure).
namespace envoc.lower;

use envoc.util;
use envoc.syntax;
use envoc.sema;
use envoc.eir;

impl Lower {
    // The drop flag of local s, or 0.
    u32 DropFlag(in this, u32 s) {
        if (this.DropFlags.Len() <= s as usize) return 0;
        return this.DropFlags.Get(s as usize);
    }

    // Starts tracking local s (just initialized when init is true) if its type needs a drop.
    void TrackDrop(ref this, u32 s, u32 t, bool init, u32 tok) {
        if (!this.C.NeedsDrop(t)) return;
        if (this.C.TyKind(t) == TYK_ARRAY) this.C.NotCore("arrays of values with a drop; use `List<T>`", tok);
        u32 flag = this.Slot(ET_BOOL);
        u64 v = 0;
        if (init) v = 1;
        u32 c = this.Const(ET_BOOL, v);
        this.Store(ET_BOOL, c, flag);
        while (this.DropFlags.Len() <= s as usize) this.DropFlags.Push(0);
        this.DropFlags.Set(s as usize, flag);
        this.Drops.Push(s);
        this.FlagSyms.Push(s);
        if (this.C.SymAt(s).Flags & SF_PARTLY != 0) this.TrackFields(s, init);
    }

    // Field drop flags for partly moved local s.
    void TrackFields(ref this, u32 s, bool init) {
        u32 t = this.LSubst(this.C.SymAt(s).Type);
        u32 start = this.FieldFlagSlots.Len() as u32;
        u64 v = 0;
        if (init) v = 1;
        u32 f = this.C.NodeAt(this.C.SymAt(this.C.TypeAt(t).Sym).Node).A;
        while (f != 0) {
            u32 flag = 0;
            if (this.C.NeedsDrop(this.C.FieldType(t, f))) {
                flag = this.Slot(ET_BOOL);
                u32 c = this.Const(ET_BOOL, v);
                this.Store(ET_BOOL, c, flag);
            }
            this.FieldFlagSlots.Push(flag);
            f = this.C.NNext(f);
        }
        while (this.FieldFlags.Len() <= s as usize) this.FieldFlags.Push(0);
        this.FieldFlags.Set(s as usize, start + 1);
    }

    // The drop flag of field i of local s, or 0.
    u32 FieldFlag(in this, u32 s, u32 i) {
        if (this.FieldFlags.Len() <= s as usize || this.FieldFlags.Get(s as usize) == 0) return 0;
        return this.FieldFlagSlots.Get((this.FieldFlags.Get(s as usize) - 1 + i) as usize);
    }

    bool HasFieldFlags(in this, u32 s) => this.FieldFlags.Len() > s as usize && this.FieldFlags.Get(s as usize) != 0;

    // Member node n moves its field out of a partly moved local: the field's flag goes off.
    void ClearFieldFlag(ref this, u32 n) {
        u32 top = 0;
        u32 s = this.C.MemberRoot(n, ref top);
        if (s == 0) return;
        u32 flag = this.FieldFlag(s, this.C.MemberIndex(top));
        if (flag == 0) return;
        u32 off = this.Const(ET_BOOL, 0);
        this.Store(ET_BOOL, off, flag);
    }

    // Sets (or clears) local s's drop flag, if it has one.
    void SetDropFlag(ref this, u32 s, bool live) {
        u32 flag = this.DropFlag(s);
        if (flag == 0) return;
        u64 v = 0;
        if (live) v = 1;
        u32 c = this.Const(ET_BOOL, v);
        this.Store(ET_BOOL, c, flag);
        if (!this.HasFieldFlags(s)) return;
        u32 first = this.FieldFlags.Get(s as usize) - 1;
        u32 t = this.LSubst(this.C.SymAt(s).Type);
        u32 f = this.C.NodeAt(this.C.SymAt(this.C.TypeAt(t).Sym).Node).A;
        u32 i = 0;
        while (f != 0) {
            u32 ff = this.FieldFlagSlots.Get((first + i) as usize);
            if (ff != 0) {
                u32 fc = this.Const(ET_BOOL, v);
                this.Store(ET_BOOL, fc, ff);
            }
            i++;
            f = this.C.NNext(f);
        }
    }

    // A new function: no local has a drop flag yet. (Flags are kept per symbol, and one
    // generic body is lowered once per instance, so the last instance's must go.)
    void ResetDropFlags(ref this) {
        foreach (var s in this.FlagSyms.AsSlice()) {
            this.DropFlags.Set(s as usize, 0);
            if (this.FieldFlags.Len() > s as usize) this.FieldFlags.Set(s as usize, 0);
        }
        while (this.FlagSyms.Len() > 0) this.FlagSyms.Pop();
        while (this.Drops.Len() > 0) this.Drops.Pop();
        while (this.KeptTemps.Len() > 0) this.KeptTemps.Pop();
    }

    // [own.temp.1] A local whose type can hold a view (str, a slice, a struct holding one)
    // may borrow from a temporary of its initializer (`str s = Make().AsStr();`), and a
    // borrowing local (SF_BYREF) may be a place in one: the statement's temporaries then live until the end of the local's
    // block, dropped with its locals. In Drops such a temporary is its index in KeptTemps
    // with the top bit set.
    void KeepTemps(ref this, u32 t, bool always) {
        if (!always && !this.C.HoldsBorrow(t)) return;
        usize n = this.Temps.Len();
        for (usize i = 0; i + 1 < n; i += 2) {
            u32 at = (this.KeptTemps.Len() / 2) as u32;
            this.KeptTemps.Push(this.Temps.Get(i));
            this.KeptTemps.Push(this.Temps.Get(i + 1));
            this.Drops.Push(at | 0x80000000);
        }
        while (this.Temps.Len() > 0) this.Temps.Pop();
    }

    usize DropMark(in this) => this.Drops.Len();

    // Drops the tracked locals from mark up, newest first, each if its flag is set. keep:
    // they stay tracked (a `break` or `return` leaves them on other paths).
    void DropDownTo(ref this, usize mark, bool keep) {
        usize i = this.Drops.Len();
        while (i > mark) {
            i--;
            if (this.Block == 0) break;     // nothing more runs on this path
            u32 s = this.Drops.Get(i);
            if (s & 0x80000000 != 0) {
                usize at = ((s & 0x7FFFFFFF) * 2) as usize;
                this.DropValue(this.KeptTemps.Get(at), this.KeptTemps.Get(at + 1));
            } else {
                this.DropLocal(s);
            }
        }
        if (!keep) {
            while (this.Drops.Len() > mark) this.Drops.Pop();
        }
    }

    void DropLocal(ref this, u32 s) {
        u32 flag = this.DropFlag(s);
        u32 yes = this.NewBlock();
        u32 join = this.NewBlock();
        u32 live = this.Load(ET_BOOL, flag);
        this.CondBr(live, yes, join);
        this.Start(yes);
        u32 off = this.Const(ET_BOOL, 0);
        this.Store(ET_BOOL, off, flag);
        u32 t = this.LSubst(this.C.SymAt(s).Type);
        if (this.HasFieldFlags(s)) this.DropFields(s, t, this.SymSlot(s));
        else this.DropValue(t, this.SymSlot(s));
        this.Br(join);
        this.Start(join);
    }

    // Drops the fields of partly moved local s (type t, at p) that it still holds, in order.
    void DropFields(ref this, u32 s, u32 t, u32 p) {
        u32 et = this.LType(t);
        u32 f = this.C.NodeAt(this.C.SymAt(this.C.TypeAt(t).Sym).Node).A;
        u32 i = 0;
        while (f != 0) {
            u32 flag = this.FieldFlag(s, i);
            if (flag != 0) {
                u32 yes = this.NewBlock();
                u32 join = this.NewBlock();
                u32 live = this.Load(ET_BOOL, flag);
                this.CondBr(live, yes, join);
                this.Start(yes);
                u32 off = this.Const(ET_BOOL, 0);
                this.Store(ET_BOOL, off, flag);
                u32 at = this.Field(et, p, i);
                this.DropValue(this.C.FieldType(t, f), at);
                this.Br(join);
                this.Start(join);
            }
            i++;
            f = this.C.NNext(f);
        }
    }

    // Drops the value of concrete type t at address p: its own `Drop`, then its fields.
    void DropValue(ref this, u32 t, u32 p) {
        if (!this.C.NeedsDrop(t)) return;
        Type ty = this.C.TypeAt(t);
        if (this.C.HasDropImpl(t)) {
            u32 s = 0;
            u32 env = 0;
            u32 n = 0;
            this.DropMethod(t, ref s, ref env, ref n);
            List<u32> args = List<u32>.New();
            args.Push(p);
            u32 inst = this.C.InstGet(s, env, n, 0, 0);
            u32 f = this.InstFunc(inst);
            this.EmitCall(f, args, 0);
        }
        if (ty.Kind == TYK_UNION) {
            this.DropPayload(t, p);
            return;
        }
        u32 et = this.LType(t);
        u32 f = this.C.NodeAt(this.C.SymAt(ty.Sym).Node).A;
        u32 i = 0;
        while (f != 0) {
            u32 ft = this.C.FieldType(t, f);
            if (this.C.NeedsDrop(ft)) {
                u32 at = this.Field(et, p, i);
                this.DropValue(ft, at);
            }
            i++;
            f = this.C.NNext(f);
        }
    }

    // The `Drop` method type t implements, with its environment.
    void DropMethod(ref this, u32 t, ref u32 s, ref u32 env, ref u32 n) {
        u32 drop = this.C.DropSym;
        u32 r = this.C.FindImpl(t, this.C.SymAt(drop).Type);
        ImplRec rec = this.C.Impls.Get((r - 1) as usize);
        u32 m = rec.Methods;
        while (m != 0) {
            if (Same(this.C.TokText(this.C.NTok(m)), "Drop")) break;
            m = this.C.NNext(m);
        }
        Type ty = this.C.TypeAt(t);
        s = this.C.NSym(m);
        env = 0;
        n = 0;
        if (rec.NParams > 0) {
            env = ty.Args;
            n = ty.NArgs;
        }
    }

    // A temporary that needs a drop at the end of the statement (NMove 2), of type t at p.
    void TrackTemp(ref this, u32 n, u32 t, u32 p) {
        if (this.C.NMove.Get(n as usize) != 2 || !this.C.NeedsDrop(t)) return;
        this.Temps.Push(t);
        this.Temps.Push(p);
    }

    // Drops the statement's temporaries, newest first.
    void DropTemps(ref this) {
        this.DropTempsOnPath();
        while (this.Temps.Len() > 0) this.Temps.Pop();
    }

    // The same on one path out of the statement (an early `return` from `?`): the other
    // paths still have them.
    void DropTempsOnPath(ref this) {
        usize i = this.Temps.Len();
        while (i >= 2) {
            i -= 2;
            if (this.Block != 0) this.DropValue(this.Temps.Get(i), this.Temps.Get(i + 1));
        }
    }

    // The EIR function of instance i, declared on first use (lowering may need instances
    // the checker did not list, such as `Drop` methods).
    u32 InstFunc(ref this, u32 i) {
        if (!this.C.Insts.Get(i as usize).Declared) this.DeclareInst(i);
        return this.C.Insts.Get(i as usize).Func;
    }
}
