// Files (compiler/util/README.md).
namespace envoc.util;

// The whole contents of the file at path, or null if it cannot be opened or read.
public string? ReadFile(str path) {
    i32 fd = open(path, 0);
    if (fd < 0) return null;
    string s = string.New();
    while (true) {
        s.Reserve(1 << 16);
        isize n = 0;
        unsafe { n = read(fd, &s.Data[s.Count], s.Cap - s.Count); }
        if (n < 0) {
            close(fd);
            return null;
        }
        if (n == 0) break;
        s.Count += n as usize;
    }
    close(fd);
    return Some(s);
}

// Writes data to the file at path, replacing it; marks it executable where that means
// something. `write` reports no errors (a full disk just stops it), so the file is read
// back: false unless it holds exactly data.
public bool WriteFile(str path, in string data, bool executable) {
    i32 mode = 1;
    if (executable) mode = 2;
    i32 fd = open(path, mode);
    if (fd < 0) return false;
    write(fd, data);
    close(fd);
    string? back = ReadFile(path);
    if (back.IsNone()) return false;
    string got = back.Unwrap();
    return Same(got.AsStr(), data.AsStr());
}
