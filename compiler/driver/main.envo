// envoc: the compiler (compiler/README.md), written in Envo-S1 so that EnvoScaleAsm's
// stage 1 can still build it (PLAN D16). This is the entry file: its top-level statements are the program's
// main. The other files are listed, in order, in compiler/files.txt.
use envoc.util;
use envoc.diag;
use envoc.syntax;
use envoc.sema;
use envoc.eir;
use envoc.lower;
use envoc.x64;
use envoc.opt;

const str VERSION = "envoc 0.5.0 (EnvoScale, Envo-S1; ";

void Usage(i32 fd) {
    write(fd, "usage: envoc [--core] <command> [arguments]\n");
    write(fd, "\n");
    write(fd, "commands:\n");
    write(fd, "  lex <file.envo>     print the token stream of a source file\n");
    write(fd, "  parse <file.envo>   print the syntax tree of a source file\n");
    write(fd, "  check <file.envo>...\n");
    write(fd, "                      check names and types; print the typed syntax tree\n");
    write(fd, "  build <file.envo>... -o <output> [-O0|-O2] [--lib <dir> [--os none]] [-map <file>] [--target x86_64-windows|x86_64-linux|wasm32-web|aarch64-linux|aarch64-macos]\n");
    write(fd, "                      compile a program to an executable\n");
    write(fd, "  compile <file.envo>... -o <out.eo> [--unit <file.envo>] [--target …]\n");
    write(fd, "                      compile to an EIR object: the code of one file (--unit)\n");
    write(fd, "                      or of all of them; the others are read for their declarations\n");
    write(fd, "  link <file.eo>... -o <output> [-O0|-O2]\n");
    write(fd, "                      link EIR objects of one program into an executable\n");
    write(fd, "  eir <file.envo>... [--target x86_64-windows|x86_64-linux|wasm32-web|aarch64-linux|aarch64-macos]\n");
    write(fd, "                      print the program's EIR, runtime included (-o: binary EIR)\n");
    write(fd, "  eir-check <file.eir|file.eirb> [-O2] [-o <out.eirb>]\n");
    write(fd, "                      read and verify EIR, text or binary (-O2: and optimize it);\n");
    write(fd, "                      print it as text\n");
    write(fd, "                      or (-o) write it in the binary form\n");
    write(fd, "  version             print the version\n");
    write(fd, "  help                print this message\n");
    write(fd, "\n");
    write(fd, "options:\n");
    write(fd, "  --core              accept only Envo-Core, the subset stage 0 compiles\n");
}

// Checks the support library: a map through several rounds of growth, and numbers.
void SelfTest() {
    StrMap<u64> m = StrMap<u64>.New();
    for (u64 i = 0; i < 1000; i++) m.Put(Decimal(i), i * 3);
    for (u64 i = 0; i < 1000; i++) {
        if ((m.Get(Decimal(i)) ?? 0) != i * 3) ToolFail("selftest: a map value is wrong", EXIT_INTERNAL);
    }
    m.Put("7", 1);
    if (m.Len() != 1000 || (m.Get("7") ?? 0) != 1 || m.Has("x")) ToolFail("selftest: the map's contents are wrong", EXIT_INTERNAL);
    if (!Same(Decimal(18446744073709551615).AsStr(), "18446744073709551615")) ToolFail("selftest: Decimal is wrong", EXIT_INTERNAL);
    print("selftest: ok");
}

// `envoc embed <file>...`: prints an Envo file that holds each file's text as a string
// constant (RUNTIME_0, RUNTIME_1, ...). driver/runtime*.envo are made this way from the
// sources in runtime/, and the build checks that they are current.
i32 CmdEmbed(usize argi) {
    if (argc() <= argi) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    string o = string.From("// Generated by `envoc embed` from the files named below. Do not edit; regenerate.\n");
    for (usize i = argi; i < argc(); i++) {
        usize f = LoadSource(ref src, arg(i));
        o.Append("\n// ");
        o.Append(src.Path(f));
        o.Append("\nconst str RUNTIME_");
        o.Append(Decimal((i - argi) as u64).AsStr());
        o.Append(" = \"");
        str t = src.Text(f);
        for (usize k = 0; k < t.Len; k++) {
            u8 c = t[k];
            if (c == 10) o.Append("\\n");
            else if (c == 13) o.Append("\\r");
            else if (c == 9) o.Append("\\t");
            else if (c == 34) o.Append("\\\"");
            else if (c == 92) o.Append("\\\\");
            else o.AppendByte(c);
        }
        o.Append("\";\n");
    }
    write(1, o);
    return EXIT_OK;
}

// `envoc lex <file.envo>`
i32 CmdLex(usize argi, bool core) {
    if (argc() != argi + 1) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    usize f = LoadSource(ref src, arg(argi));
    LexTables tables = LexTables.New();
    List<Token> toks = Lex(tables, src.Path(f), src.Text(f), f as u32, core);
    string listing = string.New();
    DumpTokens(ref listing, toks, src.Text(f));
    write(1, listing);
    return EXIT_OK;
}

// `envoc parse <file.envo>`
i32 CmdParse(usize argi, bool core) {
    if (argc() != argi + 1) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    LoadSource(ref src, arg(argi));
    List<usize> starts = List<usize>.New();
    List<Token> toks = LexAll(src, ref starts, core);
    Tree tree = Parse(src, toks, starts, core);
    string listing = string.New();
    DumpTree(ref listing, tree, src, tree.Root, 0);
    write(1, listing);
    return EXIT_OK;
}

// `envoc check <file.envo>...`: names and types; prints the typed syntax tree. In
// Envo-S1 mode the prelude (driver/prelude.envo) is compiled with the program.
i32 CmdCheck(usize argi, bool core) {
    if (argc() <= argi) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    str lib = "";
    str os = "";
    usize i = argi;
    while (i < argc()) {
        if ((Same(arg(i), "--lib") || Same(arg(i), "--os")) && i + 1 < argc()) {
            if (Same(arg(i), "--lib")) lib = arg(i + 1);
            else os = arg(i + 1);
            i += 2;
            continue;
        }
        LoadSource(ref src, arg(i));
        i++;
    }
    // the libraries' native adapters use the target intrinsics, which come with the runtime
    if (lib.Len > 0) LoadLibraries(ref src, lib, PlatformOs(os, HostTargetCode()), ArchOf(HostTargetCode()), core);
    u32 prelude = 0xFFFFFFFF;
    if (!core) prelude = src.Add("<prelude>/prelude.envo", string.From(RUNTIME_3)) as u32;
    List<usize> starts = List<usize>.New();
    List<Token> toks = LexAll(src, ref starts, core);
    Tree tree = Parse(src, toks, starts, core);
    Checker c = Checker.New(src, tree, core, lib.Len > 0);
    c.PreludeFile = prelude;
    c.CheckProgram();
    string listing = string.New();
    c.Dump(ref listing, c.T.Root, 0);
    write(1, listing);
    return EXIT_OK;
}

// `envoc eir-check <file.eir>`: reads and verifies EIR text, then prints it in canonical
// form ([eir.text.4]).
i32 CmdEirCheck(usize argi) {
    // eir-check <file> [-O2] [-o <out.eirb>]
    str output = "";
    bool opt = false;
    bool bad = argc() <= argi;
    usize i = argi + 1;
    while (i < argc() && !bad) {
        if (Same(arg(i), "-O2")) {
            opt = true;
            i++;
        } else if (Same(arg(i), "-o") && i + 1 < argc()) {
            output = arg(i + 1);
            i += 2;
        } else {
            bad = true;
        }
    }
    if (bad) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    usize f = LoadSource(ref src, arg(argi));
    Module m = Module.New();
    if (IsBinaryEir(src.Text(f))) DecodeEir(ref m, src.Path(f), src.Text(f));
    else ReadEir(ref m, src.Path(f), src.Text(f));
    m.Verify();
    if (opt) {
        Optimize(ref m);
        m.Verify();
    }
    if (output.Len > 0) {
        string bytes = m.Encode();
        return WriteOut(output, bytes, false);
    }
    string listing = string.New();
    PrintModule(m, ref listing);
    write(1, listing);
    return EXIT_OK;
}

void BuildUsage() {
    write(2, "usage: envoc build <file.envo>... -o <output> [-O0|-O2] [--lib <dir> [--os none]] [-map <file>] [--target x86_64-windows|x86_64-linux|wasm32-web|aarch64-linux|aarch64-macos]\n");
    write(2, "       envoc compile <file.envo>... -o <out.eo> [--unit <file.envo>] [--target …]\n");
    write(2, "       envoc link <file.eo>... -o <output> [-O0|-O2]\n");
    exit(EXIT_USAGE);
}

// The arguments of `build` and `eir`: the files, -o <output>, --target <triple>.
struct BuildArgs {
    List<usize> Files;      // argument indexes
    str Output;
    u32 Target;
    bool TargetSet;
    bool Opt;               // -O2
    str Map;                // -map <file>: a link map of function addresses
    str Lib;                // --lib <dir>: holds lib/ and adapters/ (D21)
    str Os;                 // --os: the adapters `platform` binds (D23); "" for the target's
    str Unit;               // compile: the file whose code the object holds
}

BuildArgs ParseBuildArgs(usize argi) {
    BuildArgs b = new BuildArgs { Files = List<usize>.New(), Output = "", Target = TARGET_LINUX, TargetSet = false, Unit = "", Opt = false, Map = "", Lib = "", Os = "" };
    if (Same(HostTarget(), "x86_64-windows")) b.Target = TARGET_WINDOWS;
    usize i = argi;
    while (i < argc()) {
        str a = arg(i);
        if (Same(a, "-o")) {
            if (i + 1 >= argc()) BuildUsage();
            b.Output = arg(i + 1);
            i += 2;
        } else if (Same(a, "--target")) {
            if (i + 1 >= argc()) BuildUsage();
            str t = arg(i + 1);
            if (Same(t, "x86_64-windows")) b.Target = TARGET_WINDOWS;
            else if (Same(t, "x86_64-linux")) b.Target = TARGET_LINUX;
            else if (Same(t, "wasm32-web")) b.Target = TARGET_WASM;
            else if (Same(t, "aarch64-linux")) b.Target = TARGET_A64;
            else if (Same(t, "aarch64-macos")) b.Target = TARGET_MACOS;
            else BuildUsage();
            b.TargetSet = true;
            i += 2;
        } else if (Same(a, "-O2") || Same(a, "-O0")) {
            b.Opt = Same(a, "-O2");
            i++;
        } else if (Same(a, "--lib")) {
            if (i + 1 >= argc()) BuildUsage();
            b.Lib = arg(i + 1);
            i += 2;
        } else if (Same(a, "--os")) {
            if (i + 1 >= argc()) BuildUsage();
            b.Os = arg(i + 1);
            i += 2;
        } else if (Same(a, "-map")) {
            if (i + 1 >= argc()) BuildUsage();
            b.Map = arg(i + 1);
            i += 2;
        } else if (Same(a, "--unit")) {
            if (i + 1 >= argc()) BuildUsage();
            b.Unit = arg(i + 1);
            i += 2;
        } else {
            b.Files.Push(i);
            i++;
        }
    }
    return b;
}

// `envoc build <file.envo>... -o <output> [--target …]`
i32 CmdBuild(usize argi, bool core) {
    BuildArgs b = ParseBuildArgs(argi);
    if (b.Files.Len() == 0 || b.Output.Len == 0 || b.Unit.Len > 0) BuildUsage();
    if (core) {
        Sources src = Sources.New();
        Module m = CompileProgram(ref src, Paths(b.Files), b.Target, core, true, -1, b.Opt, b.Lib, b.Os);
        string map = string.New();
        string image = GenFor(ref m, b.Target, b.Opt, b.Map.Len > 0, ref map);
        if (b.Map.Len > 0 && WriteOut(b.Map, map, false) != EXIT_OK) return EXIT_ERRORS;
        return WriteOut(b.Output, image, true);
    }
    return BuildProgram(Paths(b.Files), b.Output, b.Target, b.Opt, b.Lib, b.Os, b.Map);
}

// The arguments at the given indexes.
List<string> Paths(in List<usize> indexes) {
    List<string> all = List<string>.New();
    foreach (var i in indexes.AsSlice()) all.Push(string.From(arg(i)));
    return all;
}

// `envoc compile <file.envo>... -o <out.eo> [--unit <file.envo>] [--target …]`
i32 CmdCompile(usize argi, bool core) {
    BuildArgs b = ParseBuildArgs(argi);
    if (b.Files.Len() == 0 || b.Output.Len == 0) BuildUsage();
    i32 unit = -1;
    if (b.Unit.Len > 0) {
        for (usize i = 0; i < b.Files.Len(); i++) {
            if (unit < 0 && Same(arg(b.Files.Get(i)), b.Unit)) unit = i as i32;
        }
        if (unit < 0) ToolFail("--unit must name one of the files", EXIT_USAGE);
    }
    Sources src = Sources.New();
    Module m = CompileProgram(ref src, Paths(b.Files), b.Target, core, true, unit, b.Opt, b.Lib, b.Os);
    string bytes = m.Encode();
    return WriteOut(b.Output, bytes, false);
}

// `envoc link <file.eo>... -o <output>`: the objects must come from the same files.
i32 CmdLink(usize argi) {
    BuildArgs b = ParseBuildArgs(argi);
    if (b.Files.Len() == 0 || b.Output.Len == 0 || b.Unit.Len > 0) BuildUsage();
    Sources src = Sources.New();
    foreach (var i in b.Files.AsSlice()) LoadSource(ref src, arg(i));
    Module m = Module.New();
    DecodeEir(ref m, src.Path(0), src.Text(0));
    for (usize k = 1; k < src.Count(); k++) {
        Module o = Module.New();
        DecodeEir(ref o, src.Path(k), src.Text(k));
        if (!m.SameProgram(o)) {
            string msg = string.From(src.Path(k));
            msg.Append(" and ");
            msg.Append(src.Path(0));
            msg.Append(" were compiled from different programs (compile every object from the same files)");
            ToolFail(msg, EXIT_ERRORS);
        }
        m.FillFrom(o);
    }
    for (u32 f = 1; f < m.Funcs.Len() as u32; f++) {
        if (m.IsDeclaration(f)) {
            string msg = string.From("no object defines @");
            msg.Append(TextStr(m.Func(f).Name));
            ToolFail(msg, EXIT_ERRORS);
        }
    }
    u32 target = TARGET_LINUX;
    if (TextIs(m.Target, "x86_64-windows")) target = TARGET_WINDOWS;
    else if (TextIs(m.Target, "wasm32-web")) target = TARGET_WASM;
    else if (TextIs(m.Target, "aarch64-linux")) target = TARGET_A64;
    else if (TextIs(m.Target, "aarch64-macos")) target = TARGET_MACOS;
    else if (!TextIs(m.Target, "x86_64-linux")) ToolFail("the objects are for an unknown target", EXIT_ERRORS);
    if (b.TargetSet && b.Target != target) ToolFail("--target differs from the objects' target", EXIT_ERRORS);
    m.Verify();
    string map = string.New();
    string image = GenFor(ref m, target, b.Opt, b.Map.Len > 0, ref map);
    if (b.Map.Len > 0 && WriteOut(b.Map, map, false) != EXIT_OK) return EXIT_ERRORS;
    return WriteOut(b.Output, image, true);
}

// `envoc eir <file.envo>... [--target …]`: the program's EIR, runtime included.
i32 CmdEir(usize argi, bool core) {
    BuildArgs b = ParseBuildArgs(argi);
    if (b.Files.Len() == 0 || b.Unit.Len > 0) BuildUsage();
    Sources src = Sources.New();
    Module m = CompileProgram(ref src, Paths(b.Files), b.Target, core, false, -1, b.Opt, b.Lib, b.Os);     // eir-check the output to verify it
    if (b.Output.Len > 0) {
        string bytes = m.Encode();
        return WriteOut(b.Output, bytes, false);
    }
    string listing = string.New();
    PrintModule(m, ref listing);
    write(1, listing);
    return EXIT_OK;
}

usize argi = 1;
bool core = false;
if (argi < argc() && Same(arg(argi), "--core")) {
    core = true;
    argi++;
}
if (argi >= argc()) {
    Usage(2);
    return EXIT_USAGE;
}
str command = arg(argi);
argi++;
if (Same(command, "version") || Same(command, "--version")) {
    string v = string.From(VERSION);
    v.Append(HostTarget());
    v.Append(")\n");
    write(1, v);
    return EXIT_OK;
}
if (Same(command, "selftest")) {
    SelfTest();
    return EXIT_OK;
}
if (Same(command, "lex")) return CmdLex(argi, core);
if (Same(command, "embed")) return CmdEmbed(argi);
if (Same(command, "parse")) return CmdParse(argi, core);
if (Same(command, "check")) return CmdCheck(argi, core);
if (Same(command, "eir-check")) return CmdEirCheck(argi);
if (Same(command, "eir")) return CmdEir(argi, core);
if (Same(command, "build")) return CmdBuild(argi, core);
if (Same(command, "compile")) return CmdCompile(argi, core);
if (Same(command, "link")) return CmdLink(argi);
if (Same(command, "help") || Same(command, "--help")) {
    Usage(1);
    return EXIT_OK;
}
string msg = string.From("unknown command '");
msg.Append(command);
msg.Append("'; run `envoc help` for the list");
ToolFail(msg, EXIT_USAGE);
