// envoc: the Stage 2 compiler (compiler/README.md), written in Envo-S1 and built by
// envoc1 (PLAN D16). This is the entry file: its top-level statements are the program's
// main. The other files are listed, in order, in compiler/files.txt.
use envoc.util;
use envoc.diag;
use envoc.syntax;
use envoc.sema;
use envoc.eir;
use envoc.lower;
use envoc.x64;

const str VERSION = "envoc 0.3.0-dev (EnvoScale stage 2, Envo-S1; ";

const usize MAX_SOURCE = 16 << 20;     // 16 MiB per file, as in Stages 0 and 1

void Usage(i32 fd) {
    write(fd, "usage: envoc [--core] <command> [arguments]\n");
    write(fd, "\n");
    write(fd, "commands:\n");
    write(fd, "  lex <file.envo>     print the token stream of a source file\n");
    write(fd, "  parse <file.envo>   print the syntax tree of a source file\n");
    write(fd, "  check <file.envo>...\n");
    write(fd, "                      check names and types; print the typed syntax tree\n");
    write(fd, "  build <file.envo>... -o <output> [--target x86_64-windows|x86_64-linux]\n");
    write(fd, "                      compile a program to an executable\n");
    write(fd, "  eir <file.envo>... [--target x86_64-windows|x86_64-linux]\n");
    write(fd, "                      print the program's EIR, runtime included\n");
    write(fd, "  eir-check <file.eir>\n");
    write(fd, "                      parse and verify an EIR text file, and print it back\n");
    write(fd, "  version             print the version\n");
    write(fd, "  help                print this message\n");
    write(fd, "\n");
    write(fd, "options:\n");
    write(fd, "  --core              accept only Envo-Core, as envoc0 does\n");
    write(fd, "\n");
    write(fd, "envoc is being built (milestone M3): the compiler commands arrive one\n");
    write(fd, "increment at a time (docs/PLAN.md section 5).\n");
}

// Checks the support library: a map through several rounds of growth, and numbers.
void SelfTest() {
    StrMap<u64> m = StrMap<u64>.New();
    for (u64 i = 0; i < 1000; i++) m.Put(Decimal(i), i * 3);
    for (u64 i = 0; i < 1000; i++) {
        if ((m.Get(Decimal(i)) ?? 0) != i * 3) ToolFail("selftest: a map value is wrong", EXIT_INTERNAL);
    }
    m.Put("7", 1);
    if (m.Len() != 1000 || (m.Get("7") ?? 0) != 1 || m.Has("x")) ToolFail("selftest: the map's contents are wrong", EXIT_INTERNAL);
    if (!Same(Decimal(18446744073709551615).AsStr(), "18446744073709551615")) ToolFail("selftest: Decimal is wrong", EXIT_INTERNAL);
    print("selftest: ok");
}

// The target this program runs on: Linux has /proc/self/exe.
str HostTarget() {
    i32 fd = open("/proc/self/exe", 0);
    if (fd >= 0) {
        close(fd);
        return "x86_64-linux";
    }
    return "x86_64-windows";
}

// Reads the source file at path into src, without a leading byte order mark, and returns
// its index. Reports a file that cannot be read, and exits.
usize Load(ref Sources src, str path) {
    string? read = ReadFile(path);
    if (read.IsNone()) {
        string msg = string.From("cannot open '");
        msg.Append(path);
        msg.AppendByte(0x27);
        ToolFail(msg, EXIT_ERRORS);
    }
    string text = read.Unwrap();
    if (text.Len() > MAX_SOURCE) {
        string msg = string.From("file too large: '");
        msg.Append(path);
        msg.Append("' (envoc accepts source files up to 16 MiB)");
        ToolFail(msg, EXIT_ERRORS);
    }
    str t = text.AsStr();
    if (t.Len >= 3 && t[0] == 0xEF && t[1] == 0xBB && t[2] == 0xBF) {
        return src.Add(path, string.From(t[3..t.Len]));
    }
    return src.Add(path, text);
}

// `envoc lex <file.envo>`
i32 CmdLex(usize argi, bool core) {
    if (argc() != argi + 1) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    usize f = Load(ref src, arg(argi));
    LexTables tables = LexTables.New();
    List<Token> toks = Lex(tables, src.Path(f), src.Text(f), f as u32, core);
    string listing = string.New();
    DumpTokens(ref listing, toks, src.Text(f));
    write(1, listing);
    return EXIT_OK;
}

// Lexes every file in src, in order, into one token list; starts gets each file's first
// token.
List<Token> LexAll(in Sources src, ref List<usize> starts, bool core) {
    LexTables tables = LexTables.New();
    List<Token> all = List<Token>.New();
    for (usize f = 0; f < src.Count(); f++) {
        starts.Push(all.Len());
        List<Token> toks = Lex(tables, src.Path(f), src.Text(f), f as u32, core);
        foreach (var t in toks.AsSlice()) all.Push(t);
    }
    return all;
}

// `envoc parse <file.envo>`
i32 CmdParse(usize argi, bool core) {
    if (argc() != argi + 1) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    Load(ref src, arg(argi));
    List<usize> starts = List<usize>.New();
    List<Token> toks = LexAll(src, ref starts, core);
    Tree tree = Parse(src, toks, starts, core);
    string listing = string.New();
    DumpTree(ref listing, tree, src, tree.Root, 0);
    write(1, listing);
    return EXIT_OK;
}

// `envoc check <file.envo>...`: names and types; prints the typed syntax tree. In
// Envo-S1 mode the prelude (driver/prelude.envo) is compiled with the program.
i32 CmdCheck(usize argi, bool core) {
    if (argc() <= argi) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    for (usize i = argi; i < argc(); i++) Load(ref src, arg(i));
    u32 prelude = 0xFFFFFFFF;
    if (!core) prelude = src.Add("<prelude>/prelude.envo", string.From(RUNTIME_3)) as u32;
    List<usize> starts = List<usize>.New();
    List<Token> toks = LexAll(src, ref starts, core);
    Tree tree = Parse(src, toks, starts, core);
    Checker c = Checker.New(src, tree, core, false);
    c.PreludeFile = prelude;
    c.CheckProgram();
    string listing = string.New();
    c.Dump(ref listing, c.T.Root, 0);
    write(1, listing);
    return EXIT_OK;
}

// `envoc eir-check <file.eir>`: reads and verifies EIR text, then prints it in canonical
// form ([eir.text.4]).
i32 CmdEirCheck(usize argi) {
    if (argc() != argi + 1) {
        Usage(2);
        return EXIT_USAGE;
    }
    Sources src = Sources.New();
    usize f = Load(ref src, arg(argi));
    Module m = Module.New();
    ReadEir(ref m, src.Path(f), src.Text(f));
    m.Verify();
    string listing = string.New();
    PrintModule(m, ref listing);
    write(1, listing);
    return EXIT_OK;
}

void BuildUsage() {
    write(2, "usage: envoc build <file.envo>... -o <output> [--target x86_64-windows|x86_64-linux]\n");
    exit(EXIT_USAGE);
}

// The arguments of `build` and `eir`: the files, -o <output>, --target <triple>.
struct BuildArgs {
    List<usize> Files;      // argument indexes
    str Output;
    u32 Target;
}

BuildArgs ParseBuildArgs(usize argi) {
    BuildArgs b = new BuildArgs { Files = List<usize>.New(), Output = "", Target = TARGET_LINUX };
    if (Same(HostTarget(), "x86_64-windows")) b.Target = TARGET_WINDOWS;
    usize i = argi;
    while (i < argc()) {
        str a = arg(i);
        if (Same(a, "-o")) {
            if (i + 1 >= argc()) BuildUsage();
            b.Output = arg(i + 1);
            i += 2;
        } else if (Same(a, "--target")) {
            if (i + 1 >= argc()) BuildUsage();
            str t = arg(i + 1);
            if (Same(t, "x86_64-windows")) b.Target = TARGET_WINDOWS;
            else if (Same(t, "x86_64-linux")) b.Target = TARGET_LINUX;
            else BuildUsage();
            i += 2;
        } else {
            b.Files.Push(i);
            i++;
        }
    }
    return b;
}

// Compiles the program in the given files, with the runtime for target, to an EIR module.
Module CompileProgram(ref Sources src, in List<usize> files, u32 target, bool core, bool verify) {
    foreach (var i in files.AsSlice()) Load(ref src, arg(i));
    src.Add("<runtime>/common.envo", string.From(RUNTIME_0));
    if (target == TARGET_WINDOWS) src.Add("<runtime>/windows.envo", string.From(RUNTIME_2));
    else src.Add("<runtime>/linux.envo", string.From(RUNTIME_1));
    u32 prelude = 0xFFFFFFFF;
    if (!core) prelude = src.Add("<prelude>/prelude.envo", string.From(RUNTIME_3)) as u32;
    List<usize> starts = List<usize>.New();
    List<Token> toks = LexAll(src, ref starts, core);
    Tree tree = Parse(src, toks, starts, core);
    Checker c = Checker.New(src, tree, core, true);
    c.PreludeFile = prelude;
    c.CheckProgram();
    Lower l = Lower.New(c, target);
    l.LowerProgram();
    Module m = l.TakeModule();
    if (verify) m.Verify();
    return m;
}

// `envoc build <file.envo>... -o <output> [--target …]`
i32 CmdBuild(usize argi, bool core) {
    BuildArgs b = ParseBuildArgs(argi);
    if (b.Files.Len() == 0 || b.Output.Len == 0) BuildUsage();
    Sources src = Sources.New();
    Module m = CompileProgram(ref src, b.Files, b.Target, core, true);
    string image = GenModule(ref m, b.Target);
    if (!WriteFile(b.Output, image, true)) {
        write(2, "envoc: error: cannot write '");
        write(2, b.Output);
        write(2, "'\n");
        return EXIT_ERRORS;
    }
    return EXIT_OK;
}

// `envoc eir <file.envo>... [--target …]`: the program's EIR, runtime included.
i32 CmdEir(usize argi, bool core) {
    BuildArgs b = ParseBuildArgs(argi);
    if (b.Files.Len() == 0) BuildUsage();
    Sources src = Sources.New();
    Module m = CompileProgram(ref src, b.Files, b.Target, core, false);     // eir-check the output to verify it
    string listing = string.New();
    PrintModule(m, ref listing);
    write(1, listing);
    return EXIT_OK;
}

usize argi = 1;
bool core = false;
if (argi < argc() && Same(arg(argi), "--core")) {
    core = true;
    argi++;
}
if (argi >= argc()) {
    Usage(2);
    return EXIT_USAGE;
}
str command = arg(argi);
argi++;
if (Same(command, "version") || Same(command, "--version")) {
    string v = string.From(VERSION);
    v.Append(HostTarget());
    v.Append(")\n");
    write(1, v);
    return EXIT_OK;
}
if (Same(command, "selftest")) {
    SelfTest();
    return EXIT_OK;
}
if (Same(command, "lex")) return CmdLex(argi, core);
if (Same(command, "parse")) return CmdParse(argi, core);
if (Same(command, "check")) return CmdCheck(argi, core);
if (Same(command, "eir-check")) return CmdEirCheck(argi);
if (Same(command, "eir")) return CmdEir(argi, core);
if (Same(command, "build")) return CmdBuild(argi, core);
if (Same(command, "help") || Same(command, "--help")) {
    Usage(1);
    return EXIT_OK;
}
string msg = string.From("unknown command '");
msg.Append(command);
msg.Append("'; run `envoc help` for the list");
ToolFail(msg, EXIT_USAGE);
