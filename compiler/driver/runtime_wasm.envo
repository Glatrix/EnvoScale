const str RUNTIME_WASM = "// The Stage 2 runtime, part 2 for WebAssembly (PLAN D48, D49): the OS layer over the\n// host's functions, reached through the target intrinsic __hostcall(k, a, b, c, d). The\n// host is adapters/interop/js/envo.js, in Node.js or a browser. k:\n//   0 grow the memory by a bytes: the old end, or -1\n//   1 write(fd a, ptr b, len c)       2 read(fd a, ptr b, len c)\n//   3 exit(code a)                    4 the argument count\n//   5 argument a's length             6 copy argument a to ptr b\n//   7 open(ptr a, len b, mode c)      8 close(fd a)\n// Compiled into every wasm32-web program with runtime/common.envo; embedded in envoc as\n// compiler/driver/runtime_wasm.envo.\n\ni64 __os_ptr(*u8 p) {\n    unsafe { return p as isize as i64; }\n}\n\nvoid __os_init(i64 sp) {\n    usize argc = __hostcall(4, 0, 0, 0, 0) as usize;\n    *str args = __rt_str_array(argc);\n    unsafe {\n        for (usize i = 0; i < argc; i++) {\n            usize n = __hostcall(5, i as i64, 0, 0, 0) as usize;\n            *u8 p = __rt_alloc(n + 1);\n            __hostcall(6, i as i64, __os_ptr(p), 0, 0);\n            args[i] = str_from(p, n);\n        }\n    }\n    __rt_set_args(argc, args);\n}\n\nisize __os_write(i32 fd, *u8 p, usize n) {\n    return __hostcall(1, fd as i64, __os_ptr(p), n as i64, 0) as isize;\n}\n\nisize __os_read(i32 fd, *u8 p, usize n) {\n    return __hostcall(2, fd as i64, __os_ptr(p), n as i64, 0) as isize;\n}\n\ni32 __os_open(*u8 path, usize len, i32 mode) {\n    return __hostcall(7, __os_ptr(path), len as i64, mode as i64, 0) as i32;\n}\n\nvoid __os_close(i32 fd) {\n    if (fd < 3) return;\n    __hostcall(8, fd as i64, 0, 0, 0);\n}\n\n// Zeroed memory (new pages are), or null.\n*u8 __os_pages(usize n) {\n    i64 r = __hostcall(0, n as i64, 0, 0, 0);\n    unsafe {\n        if (r < 0) return 0 as usize as *u8;\n        return r as isize as *u8;\n    }\n}\n\nvoid __os_exit(i32 code) {\n    __hostcall(3, code as i64, 0, 0, 0);\n}\n";
