const str RUNTIME_0 = "// The Envo-S1 prelude (docs/spec/envo-s1.md section 8). envoc1 compiles it with every\n// Envo-S1 program and imports it implicitly; a program's own items hide prelude items of\n// the same name, so every Envo-Core program means what it did ([s1.subset.2]). `Copy` is\n// built into the checker: it is implemented automatically ([type.copy.1]).\n//\n// M2.10 brought the interfaces ownership needs, M2.11 Option and Result, and M2.12 List\n// and string.\n\n// Runs when a value is dropped: at the end of its owner's scope, unless it was moved\n// ([own.drop.1], [s1.own.2]).\ninterface IDrop {\n    void Drop(ref this);\n}\n\ninterface IEquatable<T> {\n    bool Equals(in T other);\n}\n\ninterface IHash {\n    u64 Hash();\n}\n\n// An explicit copy of a value that is not `Copy` ([own.move.3]).\ninterface IClone<T> {\n    T Clone();\n}\n\n// An optional value ([type.opt.1]): `T?` is `Option<T>`, `null` is `None`, `a ?? b` is the\n// value or `b`, and a postfix `?` returns `None` early ([expr.q.1]).\nenum Option<T> {\n    None,\n    Some(T value),\n}\n\nimpl<T> Option<T> {\n    bool IsSome() => match this { Some(_) => true, None => false };\n    bool IsNone() => match this { Some(_) => false, None => true };\n\n    // The value; panics on `None`.\n    T Unwrap(this) {\n        match this {\n            Some(v) => { return v; }\n            None => { panic(\"called `Unwrap` on `None`\"); }\n        }\n    }\n\n    T UnwrapOr(this, T other) => match this { Some(v) => v, None => other };\n}\n\n// A value or an error (chapter 2, section 2.4); a postfix `?` returns the error early.\nenum Result<T, E> {\n    Ok(T value),\n    Err(E error),\n}\n\nimpl<T, E> Result<T, E> {\n    bool IsOk() => match this { Ok(_) => true, Err(_) => false };\n    bool IsErr() => match this { Ok(_) => false, Err(_) => true };\n\n    // The value; panics on an error.\n    T Unwrap(this) {\n        match this {\n            Ok(v) => { return v; }\n            Err(_) => { panic(\"called `Unwrap` on an `Err`\"); }\n        }\n    }\n\n    // The error; panics on a value.\n    E UnwrapErr(this) {\n        match this {\n            Ok(_) => { panic(\"called `UnwrapErr` on an `Ok`\"); }\n            Err(e) => { return e; }\n        }\n    }\n}\n\n// A growable list on the heap (envo-s1.md section 8). It owns its items: dropping the\n// list drops them.\nstruct List<T> {\n    *T Data;\n    usize Count;\n    usize Cap;\n\n    static List<T> New() {\n        unsafe { return new List<T> { Data = 0 as usize as *T, Count = 0, Cap = 0 }; }\n    }\n\n    usize Len() => this.Count;\n\n    void Push(ref this, T item) {\n        if (this.Count == this.Cap) this.Grow();\n        // writing through a raw pointer stores without dropping (the slot is empty)\n        unsafe { this.Data[this.Count] = item; }\n        this.Count++;\n    }\n\n    T? Pop(ref this) {\n        if (this.Count == 0) return null;\n        this.Count--;\n        unsafe {\n            // reading through a raw pointer takes the item\n            T item = this.Data[this.Count];\n            return Some(item);\n        }\n    }\n\n    // A copy of item i; panics if i is out of bounds. Borrow other items through AsSlice.\n    T Get(usize i) where T : Copy {\n        if (i >= this.Count) panic(\"index out of bounds\");\n        unsafe { return this.Data[i]; }\n    }\n\n    void Set(ref this, usize i, T item) {\n        if (i >= this.Count) panic(\"index out of bounds\");\n        unsafe {\n            T old = this.Data[i];       // dropped at the end of this block\n            this.Data[i] = item;\n        }\n    }\n\n    T[] AsSlice() {\n        unsafe { return slice_from(this.Data, this.Count); }\n    }\n\n    mut T[] AsMutSlice(ref this) {\n        unsafe { return slice_from_mut(this.Data, this.Count); }\n    }\n\n    void Grow(ref this) {\n        usize cap = this.Cap * 2;\n        if (cap == 0) cap = 4;\n        unsafe {\n            *T fresh = alloc(cap * sizeof(T)) as *T;\n            for (usize i = 0; i < this.Count; i++) fresh[i] = this.Data[i];\n            free(this.Data as *u8);\n            this.Data = fresh;\n        }\n        this.Cap = cap;\n    }\n}\n\nimpl<T> IDrop for List<T> {\n    void Drop(ref this) {\n        unsafe {\n            for (usize i = 0; i < this.Count; i++) {\n                T item = this.Data[i];      // taken, then dropped at the end of the block\n            }\n            free(this.Data as *u8);\n        }\n    }\n}\n\n// Owned UTF-8 text (envo-s1.md section 8). A `string` converts to `str`, a shared borrow\n// of its bytes, wherever a `str` is expected.\nstruct string {\n    *u8 Data;\n    usize Count;\n    usize Cap;\n\n    static string New() {\n        unsafe { return new string { Data = 0 as usize as *u8, Count = 0, Cap = 0 }; }\n    }\n\n    static string From(str s) {\n        string r = string.New();\n        r.Append(s);\n        return r;\n    }\n\n    usize Len() => this.Count;\n\n    void Append(ref this, str s) {\n        this.Reserve(s.Len);\n        unsafe {\n            for (usize i = 0; i < s.Len; i++) this.Data[this.Count + i] = s[i];\n        }\n        this.Count += s.Len;\n    }\n\n    void AppendByte(ref this, u8 b) {\n        this.Reserve(1);\n        unsafe { this.Data[this.Count] = b; }\n        this.Count++;\n    }\n\n    str AsStr() {\n        unsafe { return str_from(this.Data, this.Count); }\n    }\n\n    bool Equals(str other) {\n        if (other.Len != this.Count) return false;\n        unsafe {\n            for (usize i = 0; i < this.Count; i++) {\n                if (this.Data[i] != other[i]) return false;\n            }\n        }\n        return true;\n    }\n\n    // Room for n more bytes.\n    void Reserve(ref this, usize n) {\n        if (this.Count + n <= this.Cap) return;\n        usize cap = this.Cap * 2;\n        if (cap < this.Count + n) cap = this.Count + n;\n        if (cap < 16) cap = 16;\n        unsafe {\n            *u8 fresh = alloc(cap);\n            for (usize i = 0; i < this.Count; i++) fresh[i] = this.Data[i];\n            free(this.Data);\n            this.Data = fresh;\n        }\n        this.Cap = cap;\n    }\n}\n\nimpl IDrop for string {\n    void Drop(ref this) {\n        unsafe { free(this.Data); }\n    }\n}\n";
