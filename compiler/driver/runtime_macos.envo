// compiler/runtime/macos_aarch64.envo
const str RUNTIME_MACOS = "// The Stage 2 runtime, part 2 for macOS on arm64 (M10, PLAN D70): the OS layer over BSD\n// system calls (number in x16, `svc #0x80`; the backend turns a failure into a negative\n// errno, as on Linux). dyld calls the entry as main(argc, argv), so __os_init gets the\n// address of the pair. __syscall(n, a1, …, a6) is a target intrinsic the backend encodes.\n// Compiled into every aarch64-macos program with runtime/common.envo; embedded in envoc as\n// compiler/driver/runtime_macos.envo.\n\ni64 __os_ptr(*u8 p) {\n    unsafe { return p as isize as i64; }\n}\n\nvoid __os_init(i64 sp) {\n    unsafe {\n        *u64 pair = sp as isize as *u64;\n        usize argc = pair[0] as usize;\n        **u8 argv = pair[1] as isize as **u8;\n        *str args = __rt_str_array(argc);\n        for (usize i = 0; i < argc; i++) {\n            *u8 a = argv[i];\n            args[i] = str_from(a, __rt_cstr_len(a));\n        }\n        __rt_set_args(argc, args);\n    }\n}\n\n// Retries on EINTR.\nisize __os_write(i32 fd, *u8 p, usize n) {\n    while (true) {\n        i64 r = __syscall(4, fd as i64, __os_ptr(p), n as i64, 0, 0, 0);\n        if (r != -4) return r as isize;\n    }\n}\n\nisize __os_read(i32 fd, *u8 p, usize n) {\n    while (true) {\n        i64 r = __syscall(3, fd as i64, __os_ptr(p), n as i64, 0, 0, 0);\n        if (r != -4) return r as isize;\n    }\n}\n\n// mode 0 = read, 1 = write (create/truncate, 0644), 2 = the same, executable (0755).\n// A path with a NUL byte fails: the system would read only the part before it.\ni32 __os_open(*u8 path, usize len, i32 mode) {\n    *u8 z = __rt_alloc(len + 1);       // zeroed, so the copy ends in NUL\n    unsafe {\n        for (usize i = 0; i < len; i++) {\n            if (path[i] == 0) return -1;\n            z[i] = path[i];\n        }\n    }\n    i64 flags = 0x1000000;             // O_RDONLY | O_CLOEXEC\n    i64 perm = 0;\n    if (mode != 0) {\n        flags = 0x1000601;             // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC\n        perm = 0x1A4;                  // 0644\n        if (mode == 2) perm = 0x1ED;   // 0755\n    }\n    return __syscall(5, __os_ptr(z), flags, perm, 0, 0, 0) as i32;\n}\n\n// fds 0-2 are left open, as on Windows.\nvoid __os_close(i32 fd) {\n    if (fd < 3) return;\n    __syscall(6, fd as i64, 0, 0, 0, 0, 0);\n}\n\n// Zeroed, page-aligned memory, or null.\n*u8 __os_pages(usize n) {\n    i64 r = __syscall(197, 0, n as i64, 3, 0x1002, -1, 0);  // mmap: RW, private, anonymous\n    unsafe {\n        if (r < 0 && r >= -4095) return 0 as usize as *u8;\n        return r as isize as *u8;\n    }\n}\n\nvoid __os_exit(i32 code) {\n    __syscall(1, code as i64, 0, 0, 0, 0, 0);            // exit\n}\n";
