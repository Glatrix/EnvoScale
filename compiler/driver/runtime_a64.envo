= 0x1A4;                  // 0644\n        if (mode == 2) perm = 0x1ED;   // 0755\n    }\n    return __syscall(56, -100, __os_ptr(z), flags, perm, 0, 0) as i32;     // openat(AT_FDCWD, …)\n}\n\n// fds 0-2 are left open, as on Windows.\nvoid __os_close(i32 fd) {\n    if (fd < 3) return;\n    __syscall(57, fd as i64, 0, 0, 0, 0, 0);\n}\n\n// Zeroed, page-aligned memory, or null.\n*u8 __os_pages(usize n) {\n    i64 r = __syscall(222, 0, n as i64, 3, 0x22, -1, 0);    // mmap: RW, private, anonymous\n    unsafe {\n        if (r < 0 && r >= -4095) return 0 as usize as *u8;\n        return r as isize as *u8;\n    }\n}\n\nvoid __os_exit(i32 code) {\n    __syscall(94, code as i64, 0, 0, 0, 0, 0);           // exit_group\n}\n";
