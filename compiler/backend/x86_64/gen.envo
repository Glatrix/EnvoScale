// The x86-64 backend at -O0. Follows Stage 1's bootstrap/stage1/x64/gen.envo, so
// `envoc build` writes the same bytes as `envoc1 build`: every SSA value lives in its own
// rbp slot; each instruction loads its operands into fixed registers, computes and stores
// its result. Values are kept canonical (sign- or zero-extended to 64 bits), so overflow
// checks are the CPU flags for 64-bit types and "does it survive re-normalization" for
// narrower ones.
namespace envoc.x64;

use envoc.util;
use envoc.diag;
use envoc.eir;

const u64 TRAP_OVERFLOW = 0;
const u64 TRAP_BOUNDS = 1;
const u64 TRAP_DIVISION = 2;
const u64 TRAP_SHIFT = 4;
const u64 TRAP_UNREACHABLE = 5;
const u64 TRAP_UTF8 = 6;

void Bug(str msg) => ToolFail(msg, EXIT_INTERNAL);

struct Gen {
    Asm A;
    u32 Target;
    List<u32> FuncLabels;   // per function
    List<u32> GlobalLabels; // per global
    List<u32> BlockLabels;  // per block (module-wide index)
    List<u32> Traps;        // per panic reason: the shared stub's label, 0 until used
    u32 Func;               // the function being generated
    u32 FirstValue;
    u32 NParams;
    WinImports Imports;

    // ------------------------------------------------------------------ helpers

    // The rbp offset of value v: parameters are the caller's argument slots, others are
    // below the frame pointer.
    i32 VOff(in this, u32 v) {
        u32 k = v - this.FirstValue;
        if (k < this.NParams) return (16 + 8 * k) as i32;
        return 0 - (8 * (k + 1)) as i32;
    }

    void LoadV(ref this, u8 r, u32 v) {
        i32 off = this.VOff(v);
        this.A.Load(r, RBP, off, 8, false);
    }

    void StoreV(ref this, u32 v, u8 r) {
        i32 off = this.VOff(v);
        this.A.Store(RBP, off, r, 8);
    }

    // The value of operand o (a value or an integer) into register r.
    void LoadOp(ref this, in Module m, u8 r, u32 o) {
        EOp op = m.Op(o);
        if (op.Kind == OK_VALUE) this.LoadV(r, op.Ref);
        else this.A.MovRI(r, op.Int);
    }

    // The label of the shared stub that panics with reason i.
    u32 TrapLabel(ref this, u64 reason) {
        u32 l = this.Traps.Get(reason as usize);
        if (l == 0) {
            l = this.A.NewLabel();
            this.Traps.Set(reason as usize, l);
        }
        return l;
    }

    // Panics with reason unless r survives re-normalization to type t (narrow types).
    void CheckNormal(ref this, in Module m, u8 r, u32 t) {
        ETy ty = m.Ty(t);
        this.A.MovRR(R11, r);
        this.A.Extend(R11, ty.Size, m.IsSigned(t));
        this.A.Alu(ALU_CMP, R11, r);
        u32 trap = this.TrapLabel(TRAP_OVERFLOW);
        this.A.Jcc(CC_NE, trap);
    }

    u32 FuncNamed(in this, in Module m, str name) {
        u64? named = m.Names.Get(name);
        if (named.IsNone() || named.Unwrap() >> 32 != NAME_FUNC) {
            string b = string.From("x64: the runtime has no function ");
            b.Append(name);
            Bug(b);
        }
        return (named.Unwrap() & 0xFFFFFFFF) as u32;
    }

    // ------------------------------------------------------------------ branches

    // Moves branch target o's arguments into the target block's parameters (a parallel
    // copy through the stack) and jumps there.
    void Jump(ref this, in Module m, u32 o) {
        EOp op = m.Op(o);
        EBlock target = m.Block(op.Ref);
        for (u32 i = 0; i < op.NArgs; i++) {
            this.LoadV(RAX, m.Arg(op.Args + i));
            this.A.Push(RAX);
        }
        u32 i = op.NArgs;
        while (i > 0) {
            i--;
            this.A.Pop(RAX);
            this.StoreV(target.FirstParam + i, RAX);
        }
        this.A.Jmp(this.BlockLabels.Get(op.Ref as usize));
    }

    // ------------------------------------------------------------------ instructions

    void Inst(ref this, in Module m, u32 i) {
        EInst inst = m.Inst(i);
        OpInfo info = OpTable(inst.Op);
        u16 op = inst.Op;
        u8 sh = info.Shape;
        u32 f = inst.FirstOp;
        u32 n = inst.NOps;
        u32 t = inst.Ty;
        ETy ty = m.Ty(t);
        bool signed = m.IsSigned(t);
        if (sh == SH_CONST) {
            this.A.MovRI(RAX, inst.Imm);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_ADDR) {
            EOp rf = m.Op(f);
            if (rf.Int == NAME_FUNC) this.A.LeaLabel(RAX, this.FuncLabels.Get(rf.Ref as usize));
            else this.A.LeaLabel(RAX, this.GlobalLabels.Get(rf.Ref as usize));
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_SLOT) {
            // the address was computed when the frame was laid out; see Func
            this.A.LeaRM(RAX, RBP, inst.Imm as i32);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_UNARY_V) {
            // slot.end: storage is never reused at -O0
        } else if (sh == SH_BIN) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            if (op == 5 || op == 8) this.A.Alu(ALU_ADD, RAX, RCX);
            else if (op == 6 || op == 9) this.A.Alu(ALU_SUB, RAX, RCX);
            else if (op == 7) this.A.ImulRR(RAX, RCX);
            else if (op == 10) {
                if (ty.Size == 8 && !signed) this.A.Group3(4, RCX);     // mul rcx: CF/OF if the high half is set
                else this.A.ImulRR(RAX, RCX);
            } else if (op == 12 || op == 13) {
                this.A.TestRR(RCX, RCX);
                u32 divTrap = this.TrapLabel(TRAP_DIVISION);
                this.A.Jcc(CC_E, divTrap);
                if (signed) {
                    if (ty.Size == 8) {
                        // MIN / -1 overflows (and would fault)
                        u32 ok = this.A.NewLabel();
                        this.A.AluImm(7, RCX, -1);
                        this.A.Jcc(CC_NE, ok);
                        this.A.MovRI(RDX, 0x8000000000000000);
                        this.A.Alu(ALU_CMP, RAX, RDX);
                        u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                        this.A.Jcc(CC_E, ovTrap);
                        this.A.Bind(ok);
                    }
                    this.A.Cqo();
                    this.A.Group3(7, RCX);
                } else {
                    this.A.Alu(ALU_XOR, RDX, RDX);
                    this.A.Group3(6, RCX);
                }
                if (op == 13) this.A.MovRR(RAX, RDX);
            } else if (op == 14) this.A.Alu(ALU_AND, RAX, RCX);
            else if (op == 15) this.A.Alu(ALU_OR, RAX, RCX);
            else if (op == 16) this.A.Alu(ALU_XOR, RAX, RCX);
            else if (op == OP_SHL || op == OP_SHR) {
                if (signed) {
                    this.A.TestRR(RCX, RCX);
                    u32 shTrap = this.TrapLabel(TRAP_SHIFT);
                    this.A.Jcc(CC_L, shTrap);
                }
                this.A.AluImm(7, RCX, (ty.Size * 8) as i32);
                u32 shTrap2 = this.TrapLabel(TRAP_SHIFT);
                this.A.Jcc(CC_AE, shTrap2);
                if (op == OP_SHL) this.A.ShiftCl(4, RAX);
                else if (signed) this.A.ShiftCl(7, RAX);
                else this.A.ShiftCl(5, RAX);
            } else {
                Bug("x64: floating-point instructions are not supported by the -O0 backend");
            }
            // checks and re-normalization
            if (op == 8 || op == 9 || op == 10) {
                if (ty.Size == 8) {
                    u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                    if (signed || op == 10) this.A.Jcc(CC_O, ovTrap);
                    else this.A.Jcc(CC_B, ovTrap);
                } else {
                    this.CheckNormal(m, RAX, t);
                }
            } else if (op == 12) {
                if (ty.Size != 8) this.CheckNormal(m, RAX, t);
            } else if (t != ET_BOOL) {
                this.A.Extend(RAX, ty.Size, signed);
            }
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_UN) {
            this.LoadOp(m, RAX, f);
            if (op == 11) {
                if (signed) {
                    this.A.Group3(3, RAX);
                    if (ty.Size == 8) {
                        u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                        this.A.Jcc(CC_O, ovTrap);
                    } else this.CheckNormal(m, RAX, t);
                } else {
                    this.A.TestRR(RAX, RAX);
                    u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                    this.A.Jcc(CC_NE, ovTrap);
                }
            } else if (op == 17) {
                if (t == ET_BOOL) {
                    this.A.AluImm(6, RAX, 1);       // xor rax, 1
                } else {
                    this.A.Group3(2, RAX);
                    this.A.Extend(RAX, ty.Size, signed);
                }
            } else {
                Bug("x64: floating-point instructions are not supported by the -O0 backend");
            }
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_CMP) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            this.A.Alu(ALU_CMP, RAX, RCX);
            u8 cc = CC_E;
            if (op == 21) cc = CC_NE;
            if (op == 22) cc = CC_B;
            if (op == 23) cc = CC_BE;
            if (op == 24) cc = CC_A;
            if (op == 25) cc = CC_AE;
            if (signed && op == 22) cc = CC_L;
            if (signed && op == 23) cc = CC_LE;
            if (signed && op == 24) cc = CC_G;
            if (signed && op == 25) cc = CC_GE;
            this.A.SetCC(cc, RAX);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_SELECT) {
            u32 done = this.A.NewLabel();
            this.LoadOp(m, RAX, f + 1);
            this.LoadOp(m, RCX, f);
            this.A.TestRR(RCX, RCX);
            this.A.Jcc(CC_NE, done);
            this.LoadOp(m, RAX, f + 2);
            this.A.Bind(done);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_CONV) {
            this.LoadOp(m, RAX, f);
            ETy to = m.Ty(inst.Ty2);
            bool toSigned = m.IsSigned(inst.Ty2);
            if (op == 32 || op == 41) {
                this.A.Extend(RAX, to.Size, toSigned);
            } else if (op == 33) {
                this.A.Extend(RAX, ty.Size, false);
                this.A.Extend(RAX, to.Size, toSigned);
            } else if (op == 34) {
                this.A.Extend(RAX, ty.Size, true);
                this.A.Extend(RAX, to.Size, toSigned);
            } else if (op != 39 && op != 40) {
                Bug("x64: floating-point conversions are not supported by the -O0 backend");
            }
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_LOAD) {
            this.LoadOp(m, RCX, f);
            this.A.Load(RAX, RCX, 0, ty.Size, signed);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_STORE) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            this.A.Store(RCX, 0, RAX, ty.Size);
        } else if (sh == SH_FIELD) {
            this.LoadOp(m, RAX, f);
            this.A.LeaRM(RAX, RAX, m.FieldOffset(t, inst.Imm as u32) as i32);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_ELEM) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            this.A.MovRI(RDX, ty.Size as u64);
            this.A.ImulRR(RCX, RDX);
            this.A.Alu(ALU_ADD, RAX, RCX);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_PTRADD) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            this.A.Alu(ALU_ADD, RAX, RCX);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_VALUES) {
            if (op == 47) {
                this.LoadOp(m, RDI, f);
                this.LoadOp(m, RSI, f + 1);
                this.LoadOp(m, RCX, f + 2);
                this.A.RepMovsb();
            } else if (op == 48) {
                this.LoadOp(m, RDI, f);
                this.LoadOp(m, RCX, f + 1);
                this.A.Alu(ALU_XOR, RAX, RAX);
                this.A.RepStosb();
            } else if (op == 50) {
                this.LoadOp(m, RAX, f);
                this.LoadOp(m, RCX, f + 1);
                this.LoadOp(m, RDX, f + 2);
                this.A.Alu(ALU_CMP, RAX, RCX);
                u32 b1 = this.TrapLabel(TRAP_BOUNDS);
                this.A.Jcc(CC_A, b1);
                this.A.Alu(ALU_CMP, RCX, RDX);
                u32 b2 = this.TrapLabel(TRAP_BOUNDS);
                this.A.Jcc(CC_A, b2);
            } else {
                u32 ok = this.A.NewLabel();
                this.LoadOp(m, RDX, f);
                this.LoadOp(m, RCX, f + 1);
                this.LoadOp(m, RAX, f + 2);
                this.A.TestRR(RAX, RAX);
                this.A.Jcc(CC_E, ok);
                this.A.Alu(ALU_CMP, RAX, RCX);
                this.A.Jcc(CC_E, ok);
                this.A.Alu(ALU_ADD, RDX, RAX);
                this.A.Load(RDX, RDX, 0, 1, false);
                this.A.AluImm(4, RDX, 0xC0);
                this.A.AluImm(7, RDX, 0x80);
                u32 u8Trap = this.TrapLabel(TRAP_UTF8);
                this.A.Jcc(CC_E, u8Trap);
                this.A.Bind(ok);
            }
        } else if (sh == SH_BOUNDS) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            if (signed) {
                this.A.TestRR(RAX, RAX);
                u32 b1 = this.TrapLabel(TRAP_BOUNDS);
                this.A.Jcc(CC_L, b1);
            }
            this.A.Alu(ALU_CMP, RAX, RCX);
            u32 b2 = this.TrapLabel(TRAP_BOUNDS);
            this.A.Jcc(CC_AE, b2);
        } else if (sh == SH_CALL || sh == SH_CALLIND) {
            u32 first = 1;
            u32 count = n - 1;
            if (sh == SH_CALLIND) {
                if (inst.Str.Len > 0) Bug("x64: calls with a foreign ABI are not supported by the -O0 backend");
                first = 0;
            }
            i32 reserve = ((8 * count + 15) & ~15) as i32;
            if (reserve > 0) this.A.AluImm(5, RSP, reserve);
            for (u32 k = 0; k < count; k++) {
                this.LoadOp(m, RAX, f + first + k);
                this.A.Store(RSP, (8 * k) as i32, RAX, 8);
            }
            if (sh == SH_CALL) {
                this.A.CallLabel(this.FuncLabels.Get(m.Op(f).Ref as usize));
            } else {
                this.LoadOp(m, RAX, f + n - 1);
                this.A.CallR(RAX);
            }
            if (reserve > 0) this.A.AluImm(0, RSP, reserve);
            if (inst.Result != 0) this.StoreV(inst.Result, RAX);
        } else if (sh == SH_INTRINSIC) {
            this.Intrinsic(m, inst);
        } else if (sh == SH_BR) {
            this.Jump(m, f);
        } else if (sh == SH_CONDBR) {
            u32 other = this.A.NewLabel();
            this.LoadOp(m, RAX, f);
            this.A.TestRR(RAX, RAX);
            this.A.Jcc(CC_E, other);
            this.Jump(m, f + 1);
            this.A.Bind(other);
            this.Jump(m, f + 2);
        } else if (sh == SH_SWITCH) {
            u32 k = 1;
            while (k + 1 < n) {
                u32 next = this.A.NewLabel();
                this.LoadOp(m, RAX, f);
                this.A.MovRI(RCX, m.Op(f + k).Int);
                this.A.Alu(ALU_CMP, RAX, RCX);
                this.A.Jcc(CC_NE, next);
                this.Jump(m, f + k + 1);
                this.A.Bind(next);
                k += 2;
            }
            this.Jump(m, f + n - 1);
        } else if (sh == SH_RET) {
            if (n == 1) this.LoadOp(m, RAX, f);
            this.A.MovRR(RSP, RBP);
            this.A.Pop(RBP);
            this.A.RetNear();
        } else if (sh == SH_PANIC) {
            u32 trap = this.TrapLabel(inst.Imm);
            this.A.Jmp(trap);
        } else {
            u32 trap = this.TrapLabel(TRAP_UNREACHABLE);
            this.A.Jmp(trap);
        }
    }

    // Target intrinsics: `syscall` on Linux, `wincall` on Windows.
    void Intrinsic(ref this, in Module m, EInst inst) {
        u32 f = inst.FirstOp;
        u32 n = inst.NOps;
        if (TextIs(inst.Str, "syscall")) {
            if (this.Target != TARGET_LINUX) Bug("x64: syscall on a non-Linux target");
            u8[6] regs;
            regs[0] = RDI;
            regs[1] = RSI;
            regs[2] = RDX;
            regs[3] = R10;
            regs[4] = R8;
            regs[5] = R9;
            for (u32 k = 1; k < n; k++) this.LoadOp(m, regs[k - 1], f + k);
            this.LoadOp(m, RAX, f);
            this.A.Syscall();
        } else if (TextIs(inst.Str, "wincall")) {
            if (this.Target != TARGET_WINDOWS) Bug("x64: wincall on a non-Windows target");
            u32 args = n - 1;
            u32 stackArgs = 0;
            if (args > 4) stackArgs = args - 4;
            i32 reserve = ((32 + 8 * stackArgs + 15) & ~15) as i32;
            this.A.AluImm(5, RSP, reserve);
            // the import's IAT slot: iat + 8 * k, in r10 (not an argument register)
            this.A.LeaLabel(R10, this.Imports.Iat);
            this.LoadOp(m, R11, f);
            this.A.MovRI(RAX, 8);
            this.A.ImulRR(R11, RAX);
            this.A.Alu(ALU_ADD, R10, R11);
            for (u32 k = 4; k < args; k++) {
                this.LoadOp(m, RAX, f + 1 + k);
                this.A.Store(RSP, (32 + 8 * (k - 4)) as i32, RAX, 8);
            }
            u8[4] regs;
            regs[0] = RCX;
            regs[1] = RDX;
            regs[2] = R8;
            regs[3] = R9;
            for (u32 k = 0; k < args && k < 4; k++) this.LoadOp(m, regs[k], f + 1 + k);
            this.A.CallMem(R10);
            this.A.AluImm(0, RSP, reserve);
        } else {
            Bug("x64: portable intrinsics reach the backend only through the runtime");
        }
        if (inst.Result != 0) this.StoreV(inst.Result, RAX);
    }

    // ------------------------------------------------------------------ functions

    void Func(ref this, ref Module m, u32 fi) {
        EFunc f = m.Func(fi);
        if (f.Extern) Bug("x64: extern functions are not supported by the -O0 backend");
        this.Func = fi;
        this.FirstValue = f.FirstValue;
        this.NParams = f.NParams;
        this.A.Bind(this.FuncLabels.Get(fi as usize));
        // frame: value slots, then the storage of `slot` instructions (zeroed on entry)
        u64 valueArea = 8 * f.NValues as u64;
        u64 slotArea = 0;
        EBlock entry = m.Block(f.FirstBlock);
        for (u32 i = entry.FirstInst; i < entry.FirstInst + entry.NInsts; i++) {
            EInst inst = m.Inst(i);
            if (inst.Op != OP_SLOT) break;
            ETy st = m.Ty(inst.Ty);
            u64 align = st.Align as u64;
            if (align < 8) align = 8;
            slotArea = (slotArea + st.Size as u64 + align - 1) & ~(align - 1);
            inst.Imm = 0 -% (valueArea + slotArea);     // rbp offset of the storage
            m.Insts.Set(i as usize, inst);
        }
        u64 frame = (valueArea + slotArea + 15) & ~15;
        this.A.Push(RBP);
        this.A.MovRR(RBP, RSP);
        if (frame > 0) this.A.AluImm(5, RSP, frame as i32);
        if (slotArea > 0) {
            this.A.LeaRM(RDI, RBP, (0 -% (valueArea + slotArea)) as i32);
            this.A.MovRI(RCX, slotArea);
            this.A.Alu(ALU_XOR, RAX, RAX);
            this.A.RepStosb();
        }
        for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
            EBlock blk = m.Block(b);
            this.A.Bind(this.BlockLabels.Get(b as usize));
            for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) this.Inst(m, i);
        }
    }

    // ------------------------------------------------------------------ data

    // The bytes of initializer i for type t, appended to the data.
    void Init(ref this, in Module m, u32 i, u32 t) {
        EInit init = m.Init(i);
        ETy ty = m.Ty(t);
        usize start = this.A.Data.Len();
        if (init.Kind == EI_BYTES) {
            this.A.Data.Append(TextStr(init.Bytes));
        } else if (init.Kind == EI_INT) {
            for (u32 k = 0; k < ty.Size; k++) this.A.DataByte((init.Int >> (8 * k) as u64 & 0xFF) as u8);
        } else if (init.Kind == EI_ADDR) {
            u64 named = m.Names.Get(TextStr(init.Bytes)) ?? 0;
            u32 idx = (named & 0xFFFFFFFF) as u32;
            if (named >> 32 == NAME_FUNC) this.A.DataAddr(this.FuncLabels.Get(idx as usize));
            else this.A.DataAddr(this.GlobalLabels.Get(idx as usize));
        } else if (init.Kind == EI_LIST) {
            u32 e = init.First;
            u32 k = 0;
            while (e != 0) {
                u32 et = ty.Elem;
                u64 at = k as u64 * m.Ty(ty.Elem).Size as u64;
                if (ty.Kind == EK_STRUCT) {
                    et = m.Field(ty.Fields + k);
                    at = m.FieldOffset(t, k);
                }
                while (this.A.Data.Len() < start + at as usize) this.A.DataByte(0);
                this.Init(m, e, et);
                e = m.Init(e).Next;
                k++;
            }
        }
        while (this.A.Data.Len() < start + ty.Size as usize) this.A.DataByte(0);
    }
}

// Generates module m (verified and laid out) for target into a complete executable image.
public string GenModule(ref Module m, u32 target) {
    Gen g = new Gen {
        A = Asm.New(), Target = target, FuncLabels = List<u32>.New(), GlobalLabels = List<u32>.New(),
        BlockLabels = List<u32>.New(), Traps = List<u32>.New(), Func = 0, FirstValue = 0, NParams = 0,
        Imports = new WinImports { Dir = 0, Iat = 0 }
    };
    for (usize i = 0; i < m.Funcs.Len(); i++) g.FuncLabels.Push(0);
    for (usize i = 0; i < m.Globals.Len(); i++) g.GlobalLabels.Push(0);
    for (usize i = 0; i < m.Blocks.Len(); i++) g.BlockLabels.Push(0);
    for (u64 r = 0; r < PANIC_COUNT; r++) g.Traps.Push(0);
    for (u32 i = 1; i < m.Funcs.Len() as u32; i++) {
        u32 l = g.A.NewLabel();
        g.FuncLabels.Set(i as usize, l);
    }
    for (u32 i = 1; i < m.Blocks.Len() as u32; i++) {
        u32 l = g.A.NewLabel();
        g.BlockLabels.Set(i as usize, l);
    }
    for (u32 i = 1; i < m.Globals.Len() as u32; i++) {
        u32 l = g.A.NewLabel();
        g.GlobalLabels.Set(i as usize, l);
    }
    if (target == TARGET_WINDOWS) g.Imports = EmitImports(ref g.A);
    // the entry point: __rt_init(initial stack pointer), __main(), __rt_exit(code)
    g.A.MovRR(RAX, RSP);
    g.A.AluImm(4, RSP, -16);
    g.A.AluImm(5, RSP, 16);
    g.A.Store(RSP, 0, RAX, 8);
    u32 init = g.FuncLabels.Get(g.FuncNamed(m, "__rt_init") as usize);
    g.A.CallLabel(init);
    u32 main = g.FuncLabels.Get(g.FuncNamed(m, "__main") as usize);
    g.A.CallLabel(main);
    g.A.Store(RSP, 0, RAX, 8);
    u32 exitFn = g.FuncLabels.Get(g.FuncNamed(m, "__rt_exit") as usize);
    g.A.CallLabel(exitFn);
    g.A.Ud2();
    for (u32 i = 1; i < m.Funcs.Len() as u32; i++) g.Func(ref m, i);
    // the panic stubs: __rt_trap(reason)
    u32 trap = g.FuncLabels.Get(g.FuncNamed(m, "__rt_trap") as usize);
    for (u64 r = 0; r < PANIC_COUNT; r++) {
        u32 l = g.Traps.Get(r as usize);
        if (l == 0) continue;
        g.A.Bind(l);
        g.A.AluImm(5, RSP, 16);
        g.A.MovRI(RAX, r);
        g.A.Store(RSP, 0, RAX, 8);
        g.A.CallLabel(trap);
        g.A.Ud2();
    }
    for (u32 i = 1; i < m.Globals.Len() as u32; i++) {
        EGlobal gl = m.Global(i);
        ETy gt = m.Ty(gl.Type);
        usize align = gt.Align as usize;
        if (align < 8) align = 8;
        g.A.DataAlign(align);
        g.A.BindData(g.GlobalLabels.Get(i as usize));
        g.Init(m, gl.Init, gl.Type);
    }
    return WriteImage(ref g.A, target, g.Imports);
}
