// Executable images: one read-write-execute section at IMAGE_BASE. Follows Stage 1's
// bootstrap/stage1/x64/image.envo. Windows images import from KERNEL32.dll and
// ADVAPI32.dll; import k is the k-th slot of the address table, reached through `wincall`:
// KERNEL32's functions are 0-27, slot 28 ends them, ADVAPI32's SystemFunction036
// (RtlGenRandom) is slot 29 and slot 30 ends it, WS2_32's are slots 31-45, ended by
// slot 46, and CRYPT32's are slots 47-49, ended by slot 50 (PLAN D25, D28, D40, D41).
namespace envoc.x64;

use envoc.util;

const u64 IMAGE_BASE = 0x400000;
const u64 ELF_HEADERS = 176;        // ELF header (64) + 2 program headers (56 each)
const u64 PE_SECTION_RVA = 0x1000;

// The same values as envoc.lower's.
const u32 TARGET_LINUX = 1;
const u32 TARGET_WINDOWS = 2;

const u32 WIN_IMPORTS = 28;        // from KERNEL32.dll; then ADVAPI32's one, at slot 29
const u32 WS_IMPORTS = 15;         // from WS2_32.dll, at slots 31-45
const u32 CR_IMPORTS = 3;          // from CRYPT32.dll, at slots 47-49

// The KERNEL32.dll functions, by wincall index.
str WinImport(u32 k) {
    match k {
        0 => { return "GetStdHandle"; }
        1 => { return "GetCommandLineW"; }
        2 => { return "CreateFileW"; }
        3 => { return "ReadFile"; }
        4 => { return "WriteFile"; }
        5 => { return "CloseHandle"; }
        6 => { return "VirtualAlloc"; }
        7 => { return "VirtualFree"; }
        8 => { return "GetLastError"; }
        9 => { return "ExitProcess"; }
        10 => { return "MultiByteToWideChar"; }
        11 => { return "WideCharToMultiByte"; }
        12 => { return "GetSystemTimePreciseAsFileTime"; }
        13 => { return "QueryPerformanceCounter"; }
        14 => { return "QueryPerformanceFrequency"; }
        15 => { return "DeleteFileW"; }
        16 => { return "CreateDirectoryW"; }
        17 => { return "RemoveDirectoryW"; }
        18 => { return "GetFileAttributesW"; }
        19 => { return "CreateProcessW"; }
        20 => { return "WaitForSingleObject"; }
        21 => { return "GetExitCodeProcess"; }
        22 => { return "FindFirstFileW"; }
        23 => { return "FindNextFileW"; }
        24 => { return "FindClose"; }
        25 => { return "SetHandleInformation"; }
        26 => { return "GetEnvironmentVariableW"; }
        _ => { return "GetCurrentDirectoryW"; }
    }
}

// The WS2_32.dll functions (D40), by their index after ADVAPI32's: import slot 31 + k.
str WsImport(u32 k) {
    match k {
        0 => { return "WSAStartup"; }
        1 => { return "socket"; }
        2 => { return "connect"; }
        3 => { return "bind"; }
        4 => { return "listen"; }
        5 => { return "accept"; }
        6 => { return "send"; }
        7 => { return "recv"; }
        8 => { return "closesocket"; }
        9 => { return "getaddrinfo"; }
        10 => { return "freeaddrinfo"; }
        11 => { return "WSAGetLastError"; }
        12 => { return "setsockopt"; }
        13 => { return "shutdown"; }
        _ => { return "getsockname"; }
    }
}

// The CRYPT32.dll functions (D41), by their index after WS2_32's: import slot 47 + k.
str CrImport(u32 k) {
    match k {
        0 => { return "CertOpenSystemStoreW"; }
        1 => { return "CertEnumCertificatesInStore"; }
        _ => { return "CertCloseStore"; }
    }
}

struct WinImports {
    u32 Dir;        // the import directory (five descriptors, 100 bytes)
    u32 Iat;        // the first IAT entry; entry k is 8k bytes after it
}

// The import directory, lookup and address tables, hint/name entries and DLL name, in the
// data. Returns the labels the PE header and wincall need.
WinImports EmitImports(ref Asm a) {
    u32[28] names;
    u32[15] wsNames;
    u32[3] crNames;
    u32 ilt4 = a.NewLabel();
    u32 dll4 = a.NewLabel();
    u32 iat4 = a.NewLabel();
    u32 ilt3 = a.NewLabel();
    u32 dll3 = a.NewLabel();
    u32 iat3 = a.NewLabel();
    u32 ilt = a.NewLabel();
    u32 dll = a.NewLabel();
    u32 ilt2 = a.NewLabel();
    u32 dll2 = a.NewLabel();
    u32 iat2 = a.NewLabel();
    u32 name2 = a.NewLabel();
    u32 dir = a.NewLabel();
    u32 iat = a.NewLabel();
    for (u32 k = 0; k < WIN_IMPORTS; k++) names[k] = a.NewLabel();
    for (u32 k = 0; k < WS_IMPORTS; k++) wsNames[k] = a.NewLabel();
    for (u32 k = 0; k < CR_IMPORTS; k++) crNames[k] = a.NewLabel();
    a.DataAlign(8);
    a.BindData(dir);
    a.DataRva(ilt, 4);          // OriginalFirstThunk
    a.DataU32(0);               // TimeDateStamp
    a.DataU32(0);               // ForwarderChain
    a.DataRva(dll, 4);          // Name
    a.DataRva(iat, 4);          // FirstThunk
    a.DataRva(ilt2, 4);         // ADVAPI32.dll
    a.DataU32(0);
    a.DataU32(0);
    a.DataRva(dll2, 4);
    a.DataRva(iat2, 4);
    a.DataRva(ilt3, 4);         // WS2_32.dll
    a.DataU32(0);
    a.DataU32(0);
    a.DataRva(dll3, 4);
    a.DataRva(iat3, 4);
    a.DataRva(ilt4, 4);         // CRYPT32.dll
    a.DataU32(0);
    a.DataU32(0);
    a.DataRva(dll4, 4);
    a.DataRva(iat4, 4);
    a.DataZeros(20);            // the null descriptor
    a.DataAlign(8);
    a.BindData(ilt);
    for (u32 k = 0; k < WIN_IMPORTS; k++) a.DataRva(names[k], 8);
    a.DataZeros(8);
    a.BindData(ilt2);
    a.DataRva(name2, 8);
    a.DataZeros(8);
    a.BindData(ilt3);
    for (u32 k = 0; k < WS_IMPORTS; k++) a.DataRva(wsNames[k], 8);
    a.DataZeros(8);
    a.BindData(ilt4);
    for (u32 k = 0; k < CR_IMPORTS; k++) a.DataRva(crNames[k], 8);
    a.DataZeros(8);
    a.BindData(iat);
    for (u32 k = 0; k < WIN_IMPORTS; k++) a.DataRva(names[k], 8);
    a.DataZeros(8);             // slot 28 ends KERNEL32's
    a.BindData(iat2);           // slot 29
    a.DataRva(name2, 8);
    a.DataZeros(8);             // slot 30 ends ADVAPI32's
    a.BindData(iat3);           // slots 31-45
    for (u32 k = 0; k < WS_IMPORTS; k++) a.DataRva(wsNames[k], 8);
    a.DataZeros(8);             // slot 46 ends WS2_32's
    a.BindData(iat4);           // slots 47-49
    for (u32 k = 0; k < CR_IMPORTS; k++) a.DataRva(crNames[k], 8);
    a.DataZeros(8);             // slot 50 ends CRYPT32's
    for (u32 k = 0; k < WIN_IMPORTS; k++) {
        a.DataAlign(2);
        a.BindData(names[k]);
        a.DataZeros(2);         // hint
        str name = WinImport(k);
        for (usize i = 0; i < name.Len; i++) a.DataByte(name[i]);
        a.DataByte(0);
    }
    a.DataAlign(2);
    a.BindData(name2);
    a.DataZeros(2);
    str random = "SystemFunction036";
    for (usize i = 0; i < random.Len; i++) a.DataByte(random[i]);
    a.DataByte(0);
    for (u32 k = 0; k < WS_IMPORTS; k++) {
        a.DataAlign(2);
        a.BindData(wsNames[k]);
        a.DataZeros(2);         // hint
        str wname = WsImport(k);
        for (usize i = 0; i < wname.Len; i++) a.DataByte(wname[i]);
        a.DataByte(0);
    }
    for (u32 k = 0; k < CR_IMPORTS; k++) {
        a.DataAlign(2);
        a.BindData(crNames[k]);
        a.DataZeros(2);         // hint
        str cname = CrImport(k);
        for (usize i = 0; i < cname.Len; i++) a.DataByte(cname[i]);
        a.DataByte(0);
    }
    a.BindData(dll);
    str kernel = "KERNEL32.dll";
    for (usize i = 0; i < kernel.Len; i++) a.DataByte(kernel[i]);
    a.DataByte(0);
    a.BindData(dll2);
    str advapi = "ADVAPI32.dll";
    for (usize i = 0; i < advapi.Len; i++) a.DataByte(advapi[i]);
    a.DataByte(0);
    a.BindData(dll3);
    str ws2 = "WS2_32.dll";
    for (usize i = 0; i < ws2.Len; i++) a.DataByte(ws2[i]);
    a.DataByte(0);
    a.BindData(dll4);
    str crypt32 = "CRYPT32.dll";
    for (usize i = 0; i < crypt32.Len; i++) a.DataByte(crypt32[i]);
    a.DataByte(0);
    return new WinImports { Dir = dir, Iat = iat };
}

void Put16(ref string f, usize at, u64 v) => PutBytes(ref f, at, v, 2);
void Put32(ref string f, usize at, u64 v) => PutBytes(ref f, at, v & 0xFFFFFFFF, 4);
void Put64(ref string f, usize at, u64 v) => PutBytes(ref f, at, v, 8);

// n zero bytes.
string Zeros(usize n) {
    string s = string.New();
    s.Reserve(n);
    for (usize i = 0; i < n; i++) s.AppendByte(0);
    return s;
}

// Links the code and data and returns a complete executable. The section starts with the
// entry point.
string WriteImage(ref Asm a, u32 target, WinImports imports) {
    u64 dataStart = 0;
    if (target == TARGET_WINDOWS) {
        string section = a.Link(IMAGE_BASE, PE_SECTION_RVA, ref dataStart);
        u64 size = (section.Len() as u64 + 0xFFF) & ~0xFFF;
        u64 fileSize = 0x1000 + size;
        string f = Zeros(0x1000);
        f.Append(section);
        while (f.Len() < fileSize as usize) f.AppendByte(0);
        Put16(ref f, 0, 0x5A4D);                    // MZ
        Put32(ref f, 0x3C, 0x40);                   // e_lfanew
        Put32(ref f, 0x40, 0x4550);                 // PE
        Put16(ref f, 0x44, 0x8664);                 // AMD64
        Put16(ref f, 0x46, 1);                      // one section
        Put16(ref f, 0x54, 240);                    // SizeOfOptionalHeader
        Put16(ref f, 0x56, 0x0023);                 // RELOCS_STRIPPED | EXECUTABLE | LARGE_ADDRESS_AWARE
        Put16(ref f, 0x58, 0x020B);                 // PE32+
        Put32(ref f, 0x5C, size);                   // SizeOfCode
        Put32(ref f, 0x68, PE_SECTION_RVA);         // entry point: the start of the section
        Put32(ref f, 0x6C, PE_SECTION_RVA);         // BaseOfCode
        Put64(ref f, 0x70, IMAGE_BASE);
        Put32(ref f, 0x78, 0x1000);                 // SectionAlignment
        Put32(ref f, 0x7C, 0x1000);                 // FileAlignment
        Put16(ref f, 0x80, 6);                      // OS version 6.0
        Put16(ref f, 0x88, 6);                      // subsystem version 6.0
        Put32(ref f, 0x90, size + 0x1000);          // SizeOfImage
        Put32(ref f, 0x94, 0x1000);                 // SizeOfHeaders
        Put16(ref f, 0x9C, 3);                      // console
        Put16(ref f, 0x9E, 0x8100);                 // NX_COMPAT | TERMINAL_SERVER_AWARE
        Put64(ref f, 0xA0, 0x800000);               // stack reserve (8 MiB)
        Put64(ref f, 0xA8, 0x1000);                 // stack commit
        Put64(ref f, 0xB0, 0x100000);               // heap reserve
        Put64(ref f, 0xB8, 0x1000);                 // heap commit
        Put32(ref f, 0xC4, 16);                     // NumberOfRvaAndSizes
        Put32(ref f, 0xD0, PE_SECTION_RVA + a.LabelOffset(imports.Dir, dataStart));
        Put32(ref f, 0xD4, 100);
        Put32(ref f, 0x148, 0x7865742E);            // ".tex"
        Put16(ref f, 0x14C, 0x74);                  // "t"
        Put32(ref f, 0x150, size);                  // VirtualSize
        Put32(ref f, 0x154, PE_SECTION_RVA);        // VirtualAddress
        Put32(ref f, 0x158, size);                  // SizeOfRawData
        Put32(ref f, 0x15C, 0x1000);                // PointerToRawData
        Put32(ref f, 0x16C, 0xE0000020);            // CODE | EXECUTE | READ | WRITE
        return f;
    }
    string section = a.Link(IMAGE_BASE, ELF_HEADERS, ref dataStart);
    u64 fileSize = ELF_HEADERS + section.Len() as u64;
    string f = Zeros(ELF_HEADERS as usize);
    f.Append(section);
    Put32(ref f, 0, 0x464C457F);                    // 0x7F 'E' 'L' 'F'
    Put32(ref f, 4, 0x00010102);                    // 64-bit, little-endian, version 1
    Put16(ref f, 16, 2);                            // ET_EXEC
    Put16(ref f, 18, 0x3E);                         // x86-64
    Put32(ref f, 20, 1);
    Put64(ref f, 24, IMAGE_BASE + ELF_HEADERS);     // entry point: the start of the section
    Put64(ref f, 32, 64);                           // program headers follow
    Put16(ref f, 52, 64);
    Put16(ref f, 54, 56);
    Put16(ref f, 56, 2);
    Put32(ref f, 64, 1);                            // PT_LOAD, R | W | X, the whole file
    Put32(ref f, 68, 7);
    Put64(ref f, 80, IMAGE_BASE);
    Put64(ref f, 88, IMAGE_BASE);
    Put64(ref f, 96, fileSize);
    Put64(ref f, 104, fileSize);
    Put64(ref f, 112, 0x1000);
    Put32(ref f, 120, 0x6474E551);                  // PT_GNU_STACK, R | W
    Put32(ref f, 124, 6);
    Put64(ref f, 168, 16);
    return f;
}
