// Register allocation at -O2 (PLAN D20, D79): linear scan. Each SSA value gets one
// interval, from its definition to its last use in the order of the function's blocks,
// widened to every block where it is live, so loops are covered. Values then take a
// register for their whole interval or stay in their stack slot. When registers run out,
// the value that would cost least in memory (its uses, weighted by 8 per enclosing loop)
// is the one that stays there. The callee-saved
// registers rbx and r12-r15 survive everything; rsi, rdi and r8-r10 are free between
// calls, so they go to values that live across no call or system call (liveness at each
// call says which do: a value whose interval merely spans a call it is dead at may have
// one), and whose interval holds none of the copies and fills that use rsi and rdi. A value that crosses calls and finds no
// callee-saved register may still take one of them when storing it before each call it
// lives through and loading it after costs less than keeping it in memory: those calls
// are listed in keepInst and keepVal for the code generator. The code generator's scratch
// registers are rax, rcx, rdx and r11.
//
// At -O2 calls pass their first NARGREGS arguments in rdi, rsi, r8, r9 and r10: the
// registers every call overwrites anyway. A parameter that arrives in one keeps it when
// it can.
namespace envoc.x64;

use envoc.util;
use envoc.eir;

public const u8 R12 = 12;
public const u8 R13 = 13;
public const u8 R14 = 14;
public const u8 R15 = 15;
const u8 NOREG = 0xFF;
const u32 NOHINT = 0xFFFFFFFF;
const u32 NREGS = 10;       // allocatable: the callee-saved first, then the caller-saved
const u32 NSAVED = 5;       // the callee-saved ones, which a function that uses them saves

public const u32 NARGREGS = 5;

// The register argument k arrives in.
u8 ArgReg(u32 k) {
    if (k == 0) return RDI;
    if (k == 1) return RSI;
    return R8 + (k - 2) as u8;
}

// ArgReg(k) as an allocation index (AllocReg's argument).
u32 ArgRegIndex(u32 k) {
    if (k == 0) return 6;
    if (k == 1) return 5;
    return 7 + k - 2;
}

// Is value a dead at every position of [cs, ce] (cur's interval, which starts where cur is
// defined), after the instruction at cs reads it? Then
// a value living only there can share a's register: a's later uses are on paths that do
// not pass through it. The instruction at cs may read a only as the first operand of an
// add, sub, and, or or xor (which reads it before writing the result), and with strict,
// not at all.
bool DeadThrough(in Module m, in EFunc f, u32 a, u32 cur, u32 cs, u32 ce, in List<u32> posBlock, in List<u32> posInst, in List<u32> bstart, in BitSets live, in BitSets liveOut, in BitSets defs, bool strict) {
    u32 cb = posBlock.Get(cs as usize);
    if (liveOut.Has(cb, a)) return false;
    EBlock blk = m.Block(f.FirstBlock + cb);
    u32 from = blk.FirstInst;
    u32 at = posInst.Get(cs as usize);
    // cs must be where cur is defined
    if (at != NOHINT && m.Inst(at).Result - f.FirstValue != cur) return false;
    if (at == NOHINT && (cur + f.FirstValue < blk.FirstParam || cur + f.FirstValue >= blk.FirstParam + blk.NParams)) return false;
    if (at != NOHINT) {
        from = at + 1;
        if (strict && Reads(m, f, at, a)) return false;
    }
    for (u32 i = from; i < blk.FirstInst + blk.NInsts; i++) {
        if (Reads(m, f, i, a)) return false;
    }
    for (u32 bi = cb + 1; bi < f.NBlocks && bstart.Get(bi as usize) <= ce; bi++) {
        if (live.Has(bi, a) || defs.Has(bi, a)) return false;
    }
    return true;
}

// Does instruction i read value a (relative)?
bool Reads(in Module m, in EFunc f, u32 i, u32 a) {
    EInst inst = m.Inst(i);
    for (u32 o = inst.FirstOp; o < inst.FirstOp + inst.NOps; o++) {
        EOp op = m.Op(o);
        if (op.Kind == OK_VALUE && op.Ref - f.FirstValue == a) return true;
        if (op.Kind == OK_TARGET) {
            for (u32 k = 0; k < op.NArgs; k++) {
                if (m.Arg(op.Args + k) - f.FirstValue == a) return true;
            }
        }
    }
    return false;
}

// The allocation index of register r (AllocReg's inverse), NREGS for none.
u32 RegIndex(u8 r) {
    if (r == NOREG) return NREGS;
    for (u32 i = 0; i < NREGS; i++) {
        if (AllocReg(i) == r) return i;
    }
    return NREGS;
}

u8 AllocReg(u32 i) {
    if (i == 0) return RBX;
    if (i < NSAVED) return R12 + (i - 1) as u8;
    if (i == 5) return RSI;
    if (i == 6) return RDI;
    return R8 + (i - 7) as u8;
}

// The caller-saved registers instruction inst overwrites (bit i - NSAVED for AllocReg(i)).
u32 Clobbers(in Module m, in EInst inst) {
    u16 op = inst.Op;
    if (op == 52 || op == 53 || op == 54) return 31;    // call, call.ind, intrinsic
    // a copy or zero of up to 256 constant bytes goes through rax (gen.envol)
    if (op == 47 && !SmallSize(m, inst.FirstOp + 2)) return 3;     // copy: rsi, rdi
    if (op == 48 && !SmallSize(m, inst.FirstOp + 1)) return 2;     // zero: rdi
    return 0;
}

// Is operand o a constant of at most 256 (written, or a `const`)?
bool SmallSize(in Module m, u32 o) {
    EOp op = m.Op(o);
    if (op.Kind == OK_INT) return op.Int <= 256;
    if (op.Kind != OK_VALUE) return false;
    EVal v = m.Val(op.Ref);
    if (v.Inst == 0) return false;
    EInst d = m.Inst(v.Inst);
    return d.Op == OP_CONST && d.Imm <= 256;
}

// A set of values (relative to the function's first) per block.
struct BitSets {
    usize Words;
    List<u64> Bits;

    static BitSets New(u32 sets, u32 values) {
        BitSets b = new BitSets { Words = ((values + 63) / 64) as usize, Bits = List<u64>.New() };
        if (b.Words == 0) b.Words = 1;
        for (usize i = 0; i < b.Words * sets as usize; i++) b.Bits.Push(0);
        return b;
    }

    bool Has(in this, u32 set, u32 v) {
        u64 w = this.Bits.Get(set as usize * this.Words + (v / 64) as usize);
        return (w >> (v % 64) as u64) & 1 != 0;
    }

    void Add(ref this, u32 set, u32 v) {
        usize at = set as usize * this.Words + (v / 64) as usize;
        u64 w = this.Bits.Get(at);
        this.Bits.Set(at, w | ((1 as u64) << (v % 64) as u64));
    }
}

// The registers of function fi's values (relative to its first), NOREG for a value that
// stays in memory. Values with remat[k] set are recomputed where used and get none.
// used[r] is set for each register given out.
List<u8> AllocateRegs(in Module m, u32 fi, in List<u8> remat, ref List<bool> used, ref List<u32> keepInst, ref List<u32> keepVal) {
    EFunc f = m.Func(fi);
    u32 nv = f.NValues;
    u32 nb = f.NBlocks;
    List<u8> regs = List<u8>.New();
    for (u32 k = 0; k < nv; k++) regs.Push(NOREG);
    for (u32 r = 0; r < NREGS; r++) used.Push(false);
    if (nv == 0) return regs;

    // positions: each block's start, then one per instruction (the last is its terminator)
    List<u32> bstart = List<u32>.New();
    List<u32> bend = List<u32>.New();
    List<u32> start = List<u32>.New();
    List<u32> end = List<u32>.New();
    for (u32 k = 0; k < nv; k++) {
        start.Push(0xFFFFFFFF);
        end.Push(0);
    }
    for (u32 k = 0; k < f.NParams; k++) start.Set(k as usize, 0);
    BitSets defs = BitSets.New(nb, nv);
    BitSets uses = BitSets.New(nb, nv);
    List<u32> clob = List<u32>.New();      // per position: the caller-saved registers it overwrites
    // hints, so copies between a branch's arguments and its target's parameters vanish:
    // pairs (parameter, argument), and per value the first operand of the add, sub, and,
    // or or xor that defines it (NOHINT if none)
    List<u32> pairP = List<u32>.New();
    List<u32> pairA = List<u32>.New();
    List<u32> op0 = List<u32>.New();
    for (u32 k = 0; k < nv; k++) op0.Push(NOHINT);
    clob.Push(0);
    // the calls, in order: position, instruction, and weight times 8 (a value kept in a
    // caller-saved register is stored and loaded around each it lives across)
    List<u32> callPos = List<u32>.New();
    List<u32> callInst = List<u32>.New();
    List<u64> callWt = List<u64>.New();
    List<bool> callRare = List<bool>.New();     // on one arm of a branch
    // how deep in loops each block is: a branch back to an earlier block (in the order
    // the blocks are emitted) closes a loop over the blocks between
    List<u32> depth = List<u32>.New();
    for (u32 bi = 0; bi < nb; bi++) depth.Push(0);
    for (u32 bi = 0; bi < nb; bi++) {
        EBlock blk = m.Block(f.FirstBlock + bi);
        EInst term = m.Inst(blk.FirstInst + blk.NInsts - 1);
        for (u32 o = term.FirstOp; o < term.FirstOp + term.NOps; o++) {
            EOp op = m.Op(o);
            if (op.Kind != OK_TARGET) continue;
            u32 tb = op.Ref - f.FirstBlock;
            if (tb > bi) continue;
            for (u32 k = tb; k <= bi; k++) depth.Set(k as usize, depth.Get(k as usize) + 1);
        }
    }
    // blocks only one arm of a conditional branch reaches: a call there runs on some of
    // the passes only (a list or string growing, an error path), counted 1/8 as often
    List<u32> npred = List<u32>.New();
    List<bool> armOnly = List<bool>.New();
    for (u32 bi = 0; bi < nb; bi++) {
        npred.Push(0);
        armOnly.Push(false);
    }
    for (u32 bi = 0; bi < nb; bi++) {
        EBlock blk = m.Block(f.FirstBlock + bi);
        EInst term = m.Inst(blk.FirstInst + blk.NInsts - 1);
        for (u32 o = term.FirstOp; o < term.FirstOp + term.NOps; o++) {
            EOp op = m.Op(o);
            if (op.Kind != OK_TARGET) continue;
            u32 tb = op.Ref - f.FirstBlock;
            npred.Set(tb as usize, npred.Get(tb as usize) + 1);
            armOnly.Set(tb as usize, term.Op == 56);
        }
    }
    // what keeping each value in memory would cost: its uses and definition, each weighted
    // by 8 per loop around it
    List<u64> weight = List<u64>.New();
    for (u32 k = 0; k < nv; k++) weight.Push(0);
    u32 pos = 1;
    List<u32> posBlock = List<u32>.New();       // per position: its block
    List<u32> posInst = List<u32>.New();        // per position: its instruction, NOHINT at a block's start
    posBlock.Push(0);
    posInst.Push(NOHINT);
    for (u32 bi = 0; bi < nb; bi++) {
        u32 dd = depth.Get(bi as usize);
        if (dd > 6) dd = 6;
        u64 wt = (1 as u64) << (3 * dd) as u64;
        EBlock blk = m.Block(f.FirstBlock + bi);
        bstart.Push(pos);
        clob.Push(0);
        posBlock.Push(bi);
        posInst.Push(NOHINT);
        for (u32 k = 0; k < blk.NParams; k++) {
            u32 v = blk.FirstParam + k - f.FirstValue;
            defs.Add(bi, v);
            if (start.Get(v as usize) > pos) start.Set(v as usize, pos);
        }
        if (bi == 0) {
            for (u32 k = 0; k < f.NParams; k++) defs.Add(0, k);
        }
        pos++;
        for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) {
            EInst inst = m.Inst(i);
            u32 cl = Clobbers(m, inst);
            clob.Push(cl);
            if (cl == 31) {
                callPos.Push(pos);
                callInst.Push(i);
                bool rare = npred.Get(bi as usize) == 1 && armOnly.Get(bi as usize);
                callRare.Push(rare);
                if (rare) callWt.Push(wt);
                else callWt.Push(8 * wt);
            }
            posBlock.Push(bi);
            posInst.Push(i);
            for (u32 o = inst.FirstOp; o < inst.FirstOp + inst.NOps; o++) {
                EOp op = m.Op(o);
                if (op.Kind == OK_VALUE) {
                    u32 v = op.Ref - f.FirstValue;
                    weight.Set(v as usize, weight.Get(v as usize) + wt);
                    if (!defs.Has(bi, v)) uses.Add(bi, v);
                    if (end.Get(v as usize) < pos) end.Set(v as usize, pos);
                } else if (op.Kind == OK_TARGET) {
                    EBlock tb = m.Block(op.Ref);
                    for (u32 a = 0; a < op.NArgs; a++) {
                        u32 v = m.Arg(op.Args + a) - f.FirstValue;
                        weight.Set(v as usize, weight.Get(v as usize) + wt);
                        if (!defs.Has(bi, v)) uses.Add(bi, v);
                        if (end.Get(v as usize) < pos) end.Set(v as usize, pos);
                        pairP.Push(tb.FirstParam + a - f.FirstValue);
                        pairA.Push(v);
                    }
                }
            }
            if (inst.Result != 0) {
                u32 v = inst.Result - f.FirstValue;
                weight.Set(v as usize, weight.Get(v as usize) + wt);
                u16 iop = inst.Op;
                if ((iop == 5 || iop == 6 || iop == 8 || iop == 9 || iop == 14 || iop == 15 || iop == 16) && inst.NOps == 2 && m.Op(inst.FirstOp).Kind == OK_VALUE && !m.IsFloat(inst.Ty)) {
                    op0.Set(v as usize, m.Op(inst.FirstOp).Ref - f.FirstValue);
                }
                defs.Add(bi, v);
                if (start.Get(v as usize) > pos) start.Set(v as usize, pos);
            }
            pos++;
        }
        bend.Push(pos - 1);
    }

    // liveness: in(b) = uses(b) + (out(b) - defs(b)), out(b) = the union of in(successors)
    BitSets live = BitSets.New(nb, nv);     // live-in
    BitSets liveOut = BitSets.New(nb, nv);      // live-out
    bool changed = true;
    while (changed) {
        changed = false;
        u32 bi = nb;
        while (bi > 0) {
            bi--;
            EBlock blk = m.Block(f.FirstBlock + bi);
            EInst term = m.Inst(blk.FirstInst + blk.NInsts - 1);
            for (u32 o = term.FirstOp; o < term.FirstOp + term.NOps; o++) {
                EOp op = m.Op(o);
                if (op.Kind != OK_TARGET) continue;
                u32 s = op.Ref - f.FirstBlock;
                for (usize w = 0; w < liveOut.Words; w++) {
                    usize at = bi as usize * liveOut.Words + w;
                    u64 add = live.Bits.Get(s as usize * live.Words + w);
                    u64 cur = liveOut.Bits.Get(at);
                    if (cur | add != cur) liveOut.Bits.Set(at, cur | add);
                }
            }
            for (usize w = 0; w < live.Words; w++) {
                usize at = bi as usize * live.Words + w;
                u64 v = uses.Bits.Get(at) | (liveOut.Bits.Get(at) & ~defs.Bits.Get(at));
                if (v != live.Bits.Get(at)) {
                    live.Bits.Set(at, v);
                    changed = true;
                }
            }
        }
    }
    // each interval covers the blocks it is live in (the set bits only: functions grown by
    // inlining have many blocks and values)
    for (u32 bi = 0; bi < nb; bi++) {
        u32 bs = bstart.Get(bi as usize);
        u32 be = bend.Get(bi as usize);
        for (usize w = 0; w < live.Words; w++) {
            u64 li = live.Bits.Get(bi as usize * live.Words + w);
            u64 lo = liveOut.Bits.Get(bi as usize * live.Words + w);
            u64 any = li | lo;
            u32 v = (w * 64) as u32;
            while (any != 0) {
                while (any & 0xFF == 0) {
                    any = any >> 8;
                    li = li >> 8;
                    lo = lo >> 8;
                    v += 8;
                }
                if (li & 1 != 0 && start.Get(v as usize) > bs) start.Set(v as usize, bs);
                if (lo & 1 != 0 && end.Get(v as usize) < be) end.Set(v as usize, be);
                any = any >> 1;
                li = li >> 1;
                lo = lo >> 1;
                v++;
            }
        }
    }

    // per caller-saved register: how many positions up to p that are not calls (copies
    // and fills) overwrite it
    List<u32> prefixOther = List<u32>.New();      // (p + 1) * 5 + r
    for (u32 r = 0; r < 5; r++) prefixOther.Push(0);
    for (u32 q = 0; q < clob.Len() as u32; q++) {
        u32 c = clob.Get(q as usize);
        for (u32 r = 0; r < 5; r++) {
            u32 no = prefixOther.Get((q * 5 + r) as usize);
            if ((c >> r) & 1 != 0 && c != 31) no++;
            prefixOther.Push(no);
        }
    }
    // per call: the values live across it (live after it, its result aside), from a walk
    // back through each block
    usize words = live.Words;
    usize ncalls = callPos.Len();
    List<u64> callLive = List<u64>.New();
    for (usize q = 0; q < ncalls * words; q++) callLive.Push(0);
    List<u64> now = List<u64>.New();
    for (usize w = 0; w < words; w++) now.Push(0);
    usize ci = ncalls;
    u32 wb = nb;
    while (wb > 0 && ci > 0) {
        wb--;
        for (usize w = 0; w < words; w++) now.Set(w, liveOut.Bits.Get(wb as usize * words + w));
        EBlock blk = m.Block(f.FirstBlock + wb);
        u32 i = blk.FirstInst + blk.NInsts;
        while (i > blk.FirstInst) {
            i--;
            EInst inst = m.Inst(i);
            if (inst.Result != 0) {
                u32 v = inst.Result - f.FirstValue;
                usize at = (v / 64) as usize;
                now.Set(at, now.Get(at) & ~((1 as u64) << (v % 64) as u64));
            }
            if (ci > 0 && callInst.Get(ci - 1) == i) {
                ci--;
                for (usize w = 0; w < words; w++) callLive.Set(ci * words + w, now.Get(w));
            }
            for (u32 o = inst.FirstOp; o < inst.FirstOp + inst.NOps; o++) {
                EOp op = m.Op(o);
                if (op.Kind == OK_VALUE) {
                    u32 v = op.Ref - f.FirstValue;
                    usize at = (v / 64) as usize;
                    now.Set(at, now.Get(at) | ((1 as u64) << (v % 64) as u64));
                } else if (op.Kind == OK_TARGET) {
                    for (u32 a = 0; a < op.NArgs; a++) {
                        u32 v = m.Arg(op.Args + a) - f.FirstValue;
                        usize at = (v / 64) as usize;
                        now.Set(at, now.Get(at) | ((1 as u64) << (v % 64) as u64));
                    }
                }
            }
        }
    }
    List<bool> keep = List<bool>.New();     // per value: kept in a caller-saved register across calls
    for (u32 k = 0; k < nv; k++) keep.Push(false);

    // each value's partners in the pairs, in one flat list
    List<u32> pfirst = List<u32>.New();
    for (u32 k = 0; k <= nv; k++) pfirst.Push(0);
    for (usize j = 0; j < pairP.Len(); j++) {
        pfirst.Set((pairP.Get(j) + 1) as usize, pfirst.Get((pairP.Get(j) + 1) as usize) + 1);
        pfirst.Set((pairA.Get(j) + 1) as usize, pfirst.Get((pairA.Get(j) + 1) as usize) + 1);
    }
    for (u32 k = 1; k <= nv; k++) pfirst.Set(k as usize, pfirst.Get(k as usize) + pfirst.Get((k - 1) as usize));
    List<u32> partner = List<u32>.New();
    List<u32> fillAt = List<u32>.New();
    for (u32 k = 0; k < nv; k++) fillAt.Push(pfirst.Get(k as usize));
    for (usize j = 0; j < pairP.Len() * 2; j++) partner.Push(0);
    for (usize j = 0; j < pairP.Len(); j++) {
        u32 pv = pairP.Get(j);
        u32 av = pairA.Get(j);
        partner.Set(fillAt.Get(pv as usize) as usize, av);
        fillAt.Set(pv as usize, fillAt.Get(pv as usize) + 1);
        partner.Set(fillAt.Get(av as usize) as usize, pv);
        fillAt.Set(av as usize, fillAt.Get(av as usize) + 1);
    }

    // linear scan, intervals in order of start (bucketed by position)
    List<u32> heads = List<u32>.New();     // per position: first value starting there, + 1
    List<u32> next = List<u32>.New();      // per value: the next value starting at the same position, + 1
    for (u32 p = 0; p <= pos; p++) heads.Push(0);
    for (u32 v = 0; v < nv; v++) next.Push(0);
    u32 v = nv;
    while (v > 0) {
        v--;
        if (remat.Get(v as usize) != 0 || end.Get(v as usize) == 0 || start.Get(v as usize) > pos) continue;
        u32 s = start.Get(v as usize);
        next.Set(v as usize, heads.Get(s as usize));
        heads.Set(s as usize, v + 1);
    }
    // per register: the values given it, as linked lists (firstOnReg: index + 1 into
    // onReg, 0 for none; onRegNext: the next, likewise)
    List<u32> firstOnReg = List<u32>.New();
    for (u32 r = 0; r < NREGS; r++) firstOnReg.Push(0);
    List<u32> onReg = List<u32>.New();
    List<u32> onRegNext = List<u32>.New();
    List<u32> holder = List<u32>.New();    // per register: the value + 1 holding it, or 0
    for (u32 r = 0; r < NREGS; r++) holder.Push(0);
    // per register: 1 + the last position of values that share it with its holder, inside
    // a stretch where the holder is dead (0: none); the register is busy until then
    List<u32> shareEnd = List<u32>.New();
    for (u32 r = 0; r < NREGS; r++) shareEnd.Push(0);
    for (u32 p = 0; p <= pos; p++) {
        u32 h = heads.Get(p as usize);
        while (h != 0) {
            u32 cur = h - 1;
            h = next.Get(cur as usize);
            u32 cs = start.Get(cur as usize);
            u32 ce = end.Get(cur as usize);
            // the caller-saved registers overwritten while it lives: by the copies and fills
            // in its interval, and all of them by a call it lives across
            u32 forbidOther = 0;
            u32 last = ce;
            if (last >= clob.Len() as u32) last = clob.Len() as u32 - 1;
            for (u32 r = 0; r < 5; r++) {
                if (prefixOther.Get(((last + 1) * 5 + r) as usize) != prefixOther.Get(((cs + 1) * 5 + r) as usize)) forbidOther = forbidOther | (1 << r);
            }
            usize c0 = CallAfter(callPos, cs);
            bool crosses = false;
            for (usize c = c0; c < ncalls && callPos.Get(c) <= last && !crosses; c++) {
                if (LiveAcross(callLive, words, c, cur)) crosses = true;
            }
            u32 forbid = forbidOther;
            if (crosses) forbid = 31;
            // free the registers of intervals that ended
            for (u32 r = 0; r < NREGS; r++) {
                u32 hv = holder.Get(r as usize);
                if (hv != 0 && end.Get((hv - 1) as usize) < cs) holder.Set(r as usize, 0);
            }
            // a parameter: the register it arrives in, if it may have it; else a free
            // caller-saved register it may have, else a free callee-saved one
            u32 pick = NREGS;
            bool shared = false;
            if (cur < f.NParams && cur < NARGREGS) {
                u32 a = ArgRegIndex(cur);
                if ((forbid >> (a - NSAVED)) & 1 == 0 && holder.Get(a as usize) == 0 && shareEnd.Get(a as usize) <= cs) pick = a;
            }
            // a register a related value has, if it is free and allowed
            if (pick == NREGS) {
                u32 a = op0.Get(cur as usize);
                if (a != NOHINT) {
                    u32 ri = RegIndex(regs.Get(a as usize));
                    // the operand's register, free or freed by this very instruction, or
                    // shared while the operand is dead
                    bool allowed = ri != NREGS && (ri < NSAVED || (forbid >> (ri - NSAVED)) & 1 == 0) && (ri == NREGS || shareEnd.Get(ri as usize) <= cs);
                    if (allowed && (holder.Get(ri as usize) == 0 || (holder.Get(ri as usize) == a + 1 && end.Get(a as usize) == cs))) {
                        holder.Set(ri as usize, 0);
                        pick = ri;
                    } else if (allowed && holder.Get(ri as usize) == a + 1 && DeadThrough(m, f, a, cur, cs, ce, posBlock, posInst, bstart, live, liveOut, defs, false)) {
                        pick = ri;
                        shared = true;
                    }
                }
            }
            for (u32 j = pfirst.Get(cur as usize); j < pfirst.Get((cur + 1) as usize) && pick == NREGS; j++) {
                u32 other = partner.Get(j as usize);
                if (other == cur) continue;
                u32 ri = RegIndex(regs.Get(other as usize));
                if (ri == NREGS || shareEnd.Get(ri as usize) > cs) continue;
                if (ri >= NSAVED && (forbid >> (ri - NSAVED)) & 1 != 0) continue;
                if (holder.Get(ri as usize) == 0) {
                    pick = ri;
                } else if (holder.Get(ri as usize) == other + 1 && DeadThrough(m, f, other, cur, cs, ce, posBlock, posInst, bstart, live, liveOut, defs, true)) {
                    pick = ri;
                    shared = true;
                }
            }
            for (u32 r = NSAVED; r < NREGS && pick == NREGS; r++) {
                if ((forbid >> (r - NSAVED)) & 1 == 0 && holder.Get(r as usize) == 0 && shareEnd.Get(r as usize) <= cs) pick = r;
            }
            for (u32 r = 0; r < NSAVED && pick == NREGS; r++) {
                if (holder.Get(r as usize) == 0 && shareEnd.Get(r as usize) <= cs) pick = r;
            }
            if (pick == NREGS) {
                // all it may have are taken: the cheapest of the holders and this one goes
                // to memory (of equal cost, the one that ends last)
                u32 far = NREGS;
                for (u32 r = 0; r < NREGS; r++) {
                    if (r >= NSAVED && (forbid >> (r - NSAVED)) & 1 != 0) continue;
                    if (holder.Get(r as usize) == 0 || shareEnd.Get(r as usize) > cs) continue;
                    if (far == NREGS) {
                        far = r;
                        continue;
                    }
                    u32 hr = holder.Get(r as usize) - 1;
                    u32 hf = holder.Get(far as usize) - 1;
                    u64 wr = weight.Get(hr as usize);
                    u64 wf = weight.Get(hf as usize);
                    if (wr < wf || (wr == wf && end.Get(hr as usize) > end.Get(hf as usize))) far = r;
                }
                if (far == NREGS) continue;
                u32 victim = holder.Get(far as usize) - 1;
                u64 wv = weight.Get(victim as usize);
                u64 wc = weight.Get(cur as usize);
                if (wc < wv || (wc == wv && end.Get(victim as usize) <= ce)) continue;
                regs.Set(victim as usize, NOREG);
                pick = far;
            }
            if (shared) {
                if (shareEnd.Get(pick as usize) < ce + 1) shareEnd.Set(pick as usize, ce + 1);
            } else {
                holder.Set(pick as usize, cur + 1);
            }
            regs.Set(cur as usize, AllocReg(pick));
            used.Set(pick as usize, true);
            onReg.Push(cur);
            onRegNext.Push(firstOnReg.Get(pick as usize));
            firstOnReg.Set(pick as usize, onReg.Len() as u32);
        }
    }

    // second chance: a value left in memory that lives across calls on one arm of a
    // branch only (a list or string growing, an error path) takes a caller-saved register
    // free over its whole interval, stored before each of those calls and loaded after,
    // when that costs less than memory. Values given registers above keep them.
    for (u32 k = 0; k < nv; k++) {
        if (regs.Get(k as usize) != NOREG || remat.Get(k as usize) != 0 || end.Get(k as usize) == 0 || start.Get(k as usize) > pos) continue;
        u32 cs = start.Get(k as usize);
        u32 last = end.Get(k as usize);
        if (last >= clob.Len() as u32) last = clob.Len() as u32 - 1;
        u64 cross = 0;
        bool rare = true;
        bool crosses = false;
        for (usize c = CallAfter(callPos, cs); c < ncalls && callPos.Get(c) <= last && rare; c++) {
            if (!LiveAcross(callLive, words, c, k)) continue;
            crosses = true;
            cross += callWt.Get(c);
            if (!callRare.Get(c)) rare = false;
        }
        if (!crosses || !rare || 2 * cross >= 8 * weight.Get(k as usize)) continue;
        u32 forbidOther = 0;
        for (u32 r = 0; r < 5; r++) {
            if (prefixOther.Get(((last + 1) * 5 + r) as usize) != prefixOther.Get(((cs + 1) * 5 + r) as usize)) forbidOther = forbidOther | (1 << r);
        }
        u32 pick = NREGS;
        for (u32 r = NSAVED; r < NREGS && pick == NREGS; r++) {
            if ((forbidOther >> (r - NSAVED)) & 1 != 0) continue;
            // free if no value with this register overlaps [cs, last]
            bool free = true;
            u32 at = firstOnReg.Get(r as usize);
            while (at != 0 && free) {
                u32 w = onReg.Get((at - 1) as usize);
                at = onRegNext.Get((at - 1) as usize);
                if (regs.Get(w as usize) != AllocReg(r)) continue;
                if (start.Get(w as usize) <= end.Get(k as usize) && end.Get(w as usize) >= cs) free = false;
            }
            if (free) pick = r;
        }
        if (pick == NREGS) continue;
        regs.Set(k as usize, AllocReg(pick));
        used.Set(pick as usize, true);
        keep.Set(k as usize, true);
        onReg.Push(k);
        onRegNext.Push(firstOnReg.Get(pick as usize));
        firstOnReg.Set(pick as usize, onReg.Len() as u32);
    }

    // the calls each kept value lives across
    for (u32 k = 0; k < nv; k++) {
        if (!keep.Get(k as usize) || regs.Get(k as usize) == NOREG) continue;
        u32 last = end.Get(k as usize);
        if (last >= clob.Len() as u32) last = clob.Len() as u32 - 1;
        for (usize c = CallAfter(callPos, start.Get(k as usize)); c < ncalls && callPos.Get(c) <= last; c++) {
            if (!LiveAcross(callLive, words, c, k)) continue;
            keepInst.Push(callInst.Get(c));
            keepVal.Push(k);
        }
    }
    return regs;
}

// The first of the calls (their positions, in order) after position p.
usize CallAfter(in List<u32> callPos, u32 p) {
    usize lo = 0;
    usize hi = callPos.Len();
    while (lo < hi) {
        usize mid = (lo + hi) / 2;
        if (callPos.Get(mid) <= p) lo = mid + 1;
        else hi = mid;
    }
    return lo;
}

// Is value v live across call c?
bool LiveAcross(in List<u64> callLive, usize words, usize c, u32 v) {
    return (callLive.Get(c * words + (v / 64) as usize) >> (v % 64) as u64) & 1 != 0;
}
