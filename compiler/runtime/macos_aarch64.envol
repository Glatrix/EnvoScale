// The Stage 2 runtime, part 2 for macOS on arm64 (M10, PLAN D70): the OS layer over BSD
// system calls (number in x16, `svc #0x80`; the backend turns a failure into a negative
// errno, as on Linux). dyld calls the entry as main(argc, argv), so __os_init gets the
// address of the pair. __syscall(n, a1, …, a6) is a target intrinsic the backend encodes.
// Compiled into every aarch64-macos program with runtime/common.envol; embedded in envoc as
// compiler/driver/runtime_macos.envol.

i64 __os_ptr(*u8 p) {
    unsafe { return p as isize as i64; }
}

void __os_init(i64 sp) {
    unsafe {
        *u64 pair = sp as isize as *u64;
        usize argc = pair[0] as usize;
        **u8 argv = pair[1] as isize as **u8;
        *str args = __rt_str_array(argc);
        for (usize i = 0; i < argc; i++) {
            *u8 a = argv[i];
            args[i] = str_from(a, __rt_cstr_len(a));
        }
        __rt_set_args(argc, args);
    }
}

// Retries on EINTR.
isize __os_write(i32 fd, *u8 p, usize n) {
    while (true) {
        i64 r = __syscall(4, fd as i64, __os_ptr(p), n as i64, 0, 0, 0);
        if (r != -4) return r as isize;
    }
}

isize __os_read(i32 fd, *u8 p, usize n) {
    while (true) {
        i64 r = __syscall(3, fd as i64, __os_ptr(p), n as i64, 0, 0, 0);
        if (r != -4) return r as isize;
    }
}

// mode 0 = read, 1 = write (create/truncate, 0644), 2 = the same, executable (0755).
// A path with a NUL byte fails: the system would read only the part before it.
i32 __os_open(*u8 path, usize len, i32 mode) {
    *u8 z = __rt_alloc(len + 1);       // zeroed, so the copy ends in NUL
    unsafe {
        for (usize i = 0; i < len; i++) {
            if (path[i] == 0) return -1;
            z[i] = path[i];
        }
    }
    i64 flags = 0x1000000;             // O_RDONLY | O_CLOEXEC
    i64 perm = 0;
    if (mode != 0) {
        flags = 0x1000601;             // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC
        perm = 0x1A4;                  // 0644
        if (mode == 2) perm = 0x1ED;   // 0755
    }
    return __syscall(5, __os_ptr(z), flags, perm, 0, 0, 0) as i32;
}

// fds 0-2 are left open, as on Windows.
void __os_close(i32 fd) {
    if (fd < 3) return;
    __syscall(6, fd as i64, 0, 0, 0, 0, 0);
}

// Zeroed, page-aligned memory, or null.
// How many times a large block's room the heap reserves after it to grow into (mappings
// are lazy: untouched pages cost nothing).
const usize __OS_RESERVE = 4;

*u8 __os_pages(usize n) {
    i64 r = __syscall(197, 0, n as i64, 3, 0x1002, -1, 0);  // mmap: RW, private, anonymous
    unsafe {
        if (r < 0 && r >= -4095) return 0 as usize as *u8;
        return r as isize as *u8;
    }
}

void __os_exit(i32 code) {
    __syscall(1, code as i64, 0, 0, 0, 0, 0);            // exit
}
