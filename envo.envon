#eon 1
// The EnvoScale workspace: `envo` commands run here treat the repository as one
// workspace. Format: docs/spec/eon.md.

workspace {
    name    = "envoscale"
    version = "0.0.1"
    edition = "2027"
    license = "PolyForm-Noncommercial-1.0.0 OR LicenseRef-EnvoScale-Commercial"

    // Packages built as part of the workspace. Each member has its own envo.envon.
    members = [
        "compiler",
        "runtime",
        "lib",
        "tools",
        "adapters",
        "examples/*",
    ]
}

// The standard platform needs no packages at all.
dependencies {
}

targets {
    default = ["native", "wasm"]
}
